<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Nubida AI STUDIO</title>
    <link rel="stylesheet" href="/static/css/style.css?v=260916a">
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">

    <!-- [속도개선 260914] 대용량 WASM/모델(약 240MB) preload 제거 -->
    <!-- 이유: preload 는 HTML 파싱 즉시 다운로드를 시작해 첫 화면(핀번호 입력)이 뜨기 전에 240MB를 받아버림 -->
    <!-- Emscripten(sherpa-onnx)은 locateFile 로 필요 시점에 스스로 로드하므로 preload 없이도 정상 동작 -->
    <!-- 대상: tts.wasm(11.7MB) + tts.data(166MB) + ko-kss/model.onnx(62MB) -->
    
    <!-- ══════════════════════════════════════════════════════════════
         [대용량 절감 260914] sherpa-onnx-wasm-main-tts.data (158MB) 다운로드 차단
         ──────────────────────────────────────────────────────────────
         · 반드시 WASM 로더 스크립트보다 "먼저" 실행되어야 한다.
           (로더가 로드되는 즉시 .data 패키지를 받기 때문)
         · 원리: Emscripten 은 아래 순서로 .data 를 로드한다.
             fetched = Module.getPreloadedPackage(NAME, SIZE)
             if (!fetched) fetchRemotePackage(...)   <-- 네트워크 다운로드
           getPreloadedPackage 가 빈 버퍼를 반환하면 다운로드가 발생하지 않는다.
         · .data 안에는 쓰지 않는 영어 TTS 모델(78MB) + 전세계 사전/목소리(~25MB)가 들어있음
         · ui_controller.js 가 필요한 파일만 /vfs/ 에 직접 로드하므로 .data 는 불필요
         · 실측 검증: 차단해도 WASM 정상 부팅 + TTS 생성 정상 (0.83초 오디오 OK)
         · 효과: 첫 방문 다운로드 230MB -> 약 72MB (158MB 절감, 69% 감소)
         ══════════════════════════════════════════════════════════════ -->
    <script>
    (function () {
        try {
            // Module 선점: Emscripten 로더는 기존 window.Module 을 재사용한다.
            window.Module = window.Module || {};

            // ★ 핵심: .data 패키지를 "이미 로드됨"으로 속이고 빈 버퍼를 반환
            //   -> fetchRemotePackage() 가 호출되지 않아 네트워크 다운로드가 없다.
            Module.getPreloadedPackage = function (packageName, packageSize) {
                if (packageName && /tts\.data/.test(packageName)) {
                    console.log('[절감] tts.data(158MB) 다운로드 차단');
                    return new ArrayBuffer(0);
                }
                return null;
            };

            // 이중 방어: .data 로드 트리거(카운터/목록)도 봉쇄
            Object.defineProperty(Module, 'expectedDataFileDownloads', {
                get: function () { return 0; },
                set: function () { /* 무시 */ },
                configurable: true
            });
            Object.defineProperty(Module, 'dataFileDownloads', {
                get: function () { return {}; },
                set: function () { /* 무시 */ },
                configurable: true
            });
            console.log('[절감] tts.data 차단 준비 완료');
        } catch (e) { console.log('[절감] 차단 실패(무시):', e.message); }
    })();
    </script>

    <!-- 엔진 및 제어 스크립트 -->
    <script src="/static/sherpa/sherpa-onnx-wasm-main-tts.js"></script>

    <script src="/static/sherpa/sherpa-onnx-tts.js"></script>
    <script src="/static/js/config.js?v=17" defer></script>
    <script src="/static/js/board.js?v=17" defer></script>
    <script src="/static/js/engine.js?v=17" defer></script>
    <script src="/static/js/ui_controller.js?v=17" defer></script>
    <script src="/static/js/mic.js?v=17" defer></script>
    <script src="/static/js/ai-assistant.js?v=17" defer></script>
    <script src="/static/js/song-generator.js?v=19" defer></script>

    
    <script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
        // [260914] ?v= 쿼리로 등록: Cloudflare/브라우저가 옛 sw.js 를 캐시해도
        //          새 버전이 확실히 로드되도록 캐시 키를 분리한다.
        //          v14: 필터/패닝/거칠기 효과 + Range은 SW 가 가로채지 않도록 수정 (4분할 병렬 다운로드 활성화)
        navigator.serviceWorker.register('/sw.js?v=17')
            .then(reg => console.log('🚀 서비스 워커 등록 성공!', reg.scope))
            .catch(err => console.log('❌ 등록 실패:', err));
        });
    }
    </script>


</head>

<body>
    <!-- [공통] 로딩 화면 -->
    <div id="loading" class="loading">
        <div class="loader-box">
            <h2>AI STUDIO <span>PRO</span></h2>
            <div class="progress-bar"><div id="load-progress" class="progress-fill"></div></div>
            <p id="load-status">시스템 최적화 중...</p>
        </div>
    </div>

    <!-- [공통] 상단 내비게이션 -->
    <nav id="main-nav">
        <div class="nav-brand" onclick="showPage('page-gate')">Nubida AI <span>STUDIO</span></div>
        <div class="nav-menu">
            <div class="nav-item" id="nav-studio" onclick="tryAccessStudio()">🎙️ 작업실</div>
            <div class="nav-item" id="nav-song" onclick="showPage('page-song')">🎵 AI 노래</div>
            <div class="nav-item" id="nav-ai" onclick="showPage('page-ai')">🤖 AI 도우미</div>
            <div class="nav-item" id="nav-board" onclick="showPage('page-board')">🎶 게시판</div>
        </div>
    </nav>

    <div class="container">
        <!-- [1] 게이트 페이지 (핀번호 입력) -->
        <div id="page-gate" class="page active">
        <div class="card gate-card">
            <h1>WELCOME TO <span>STUDIO</span></h1>
            <p>작업실 입장을 위해 핀번호를 입력하세요.</p>
            <div class="pin-group">
                <input type="password" id="pin-code" 
                    maxlength="4" 
                    inputmode="numeric" 
                    pattern="[0-9]*"
                    placeholder="****">
                <button class="btn-main" onclick="checkPin()">ENTER</button>
            </div>
            <p class="hint">게시판은 자유롭게 이용 가능합니다.</p>
        </div>
    </div>

        <!-- [2] 작업실 페이지 (보호됨) -->
        <div id="page-studio" class="page">
            <header class="studio-header">
                <h2>AI <span>PRODUCER</span></h2>
                <div class="visualizer-box"><canvas id="visualizer"></canvas></div>
            </header>

            <!-- 결과창 (미리보기/업로드) -->
            <div id="result-area" class="card result-card" style="display:none;">
    <div class="res-head">✨ MIXING COMPLETED</div>
    <input type="text" id="song-title-input" placeholder="곡 제목을 입력하세요">
    
    <!-- 개인 비밀번호 입력칸 추가 -->
    <div style="margin-top: 10px;">
        <input type="password" id="post-password" placeholder="삭제 비밀번호"
               style="width:100%; max-width:400px; padding:12px; border-radius:10px; border:1px solid #ddd;">
    </div>

            <div class="res-btns" style="margin-top:20px;">
        <button class="btn-sub" onclick="toggleProduction(true)">🎧 다시 듣기</button>
        <button class="btn-main" onclick="uploadToBoard()">🚀 게시판 업로드</button>
    </div>
        </div>

            <div class="card info-card">
                <div class="input-row">
                    <input type="text" id="school-name" placeholder="학교명">
                    <input type="text" id="user-name" placeholder="작성자 이름">
                </div>
                <div class="singer-grid" id="singerGrid"></div>
            </div>

            <div id="lyrics-list"></div>
            <button class="btn-add-bar" onclick="addLine()">+ 새로운 마디 추가</button>

            <!-- ══════════════════════════════════════════════════════════
                 [C안 260914] 내 목소리로 가창하기 (마이크 녹음) — AI 가창과 별도
                 ══════════════════════════════════════════════════════════ -->
            <div class="card mic-card" id="mic-card">
                <div class="mic-head">
                    <span class="mic-title">🎤 내 목소리로 부르기</span>
                    <span class="mic-sub">AI 대신 직접 랩/노래를 녹음할 수 있어요</span>
                </div>
                <div id="mic-status">대기 중 — 마이크 권한이 필요합니다</div>
                <div class="mic-level-wrap"><div id="mic-level-bar"></div></div>
                <div class="mic-btns">
                    <button id="btn-mic-rec" class="btn-mic-rec" onclick="micToggle()">🎤 마이크 녹음 시작</button>
                    <button id="btn-mic-play" class="btn-mic-sub" onclick="micPlayRecording()" disabled>▶ 재생</button>
                    <button id="btn-mic-download" class="btn-mic-sub" onclick="micDownloadRecording()" disabled>⬇ 저장</button>
                </div>
                <audio id="mic-playback" controls style="display:none;"></audio>
                <div class="mic-tip">💡 헤드폰 착용을 권장합니다 (스피커 사용 시 하울링 가능)</div>
            </div>

            <div style="height:120px;"></div> <!-- 여백 -->

            <!-- 하단 고정 바 -->
            <div class="bottom-ctrl">
                <button id="btn-record" class="btn-main rec-btn" onclick="toggleProduction(false)" disabled>🔴 가창 시작</button>
                <button class="btn-stop" onclick="stopAll()">정지</button>
            </div>
        </div>

        <!-- [3] 게시판 페이지 -->
        <div id="page-board" class="page">
            <h1 class="center">TOP 3 <span>CHART</span></h1>
            <div id="ranking-list" class="ranking-row"></div>
            <h2 class="section-title">최신 게시물</h2>
            <div id="board-list"></div>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             [4] AI 도우미 페이지 — 가사 생성 + AI 채팅 + 노래 만들기 가이드
             ══════════════════════════════════════════════════════════ -->
        <div id="page-ai" class="page">
            <h1 class="center">AI <span>도우미</span></h1>
            <p class="ai-lead">주제만 알려주면 가사를 만들어드려요. 노래 만드는 방법도 함께 배워보세요.</p>

            <!-- 노래 만들기 5단계 -->
            <div class="card ai-card">
                <div class="ai-card-head">🎼 노래 만드는 5단계</div>
                <div id="ai-guide-list" class="ai-guide-list"></div>
            </div>

            <!-- 장르 템플릿 -->
            <div class="card ai-card">
                <div class="ai-card-head">🎚️ 장르 고르기 (가창 설정 자동 적용)</div>
                <div id="ai-genre-grid" class="ai-genre-grid"></div>
                <button class="ai-btn-ghost ai-full" onclick="aiApplyGenreToStudio()">🎛️ 이 장르 설정을 작업실 모든 마디에 적용</button>
            </div>

            <!-- 가사 자동 생성 -->
            <div class="card ai-card">
                <div class="ai-card-head">✍️ 가사 자동 만들기</div>
                <div class="ai-topic-row">
                    <input type="text" id="ai-topic" placeholder="주제를 입력하세요 (예: 우정, 꿈, 여행, 우리 반)"
                           onkeydown="if(event.key==='Enter'){aiGenerateLyrics();}">
                    <select id="ai-bars">
                        <option value="4">4마디</option>
                        <option value="8" selected>8마디</option>
                        <option value="12">12마디</option>
                        <option value="16">16마디</option>
                    </select>
                </div>
                <button class="ai-btn-primary ai-full" onclick="aiGenerateLyrics()">✨ 가사 만들기</button>
                <div id="ai-lyrics-result" class="ai-lyrics-result"></div>
            </div>

            <!-- AI 채팅 -->
            <div class="card ai-card">
                <div class="ai-card-head">💬 AI에게 물어보기</div>
                <div id="ai-messages" class="ai-messages"></div>
                <div id="ai-status" class="ai-status"></div>
                <div class="ai-quick-row">
                    <button class="ai-chip" onclick="aiQuickAsk('우정에 대한 힙합 가사 8마디 써줘')">우정 힙합 가사</button>
                    <button class="ai-chip" onclick="aiQuickAsk('동요 만들기 좋은 주제 5개 추천해줘')">동요 주제 추천</button>
                    <button class="ai-chip" onclick="aiQuickAsk('노래를 잘 만들려면 어떻게 해야 해?')">노래 잘 만드는 법</button>
                </div>
                <div class="ai-input-row">
                    <input type="text" id="ai-input" placeholder="AI에게 무엇이든 물어보세요"
                           onkeydown="if(event.key==='Enter'){aiSend();}">
                    <button class="ai-btn-primary" onclick="aiSend()">전송</button>
                </div>
            </div>

            <div style="height:40px;"></div>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             [5] AI 노래 페이지 — ACE-Step 1.5 로 실제 노래(가창) 생성
                  ※ 기존 가창(작업실/sherpa TTS) 과는 별개 기능
             ══════════════════════════════════════════════════════════ -->
        <div id="page-song" class="page">
            <h1 class="center">AI <span>노래</span></h1>
            <p class="ai-lead">가사와 스타일만 정하면 AI가 진짜 노래로 불러드려요.</p>

            <!-- 안내 -->
            <div class="card ai-card song-notice-card">
                <div class="song-notice">
                    <span class="song-notice-icon">⏱️</span>
                    <div>
                        <b>한 곡에 약 1~2분</b> 걸려요.<br>
                        만드는 동안에는 <b>AI 도우미 채팅이 잠시 멈춥니다</b> (같은 컴퓨터 자원을 쓰기 때문).
                    </div>
                </div>
            </div>

            <!-- 스타일 선택 -->
            <div class="card ai-card">
                <div class="ai-card-head">🎚️ 스타일 고르기</div>
                <div id="song-style-grid" class="ai-genre-grid"></div>
            </div>

            <!-- 가사 입력 -->
            <div class="card ai-card">
                <div class="ai-card-head">✍️ 가사</div>
                <textarea id="song-lyrics" class="song-textarea"
                    placeholder="[verse]&#10;첫 번째 줄&#10;두 번째 줄&#10;&#10;[chorus]&#10;후렴 줄&#10;후렴 줄"></textarea>
                <div class="song-row">
                    <button class="ai-btn-ghost" onclick="songFillFromAi()">📋 AI 도우미 가사 가져오기</button>
                    <button class="ai-btn-ghost" onclick="songLoadExample()">💡 예시 채우기</button>
                </div>
            </div>

            <!-- 옵션 -->
            <div class="card ai-card">
                <div class="ai-card-head">⚙️ 설정</div>
                <div class="song-opt-row">
                    <label class="song-opt">
                        <span>길이</span>
                        <select id="song-duration">
                            <option value="20">20초 (가장 빠름)</option>
                            <option value="30" selected>30초 (추천)</option>
                            <option value="45">45초</option>
                            <option value="60">60초</option>
                            <option value="90">90초</option>
                        </select>
                    </label>
                    <label class="song-opt">
                        <span>품질</span>
                        <select id="song-steps">
                            <option value="8" selected>표준 (8단계)</option>
                            <option value="16">높음 (16단계, 느림)</option>
                        </select>
                    </label>
                </div>
                <div class="song-row">
                    <input type="text" id="song-title-input2" placeholder="곡 제목 (선택)" maxlength="60">
                </div>
                <button id="song-generate-btn" class="ai-btn-primary ai-full" onclick="songGenerate()">🎵 노래 만들기</button>
            </div>

            <!-- 진행 상황 -->
            <div id="song-progress-card" class="card ai-card" style="display:none;">
                <div class="ai-card-head">🎧 만드는 중...</div>
                <div class="song-progress-bar"><div id="song-progress-fill" class="song-progress-fill"></div></div>
                <div id="song-progress-status" class="song-progress-status">준비 중...</div>
            </div>

            <!-- 결과 -->
            <div id="song-result-card" class="card ai-card" style="display:none;">
                <div class="ai-card-head">✨ 완성!</div>
                <div id="song-result-title" class="song-result-title"></div>
                <audio id="song-audio" controls class="song-audio"></audio>
                <div class="song-row">
                    <a id="song-download" class="ai-btn-ghost" download>⬇️ 다운로드</a>
                    <button class="ai-btn-ghost" onclick="songGenerate()">🔄 다시 만들기</button>
                </div>
            </div>

            <div id="song-error" class="song-error" style="display:none;"></div>

            <div style="height:40px;"></div>
        </div>
    </div>
</body>
</html>
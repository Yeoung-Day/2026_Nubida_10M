@app.route('/api/generate', methods=['POST'])
def generate_request():
    task_id = str(uuid.uuid4())
    # 1. 대기열에 요청 추가
    rd.rpush("music_queue", task_id)
    # 2. 현재 대기 인원 확인
    queue_len = rd.llen("music_queue")
    return jsonify({"task_id": task_id, "queue_number": queue_len})


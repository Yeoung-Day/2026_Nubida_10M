@app.route('/api/posts', methods=['GET'])
def get_posts():
    conn = get_db_connection()
    if not conn:
        return jsonify({"error": "데이터베이스 연결 실패"}), 500
    try:
        cursor = conn.cursor(dictionary=True)
        cursor.execute("SELECT * FROM posts ORDER BY created_at DESC")
        rows = cursor.fetchall()
        
        for row in rows:
            if row.get('recipe'):
                try: row['recipe'] = json.loads(row['recipe'])
                except: row['recipe'] = []
            else:
                row['recipe'] = []
            
            # 해당 게시물 댓글 가져오기
            cursor.execute("SELECT text FROM comments WHERE post_id = %s", (row['id'],))
            row['comments'] = [c_row['text'] for c_row in cursor.fetchall()]
            
            if row['created_at']:
                row['created_at'] = row['created_at'].strftime('%Y-%m-%d %H:%M:%S')

        return jsonify(rows)
    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500
    finally:
        if 'cursor' in locals(): cursor.close()
        conn.close()

# [수정됨] 게시물 저장 시 비밀번호(password)를 쿼리에 추가했습니다.
@app.route('/api/posts', methods=['POST'])
def save_post():
    data = request.json
    conn = get_db_connection()
    if not conn: return jsonify({"error": "DB 연결 실패"}), 500
    
    try:
        cursor = conn.cursor()
        # 가사 데이터(recipe)를 문자열로 변환하여 유실 방지
        recipe_str = json.dumps(data.get('recipe', []), ensure_ascii=False)
        
        sql = """INSERT INTO posts (id, title, password, author, school, singerId, singerName, mrPath, recipe, likes) 
                 VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, 0)"""
        
        cursor.execute(sql, (
            data.get('id'),
            data.get('title'),
            hash_password(str(data.get('password', ''))),
            data.get('author', '무명'),
            data.get('school', '개인'),
            data.get('singerId'),
            data.get('singerName'),
            data.get('mrPath'), # 사용자가 선택한 MR 경로
            recipe_str         # [핵심] JSON 문자열로 저장
        ))
        conn.commit()
        return jsonify({"status": "success"})
    except Exception as e:
        print(f"저장 에러: {e}")
        return jsonify({"error": str(e)}), 500
    finally:
        cursor.close()
        conn.close()

@app.route('/api/posts/<post_id>/like', methods=['POST'])
def toggle_like(post_id):
    data = request.json or {}
    user_id = data.get('user_id', request.remote_addr)

    conn = get_db_connection()
    if not conn: return jsonify({"error": "DB 연결 실패"}), 500
        
    try:
        cursor = conn.cursor()
        cursor.execute("SELECT 1 FROM post_likes WHERE post_id = %s AND user_id = %s", (post_id, user_id))
        exists = cursor.fetchone()

        if exists:
            cursor.execute("DELETE FROM post_likes WHERE post_id = %s AND user_id = %s", (post_id, user_id))
            cursor.execute("UPDATE posts SET likes = GREATEST(0, likes - 1) WHERE id = %s", (post_id,))
            action = "unliked"
        else:
            cursor.execute("INSERT INTO post_likes (post_id, user_id) VALUES (%s, %s)", (post_id, user_id))
            cursor.execute("UPDATE posts SET likes = likes + 1 WHERE id = %s", (post_id,))
            action = "liked"

        conn.commit()
        return jsonify({"status": "success", "action": action})
    except Exception as e:
        conn.rollback()
        return jsonify({"error": str(e)}), 500
    finally:
        conn.close()

@app.route('/api/posts/<post_id>/delete', methods=['POST'])
def delete_post(post_id):
    data = request.json
    client_password = str(data.get('password', '')).strip()

    conn = get_db_connection()
    try:
        cursor = conn.cursor(dictionary=True)
        cursor.execute("SELECT password FROM posts WHERE id = %s", (post_id,))
        post = cursor.fetchone()

        if not post:
            return jsonify({"status": "error", "message": "게시물을 찾을 수 없습니다."}), 404

        db_password = str(post['password'] if post['password'] is not None else '').strip()

        print(f"--- 삭제 시도 로그 ---")
        print(f"ID: {post_id} | 비밀번호 검증")

        if not verify_password(client_password, db_password):
            return jsonify({"status": "error", "message": "비밀번호가 일치하지 않습니다."}), 401

        # 기존 평문이면 검증 성공 시점에 해시로 자동 교체
        if db_password and not db_password.startswith("pbkdf2_sha256$"):
            try:
                cursor.execute("UPDATE posts SET password = %s WHERE id = %s",
                               (hash_password(client_password), post_id))
                conn.commit()
            except Exception:
                pass

        cursor.execute("DELETE FROM posts WHERE id = %s", (post_id,))
        conn.commit()
        return jsonify({"status": "success"})
    except Exception as e:
        print(traceback.format_exc())
        return jsonify({"status": "error", "message": str(e)}), 500
    finally:
        conn.close()

@app.route('/api/posts/<post_id>/comment', methods=['POST'])

services:
  # 1. 데이터베이스 (MariaDB)
  db:
    image: mariadb:10.11
    container_name: music-db
    restart: always
    environment:
      MARIADB_ROOT_PASSWORD: '***MASKED***'
      MARIADB_DATABASE: 'nubida_music'
      MARIADB_USER: 'nubidaplet'
      MARIADB_PASSWORD: '***MASKED***'
    volumes:
      - /data/ssd/mysql:/var/lib/mysql
    command:
      - --innodb-buffer-pool-size=16G
      - --max-connections=3000

  # 2. AI 음악 서비스 (Python + GPU) - 아까 성공했던 방식
  music-ai-app:
    image: python:3.10-slim
    container_name: music-ai-app
    restart: always
    depends_on:
      - db
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    ports:
      - "8001:8080"
    volumes:
      - .:/app
      - /data/ssd/music-assets/models:/app/static/models:ro
      - /data/ssd/music-assets/mr:/app/static/mr:ro
      - /data/hdd/logs/music:/app/logs
    working_dir: /app
    # 이 명령어가 아까 성공했던 "마법의 한 줄"입니다.
    command: >
      sh -c "apt-get update && 
             apt-get install -y libgl1 libglib2.0-0 && 
             pip install --no-cache-dir flask flask-cors torch torchaudio mysql-connector-python gunicorn && 
             gunicorn --workers 4 --timeout 300 --bind 0.0.0.0:8080 app

  # 3. ADU 웹 서비스 (Node.js)
  adu-app:
    # ADU는 빌드가 아까 잘 되었으므로 그대로 유지하거나, 
    # 불안하시면 아래처럼 이미지를 직접 쓰셔도 됩니다.
    build: ../adu-service
    container_name: adu-web-app
    restart: always
    depends_on:
      - db
    ports:
      - "8002:3000"
    volumes:
      - ../adu-service:/app
      - /data/ssd/adu-assets/uploads:/app/public/images
      - /data/hdd/logs/adu:/app/logs
    environment:
      - NODE_ENV=production

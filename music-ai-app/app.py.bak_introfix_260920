# ── [260920 재측정] 가사 '최소' 줄 수 보장 ──
#   ACE-Step 실측 결과 (2026-09-20, ffmpeg volumedetect):
#     · 가사  2줄 / 30초 → 마지막  9.0초 무음  ❌ (모델이 채울 코드가 없어 패딩)
#     · 가사  4줄 / 30초 → 마지막  1.2초 무음  ✅
#     · 가사  6줄 / 30초 → 마지막  1.5초 무음  ✅
#     · 가사  8줄 / 30초 → 마지막  0.8초 무음  ✅ (가장 안정적)
#   → 가사가 '많은' 것은 문제가 아니다. '적은' 것이 무음을 만든다.
#   → 자르지 않는다. 최소 줄 수만 보장한다(부족하면 같은 가사를 반복).
MIN_LINES_BY_DURATION = {20: 3, 30: 4, 40: 6}


def _min_lines_for(duration):
    """곡 길이(초)에 필요한 '최소' 가사 줄 수 (이보다 적으면 무음이 생긴다)."""
    try:
        d = int(duration)
    except (TypeError, ValueError):
        d = 30
    if d in MIN_LINES_BY_DURATION:
        return MIN_LINES_BY_DURATION[d]
    return max(2, int(round(d / 7.0)))


def _compress_lyrics(lyrics, duration):
    """가사가 너무 '적으면' 같은 가사를 반복해 최소 줄 수를 채운다.

    ★ 자르지 않는다. (실측: 8줄/30초가 오히려 가장 안정적)
    ★ 부족하면 보충한다. (실측: 2줄/30초 → 9초 무음)

    Returns:
        (new_lyrics, info)
        info = {"min": int, "kept": int, "added": int, "changed": bool}
    """
    raw = (lyrics or "").strip()
    need = _min_lines_for(duration)
    if not raw:
        return raw, {"min": need, "kept": 0, "added": 0, "changed": False}

    lines = raw.split("\n")
    tags, body = [], []
    for ln in lines:
        s = ln.strip()
        if not s:
            continue
        if s.startswith("[") and s.endswith("]"):
            tags.append(s)
        else:
            body.append(s)

    have = len(body)
    if have == 0:
        return raw, {"min": need, "kept": 0, "added": 0, "changed": False}

    if have >= need:
        # 충분하다 → 그대로 사용 (자르지 않음)
        return raw, {"min": need, "kept": have, "added": 0, "changed": False}

    # 부족하다 → 가사를 반복해 최소 줄 수까지 채운다
    out = list(tags) if tags else ["[verse]"]
    filled = 0
    i = 0
    while filled < need:
        out.append(body[i % have])
        filled += 1
        i += 1
    added = filled - have
    return ("\n".join(out),
            {"min": need, "kept": filled, "added": added, "changed": True})


_song_last_request = {}          # (구) IP별 마지막 요청 시각 — 하위호환 유지
_song_pending = {}               # ★ IP별 진행중 작업 {'task': id, 'at': 시각}
_song_rate_lock = __import__('threading').Lock()

# ★ gunicorn 은 워커(프로세스)가 여러 개라 메모리 Lock 으로는 순번 계산이 어긋난다.
#   → 파일 잠금(flock)으로 프로세스 간 직렬화한다.
import fcntl


class _FileLock:
    """프로세스 간 공용 잠금 (gunicorn 멀티워커 대응)"""

    def __init__(self, path):
        self.path = path
        self.fh = None

    def __enter__(self):
        self.fh = open(self.path, "a+")
        fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
        finally:
            self.fh.close()
        return False


_QUEUE_LOCK_PATH = os.path.join("/tmp", "nubida_song_queue.lock")


def _song_dir_ready():
    try:
        os.makedirs(SONG_DIR, exist_ok=True)
        return os.path.isdir(SONG_DIR)
    except Exception as e:
        print(f"[SONG] 저장 디렉토리 접근 실패: {e}")
        return False


def _write_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def _read_json(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def _queue_status(my_task_id=None):
    """대기열 현황 조회.

    my_task_id 를 주면 그 작업보다 '먼저 온' 요청 개수를 함께 반환.
    반환: (내앞개수, 전체대기수, 예상대기초)
    """
    items = []
    try:
        for fn in os.listdir(SONG_DIR):
            if not fn.startswith(REQ_PREFIX) or not fn.endswith(".json"):
                continue
            try:
                mtime = os.path.getmtime(os.path.join(SONG_DIR, fn))
            except Exception:
                continue
            items.append((mtime, fn[len(REQ_PREFIX):-len(".json")]))
    except Exception:
        return (0, 0, 0)

    items.sort()
    total = len(items)
    if not my_task_id:
        return (0, total, 0)

    ahead = 0
    for _mt, tid in items:
        if tid == my_task_id:
            return (ahead, total, 0)
        ahead += 1
    # 내 req 파일이 아직 없으면(기록 전) = 내가 가장 마지막
    return (total, total + 1, 0)


def _running_task():
    """지금 생성 중인 작업이 있는지 → (task_id, elapsed) 또는 None"""
    try:
        for fn in os.listdir(SONG_DIR):
            if not fn.startswith(RES_PREFIX) or not fn.endswith(".json"):
                continue
            try:
                r = _read_json(os.path.join(SONG_DIR, fn))
            except Exception:
                continue
            if r.get("status") == "running":
                # 5분 넘게 갱신 없으면 죽은 것으로 간주
                try:
                    stale = _time2.time() - os.path.getmtime(os.path.join(SONG_DIR, fn))
                except Exception:
                    stale = 0
                if stale > 300:
                    continue
                started = r.get("started") or 0
                return (fn[len(RES_PREFIX):-len(".json")],
                        _time2.time() - started if started else 0)
    except Exception:
        pass
    return None


@app.route('/api/ai/song', methods=['POST'])
def ai_song():
    """AI 노래 생성 요청 → task_id 반환 (대기열 방식)

    ★ 260918 개편: 거절(429)하지 않고 '순서대로 줄을 세운다'
      - 학급 수업에서 여러 명이 동시에 눌러도 모두 자기 곡을 받을 수 있게 함
    """
    ip = request.headers.get('X-Forwarded-For', request.remote_addr or 'unknown').split(',')[0].strip()

    data = request.get_json(silent=True) or {}
    lyrics = (data.get('lyrics') or '').strip()
    if len(lyrics) < 10:
        return jsonify({"error": "가사를 10자 이상 입력해주세요."}), 400
    if len(lyrics) > 3000:
        return jsonify({"error": "가사가 너무 깁니다 (3000자 이하)."}), 400

    if not _song_dir_ready():
        return jsonify({"error": "노래 저장 공간을 사용할 수 없습니다. 관리자에게 문의해주세요."}), 500

    now = _time2.time()

    # ── ★ IP 제한: '동시 대기/생성 중복'만 막고, 끝나면 바로 다시 허용 ──
    #    (기존: 무조건 3분 대기 → 교실 공유 IP에서 3분에 1곡만 가능했던 문제 해결)
    with _song_rate_lock:
        pend = _song_pending.get(ip)          # {'task': id, 'at': 시각}
        if pend and now - pend.get('at', 0) < 900:   # 15분 = 최대 생성시간
            _t = pend.get('task')
            # 그 작업이 아직 살아있으면 중복 제출로 간주
            if _t and os.path.exists(os.path.join(SONG_DIR, f"{RES_PREFIX}{_t}.json")):
                try:
                    _r = _read_json(os.path.join(SONG_DIR, f"{RES_PREFIX}{_t}.json"))
                    if _r.get("status") in ("queued", "running"):
                        return jsonify({
                            "error": "이미 만들고 있는 곡이 있어요. 완성되면 다시 만들 수 있어요.",
                            "busy": True, "task_id": _t}), 429
                except Exception:
                    pass
        # 대기열이 너무 길면 막음 (22명 초과 시 = 약 25분)
        _ahead, _total, _ = _queue_status()
        if _total >= 22:
            return jsonify({
                "error": f"지금 대기 중인 곡이 너무 많아요 ({_total}곡). "
                         f"조금 뒤에 다시 시도해 주세요.",
                "busy": True}), 429

    try:
        duration = max(15, min(120, int(data.get('duration') or 30)))
        steps = max(4, min(32, int(data.get('steps') or 8)))
    except (TypeError, ValueError):
        duration, steps = 30, 8

    # ── 코드별 노래 길이 강제 (260919 수정) ──
    #   관리자가 코드 발급 시 지정한 duration_sec 이 있으면
    #   그 값을 "고정값"으로 강제한다. (요청값 무시)
    #   - 이전: 요청값이 더 클 때만 잘라냄 → 30초 설정인데 60초로 생성되는 문제
    #   - 현재: 코드에 값이 있으면 요청값과 무관하게 그 값으로 생성
    _code = _session_valid()
    if _code:
        _cd = _get_code_duration(_code)
        if _cd and int(duration) != int(_cd):
            print(f"[SONG] duration forced {duration}->{_cd}s by code {_code}")
            duration = int(_cd)

    task_id = str(uuid.uuid4())

    # ── [260920 재측정] 가사가 적으면 무음이 생기므로 최소 줄 수를 보장 ──
    #   자르지 않는다. 부족할 때만 같은 가사를 반복해 채운다.
    lyrics_used, _cinfo = _compress_lyrics(lyrics, duration)
    if _cinfo["changed"]:
        print(f"[SONG] 가사 보충 {_cinfo['added']}줄 추가 → {_cinfo['kept']}줄 "
              f"(dur={duration}s, 최소 {_cinfo['min']}줄)")

    req = {
        "task_id": task_id,
        "lyrics": lyrics_used,
        "prompt": _ensure_no_long_intro(
            (data.get('prompt') or '').strip() or
            "korean pop ballad, emotional, clear female vocal, piano"),
        "title": (data.get('title') or '').strip(),
        "language": (data.get('language') or 'ko').strip(),
        "duration": duration,
        "steps": steps,
        "created": now,
        "ip": ip,
    }

    # 내 순번 계산 (나보다 먼저 온 요청 개수)
    # ★ flock 으로 프로세스 간 직렬화 → 동시 제출에도 순번이 정확
    # ★ req 파일을 '먼저' 쓴 뒤 순번을 계산해야 내 위치가 정확히 잡힌다
    with _FileLock(_QUEUE_LOCK_PATH):
        try:
            _write_json(os.path.join(SONG_DIR, f"{REQ_PREFIX}{task_id}.json"), req)
        except Exception as e:
            traceback.print_exc()
            return jsonify({"error": f"요청을 저장하지 못했습니다: {e}"}), 500
        ahead, total, _ = _queue_status(task_id)
        eta = ahead * max(25, int(round(20 + duration * 0.9)))
        try:
            _write_json(os.path.join(SONG_DIR, f"{RES_PREFIX}{task_id}.json"), {
                "status": "queued",
                "message": (f"대기 {ahead + 1}번째예요 (약 {max(1, eta // 60)}분)" if ahead > 0
                            else "곧 시작해요!"),
                "progress": 5,
                "title": req["title"] or "AI 노래",
                "started": None,
                "queue_ahead": ahead,
                "queue_total": total,
                "eta": eta,
            })
        except Exception as e:
            traceback.print_exc()
            return jsonify({"error": f"요청을 저장하지 못했습니다: {e}"}), 500
        _song_pending[ip] = {'task': task_id, 'at': now}

    print(f"[SONG] 요청 접수 task={task_id} dur={duration} steps={steps} "
          f"내앞={ahead} 전체={total}")
    _resp = {"task_id": task_id, "queue_number": ahead + 1,
             "queue_ahead": ahead, "queue_total": total,
             "eta": eta}
    # ★ 가사가 부족해 보충된 경우 학생에게 안내
    if _cinfo["changed"]:
        _resp["lyrics_added"] = True
        _resp["lyrics_used_lines"] = _cinfo["kept"]
        _resp["lyrics_added_lines"] = _cinfo["added"]
        _resp["lyrics_min"] = _cinfo["min"]
        _resp["notice"] = (f"{duration}초 곡에는 가사 {_cinfo['min']}줄 이상이 좋아요. "
                           f"같은 가사를 한 번 더 반복해서 채웠어요.")
    _resp["lyrics_min"] = _cinfo["min"]
    return jsonify(_resp)


@app.route('/api/ai/song/status', methods=['GET'])
def ai_song_status():
    """노래 생성 진행 상황 (결과 파일 읽기)"""
    task_id = request.args.get('task_id', '').strip()
    if not task_id:
        return jsonify({"error": "task_id 가 필요합니다."}), 400

    # 경로 탈출 방지
    if '/' in task_id or '\\' in task_id or '..' in task_id:
        return jsonify({"error": "잘못된 요청입니다."}), 400

    path = os.path.join(SONG_DIR, f"{RES_PREFIX}{task_id}.json")
    if not os.path.exists(path):
        return jsonify({"error": "작업을 찾을 수 없습니다."}), 404

    try:
        r = _read_json(path)
    except Exception as e:
        return jsonify({"error": f"상태 확인 실패: {e}"}), 500

    out = {
        "status": r.get("status", "unknown"),
        "message": r.get("message", ""),
        "progress": r.get("progress", 0),
        "title": r.get("title", "AI 노래"),
    }
    # ★ 대기열 정보 전달 (UI 에서 순번 표시)
    if r.get("queue_ahead") is not None:
        out["queue_ahead"] = r.get("queue_ahead")
    if r.get("queue_total") is not None:
        out["queue_total"] = r.get("queue_total")
    if r.get("eta") is not None:
        out["eta"] = r.get("eta")

    fname = r.get("file")
    if r.get("status") == "done" and fname:
        out["url"] = f"/static/assets/uploads/songs/{os.path.basename(fname)}"
        out["elapsed"] = r.get("elapsed")
    elif r.get("status") == "done" and not fname:
        # ★ 레이스 방어: done 인데 파일명이 아직 없으면 '마무리 중' 으로 보고
        out["status"] = "processing"
        out["message"] = "마무리 중"
        out["progress"] = 99
    return jsonify(out)


            cursor.execute("""SELECT id FROM board_folders
                              WHERE id=%s OR slug=%s OR name=%s LIMIT 1""",
                           (folder, folder, folder))
            frow = cursor.fetchone()
            if frow:
                cursor.execute("SELECT * FROM posts WHERE folder_id=%s "
                               "ORDER BY created_at DESC", (frow['id'],))
            else:
                # 폴더가 없으면 빈 목록 (다른 학교 글 노출 방지)
                cursor.execute("SELECT * FROM posts WHERE 1=0")
        else:
            cursor.execute("SELECT * FROM posts ORDER BY created_at DESC")

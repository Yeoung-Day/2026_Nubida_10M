INTRO_FIX = ', vocal starts within 1 second, no long instrumental intro, short intro'


def _ensure_no_long_intro(prompt):
    """프롬프트에 간주 단축 지시가 없으면 붙인다."""
    p = (prompt or '').strip()
    if not p:
        return p
    low = p.lower()
    if 'no long instrumental intro' in low or 'vocal starts within' in low:
        return p
    return p + INTRO_FIX



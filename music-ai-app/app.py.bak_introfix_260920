def _get_lock_config():
    """잠금 설정 조회 → (lock_enabled, updated_by)"""
    conn = get_db_connection()
    if not conn:
        return (False, None)
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute("SELECT lock_enabled, updated_by FROM access_lock_config WHERE id=1")
        row = cur.fetchone()
        cur.close()
        conn.close()
        if not row:
            return (False, None)
        return (bool(row['lock_enabled']), row.get('updated_by'))
    except Exception as e:
        print("!!! lock config error: %s" % e)
        try:
            conn.close()
        except Exception:
            pass
        return (False, None)


def _token_for(code, ends_at):
    """코드 + 만료시각 서명 토큰 (위조 방지)"""
    msg = ("%s|%s" % (code, ends_at)).encode('utf-8')
    return hmac.new(ACCESS_SECRET, msg, hashlib.sha256).hexdigest()


def _session_valid():
    """쿠키 토큰 검증 → 유효하면 코드 반환, 아니면 None"""
    raw = request.cookies.get(ACCESS_COOKIE)
    if not raw:
        return None
    parts = raw.split('|')
    if len(parts) < 3:
        return None
    code, ends_at, sig = parts[0], parts[1], '|'.join(parts[2:])
    if not hmac.compare_digest(sig, _token_for(code, ends_at)):
        return None
    try:
        ends = datetime.fromisoformat(ends_at)
    except Exception:
        return None
    if datetime.now() > ends:
        return None
    # 코드가 DB에서 아직 활성인지 재확인 (관리자가 중간에 끌 수 있음)
    conn = get_db_connection()
    if not conn:
        return code
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute("""SELECT id FROM access_codes
                       WHERE code=%s AND is_active=1
                         AND starts_at<=NOW() AND ends_at>=NOW()""", (code,))
        ok = cur.fetchone() is not None
        cur.close()
        conn.close()
        return code if ok else None
    except Exception:
        try:
            conn.close()
        except Exception:
            pass
        return code


def _get_code_duration(code):
    """코드에 지정된 노래 길이(초) 반환. 없으면 None."""
    conn = get_db_connection()
    if not conn:
        return None
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute("SELECT duration_sec FROM access_codes WHERE code=%s LIMIT 1", (code,))
        row = cur.fetchone()
        cur.close()
        conn.close()
        if row and row.get('duration_sec'):
            return int(row['duration_sec'])
        return None
    except Exception:
        try:
            conn.close()
        except Exception:
            pass
        return None


def _visitor_key(req):
    """방문자 고유키 생성 — 쿠키 우선, 없으면 지문 생성용 시드 반환.
    실제 쿠키 발급은 unlock 응답에서 한다."""
    ck = req.cookies.get(VISITOR_COOKIE)
    if ck and len(ck) >= 16:
        return ck, False          # 기존 방문자
    return None, True             # 신규 → 발급 필요


def _new_visitor_key():
    return uuid.uuid4().hex + uuid.uuid4().hex[:8]


def _count_visitor(code, vkey, ip, ua):
    """방문자 등록. (is_new, current_count) 반환."""
    conn = get_db_connection()
    if not conn:
        return (True, 0)
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute("""SELECT id FROM access_visitors
                       WHERE code=%s AND visitor_key=%s LIMIT 1""", (code, vkey))
        exists = cur.fetchone() is not None
        if not exists:
            cur.execute("""INSERT IGNORE INTO access_visitors
                           (id, code, visitor_key, ip, ua)
                           VALUES (%s,%s,%s,%s,%s)""",
                        ('av_' + uuid.uuid4().hex[:16], code, vkey,
                         (ip or '')[:45], (ua or '')[:255]))
            conn.commit()
        cur.execute("SELECT COUNT(*) AS c FROM access_visitors WHERE code=%s", (code,))
        cnt = cur.fetchone()['c']
        cur.close()
        conn.close()
        return (not exists, cnt)
    except Exception as e:
        print("!!! visitor count error: %s" % e)
        try:
            conn.close()
        except Exception:
            pass
        return (True, 0)


def _sync_used_count(code):
    """access_codes.used_count 를 실제 방문자 수로 맞춘다 (표시용)."""
    conn = get_db_connection()
    if not conn:
        return
    try:
        cur = conn.cursor()
        cur.execute("""UPDATE access_codes SET used_count =
                       (SELECT COUNT(*) FROM access_visitors WHERE code=%s)
                       WHERE code=%s""", (code, code))
        conn.commit()
        cur.close()
        conn.close()
    except Exception:
        try:
            conn.close()
        except Exception:
            pass


def _verify_code(entered, vkey=None, ip=None, ua=None):
    """입력 코드 검증 → 유효하면 (code, ends_at_str, is_new_visitor) 반환

    인원 기준 제한:
      · max_uses = 허용 인원 (고유 방문자 수)
      · 같은 방문자가 다시 입력해도 카운트되지 않음
    """
    entered = (entered or '').strip().upper()
    if not entered:
        return None
    if not vkey:
        vkey = 'legacy_' + _new_visitor_key()
    conn = get_db_connection()
    if not conn:
        return None
    try:
        cur = conn.cursor(dictionary=True)
        cur.execute("""SELECT id, code, ends_at, max_uses, used_count FROM access_codes
                       WHERE code=%s AND is_active=1
                         AND starts_at<=NOW() AND ends_at>=NOW()
                       ORDER BY ends_at DESC LIMIT 1""", (entered,))
        row = cur.fetchone()
        if not row:
            cur.close()
            conn.close()
            return None

        # ── 이미 이 코드로 들어온 방문자인가? ──
        cur.execute("""SELECT id FROM access_visitors
                       WHERE code=%s AND visitor_key=%s LIMIT 1""",
                    (row['code'], vkey))
        already = cur.fetchone() is not None
        cur.close()
        conn.close()

        # 신규 방문자만 인원 제한 검사
        if not already and row['max_uses'] is not None:
            _, cnt = _count_visitor(row['code'], vkey, ip, ua)
            if cnt > int(row['max_uses']):
                # 초과 → 방금 등록한 방문자 기록 롤백
                _remove_visitor(row['code'], vkey)
                return None
            _sync_used_count(row['code'])
            return (row['code'], row['ends_at'].strftime('%Y-%m-%dT%H:%M:%S'), True)

        # 기존 방문자 또는 무제한
        if not already:
            _count_visitor(row['code'], vkey, ip, ua)
            _sync_used_count(row['code'])
            return (row['code'], row['ends_at'].strftime('%Y-%m-%dT%H:%M:%S'), True)

        return (row['code'], row['ends_at'].strftime('%Y-%m-%dT%H:%M:%S'), False)
    except Exception as e:
        print("!!! code verify error: %s" % e)
        try:
            conn.close()
        except Exception:
            pass
        return None


def _remove_visitor(code, vkey):
    """인원 초과 시 방문자 기록 제거 (롤백)"""
    conn = get_db_connection()
    if not conn:
        return
    try:
        cur = conn.cursor()
        cur.execute("DELETE FROM access_visitors WHERE code=%s AND visitor_key=%s",
                    (code, vkey))
        conn.commit()
        cur.close()
        conn.close()
    except Exception:
        try:
            conn.close()
        except Exception:
            pass


@app.route('/api/access/status', methods=['GET'])
def access_status():
    """잠금 상태 + 현재 세션 유효성 + 코드별 노래 길이"""
    enabled, _ = _get_lock_config()
    if not enabled:
        return jsonify({"locked": False, "unlocked": True, "duration_sec": None})
    code = _session_valid()
    if not code:
        return jsonify({"locked": True, "unlocked": False, "duration_sec": None})
    # [260919] 코드에 노래 길이(duration_sec)가 지정돼 있으면 알려준다.
    #   프론트는 이 값을 받아 길이 선택 UI를 숨기고 고정값으로 표시한다.
    dur = _get_code_duration(code)
    return jsonify({"locked": True, "unlocked": True,
                    "duration_sec": int(dur) if dur else None})


@app.route('/api/access/unlock', methods=['POST'])
def access_unlock():
    """코드 입력 → 검증 → 쿠키 발급 (방문자 기준 인원 제한)"""
    data = request.get_json(silent=True) or {}
    code_in = str(data.get('code', '')).strip().upper()
    if not code_in:
        return jsonify({"ok": False, "message": "코드를 입력해 주세요."}), 400

    # ── 방문자 식별 (없으면 새로 발급) ──
    vkey, is_new_cookie = _visitor_key(request)
    if is_new_cookie:
        vkey = _new_visitor_key()

    ip = (request.headers.get('X-Forwarded-For', '') or request.remote_addr or '').split(',')[0].strip()
    ua = request.headers.get('User-Agent', '')

    result = _verify_code(code_in, vkey=vkey, ip=ip, ua=ua)
    if not result:
        return jsonify({"ok": False,
                        "message": "코드가 올바르지 않거나 이용 시간이 아니거나 인원이 초과되었습니다."}), 403
    code, ends_at, _is_new = result
    resp = make_response(jsonify({"ok": True, "ends_at": ends_at}))
    resp.set_cookie(
        ACCESS_COOKIE,
        "%s|%s|%s" % (code, ends_at, _token_for(code, ends_at)),
        max_age=60 * 60 * 24,
        httponly=True,
        samesite='Lax',
    )
    # 방문자 쿠키 (인원 카운트용, 1년)
    if is_new_cookie:
        resp.set_cookie(
            VISITOR_COOKIE,
            vkey,
            max_age=60 * 60 * 24 * 365,
            httponly=False,
            samesite='Lax',
        )
    return resp


@app.before_request
def _access_lock_guard():
    """전역 접속 가드 — 잠금 ON이면 코드 없는 요청을 차단"""
    path = request.path or '/'
    if path in _LOCK_EXEMPT_EXACT:
        return None
    for pref in _LOCK_EXEMPT_PREFIX:
        if path.startswith(pref):
            return None
    enabled, _ = _get_lock_config()
    if not enabled:
        return None
    if _session_valid():
        return None
    # API 요청은 401 JSON
    if path.startswith('/api/'):
        return jsonify({"ok": False, "locked": True,
                        "message": "이용 시간이 아닙니다. 선생님께 코드를 확인해 주세요."}), 401
    # 페이지 요청 → 잠금화면
    return send_from_directory(BASE_DIR, 'lock.html')



        for row in rows:
            if row.get('recipe'):
                try: row['recipe'] = json.loads(row['recipe'])
                except: row['recipe'] = []
            else:
                row['recipe'] = []
            
            # 해당 게시물 댓글 가져오기
            cursor.execute("SELECT text FROM comments WHERE post_id = %s", (row['id'],))

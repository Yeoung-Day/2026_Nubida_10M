@app.route('/api/access/admin/codes', methods=['GET', 'POST'])
def access_admin_codes():
    if not _admin_ok():
        return jsonify({"ok": False, "message": "권한 없음"}), 403
    conn = get_db_connection()
    if not conn:
        return jsonify({"ok": False, "message": "DB 연결 실패"}), 500
    try:
        cur = conn.cursor(dictionary=True)
        if request.method == 'GET':
            cur.execute("""SELECT id, code, label, starts_at, ends_at,
                                  duration_sec, max_songs, max_uses,
                                  used_count, is_active, created_by, created_at,
                                  (SELECT COUNT(*) FROM access_visitors v
                                    WHERE v.code = access_codes.code) AS visitor_count
                           FROM access_codes ORDER BY created_at DESC LIMIT 200""")
            rows = cur.fetchall()
            for r in rows:
                for k in ('starts_at', 'ends_at', 'created_at'):
                    if r.get(k):
                        r[k] = r[k].strftime('%Y-%m-%d %H:%M:%S')
                # 표시용: used_count = 실제 방문자 수
                r['used_count'] = int(r.get('visitor_count') or 0)
            cur.close()
            conn.close()
            return jsonify({"ok": True, "codes": rows})

        data = request.get_json(silent=True) or {}
        starts = str(data.get('starts_at', '')).strip()
        ends = str(data.get('ends_at', '')).strip()
        if not starts or not ends:
            cur.close()
            conn.close()
            return jsonify({"ok": False, "message": "시작/종료 시간이 필요합니다."}), 400
        code = str(data.get('code', '')).strip().upper()
        if not code:
            code = _gen_code()
        if len(code) < 6 or not code.isalnum():
            cur.close()
            conn.close()
            return jsonify({"ok": False,
                            "message": "코드는 영문/숫자 6자리 이상이어야 합니다."}), 400
        # 노래 길이 (20/30/40 등, 없으면 NULL = 기본 30초)
        _dur = data.get('duration_sec')
        try:
            dur = int(_dur) if _dur not in (None, '', 0, '0') else None
        except (TypeError, ValueError):
            dur = None
        _ms = data.get('max_songs')
        try:
            msongs = int(_ms) if _ms not in (None, '', 0, '0') else None
        except (TypeError, ValueError):
            msongs = None

        cid = 'ac_' + uuid.uuid4().hex[:16]
        cur.execute("""INSERT INTO access_codes
                       (id, code, label, starts_at, ends_at,
                        duration_sec, max_songs, max_uses, created_by)
                       VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s)""",
                    (cid, code, str(data.get('label', ''))[:100] or None,
                     starts, ends, dur, msongs,
                     int(data['max_uses']) if data.get('max_uses') else None,
                     str(data.get('created_by', ''))[:100] or None))
        conn.commit()
        cur.close()
        conn.close()
        return jsonify({"ok": True, "id": cid, "code": code,
                        "duration_sec": dur})
    except Exception as e:
        print("!!! admin codes error: %s" % e)
        try:
            conn.close()
        except Exception:
            pass
        return jsonify({"ok": False, "message": str(e)}), 500



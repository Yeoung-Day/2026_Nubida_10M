import urllib.request
import urllib.error

OLLAMA_URL = os.environ.get('OLLAMA_URL', 'http://ollama:11434')
OLLAMA_MODEL = os.environ.get('OLLAMA_MODEL', 'qwen3:8b')

# AI 남용 방지: IP 기준 1분 20회
_ai_rate = {}

def _ai_rate_ok(ip, limit=20, window=60):
    import time as _t
    now = _t.time()
    hit = _ai_rate.get(ip)
    if not hit or now - hit[0] > window:
        _ai_rate[ip] = [now, 1]
        return True, 0
    hit[1] += 1
    if hit[1] > limit:
        return False, int(window - (now - hit[0]))
    return True, 0

def _ollama_chat(messages, timeout=120):
    """Ollama /api/chat 호출 (표준 라이브러리)"""
    payload = json.dumps({
        "model": OLLAMA_MODEL,
        "messages": messages,
        "stream": False,
        # qwen3 는 thinking 모드가 기본이라 답이 느림 -> 끄기
        "think": False
    }).encode('utf-8')
    req = urllib.request.Request(
        OLLAMA_URL + '/api/chat',
        data=payload,
        headers={'Content-Type': 'application/json'},
        method='POST'
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode('utf-8'))
    msg = data.get('message') or {}
    text = msg.get('content') or ''
    # thinking 태그 제거 (모델이  thinking 를 붙이는 경우)
    if '<｜end▁of▁thinking｜>' in text:
        text = text.split('<｜end▁of▁thinking｜>')[-1]
    return text.strip()

# 스튜디오 전용 시스템 프롬프트 (가사/음악 특화)
STUDIO_SYSTEM = """너는 '누비다 AI 스튜디오'의 랩/노래 작사 도우미야.
학생들이 AI 가창으로 노래를 만들 수 있도록 돕는다.

[답변 규칙]
1. 항상 친절한 존댓말(해요체)을 쓴다.
2. 답변은 짧고 읽기 쉽게. 줄바꿈을 자주 쓴다.
3. 라임과 리듬을 살린 자연스러운 한국어 가사를 쓴다.
4. 가사를 쓸 때는 반드시 한 줄에 한 마디씩, 마디 구분은 줄바꿈으로만 한다.
5. 가사 외에 설명이 필요하면 가사 뒤에 짧게 덧붙인다.
6. 절대 거짓 정보를 지어내지 않는다. 모르면 모른다고 말한다.

[가사 작성 규칙]
- 각 마디는 8~16음절 정도로, 소리 내어 읽었을 때 자연스럽게 이어지도록 쓴다.
- 발음하기 쉬운 단어를 쓴다 (TTS 가창이므로 어려운 외래어/숫자 나열은 피한다).
- 비속어, 욕설, 차별 표현은 절대 쓰지 않는다.
- 학교/학생이 사용하는 서비스이므로 건전한 내용만 쓴다."""

@app.route('/api/ai/chat', methods=['POST'])
def ai_chat():
    """스튜디오 전용 AI 채팅"""
    ip = request.headers.get('X-Forwarded-For', request.remote_addr or 'unknown').split(',')[0].strip()
    ok, retry = _ai_rate_ok(ip)
    if not ok:
        return jsonify({"error": f"요청이 너무 많습니다. {retry}초 후 다시 시도해 주세요."}), 429

    data = request.json or {}
    message = (data.get('message') or '').strip()
    history = data.get('history') or []
    if not message:
        return jsonify({"error": "메시지를 입력해 주세요."}), 400

    msgs = [{"role": "system", "content": STUDIO_SYSTEM}]
    # 최근 6개 대화만 문맥으로 사용
    for h in history[-6:]:
        role = h.get('role')
        content = (h.get('content') or '').strip()
        if role in ('user', 'assistant') and content:
            msgs.append({"role": role, "content": content})
    msgs.append({"role": "user", "content": message})

    try:
        reply = _ollama_chat(msgs, timeout=180)
        return jsonify({"reply": reply})
    except urllib.error.URLError as e:
        print(f"[AI] Ollama 연결 실패: {e}")
        return jsonify({"error": "AI 서버에 연결할 수 없습니다."}), 503
    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "AI 응답 생성 중 오류가 발생했습니다."}), 500

@app.route('/api/ai/lyrics', methods=['POST'])
def ai_lyrics():
    """주제로 가사 자동 생성 (마디별 배열로 반환)"""
    ip = request.headers.get('X-Forwarded-For', request.remote_addr or 'unknown').split(',')[0].strip()
    ok, retry = _ai_rate_ok(ip, limit=15, window=60)
    if not ok:
        return jsonify({"error": f"요청이 너무 많습니다. {retry}초 후 다시 시도해 주세요."}), 429

    data = request.json or {}
    topic = (data.get('topic') or '').strip()
    genre = (data.get('genre') or '힙합').strip()
    bars = int(data.get('bars') or 8)
    bars = max(2, min(bars, 16))

    if not topic:
        return jsonify({"error": "주제를 입력해 주세요."}), 400

    prompt = (
        f"주제: {topic}\n"
        f"장르: {genre}\n"
        f"위 주제로 {genre} 스타일 노래 가사를 {bars}마디 써 주세요.\n\n"
        f"[매우 중요]\n"
        f"- 정확히 {bars}줄만 출력하세요. 그 이상도 이하도 안 됩니다.\n"
        f"- 각 줄이 한 마디입니다. 줄바꿈으로만 구분하세요.\n"
        f"- 마디 번호(1., 2.), 따옴표, 제목, 설명, 인사말을 절대 붙이지 마세요.\n"
        f"- 오직 가사 내용만 {bars}줄 출력하세요.\n"
        f"- 각 줄은 8~16음절의 자연스러운 한국어로 쓰세요."
    )

    try:
        raw = _ollama_chat(
            [{"role": "system", "content": STUDIO_SYSTEM},
             {"role": "user", "content": prompt}],
            timeout=180
        )
        # 후처리: 빈 줄 제거, 번호/따옴표/머리기호 제거
        import re as _re
        lines = []
        for ln in raw.split('\n'):
            s = ln.strip()
            if not s:
                continue
            s = _re.sub(r'^\s*\d+[\.\)]\s*', '', s)      # "1. ", "2) "
            s = _re.sub(r'^\s*[-*•]\s*', '', s)           # "- ", "* "
            s = s.strip('"\'' + chr(8220) + chr(8221) + ' ')
            if s:
                lines.append(s)
        lines = lines[:bars]
        if not lines:
            return jsonify({"error": "가사를 생성하지 못했습니다. 다시 시도해 주세요."}), 500
        return jsonify({"lines": lines, "count": len(lines)})
    except urllib.error.URLError as e:
        print(f"[AI] Ollama 연결 실패: {e}")
        return jsonify({"error": "AI 서버에 연결할 수 없습니다."}), 503
    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "가사 생성 중 오류가 발생했습니다."}), 500



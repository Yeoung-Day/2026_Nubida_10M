                 VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, 0)"""
        
        cursor.execute(sql, (
            data.get('id'),
            data.get('title'),
            hash_password(str(data.get('password', ''))),
            data.get('author', '무명'),
            data.get('school', '개인'),

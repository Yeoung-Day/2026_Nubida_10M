@app.route('/api/posts', methods=['POST'])
def save_post():
    data = request.json
    conn = get_db_connection()
    if not conn: return jsonify({"error": "DB 연결 실패"}), 500
    
    try:
        cursor = conn.cursor()
        # 가사 데이터(recipe)를 문자열로 변환하여 유실 방지
        recipe_str = json.dumps(data.get('recipe', []), ensure_ascii=False)
        

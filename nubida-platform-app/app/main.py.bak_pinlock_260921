# SEO — 네이버/구글 서치어드바이저 소유확인 메타태그 주입
# DB(app_settings.key='seo')에서 코드를 읽어 HTML <head>에 삽입.
# MariaDB(SQLAlchemy async_session) 사용. 실패 시 무해하게 skip.
# ============================================================


async def _load_seo_meta_tags() -> str:
    """app_settings.key='seo' → <meta> 태그 문자열 반환 (없으면 '')."""
    try:
        from sqlalchemy import text as _sa_text
        from app.core.database import async_session

        async with async_session() as _db:
            _res = await _db.execute(
                _sa_text("SELECT `value` FROM app_settings WHERE `key` = 'seo' LIMIT 1")
            )
            _row = _res.first()
        if not _row or not _row[0]:
            return ""
        import json as _json
        _val = _row[0]
        if isinstance(_val, (bytes, bytearray)):
            _val = _val.decode("utf-8", "ignore")
        if isinstance(_val, str):
            try:
                _val = _json.loads(_val)
            except Exception:
                return ""
        if not isinstance(_val, dict):
            return ""

        def _clean(v) -> str:
            # 혹시 통째로 저장된 <meta ... content=xxx /> 문자열이면 hex/토큰만 추출
            v = (v or "").strip()
            if not v:
                return ""
            _m = _re.search(r"content[=:\"'\s]+([a-zA-Z0-9_\-]+)", v)
            if _m:
                return _m.group(1)
            return _re.sub(r"[^a-zA-Z0-9_\-]", "", v)

        _naver = _clean(_val.get("naver_search_code"))
        _google = _clean(_val.get("google_search_code"))
        _tags = []
        if _naver:
            _tags.append(f'<meta name="naver-site-verification" content="{_naver}">')
        if _google:
            _tags.append(f'<meta name="google-site-verification" content="{_google}">')
        return "\n".join(_tags)
    except Exception as _e:  # noqa: BLE001
        _logger.warning("SEO meta load failed: %s", _e)
        return ""


_SEO_CACHE = {"tags": "", "ts": 0.0}


async def _seo_tags_cached() -> str:
    """60초 TTL 캐시 — 매 요청 DB 조회 방지."""
    import time as _time
    _now = _time.time()
    if _now - _SEO_CACHE["ts"] > 60:
        _SEO_CACHE["tags"] = await _load_seo_meta_tags()
        _SEO_CACHE["ts"] = _now
    return _SEO_CACHE["tags"]



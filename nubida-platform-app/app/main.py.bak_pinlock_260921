_AEO_CACHE = {"block": "", "ts": 0.0}


async def _aeo_block_cached() -> str:
    """60초 TTL 캐시."""
    import time as _time
    _now = _time.time()
    if _now - _AEO_CACHE["ts"] > 60:
        _AEO_CACHE["block"] = _load_aeo_geo_block()

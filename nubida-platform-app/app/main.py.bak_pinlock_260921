# JS 정적 파일 charset 보정 — StaticFiles가 application/javascript 에 charset을
# 붙이지 않고 nosniff 헤더까지 걸려 있어, 브라우저가 JS를 레거시 인코딩으로
# 파싱해 JS 내 한글 문자열이 깨지는 문제를 방지한다. (HTML/CSS는 이미 utf-8)
@app.middleware("http")
async def add_charset_for_js(request: Request, call_next):
    response = await call_next(request)
    _ct = (response.headers.get("content-type", "") or "").lower()
    if _ct.startswith("application/javascript") or _ct.startswith("text/javascript"):
        if "charset" not in _ct:
            response.headers["content-type"] = "application/javascript; charset=utf-8"
    return response


#
#   해법: mount 를 제거하고 화이트리스트 방식으로 바꾼다.
#     ① PWA 아이콘(icon-*.png/svg)만 허용
#     ② 교구 자료는 /download/kit/<파일> 전용 경로로만, 반드시
#        "파일로 저장"(Content-Disposition: attachment) 되게 내려준다.
#        → 브라우저에서 소스가 그대로 열려 읽히는 경로가 사라진다.
ICONS_DIR = FRONTEND_DIR / "icons"
KIT_DL_DIR = FRONTEND_DIR / "icons" / "dl"

# 허용할 아이콘 이름 패턴 (그 외 전부 404)
_ICON_ALLOW = _re.compile(r"^icon-\d+\.(png|svg)$")

# 교구 자료 다운로드 허용 목록 — 여기 없는 파일은 절대 내려가지 않는다.
KIT_DOWNLOADS = {
    "doridori_v7.zip":  "누비다머신_1_도리도리로봇.zip",
    "puppy_v1.zip":     "누비다머신_2_강아지로봇.zip",

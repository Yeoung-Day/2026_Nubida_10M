@app.middleware("http")
async def seo_meta_injection(request: Request, call_next):
    """HTML 응답(.html 또는 /)의 </head> 앞에 SEO 메타태그 + AEO/GEO 구조화데이터 주입."""
    response = await call_next(request)
    try:
        _path = request.url.path
        _ct = response.headers.get("content-type", "") or ""
        is_html = ("text/html" in _ct) and (_path.endswith(".html") or _path == "/")
        if not is_html:
            return response
        if getattr(response, "body_iterator", None) is None:
            return response

        _chunks = []
        async for _c in response.body_iterator:
            _chunks.append(_c if isinstance(_c, bytes) else str(_c).encode("utf-8"))
        _body = b"".join(_chunks)

        if b"</head>" not in _body:
            response.body_iterator = _iter_bytes(_body)
            _reset_headers(response, len(_body))
            return response

        _inject_parts = []

        # 1) 검색엔진 소유확인 메타태그 (아직 없을 때만)
        _has_seo = (b"naver-site-verification" in _body) or (b"google-site-verification" in _body)
        if not _has_seo:
            _tags = await _seo_tags_cached()
            if _tags:
                _inject_parts.append(_tags)

        # 2) AEO/GEO 구조화 데이터 (아직 없을 때만 — 중복 방지)
        if b"application/ld+json" not in _body:
            _aeo = await _aeo_block_cached()
            if _aeo:
                _inject_parts.append(_aeo)

        if _inject_parts:
            _inject = ("\n" + "\n".join(_inject_parts) + "\n").encode("utf-8")
            _body = _body.replace(b"</head>", _inject + b"</head>", 1)

        response.body_iterator = _iter_bytes(_body)
        _reset_headers(response, len(_body))
    except Exception as _e:  # noqa: BLE001
        _logger.warning("SEO/AEO injection failed: %s", _e)
    return response


async def _iter_bytes(_b: bytes):
    yield _b


def _reset_headers(_resp, _length: int) -> None:
    try:
        if "content-length" in _resp.headers:
            _resp.headers["content-length"] = str(_length)
    except Exception:
        pass



}


@app.get("/download/kit/{fname}")
async def download_kit(fname: str):
    """교구 자료 전용 다운로드 — 허용 목록에 있는 파일만 '파일로 저장' 된다."""
    if fname not in KIT_DOWNLOADS:
        return JSONResponse(status_code=404, content={"detail": "Not Found"})
    src = KIT_DL_DIR / fname
    if not src.is_file():
        return JSONResponse(status_code=404, content={"detail": "Not Found"})
    # HTML 보고서도 octet-stream 으로 보내야 원본 바이트가 그대로 보존된다.
    # (text/html 로 보내면 Starlette 가 charset 처리하며 내용이 변형됨 → md5 불일치)
    _media = "application/zip" if fname.endswith(".zip") else "application/octet-stream"
    return FileResponse(
        str(src),
        media_type=_media,
        filename=KIT_DOWNLOADS[fname],
        headers={"Cache-Control": "no-store"},
    )


@app.get("/icons/{fname}")
async def serve_icon(fname: str):
    """아이콘만 공개. 펌웨어 소스·zip 등은 여기로도 내려가지 않는다."""
    if not _ICON_ALLOW.match(fname):
        return JSONResponse(status_code=404, content={"detail": "Not Found"})
    src = ICONS_DIR / fname
    if not src.is_file():
        return JSONResponse(status_code=404, content={"detail": "Not Found"})
    return FileResponse(str(src))



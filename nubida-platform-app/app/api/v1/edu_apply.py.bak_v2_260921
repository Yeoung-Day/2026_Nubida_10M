@router.get("/file/{item_id}")
async def download_instructor_pdf(
    item_id: int,
    user: dict = Depends(get_current_user),
    db=Depends(get_db),
):
    """강사카드 PDF 다운로드 — 🔒 본사 전용.

    /uploads/... 는 정적 서빙이라 URL 만 알면 누구나 접근할 수 있으므로,
    본사 확인 후 스트리밍으로 내려준다.
    """
    _require_hq(user)

    async with db as conn:
        row = await conn.execute(
            text("SELECT pdf_path, pdf_name, name FROM edu_instructor_applications WHERE id=:iid"),
            {"iid": item_id},
        )
        item = row.fetchone()

    if not item or not item[0]:
        raise HTTPException(404, "첨부된 강사카드가 없습니다.")

    fname = os.path.basename(item[0])
    fp = os.path.join(UPLOAD_DIR, fname)
    if not os.path.isfile(fp):
        raise HTTPException(404, "파일을 찾을 수 없습니다.")

    from fastapi.responses import FileResponse
    dl_name = item[1] or f"{item[2] or 'instructor'}_card.pdf"
    return FileResponse(fp, media_type="application/pdf", filename=dl_name)


def _csv_response(kind: str, items: list, header: list, fields: list) -> "Response":
    """CSV 생성 — 엑셀 한글 깨짐 방지를 위해 UTF-8 BOM 을 붙인다."""
    buf = io.StringIO()
    w = csv.writer(buf)
    w.writerow(header)
    for it in items:
        w.writerow([it.get(f, "") if it.get(f) is not None else "" for f in fields])

    from fastapi.responses import Response
    data = ("\ufeff" + buf.getvalue()).encode("utf-8")
    stamp = datetime.now().strftime("%Y%m%d")
    return Response(
        content=data,
        media_type="text/csv; charset=utf-8",
        headers={
            "Content-Disposition": f'attachment; filename="edu_{kind}_{stamp}.csv"',
            "Cache-Control": "no-store",
        },
    )


@router.get("/csv/{kind}")
async def export_csv(
    kind: str,
    status: str = Query(None),
    user: dict = Depends(get_current_user),
    db=Depends(get_db),
):

# ── 개인정보 접근 가능 역할 (본사 전용) ──
# 이 목록에 없는 역할은 조회 계열 엔드포인트에서 전부 403.
HQ_ONLY_ROLES = ("super_admin", "admin")

# ── 업로드 저장 경로 ──
# inquiries.py 와 동일한 규칙: main.py 가 서빙하는 /app/uploads 와 일치해야
# URL 접근 시 404 가 나지 않는다.
#   abspath(__file__) = /app/app/api/v1/edu_apply.py  (dname 4 → /app)
UPLOAD_DIR = os.path.join(
    os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))),
    "uploads", "edu_apply",
)
os.makedirs(UPLOAD_DIR, exist_ok=True)

PDF_MAX_BYTES = 10 * 1024 * 1024  # 10MB

VALID_STATUSES = ("pending", "reviewing", "approved", "rejected")

STATUS_LABEL_KR = {
    "pending": "접수",
    "reviewing": "확인중",
    "approved": "승인",
    "rejected": "반려",
}



def _require_hq(user: dict) -> None:
    """본사(admin/super_admin)가 아니면 403.

    개인정보 보호의 유일한 관문이므로, 조회·수정 계열 모든 곳에서 호출한다.
    """
    role = (user or {}).get("role", "")
    if role not in HQ_ONLY_ROLES:
        raise HTTPException(403, "본사 관리자만 접근할 수 있습니다.")


def _clean(v, maxlen=200):
    """입력값 정규화 — 공백 제거, 길이 제한, None 처리."""
    if v is None:
        return None
    s = str(v).strip()
    if not s:
        return None
    return s[:maxlen]


def _check_phone(phone: str) -> str:
    """연락처 형식 검증 (숫자/하이픈/공백/+ 허용, 숫자 9~11자리)."""
    p = _clean(phone, 30)
    if not p:
        raise HTTPException(400, "연락처를 입력해주세요.")
    digits = re.sub(r"[^0-9]", "", p)
    if not (9 <= len(digits) <= 11):
        raise HTTPException(400, "연락처 형식이 올바르지 않습니다.")
    return p


def _client_meta(request: Request):
    """접수 경로 추적용 IP / User-Agent."""
    ip = None
    try:
        fwd = request.headers.get("x-forwarded-for")
        ip = (fwd.split(",")[0].strip() if fwd
              else (request.client.host if request.client else None))
    except Exception:
        ip = None
    ua = _clean(request.headers.get("user-agent"), 300)
    return ip, ua


def _table_of(kind: str) -> str:
    """kind 별 테이블명 매핑 — SQL 인젝션 방지용 화이트리스트."""
    if kind in ("application", "app", "edu"):
        return "edu_applications"
    if kind in ("instructor", "teacher", "inst"):
        return "edu_instructor_applications"
    raise HTTPException(400, "잘못된 구분입니다.")


def _row_to_dict(kind: str, r) -> dict:
    """DB row → dict. 컬럼 순서에 의존하지 않도록 직접 명시 매핑."""
    if kind == "instructor":
        return {
            "id": r[0],
            "title": r[1],
            "name": r[2],
            "phone": r[3],
            "email": r[4],
            "region": r[5],
            "organization": r[6],
            "memo": r[7],
            "birth_date": r[8],
            "career": r[9],
            "has_certificate": r[10],
            "certificate_detail": r[11],
            # 12: pdf_path (경로 자체는 노출하지 않음), 13: pdf_name
            "has_pdf": bool(r[12]),
            "pdf_name": r[13],
            "status": r[14],
            "status_label": STATUS_LABEL_KR.get(r[14], r[14]),
            "admin_note": r[15],
            # 16: ip_address, 17: user_agent (노출하지 않음)
            "created_at": str(r[18]) if len(r) > 18 and r[18] else None,
            "updated_at": str(r[19]) if len(r) > 19 and r[19] else None,
        }
    return {
        "id": r[0],
        "title": r[1],
        "name": r[2],
        "phone": r[3],
        "email": r[4],
        "region": r[5],
        "organization": r[6],
        "memo": r[7],
        "status": r[8],
        "status_label": STATUS_LABEL_KR.get(r[8], r[8]),
        "admin_note": r[9],
        # 10: ip_address, 11: user_agent (노출하지 않음)
        "created_at": str(r[12]) if len(r) > 12 and r[12] else None,
        "updated_at": str(r[13]) if len(r) > 13 and r[13] else None,
    }



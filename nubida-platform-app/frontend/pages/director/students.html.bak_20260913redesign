        .mc-status { font-size:11px; font-weight:600; padding:3px 10px; border-radius:20px; }
        .mc-status.active { background:#D1FAE5; color:#065F46; }
        .mc-status.inactive { background:#FEF3C7; color:#92400E; }
        .mc-arrow { color:#D1D5DB; font-size:18px; flex-shrink:0; }

        .tabs { display:flex; border-bottom:1px solid #E5E7EB; background:#fff; }

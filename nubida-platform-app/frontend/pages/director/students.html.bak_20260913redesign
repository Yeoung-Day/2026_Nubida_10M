        .tab .tab-count { font-size:11px; background:#F3F4F6; padding:1px 7px; border-radius:8px; margin-left:4px; }
        .tab.active .tab-count { background:#EEF2FF; color:#4F5EF8; }

        /* 검색창 — 상단 툴바와 정렬, 돋보기 아이콘 */

        .member-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; padding:18px 20px; }
        .member-card { display:flex; align-items:center; gap:14px; padding:16px 18px; background:#fff; border:1px solid #EEF0F4; border-radius:14px; transition:all 0.2s ease; cursor:pointer; }

    <script>
        let allStudents = [];
        let allParents = [];
        let currentTab = 'students';

        function esc(s) {
            if (s == null) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const u = getCurrentUser();
            if (u) {
                document.getElementById('sidebarUserName').textContent = u.name || u.username || '사용자';
                document.getElementById('sidebarUserRole').textContent = '원장';
            }
            document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {
                year:'numeric', month:'long', day:'numeric', weekday:'long'
            });
            loadAllMembers();
        });

        async function loadAllMembers() {
            try {
                const [studentsRes, parentsRes, availableRes] = await Promise.all([
                    apiGet('/director/students/all?page=1&per_page=500'),
                    apiGet('/director/parents/all?page=1&per_page=500'),
                    apiGet('/director/students/available?page=1&per_page=500')
                ]);

                allStudents = (studentsRes && studentsRes.data) || [];
                allParents = (parentsRes && parentsRes.data) || [];
                const unassigned = (availableRes && availableRes.data) || [];

                document.getElementById('tabCountStudents').textContent = allStudents.length;
                document.getElementById('tabCountParents').textContent = allParents.length;
                document.getElementById('tabCountUnassigned').textContent = unassigned.length;

                window.unassignedStudents = unassigned;
                renderCurrentTab();
            } catch(err) {
                console.error('Load error:', err);
                document.getElementById('memberListBody').innerHTML =
                    `<div style="text-align:center;padding:60px 20px;color:#EF4444;">⚠️ 로딩 실패: ${esc(err.message)}</div>`;
            }
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
            renderCurrentTab();
        }

        function renderCurrentTab() {
            const search = (document.getElementById('searchInput').value || '').trim().toLowerCase();
            let items = [];
            let title = '';

            if (currentTab === 'students') {
                items = allStudents;
                title = '🎒 등록된 학생이 없습니다';
            } else if (currentTab === 'parents') {
                items = allParents;
                title = '👪 등록된 학부모가 없습니다';
            } else if (currentTab === 'unassigned') {
                items = window.unassignedStudents || [];
                title = '✅ 모든 학생이 학급에 배정되었습니다';
            }

            if (search) {
                items = items.filter(item =>
                    (item.name || '').toLowerCase().includes(search) ||
                    (item.phone || '').includes(search) ||
                    (item.email || '').toLowerCase().includes(search)
                );
            }

            const body = document.getElementById('memberListBody');
            if (!items || items.length === 0) {
                body.className = '';
                body.innerHTML = `<div style="text-align:center;padding:60px 20px;color:#9CA3AF;">
                    <div style="font-size:48px;margin-bottom:12px;">${currentTab === 'students' ? '🎒' : currentTab === 'parents' ? '👪' : '✅'}</div>
                    <div style="font-size:14px;">${title}</div>
                    ${search ? '<div style="font-size:12px;color:#D1D5DB;margin-top:4px;">검색 결과가 없습니다</div>' : ''}
                </div>`;
                return;
            }

            body.className = 'member-grid';
            body.innerHTML = items.map(item => {
                const name = item.name || item.username || '-';
                const phone = item.phone || '-';
                const email = item.email || '-';
                const code = item.registration_code ? (item.registration_code.startsWith('#') ? item.registration_code : '#' + item.registration_code) : '';
                const date = item.created_at ? new Date(item.created_at).toLocaleDateString('ko-KR') : '-';
                const isActive = item.is_active !== false;

                const initial = (name && name.trim()) ? name.trim().charAt(0) : '?';
                const isStudentTab = currentTab === 'students';

                return `<div class="member-card" onclick="showDetail(${item.id}, '${currentTab}')">
                    <div class="mc-avatar ${isStudentTab ? 'student' : 'parent'}">${esc(initial)}<span class="mc-avatar-badge">${isStudentTab ? '🎓' : '👪'}</span></div>
                    <div class="mc-info">
                        <div class="mc-name">${esc(name)}${code ? `<span class="mc-code">${esc(code)}</span>` : ''}</div>
                        <div class="mc-meta">
                            <span class="mc-chip">📱 ${esc(phone)}</span>
                            <span class="mc-chip">✉️ ${esc(email)}</span>
                            <span class="mc-chip">📅 ${date}</span>
                            <span class="mc-status ${isActive ? 'active' : 'inactive'}">${isActive ? '활성' : '대기'}</span>
                        </div>
                    </div>
                    <span class="mc-arrow">›</span>
                </div>`;
            }).join('');
        }

        function filterMembers() {
            renderCurrentTab();
        }

        let currentDetailUserId = null;

        // === 상세 정보 모달 ===
        function showDetail(userId, tab) {
            let user = null;
            let isStudent = true;
            userId = Number(userId);  // 문자열/숫자 타입 통일

            currentDetailUserId = userId;

            if (tab === 'students') {
                user = allStudents.find(u => u.id === userId);
            } else if (tab === 'unassigned') {
                user = (window.unassignedStudents || []).find(u => u.id === userId);
            } else {
                user = allParents.find(u => u.id === userId);
                isStudent = false;
            }

            if (!user) return;

            // 기본 정보 채우기
            document.getElementById('detailModalTitle').textContent = isStudent ? '🎒 학생 정보' : '👪 학부모 정보';
            document.getElementById('dName').textContent = user.name || '-';
            document.getElementById('dUsername').textContent = user.username || '-';
            document.getElementById('dRole').textContent = isStudent ? '🎒 학생' : '👪 학부모';
            document.getElementById('dEmail').textContent = user.email || '-';
            document.getElementById('dPhone').textContent = user.phone || '-';
            document.getElementById('dCode').textContent = user.registration_code ? '#' + user.registration_code : '-';
            document.getElementById('dCreated').textContent = user.created_at ? new Date(user.created_at).toLocaleString('ko-KR') : '-';
            document.getElementById('dStatus').textContent = user.is_active !== false ? '✅ 활성' : '⏳ 승인 대기';

            // 학부모 섹션 (학생일 때만 표시)
            const parentSection = document.getElementById('parentSection');
            const parentList = document.getElementById('parentList');

            if (isStudent) {
                // 같은 branch_id의 학부모 목록 필터링
                const studentCode = user.registration_code || '';
                const matchedParents = allParents.filter(p => 
                    p.registration_code && studentCode && p.registration_code === studentCode
                );

                if (matchedParents.length > 0) {
                    parentSection.style.display = 'block';
                    parentList.innerHTML = matchedParents.map(p => `
                        <div class="parent-card">
                            <div class="pc-icon">👪</div>
                            <div class="pc-info">
                                <div class="pc-name">${esc(p.name || '-')}</div>
                                <div class="pc-meta">📱 ${esc(p.phone || '-')} · ✉️ ${esc(p.email || '-')}</div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    // 등록코드로 매칭 안 되면 같은 지사의 학부모 전체 표시
                    const branchParents = allParents;
                    if (branchParents.length > 0) {
                        parentSection.style.display = 'block';
                        parentList.innerHTML = `
                            <div style="font-size:12px;color:#9CA3AF;margin-bottom:10px;">📌 같은 지사에 등록된 학부모 목록</div>
                            ${branchParents.map(p => `
                                <div class="parent-card">
                                    <div class="pc-icon">👪</div>
                                    <div class="pc-info">
                                        <div class="pc-name">${esc(p.name || '-')}</div>
                                        <div class="pc-meta">📱 ${esc(p.phone || '-')} · ✉️ ${esc(p.email || '-')}${p.registration_code ? ' · #' + esc(p.registration_code) : ''}</div>
                                    </div>
                                </div>
                            `).join('')}
                        `;
                    } else {
                        parentSection.style.display = 'block';
                        parentList.innerHTML = '<div style="font-size:12px;color:#9CA3AF;">등록된 학부모가 없습니다.</div>';
                    }
                }
            } else {
                parentSection.style.display = 'none';
            }

            document.getElementById('detailModal').style.display = 'flex';
        }

        async function confirmWithdraw() {
            if (!currentDetailUserId) return;
            if (!confirm('정말 이 회원을 탈퇴 처리하시겠습니까?\n탈퇴 후에는 시스템을 이용할 수 없습니다.')) return;

            const btn = document.getElementById('withdrawBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 탈퇴 중...';

            try {
                const res = await apiDelete('/director/students/' + currentDetailUserId + '/withdraw');
                if (res && res.status === 'success') {
                    alert('✅ ' + (res.message || '탈퇴 처리 완료'));
                    closeModal();
                    loadAllMembers();
                } else {
                    alert('❌ ' + (res.message || '탈퇴 처리 실패'));
                    btn.disabled = false;
                    btn.textContent = '⚠️ 탈퇴';
                }
            } catch(err) {
                alert('❌ 오류: ' + (err.message || '알 수 없음'));
                btn.disabled = false;
                btn.textContent = '⚠️ 탈퇴';
            }
        }

        function closeModal() {
            document.getElementById('detailModal').style.display = 'none';
            const btn = document.getElementById('withdrawBtn');
            if (btn) {
                btn.disabled = false;
                btn.textContent = '⚠️ 탈퇴';
            }
        }

        // 모달 배경 클릭 시 닫기
        document.getElementById('detailModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        function handleLogout() {
            localStorage.removeItem('token');
            localStorage.removeItem('access_token');
            localStorage.removeItem('user');
            window.location.href = '/pages/login.html';
        }
    </script>
</body>
</html>

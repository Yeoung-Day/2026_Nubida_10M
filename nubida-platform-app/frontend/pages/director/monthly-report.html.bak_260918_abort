                            </div>
                            <div class="form-hint">자동 계산 (실적 ÷ 목표)</div>
                        </div>
                        <div>
                            <label class="form-label">월 매출 실적</label>
                            <div class="form-row">
                                <input type="number" class="form-control form-control-sm" id="resultRevenue" min="0" step="10000">
                                <span class="unit">원</span>
                            </div>
                            <div class="form-row" style="margin-top:6px">
                                <input type="number" class="form-control form-control-sm auto-calc" id="resultRevenueRate" min="0" max="100" readonly tabindex="-1">
                                <span class="unit">%</span>
                            </div>
                            <div class="form-hint">자동 계산 (실적 ÷ 목표)</div>
                        </div>
                        <div>
                            <label class="form-label">유지율 실적</label>
                            <div class="form-row">
                                <input type="number" class="form-control form-control-sm auto-calc" id="resultRetentionRate" min="0" max="100" readonly tabindex="-1">
                                <span class="unit">%</span>
                            </div>
                            <div class="form-row" style="margin-top:6px">
                                <input type="number" class="form-control form-control-sm auto-calc" id="resultRetentionRateAchieved" min="0" max="100" readonly tabindex="-1">
                                <span class="unit">%</span>
                            </div>
                            <div class="form-hint">자동 계산 (실적 ÷ 목표)</div>
                        </div>
                    </div>
                </div>

                <!-- Section 6: 특이사항 -->
                <div class="form-card">
                    <div class="section-title">특이사항</div>
                    <textarea class="form-control" id="notes" rows="4" placeholder="특이사항이나 본사에 전달할 내용을 입력하세요..."></textarea>
                </div>

                <!-- Section 7: 서명 -->
                <div class="form-card">
                    <div class="section-title">원장 확인</div>
                    <div class="signature-area">
                        <label>
                            <input type="checkbox" id="isAgreed">
                            <span>위 내용을 확인하였으며, 보고서 제출에 동의합니다.</span>
                        </label>
                        <div class="form-row" style="align-items:center;gap:8px;margin-top:6px">

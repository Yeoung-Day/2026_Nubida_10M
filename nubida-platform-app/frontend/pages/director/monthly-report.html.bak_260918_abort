                                <div><label class="form-label">본사 요청사항</label><textarea class="form-control" id="issueEducationRequest" rows="2"></textarea></div>
                            </div>
                        </div>
                        <div class="issue-row">
                            <div class="issue-label">📋 행정</div>
                            <div class="form-grid" style="grid-template-columns:1fr 1fr">
                                <div><label class="form-label">내용</label><textarea class="form-control" id="issueAdminContent" rows="2"></textarea></div>
                                <div><label class="form-label">본사 요청사항</label><textarea class="form-control" id="issueAdminRequest" rows="2"></textarea></div>
                            </div>
                        </div>
                        <div class="issue-row">
                            <div class="issue-label">🔧 기타</div>
                            <div class="form-grid" style="grid-template-columns:1fr 1fr">
                                <div><label class="form-label">내용</label><textarea class="form-control" id="issueOtherContent" rows="2"></textarea></div>
                                <div><label class="form-label">본사 요청사항</label><textarea class="form-control" id="issueOtherRequest" rows="2"></textarea></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 5: 전월 실적 -->
                <div class="form-card">
                    <div class="section-title">전월 실적 (간략)</div>
                    <div class="form-grid-3">
                        <div>
                            <label class="form-label">신규 수강생 실적</label>
                            <div class="form-row">
                                <input type="number" class="form-control form-control-sm" id="resultNewStudents" min="0">
                                <span class="unit">명</span>
                            </div>
                            <div class="form-row" style="margin-top:6px">
                                <input type="number" class="form-control form-control-sm auto-calc" id="resultNewStudentsRate" min="0" max="100" readonly tabindex="-1">

        requireAuth();
        const user = getCurrentUser();
        if (user) {
            document.getElementById('sidebarUserName').textContent = user.name || user.username || '원장';
            document.getElementById('sidebarUserRole').textContent = '원장';
        }
        const now = new Date();
        document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', { year:'numeric', month:'long', day:'numeric', weekday:'long' });
        document.getElementById('reportYear').value = now.getFullYear();
        document.getElementById('reportMonth').value = now.getMonth() + 1;
        document.getElementById('confirmedDate').value = now.toISOString().slice(0,10);
        updatePeriod();
        loadReports();

        document.getElementById('reportYear').addEventListener('input', updatePeriod);
        document.getElementById('reportMonth').addEventListener('input', updatePeriod);

        // % 항목 자동 계산 바인딩
        bindAutoCalc();

        // localStorage에서 마지막 편집 보고서 복원
        const savedId = localStorage.getItem('monthlyReport_lastId');
        if (savedId && !isNaN(parseInt(savedId))) {
            restoreReport(parseInt(savedId));
        }
    });

    async function restoreReport(reportId) {
        try {
            const res = await apiGet('/director/director-reports/' + reportId);
            if (res && res.status === 'success' && res.data) {
                fillForm(res.data);
            }
        } catch (e) {
            console.log('Auto-restore failed (report may have been deleted):', e);
            localStorage.removeItem('monthlyReport_lastId');
        }
    }

    async function loadAndFillReport(reportId) {
        try {
            const res = await apiGet('/director/director-reports/' + reportId);
            if (res && res.status === 'success' && res.data) {
                fillForm(res.data);
            } else {
                showToast('보고서를 불러올 수 없습니다.', 'error');
            }
        } catch (e) {
            showToast('보고서 불러오기 실패', 'error');
            console.error(e);
        }
    }

    function updatePeriod() {
        const y = document.getElementById('reportYear').value || '____';
        const m = document.getElementById('reportMonth').value || '__';
        document.getElementById('reportPeriod').textContent = y + '년 ' + m + '월';
    }

    // ============================================================
    // 자동 계산 — % 항목은 입력값에서 자동 산출 (원장 수동 입력 불필요)
    //   유지율            = (총수강생 − 퇴원) ÷ 총수강생 × 100
    //   신규 달성률       = 신규 실적 ÷ 신규 목표 × 100
    //   매출 달성률       = 매출 실적 ÷ 매출 목표 × 100
    //   유지율 달성률     = 유지율 실적 ÷ 목표 유지율 × 100
    //   유지율 실적       = (전월 총수강생 − 퇴원) ÷ 전월 총수강생 × 100
    // ============================================================
    function pct(numer, denom) {
        numer = Number(numer) || 0;
        denom = Number(denom) || 0;
        if (denom <= 0) return 0;
        return Math.round((numer / denom) * 100);
    }
    function num(id) {
        const el = document.getElementById(id);
        return el ? (parseInt(el.value) || 0) : 0;
    }
    function setVal(id, v) {
        const el = document.getElementById(id);
        if (el) el.value = (v === 0 ? 0 : v);
    }

    function recalc() {
        // 1) 목표 유지율 = (총수강생 − 퇴원) / 총수강생
        const total = num('totalStudents');
        const withdrawals = num('withdrawals');
        const retention = total > 0 ? pct(total - withdrawals, total) : 0;
        setVal('retentionRate', retention);

        // 2) 신규 달성률 = 실적 / 목표
        setVal('resultNewStudentsRate',
               pct(num('resultNewStudents'), num('targetNewStudents')));

        // 3) 매출 달성률 = 실적 / 목표
        setVal('resultRevenueRate',
               pct(num('resultRevenue'), num('targetRevenue')));

        // 4) 유지율 실적 — 전월 총수강생 기준 (없으면 목표 기준)
        const prevTotal = num('prevTotalStudents') || total;
        const resultRetention = prevTotal > 0 ? pct(prevTotal - withdrawals, prevTotal) : 0;
        setVal('resultRetentionRate', resultRetention);

        // 5) 유지율 달성률 = 유지율 실적 / 목표 유지율
        setVal('resultRetentionRateAchieved', pct(resultRetention, retention));
    }

    // 자동계산 트리거: 관련 입력이 바뀌면 즉시 재계산
    function bindAutoCalc() {
        ['totalStudents', 'withdrawals', 'newRegistrations',
         'targetNewStudents', 'targetRevenue',
         'resultNewStudents', 'resultRevenue', 'prevTotalStudents'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', recalc);
                el.addEventListener('change', recalc);
            }
        });
        recalc();
    }

    function getFormData() {
        recalc();
        return {
            year: parseInt(document.getElementById('reportYear').value) || 0,
            month: parseInt(document.getElementById('reportMonth').value) || 0,
            branch_name: document.getElementById('branchName').value.trim(),
            director_name: document.getElementById('directorName').value.trim(),
            contact: document.getElementById('contact').value.trim(),
            total_students: parseInt(document.getElementById('totalStudents').value) || 0,
            new_registrations: parseInt(document.getElementById('newRegistrations').value) || 0,
            withdrawals: parseInt(document.getElementById('withdrawals').value) || 0,
            retention_rate: parseInt(document.getElementById('retentionRate').value) || 0,
            target_new_students: parseInt(document.getElementById('targetNewStudents').value) || 0,
            target_monthly_revenue: parseInt(document.getElementById('targetRevenue').value) || 0,
            target_other: document.getElementById('targetOther').value.trim(),
            issue_facility_content: document.getElementById('issueFacilityContent').value.trim(),
            issue_facility_request: document.getElementById('issueFacilityRequest').value.trim(),
            issue_education_content: document.getElementById('issueEducationContent').value.trim(),
            issue_education_request: document.getElementById('issueEducationRequest').value.trim(),
            issue_admin_content: document.getElementById('issueAdminContent').value.trim(),
            issue_admin_request: document.getElementById('issueAdminRequest').value.trim(),
            issue_other_content: document.getElementById('issueOtherContent').value.trim(),
            issue_other_request: document.getElementById('issueOtherRequest').value.trim(),
            result_new_students: parseInt(document.getElementById('resultNewStudents').value) || 0,
            result_new_students_rate: parseInt(document.getElementById('resultNewStudentsRate').value) || 0,
            result_monthly_revenue: parseInt(document.getElementById('resultRevenue').value) || 0,
            result_monthly_revenue_rate: parseInt(document.getElementById('resultRevenueRate').value) || 0,
            result_retention_rate: parseInt(document.getElementById('resultRetentionRate').value) || 0,
            result_retention_rate_achieved: parseInt(document.getElementById('resultRetentionRateAchieved').value) || 0,
            notes: document.getElementById('notes').value.trim(),
            confirmed_date: document.getElementById('confirmedDate').value.trim(),
            is_agreed: document.getElementById('isAgreed').checked,
        };
    }

    function fillForm(data) {
        currentReportId = data.id;
        localStorage.setItem('monthlyReport_lastId', data.id);
        document.getElementById('reportYear').value = data.year;
        document.getElementById('reportMonth').value = data.month;
        document.getElementById('branchName').value = data.branch_name || '';
        document.getElementById('directorName').value = data.director_name || '';
        document.getElementById('contact').value = data.contact || '';
        document.getElementById('totalStudents').value = data.total_students || 0;
        document.getElementById('newRegistrations').value = data.new_registrations || 0;
        document.getElementById('withdrawals').value = data.withdrawals || 0;
        document.getElementById('retentionRate').value = data.retention_rate || 0;
        document.getElementById('targetNewStudents').value = data.target_new_students || 0;
        document.getElementById('targetRevenue').value = data.target_monthly_revenue || 0;
        document.getElementById('targetOther').value = data.target_other || '';
        document.getElementById('issueFacilityContent').value = data.issue_facility_content || '';
        document.getElementById('issueFacilityRequest').value = data.issue_facility_request || '';
        document.getElementById('issueEducationContent').value = data.issue_education_content || '';
        document.getElementById('issueEducationRequest').value = data.issue_education_request || '';
        document.getElementById('issueAdminContent').value = data.issue_admin_content || '';
        document.getElementById('issueAdminRequest').value = data.issue_admin_request || '';
        document.getElementById('issueOtherContent').value = data.issue_other_content || '';
        document.getElementById('issueOtherRequest').value = data.issue_other_request || '';
        document.getElementById('resultNewStudents').value = data.result_new_students || 0;
        document.getElementById('resultNewStudentsRate').value = data.result_new_students_rate || 0;
        document.getElementById('resultRevenue').value = data.result_monthly_revenue || 0;
        document.getElementById('resultRevenueRate').value = data.result_monthly_revenue_rate || 0;
        document.getElementById('resultRetentionRate').value = data.result_retention_rate || 0;
        document.getElementById('resultRetentionRateAchieved').value = data.result_retention_rate_achieved || 0;
        document.getElementById('notes').value = data.notes || '';
        document.getElementById('confirmedDate').value = data.confirmed_date || '';
        // 동의 체크박스는 항상 해제 상태로 시작 — 원장이 직접 눌러야 제출 가능
        document.getElementById('isAgreed').checked = false;
        updatePeriod();
        recalc();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetForm() {
        if (!confirm('모든 입력 내용을 초기화하시겠습니까?')) return;
        currentReportId = null;
        localStorage.removeItem('monthlyReport_lastId');
        document.querySelectorAll('.form-control').forEach(el => {
            if (el.type === 'number') el.value = '';
            else if (el.tagName === 'TEXTAREA') el.value = '';
            else el.value = '';
        });
        document.getElementById('isAgreed').checked = false;
        const now = new Date();
        document.getElementById('reportYear').value = now.getFullYear();
        document.getElementById('reportMonth').value = now.getMonth() + 1;
        document.getElementById('confirmedDate').value = now.toISOString().slice(0,10);
        updatePeriod();
        recalc();
        showToast('입력 내용이 초기화되었습니다.', 'success');
    }

    async function saveReport(status) {
        if (status === 'submitted') {
            const year = document.getElementById('reportYear').value;
            const month = document.getElementById('reportMonth').value;
            const name = document.getElementById('branchName').value.trim();
            if (!year || !month) { showToast('년/월을 입력해주세요.', 'error'); return; }
            if (!name) { showToast('공부방명을 입력해주세요.', 'error'); return; }
            if (!document.getElementById('isAgreed').checked) { showToast('원장 확인에 동의해주세요.', 'error'); return; }
        }

        const data = getFormData();
        data.status = status;

        try {
            let res;
            if (currentReportId) {
                res = await apiPut('/director/director-reports/' + currentReportId, data);
            } else {
                res = await apiPost('/director/director-reports', data);
            }
            if (res && res.status === 'success') {
                showToast(status === 'submitted' ? '✅ 보고서가 제출되었습니다.' : '💾 임시 저장되었습니다.', 'success');
                currentReportId = res.data?.id || null;
                if (currentReportId) localStorage.setItem('monthlyReport_lastId', currentReportId);
                await loadReports();
            } else {
                showToast(res?.message || '저장 실패', 'error');
            }
        } catch (e) {
            showToast('저장 중 오류가 발생했습니다.', 'error');
            console.error(e);
        }
    }

    async function loadReports() {
        try {
            const res = await apiGet('/director/director-reports?per_page=50');
            allReports = res?.data || [];
            renderReportList();
        } catch (e) {
            console.error('Load reports error:', e);
        }
    }

    function renderReportList() {
        const container = document.getElementById('reportItems');
        if (!allReports.length) {
            container.innerHTML = '<div class="empty-state"><div class="icon">📋</div><p>제출된 보고서가 없습니다.<br>위 폼에서 보고서를 작성해주세요.</p></div>';
            return;
        }
        container.innerHTML = allReports.map(r => {
            const statusClass = r.status === 'submitted' ? 'status-submitted' : 'status-draft';
            const statusLabel = r.status === 'submitted' ? '✅ 제출 완료' : '📝 임시 저장';
            return '<div class="report-list-item" onclick="loadAndFillReport(' + r.id + ')">' +
                '<div class="info"><div class="title">' + (r.branch_name || '공부방') + ' — ' + r.year + '년 ' + r.month + '월</div>' +
                '<div class="meta">수강생 ' + (r.total_students || 0) + '명 · 신규 ' + (r.new_registrations || 0) + '명 · 유지율 ' + (r.retention_rate || 0) + '%</div></div>' +
                '<span class="status-badge ' + statusClass + '">' + statusLabel + '</span></div>';
        }).join('');
    }

    function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast ' + (type || '') + ' show';
        clearTimeout(t._hide);
        t._hide = setTimeout(() => t.classList.remove('show'), 3000);
    }
    </script>
    

<script>
let selectedClassId = null;
let progressData = null;

document.addEventListener('DOMContentLoaded', async function() {
    requireAuth();
    renderSidebarUser();
    await loadClasses();
});

async function loadClasses() {
    try {
        const result = await apiGet('/director/classes');
        const classes = result.data || [];
        const container = document.getElementById('classSelector');
        if (classes.length === 0) {
            container.innerHTML = '<span style="color:var(--text-tertiary);font-size:14px;">등록된 학급이 없습니다</span>';
            return;
        }
        container.innerHTML = classes.map(c =>
            `<div class="class-chip ${selectedClassId === c.id ? 'active' : ''}" onclick="selectClass(${c.id})">${esc(c.name)} <span style="opacity:.6;font-size:11px">(${c.student_count || '?'})</span></div>`
        ).join('');
        if (!selectedClassId && classes.length > 0) {
            selectClass(classes[0].id);
        }
    } catch(e) {
        document.getElementById('classSelector').innerHTML = '<span style="color:var(--danger)">⚠️ 학급 로딩 실패</span>';
    }
}

function selectClass(classId) {
    selectedClassId = classId;
    loadClasses().then(() => loadProgress());
}

async function loadProgress() {
    if (!selectedClassId) return;
    const container = document.getElementById('progressContent');
    container.innerHTML = '<div class="loading-state"><div class="spinner"></div>진도 데이터 로딩 중...</div>';

    try {
        const result = await apiGet(`/director/classes/${selectedClassId}/progress`);
        progressData = result.data || {};
        renderProgress();
    } catch(e) {
        container.innerHTML = '<div class="empty-state">⚠️ 진도 데이터를 불러오지 못했습니다</div>';
    }
}

function renderProgress() {
    const container = document.getElementById('progressContent');
    const courses = progressData.courses || [];

    if (courses.length === 0) {
        container.innerHTML = '<div class="empty-state">📭 이 학급에 연결된 강좌가 없습니다</div>';
        return;
    }

    let html = `<div style="margin-bottom:16px;font-size:13px;color:var(--text-tertiary);">
        총 ${progressData.total_students}명의 학생 · ${progressData.total_courses}개 강좌
    </div>`;

    courses.forEach((course, ci) => {
        const avgRate = course.students.length > 0
            ? Math.round(course.students.reduce((s, st) => s + (st.completion_rate || 0), 0) / course.students.length)
            : 0;
        const rateClass = avgRate >= 70 ? 'high' : avgRate >= 40 ? 'medium' : 'low';

        html += `
        <div class="course-card">
            <div class="course-header" onclick="toggleCourse(${ci})">
                <div><h3>📖 ${esc(course.course_name)}</h3>
                    <div class="course-meta">자료 ${course.total_materials}개 · 학생 ${course.students.length}명</div>
                </div>
                <div style="display:flex;align-items:center;gap:12px;">
                    <div class="prog-bar" style="width:140px">
                        <div class="prog-track"><div class="prog-fill ${rateClass}" style="width:${avgRate}%"></div></div>
                        <span class="prog-label">${avgRate}%</span>
                    </div>
                    <span style="font-size:18px;color:var(--text-tertiary)">▾</span>
                </div>
            </div>
            <div class="course-body" id="courseBody${ci}">
                <table class="progress-table">
                    <thead><tr><th>학생명</th><th>완료</th><th>진행중</th><th style="width:200px">진행률</th></tr></thead>
                    <tbody>
                        ${course.students.length === 0
                            ? '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-tertiary)">학생이 없습니다</td></tr>'
                            : course.students.map(st => {
                                const sc = st.completion_rate || 0;
                                const cl = sc >= 70 ? 'high' : sc >= 40 ? 'medium' : 'low';
                                return `<tr>
                                    <td><strong>${esc(st.student_name)}</strong></td>
                                    <td><span style="color:#059669">${st.completed}</span>/<span style="color:var(--text-tertiary)">${course.total_materials}</span></td>
                                    <td><span style="color:#d97706">${st.in_progress}</span></td>
                                    <td><div class="prog-bar"><div class="prog-track"><div class="prog-fill ${cl}" style="width:${sc}%"></div></div><span class="prog-label">${sc}%</span></div></td>
                                </tr>`;
                            }).join('')
                        }
                    </tbody>
                </table>
            </div>
        </div>`;
    });

    container.innerHTML = html;
}

function toggleCourse(idx) {
    const body = document.getElementById('courseBody' + idx);
    body.classList.toggle('open');
}

function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
function renderSidebarUser() {} // handled by common js
</script>


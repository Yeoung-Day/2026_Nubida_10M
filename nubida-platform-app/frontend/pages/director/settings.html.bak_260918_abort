    <script>
        document.addEventListener('DOMContentLoaded', () => {
            requireAuth();
            renderSidebarUser();
            loadProfile();
            loadNotificationSettings();
            const now = new Date();
            const el = document.getElementById('todayDate');
            if (el) el.textContent = now.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });
        });

        /* ===== 프로필 로드 ===== */
        async function loadProfile() {
            try {
                const res = await apiGet('/auth/me');
                const u = res?.data || res;
                if (u.name) {
                    document.getElementById('profileName').value = u.name;
                    document.getElementById('displayName').textContent = u.name;
                }
                if (u.username) {
                    document.getElementById('displayUsername').textContent = u.username;
                } else if (u.email) {
                    document.getElementById('displayUsername').textContent = u.email.split('@')[0];
                }
                if (u.email) {
                    document.getElementById('profileEmail').value = u.email;
                    document.getElementById('displayEmail').textContent = u.email;
                }
                if (u.phone) {
                    document.getElementById('profilePhone').value = u.phone;
                    document.getElementById('displayPhone').textContent = u.phone;
                }
            } catch(e) { console.warn('프로필 로드 실패', e); }
        }

        /* ===== 프로필 저장 ===== */
        async function saveProfile() {
            const data = {
                name: document.getElementById('profileName').value,
                email: document.getElementById('profileEmail').value,
                phone: document.getElementById('profilePhone').value,
            };
            try {
                const res = await apiPut('/auth/me', data);
                showAlert(res?.message || '정보가 수정되었습니다.', 'success');
                const fresh = await apiGet('/auth/me');
                if (fresh?.data) localStorage.setItem('user', JSON.stringify(fresh.data));
                renderSidebarUser();
                loadProfile(); // Refresh display
            } catch(e) {
                showAlert(e?.message || '저장 실패', 'error');
            }
        }

        /* ===== 비밀번호 변경 ===== */
        async function changePassword() {
            const oldPw = document.getElementById('pwCurrent').value;
            const newPw = document.getElementById('pwNew').value;
            const confirmPw = document.getElementById('pwConfirm').value;
            if (!oldPw || !newPw || !confirmPw) { showAlert('모든 필드를 입력해주세요.', 'error'); return; }
            if (newPw !== confirmPw) { showAlert('새 비밀번호가 일치하지 않습니다.', 'error'); return; }
            if (newPw.length < 4) { showAlert('비밀번호는 4자 이상이어야 합니다.', 'error'); return; }
            try {
                const res = await apiPut('/auth/password', { old_password: oldPw, new_password: newPw });
                showAlert(res?.message || '비밀번호가 변경되었습니다.', 'success');
                document.getElementById('pwCurrent').value = '';
                document.getElementById('pwNew').value = '';
                document.getElementById('pwConfirm').value = '';
            } catch(e) {
                showAlert(e?.message || '비밀번호 변경 실패', 'error');
            }
        }

        /* ===== 알림 설정 로드 ===== */
        async function loadNotificationSettings() {
            try {
                const res = await apiGet('/auth/me/notifications');
                const s = res?.data || res || {};
                if (s.email_notifications !== undefined) document.getElementById('notifyEmail').checked = s.email_notifications;
                if (s.sms_notifications !== undefined) document.getElementById('notifySms').checked = s.sms_notifications;
                if (s.report_notifications !== undefined) document.getElementById('notifyReport').checked = s.report_notifications;
                if (s.attendance_alerts !== undefined) document.getElementById('notifyAttendance').checked = s.attendance_alerts;
            } catch(e) {
                // Use defaults silently
            }
        }

        /* ===== 알림 설정 저장 ===== */
        async function saveNotificationSettings() {
            const payload = {
                email_notifications: document.getElementById('notifyEmail').checked,
                sms_notifications: document.getElementById('notifySms').checked,
                report_notifications: document.getElementById('notifyReport').checked,
                attendance_alerts: document.getElementById('notifyAttendance').checked,
            };
            try {
                const res = await apiPut('/auth/me/notifications', payload);
                showAlert(res?.message || '알림 설정이 저장되었습니다.', 'success');
            } catch(e) {
                console.error('알림 저장 실패:', e);
                showAlert('알림 설정 저장 실패: ' + (e?.message || '알 수 없는 오류'), 'error');
            }
        }
    </script>
    

                    </label>
                </div>
            </div>

            <!-- 월간 요약 -->
            <section class="rv-summary" id="rvSummary">
                <div class="rv-sum-card rv-sum-main">
                    <div class="rv-sum-label">총매출 <span class="rv-sum-hint">학생수 × 교육비</span></div>
                    <div class="rv-sum-value" id="rvTotalExpected">0원</div>
                    <div class="rv-sum-sub">
                        <span id="rvStudentCount">0명</span>
                        <span class="rv-dot">·</span>
                        <span>납부 <b id="rvPaidCount">0</b>건</span>
                    </div>
                </div>
                <div class="rv-sum-card">
                    <div class="rv-sum-label">납부 매출</div>
                    <div class="rv-sum-value" id="rvTotalPaid">0원</div>
                    <div class="rv-sum-sub">실제 입금된 금액</div>
                </div>
                <div class="rv-sum-card rv-sum-warn">
                    <div class="rv-sum-label">미수금</div>
                    <div class="rv-sum-value" id="rvUnpaid">0원</div>
                    <div class="rv-sum-sub">미납 <b id="rvUnpaidCount">0</b>건</div>
                </div>
            </section>

            <!-- 정산 산출 내역 -->
            <section class="rv-calc" id="rvCalc">
                <div class="rv-calc-head">
                    <h2>정산 산출 내역</h2>
                    <span class="rv-calc-caption" id="rvCalcPeriod">—</span>
                </div>
                <div class="rv-calc-flow">
                    <div class="rv-flow-item">
                        <div class="rv-flow-label">총매출</div>
                        <div class="rv-flow-value" id="rvCalcTotal">0원</div>
                    </div>
                    <div class="rv-flow-op">
                        <span class="rv-op-badge">−</span>
                        <span class="rv-op-text">부가세 10%</span>
                    </div>
                    <div class="rv-flow-item">
                        <div class="rv-flow-label">공급가액</div>
                        <div class="rv-flow-value" id="rvCalcSupply">0원</div>
                    </div>
                    <div class="rv-flow-op">
                        <span class="rv-op-badge">−</span>
                        <span class="rv-op-text">로열티 45%</span>
                    </div>
                    <div class="rv-flow-item">
                        <div class="rv-flow-label">순수익</div>
                        <div class="rv-flow-value rv-flow-net" id="rvCalcNet">0원</div>
                    </div>
                </div>
                <div class="rv-calc-detail">
                    <div class="rv-detail-row"><span>부가세 (10%)</span><b id="rvCalcVat">0원</b></div>
                    <div class="rv-detail-row"><span>로열티 (45%, 본사)</span><b id="rvCalcRoyalty">0원</b></div>
                    <div class="rv-detail-row rv-detail-strong"><span>순수익 (원장)</span><b id="rvCalcNet2">0원</b></div>
                </div>
            </section>

            <!-- 학생별 납부 -->
            <section class="rv-card">
                <div class="rv-card-head">
                    <div>
                        <h2>학생별 납부 현황</h2>
                        <p class="rv-card-desc">과정을 선택하면 교육비가 자동 적용되며, <b>다음 달에도 그대로 유지</b>됩니다. 납부한 학생은 체크해 주세요.</p>
                    </div>
                    <div class="rv-legend">
                        <span class="rv-chip rv-chip-art">AI아트 98,000원</span>
                        <span class="rv-chip rv-chip-robot">AI로봇 198,000원</span>
                    </div>
                </div>
                <div class="rv-table-wrap">
                    <table class="rv-table">
                        <thead>
                            <tr>
                                <th class="rv-col-check">납부</th>
                                <th>학생</th>
                                <th class="rv-col-course">교육 과정</th>
                                <th class="rv-col-amount">교육비</th>
                                <th class="rv-col-status">상태</th>
                            </tr>
                        </thead>
                        <tbody id="rvStudentBody">
                            <tr><td colspan="5" class="rv-empty">불러오는 중...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="rv-table-foot">
                    <span id="rvFootNote">—</span>
                </div>
            </section>

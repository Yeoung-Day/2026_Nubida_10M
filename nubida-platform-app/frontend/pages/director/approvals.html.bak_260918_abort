    <script>
        let pendingUsers = [];
        let selectedUserId = null;

        function esc(s) {
            if (s == null) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        let _toastTimer = null;
        function showToast(msg, type) {
            const el = document.getElementById('apToast');
            if (!el) return;
            el.textContent = msg || '';
            el.className = 'ap-toast is-on' + (type ? ' is-' + type : '');
            if (_toastTimer) clearTimeout(_toastTimer);
            _toastTimer = setTimeout(function () {
                el.className = 'ap-toast';
            }, 2600);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const u = getCurrentUser();
            if (u) {
                document.getElementById('sidebarUserName').textContent = u.name || u.username || '사용자';
                document.getElementById('sidebarUserRole').textContent = '원장';
            }
            loadPendingUsers();
        });

        async function loadPendingUsers() {
            try {
                const res = await apiGet('/auth/pending-approvals');
                pendingUsers = (res && res.data) || [];

                // Stats
                const students = pendingUsers.filter(u => u.role === 'student').length;
                const parents = pendingUsers.filter(u => u.role === 'parent').length;
                document.getElementById('statPending').textContent = pendingUsers.length;
                document.getElementById('statStudents').textContent = students;
                document.getElementById('statParents').textContent = parents;
                document.getElementById('pendingCount').textContent = pendingUsers.length + '건';

                const body = document.getElementById('pendingListBody');
                if (pendingUsers.length === 0) {
                    body.innerHTML = `
                        <div class="ap-empty">
                            <div class="ap-empty-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="ap-empty-title">승인 대기 중인 회원이 없습니다</div>
                            <div class="ap-empty-desc">학생/학부모가 등록코드를 입력하고 가입하면 여기에 표시됩니다</div>
                        </div>`;
                    return;
                }

                body.innerHTML = pendingUsers.map(u => {
                    const roleClass = u.role === 'student' ? 'ap-role-student' : 'ap-role-parent';
                    const roleLabel = u.role === 'student' ? '학생' : '학부모';
                    const date = u.created_at ? new Date(u.created_at).toLocaleDateString('ko-KR') : '-';
                    return `<div class="ap-row">
                        <div class="ap-row-info">
                            <div class="ap-row-top">
                                <span class="ap-row-name">${esc(u.name)}</span>
                                <span class="ap-role-badge ${roleClass}">${roleLabel}</span>
                            </div>
                            <div class="ap-row-email">${esc(u.email || '이메일 없음')}</div>
                            <div class="ap-row-meta">
                                <span><span class="ap-meta-label">연락처</span>${esc(u.phone || '-')}</span>
                                <span><span class="ap-meta-label">가입일</span>${date}</span>
                                ${u.registration_code ? `<span class="ap-row-code">#${esc(u.registration_code)}</span>` : ''}
                            </div>
                        </div>
                        <div class="ap-row-actions">
                            <button class="ap-btn ap-btn-ghost" onclick="viewUser(${u.id})">정보</button>
                            <button class="ap-btn ap-btn-approve" onclick="approveUser(${u.id})">승인</button>
                        </div>
                    </div>`;
                }).join('');

            } catch(err) {
                document.getElementById('pendingListBody').innerHTML =
                    `<div class="ap-empty is-error"><div class="ap-empty-title">로딩 실패: ${esc(err.message)}</div></div>`;
            }
        }

        function viewUser(userId) {
            const user = pendingUsers.find(u => u.id === userId);
            if (!user) return;

            document.getElementById('amUserId').value = userId;
            document.getElementById('amName').textContent = user.name || '-';
            document.getElementById('amUsername').textContent = user.username || '-';
            document.getElementById('amRole').textContent = user.role === 'student' ? '학생' : '학부모';
            document.getElementById('amEmail').textContent = user.email || '-';
            document.getElementById('amPhone').textContent = user.phone || '-';
            document.getElementById('amCode').textContent = user.registration_code ? '#' + user.registration_code : '-';
            document.getElementById('amCreated').textContent = user.created_at ? new Date(user.created_at).toLocaleString('ko-KR') : '-';

            document.getElementById('approveBtn').textContent = '회원 승인';
            document.getElementById('approveBtn').disabled = false;
            document.getElementById('rejectBtn').textContent = '거절';
            document.getElementById('rejectBtn').disabled = false;
            document.getElementById('approveModal').style.display = 'flex';
        }

        function approveUser(userId) {
            viewUser(userId);
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
            document.getElementById('rejectBtn').disabled = false;
            document.getElementById('rejectBtn').textContent = '거절';
        }

        function closeRejectConfirm() {
            document.getElementById('rejectConfirmModal').style.display = 'none';
        }

        function confirmReject() {
            const userId = document.getElementById('amUserId').value;
            if (!userId) return;
            const user = pendingUsers.find(u => u.id == userId);
            document.getElementById('rejectUserName').textContent = (user && user.name) ? user.name : '해당 회원';
            const btn = document.getElementById('rejectConfirmBtn');
            btn.disabled = false;
            btn.textContent = '거절';
            document.getElementById('rejectConfirmModal').style.display = 'flex';
        }

        async function doReject() {
            const userId = document.getElementById('amUserId').value;
            if (!userId) return;

            const btn = document.getElementById('rejectConfirmBtn');
            btn.disabled = true;
            btn.textContent = '처리 중...';

            try {
                const res = await apiDelete('/director/students/' + userId + '/reject');
                if (res && res.status === 'success') {
                    showToast(res.message || '거절 완료', 'success');
                    closeRejectConfirm();
                    closeApproveModal();
                    loadPendingUsers();
                } else {
                    showToast(res && res.message ? res.message : '거절에 실패했습니다.', 'error');
                    btn.disabled = false;
                    btn.textContent = '거절';
                }
            } catch(err) {
                showToast('오류: ' + (err.message || '알 수 없음'), 'error');
                btn.disabled = false;
                btn.textContent = '거절';
            }
        }

        async function confirmApprove() {
            const userId = document.getElementById('amUserId').value;
            if (!userId) return;

            const btn = document.getElementById('approveBtn');
            btn.disabled = true;
            btn.textContent = '승인 중...';

            try {
                const res = await apiPost('/director/students/' + userId + '/approve');
                if (res && res.status === 'success') {
                    showToast(res.message || '회원이 승인되었습니다.', 'success');
                    closeApproveModal();
                    loadPendingUsers();
                } else {
                    showToast(res && res.message ? res.message : '승인에 실패했습니다.', 'error');
                    btn.disabled = false;
                    btn.textContent = '회원 승인';
                }
            } catch(err) {
                showToast('오류: ' + (err.message || '알 수 없음'), 'error');
                btn.disabled = false;
                btn.textContent = '회원 승인';
            }
        }

        function handleLogout() {
            localStorage.removeItem('token');
            localStorage.removeItem('access_token');
            localStorage.removeItem('user');
            window.location.href = '/pages/login.html';
        }
    </script>
</body>
</html>

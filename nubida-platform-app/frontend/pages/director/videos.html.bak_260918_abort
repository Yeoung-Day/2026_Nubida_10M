            <!-- Stats Grid -->
            <div class="stats-grid" id="statsGrid">
                <div class="stat-card"><div class="stat-label">📹 내 강좌 영상</div><div class="stat-value" id="statTotal">-</div></div>
                <div class="stat-card"><div class="stat-label">▶️ YouTube</div><div class="stat-value success" id="statYoutube">-</div></div>
                <div class="stat-card"><div class="stat-label">🎥 Vimeo</div><div class="stat-value warning" id="statVimeo">-</div></div>
                <div class="stat-card"><div class="stat-label">📁 업로드</div><div class="stat-value" id="statUpload">-</div></div>
            </div>

            <!-- Search & Filter -->
            <div class="card mb-24">
                <div class="card-body">
                    <div class="search-filter-row">
                        <div class="form-group" style="flex:1;min-width:200px">
                            <label>검색</label>
                            <input type="text" class="form-input" id="searchInput" placeholder="영상 제목 검색" oninput="loadVideos()">
                        </div>
                        <div class="form-group">
                            <label>유형</label>
                            <select class="form-select" id="typeFilter" onchange="loadVideos()">
                                <option value="">전체</option>
                                <option value="youtube">YouTube</option>
                                <option value="vimeo">Vimeo</option>
                                <option value="upload">업로드</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>상태</label>
                            <select class="form-select" id="statusFilter" onchange="loadVideos()">
                                <option value="">전체</option>
                                <option value="active">활성</option>
                                <option value="inactive">비활성</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>강좌</label>
                            <select class="form-select" id="courseFilter" onchange="loadVideos()">
                                <option value="">내 강좌 전체</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Video Table -->
            <div class="card">
                <div class="card-header"><h2>영상 목록</h2><span class="small-text" id="videoCount">0개</span></div>
                <div class="card-body" style="padding:0">
                    <div class="table-wrapper">
                        <table class="data-table" data-card-view>
                            <thead>
                                <tr>
                                    <th>영상</th>
                                    <th>제목</th>
                                    <th>강좌</th>
                                    <th>유형</th>
                                    <th>순서</th>
                                    <th>상태</th>
                                    <th>관리</th>
                                </tr>
                            </thead>
                            <tbody id="videoTableBody">
                                <tr><td colspan="7" style="text-align:center;color:var(--text-tertiary);padding:40px">로딩 중...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <div class="flex flex-center gap-8 mt-16" id="videoPagination"></div>
        </main>
    </div>

    <!-- Video Modal -->
    <div class="modal-overlay" id="videoModal">
        <div class="modal" style="max-width:560px">
            <h2 id="videoModalTitle">영상 등록</h2>
            <form id="videoForm" onsubmit="return false;">
                <input type="hidden" id="editVideoId">
                <div class="form-group">
                    <label for="modalTitle">제목</label>
                    <input type="text" class="form-input" id="modalTitle" required>
                </div>
                <div class="form-group">
                    <label for="modalDescription">설명</label>
                    <textarea class="form-textarea" id="modalDescription" rows="3"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="modalVideoType">영상 유형</label>
                        <select class="form-select" id="modalVideoType">
                            <option value="youtube">YouTube</option>
                            <option value="vimeo">Vimeo</option>
                            <option value="upload">업로드</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="modalCourse">강좌</label>
                        <select class="form-select" id="modalCourse"><option value="">강좌 선택</option></select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="modalUrl">URL <span style="color:var(--text-tertiary);font-weight:400">(YouTube/Vimeo 링크 또는 업로드 경로)</span></label>
                    <input type="text" class="form-input" id="modalUrl" placeholder="https://youtube.com/watch?v=...">
                </div>
                <div class="form-group">
                    <label for="modalSortOrder">정렬 순서</label>
                    <input type="number" class="form-input" id="modalSortOrder" value="0" min="0">
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeModal('videoModal')">취소</button>
                    <button type="submit" class="btn btn-primary" id="videoSaveBtn">저장</button>
                </div>
            </form>
        </div>
    </div>


                    <h1>본사 결제</h1>
                </div>
                <div class="top-nav-right">
                    <label class="pm-month-picker">
                        <span>정산월</span>
                        <input type="month" id="periodYm">
                    </label>
                </div>
            </div>

            <!-- 본사 계좌 -->
            <div class="pm-account">
                <div>
                    <div class="pm-account-label">본사 입금 계좌</div>
                    <div class="pm-account-number" id="pmAccount">—</div>
                    <div class="pm-account-holder">예금주: 누비다플랫폼</div>
                </div>
                <button class="pm-copy-btn" onclick="PM.copyAccount()">계좌 복사</button>
            </div>

            <!-- 승인 상태 배너 -->
            <div id="pmStatusBanner"></div>

            <!-- 월 정산 요약 -->
            <div class="pm-summary">
                <div class="pm-sum-card">
                    <div class="pm-sum-label">총매출</div>
                    <div class="pm-sum-value" id="pmTotal">0원</div>
                    <div class="pm-sum-sub" id="pmTotalSub">학생수 × 교육비</div>
                </div>
                <div class="pm-sum-card pm-hl">
                    <div class="pm-sum-label">공급가액 (부가세 제외)</div>
                    <div class="pm-sum-value" id="pmSupply">0원</div>
                    <div class="pm-sum-sub" id="pmVatSub">부가세 0원</div>
                </div>
                <div class="pm-sum-card pm-hl-net">
                    <div class="pm-sum-label">순수익 (원장)</div>
                    <div class="pm-sum-value" id="pmNet">0원</div>
                    <div class="pm-sum-sub">공급가액의 55%</div>
                </div>
                <div class="pm-sum-card pm-hl-royalty">
                    <div class="pm-sum-label">본사 납부액 (로열티 45%)</div>
                    <div class="pm-sum-value" id="pmRoyalty">0원</div>
                    <div class="pm-sum-sub">이 금액을 입금해 주세요</div>
                </div>
            </div>

            <!-- 입금 신청 -->
            <div class="pm-form-card">
                <div class="pm-form-title">입금 정보 작성</div>
                <div class="pm-form-desc">본사 계좌로 로열티를 입금한 뒤, 아래 내용을 작성하고 확인을 눌러주세요.</div>
                <div class="pm-form-grid">
                    <div class="pm-field">
                        <label>입금자명 <span class="req">*</span></label>
                        <input type="text" id="pmDepositor" placeholder="[지역]학원명" autocomplete="off">
                        <span class="pm-field-hint">예: <b>[부산]누리드림학원</b> 형식으로 작성해 주세요.</span>
                    </div>
                    <div class="pm-field">
                        <label>입금금액 <span class="req">*</span></label>
                        <input type="text" id="pmAmount" placeholder="0" inputmode="numeric" autocomplete="off">
                        <span class="pm-field-hint" id="pmAmountHint">본사 납부액과 동일하게 입력해 주세요.</span>
                    </div>
                </div>
                <div class="pm-submit-row">
                    <div class="pm-submit-note">
                        확인을 누르면 본사에서 입금 내역을 확인합니다.<br>
                        확인 완료 시 상태가 <b>승인</b>으로 변경됩니다.
                    </div>
                    <button class="pm-submit-btn" id="pmSubmitBtn" onclick="PM.submit()">확인</button>
                </div>
            </div>

            <!-- 입금 요청 이력 -->
            <div class="pm-card">
                <div class="pm-card-head"><h2>입금 요청 이력</h2></div>
                <div style="overflow-x:auto">
                    <table class="pm-table">
                        <thead>
                            <tr><th>정산월</th><th>입금자명</th><th>금액</th><th>상태</th><th>요청일</th></tr>
                        </thead>
                        <tbody id="pmHistoryBody">
                            <tr><td colspan="5" class="pm-empty">불러오는 중...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>


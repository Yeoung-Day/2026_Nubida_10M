        html += '<div class="section-block"><h4>👥 수강생 현황</h4><table class="detail-table">' +
            '<tr><td>총 수강생</td><td>' + (r.total_students || 0) + '명</td></tr>' +
            '<tr><td>신규 등록</td><td>' + (r.new_registrations || 0) + '명</td></tr>' +
            '<tr><td>퇴원</td><td>' + (r.withdrawals || 0) + '명</td></tr>' +
            '<tr><td>유지율</td><td>' + (r.retention_rate || 0) + '%</td></tr>' +

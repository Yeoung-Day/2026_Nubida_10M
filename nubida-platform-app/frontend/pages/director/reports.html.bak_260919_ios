            '<tr><td>연락처</td><td>' + esc(r.contact || '-') + '</td></tr>' +
            '<tr><td>보고월</td><td>' + r.year + '년 ' + r.month + '월</td></tr>' +
            '<tr><td>상태</td><td>' + getStatusBadge(r.status) + '</td></tr>' +

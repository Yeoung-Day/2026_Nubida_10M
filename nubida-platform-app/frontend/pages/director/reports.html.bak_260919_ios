        if (r.issue_facility_content || r.issue_education_content || r.issue_admin_content || r.issue_other_content) {
            html += '<div class="section-block"><h4>📌 이슈 및 건의사항</h4><table class="detail-table">';
            ['facility','education','admin','other'].forEach(k => {
                const content = r['issue_' + k + '_content'];
                const request = r['issue_' + k + '_request'];
                if (content || request) {
                    const label = {facility:'🏛️ 시설', education:'📚 교육', admin:'📋 행정', other:'🔧 기타'}[k];
                    html += '<tr><td>' + label + '</td><td>' + esc(nl2br(content) || '-') + (request ? '<br><span style="font-size:11px;color:var(--text-tertiary)">요청: ' + esc(nl2br(request)) + '</span>' : '') + '</td></tr>';

    <script>
// ============================================================
// 보고서 페이지 전용 스크립트
// ============================================================

let activeTab = 'monthly';
let _currentPage = 1;
const _perPage = 15;
let allReports = [];
let currentPage = 1;
let totalPages = 1;

document.addEventListener('DOMContentLoaded', () => {
    if (typeof requireAuth === 'function') requireAuth();
    if (typeof renderSidebarUser === 'function') renderSidebarUser();
    
    const now = new Date();
    const yearSelect = document.getElementById('filterYear');
    for (let y = now.getFullYear(); y >= 2024; y--) {
        const opt = document.createElement('option');
        opt.value = y; opt.textContent = y + '년';
        yearSelect.appendChild(opt);
    }
    document.getElementById('filterYear').value = now.getFullYear();
    document.getElementById('filterMonth').value = now.getMonth() + 1;
    
    loadDirectorReports();
    
    // Generated report defaults
    const firstOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    document.getElementById('dateStart').value = formatDateInput(firstOfMonth);
    document.getElementById('dateEnd').value = formatDateInput(now);
});

function switchTab(tab) {
    if (tab === activeTab) return;
    activeTab = tab;
    document.querySelectorAll('.tab-item').forEach(el => {
        el.classList.remove('active');
        el.style.color = '#888';
        el.style.borderBottom = '2px solid transparent';
    });
    const active = document.querySelector('.tab-item[data-tab="' + tab + '"]');
    if (active) {
        active.classList.add('active');
        active.style.color = 'var(--primary)';
        active.style.borderBottom = '2px solid var(--primary)';
    }
    document.getElementById('tabMonthly').style.display = tab === 'monthly' ? 'block' : 'none';
    document.getElementById('tabGenerated').style.display = tab === 'generated' ? 'block' : 'none';
    if (tab === 'monthly') loadDirectorReports();
    if (tab === 'generated') loadReportHistory();
}

function formatDateInput(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
}

function formatFileSize(bytes) {
    if (!bytes || bytes === 0) return '-';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function formatDateTime(str) {
    if (!str) return '-';
    try {
        const d = new Date(str);
        if (isNaN(d.getTime())) return str.slice(0, 16).replace('T', ' ');
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const h = String(d.getHours()).padStart(2, '0');
        const min = String(d.getMinutes()).padStart(2, '0');
        return `${y}-${m}-${day} ${h}:${min}`;
    } catch(e) { return str; }
}

function nl2br(s) { return (s || '').replace(/\n/g, '<br>').replace(/\r/g, ''); }
    function getStatusBadge(status) {
    if (status === 'draft') return '<span class="badge badge-warning">📝 임시 저장</span>';
    if (status === 'submitted') return '<span class="badge badge-success">✅ 제출 완료</span>';
    if (status === 'confirmed_by_branch') return '<span class="badge badge-primary" style="background:#EEF2FF;color:#4F5EF8;border:1px solid #C7D2FE;">🏢 에듀케어 확인</span>';
    return '<span class="badge">' + (status || '-') + '</span>';
}

function getPeriodStr(item) {
    const start = item.date_range_start || '';
    const end = item.date_range_end || '';
    if (start && end) return `${start} ~ ${end}`;
    if (start) return `${start} ~`;
    if (end) return `~ ${end}`;
    return '-';
}

function getReportTypeLabel(type) {
    const labels = {
        '학생 성적 보고서': '📊 성적',
        '출결 현황 보고서': '✅ 출결',
        '수업 통계 보고서': '📈 통계',
    };
    return labels[type] || type || '-';
}

// ============================================================
// 월간 보고서 (DirectorReport) 목록
// ============================================================
async function loadDirectorReports(page) {
    if (page !== undefined) currentPage = page;
    else currentPage = 1;
    
    const container = document.getElementById('reportListContainer');
    const countEl = document.getElementById('reportCount');
    const pagination = document.getElementById('paginationArea');
    
    container.innerHTML = '<div style="text-align:center;padding:32px"><div class="loading-spinner" style="margin:10px auto"></div>로딩 중...</div>';
    pagination.style.display = 'none';
    if (countEl) countEl.textContent = '';
    
    const year = document.getElementById('filterYear').value;
    const month = document.getElementById('filterMonth').value;
    const status = document.getElementById('filterStatus').value;
    
    let url = '/director/director-reports?per_page=50&page=' + currentPage;
    if (year) url += '&year=' + year;
    if (month) url += '&month=' + month;
    if (status) url += '&status=' + status;
    
    try {
        const res = await apiGet(url);
        allReports = res?.data || [];
        totalPages = res?.total_pages || 1;
        currentPage = res?.page || 1;
        renderDirectorReports();
        renderPagination();
    } catch (e) {
        container.innerHTML = '<div class="empty-state"><div class="icon">⚠️</div><p>불러오기 실패: ' + e.message + '</p></div>';
    }
}

function renderDirectorReports() {
    const container = document.getElementById('reportListContainer');
    const countEl = document.getElementById('reportCount');
    
    if (!allReports.length) {
        container.innerHTML = '<div class="empty-state"><div class="icon">📋</div><p>작성된 보고서가 없습니다. "새 보고서 작성" 버튼을 눌러 작성해보세요.</p></div>';
        if (countEl) countEl.textContent = '';
        return;
    }
    
    if (countEl) countEl.textContent = '(총 ' + allReports.length + '건)';
    
    container.innerHTML = allReports.map(r => {
        return '<div class="report-card" onclick="openDirectorDetail(' + r.id + ')">' +
            '<div class="rc-header">' +
            '<div class="rc-title">📋 ' + r.year + '년 ' + r.month + '월 보고서</div>' +
            '<div>' + getStatusBadge(r.status) + '</div>' +
            '</div>' +
            '<div class="rc-meta">' +
            '<span>📅 ' + r.year + '년 ' + r.month + '월</span>' +
            '<span>🏫 ' + esc(r.branch_name || '-') + '</span>' +
            '<span>👤 ' + esc(r.director_name || '-') + '</span>' +
            (r.is_agreed ? '<span>✅ 서명 완료</span>' : '') +
            '</div>' +
            '<div class="rc-stats">' +
            '<div class="rc-stat"><div class="val">' + (r.total_students || 0) + '</div><div class="lbl">수강생</div></div>' +
            '<div class="rc-stat"><div class="val">+' + (r.new_registrations || 0) + '</div><div class="lbl">신규</div></div>' +
            '<div class="rc-stat"><div class="val">' + (r.retention_rate || 0) + '%</div><div class="lbl">유지율</div></div>' +
            '</div>' +
            '</div>';
    }).join('');
}

function renderPagination() {
    const area = document.getElementById('paginationArea');
    if (totalPages <= 1) { area.style.display = 'none'; return; }
    area.style.display = 'block';
    document.getElementById('pageInfo').textContent = currentPage + ' / ' + totalPages + '페이지';
    document.getElementById('prevPage').disabled = currentPage <= 1;
    document.getElementById('nextPage').disabled = currentPage >= totalPages;
}

function changePage(delta) {
    const newPage = currentPage + delta;
    if (newPage < 1 || newPage > totalPages) return;
    currentPage = newPage;
    loadDirectorReports();
}

function resetFilters() {
    const now = new Date();
    document.getElementById('filterYear').value = now.getFullYear();
    document.getElementById('filterMonth').value = now.getMonth() + 1;
    document.getElementById('filterStatus').value = '';
    currentPage = 1;
    loadDirectorReports();
}


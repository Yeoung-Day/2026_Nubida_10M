        <main class="main-content">
            <div class="top-nav"><div class="top-nav-left"><button class="hamburger-btn" id="hamburgerBtn" aria-label="메뉴 열기">☰</button><h1>🎥 원격수업 관리</h1></div>
                <div class="top-nav-right">
                    <span class="small-text" id="todayDate"></span>
                </div>
            </div>

            <!-- Stats Dashboard -->
            <div class="mgmt-stats" id="statsGrid">
                <div class="mgmt-stat-card">
                    <div class="stat-icon">📅</div>
                    <div class="stat-label">오늘 수업</div>
                    <div class="stat-value" id="todayCount">-</div>
                </div>
                <div class="mgmt-stat-card">
                    <div class="stat-icon">📚</div>
                    <div class="stat-label">총 수업</div>
                    <div class="stat-value" id="totalCount">-</div>
                </div>
                <div class="mgmt-stat-card">
                    <div class="stat-icon">✅</div>
                    <div class="stat-label">평균 출석률</div>
                    <div class="stat-value" id="avgAttendance">-</div>
                </div>
                <div class="mgmt-stat-card">
                    <div class="stat-icon">📡</div>
                    <div class="stat-label">진행중</div>
                    <div class="stat-value warning" id="liveCount">-</div>
                </div>
            </div>

            <!-- Toolbar -->
            <div class="mgmt-toolbar">
                <div class="mgmt-toolbar-left">
                    <div class="nav-search">
                        <span class="search-icon">🔍</span>
                        <input class="form-input" type="text" placeholder="수업 검색..." id="searchInput" oninput="filterClasses()">
                    </div>
                    <select class="form-select" style="width:auto;min-width:120px" id="statusFilter" onchange="filterClasses()">
                        <option value="">전체 상태</option>
                        <option value="scheduled">예정</option>
                        <option value="live">진행중</option>
                        <option value="completed">완료</option>
                        <option value="cancelled">취소</option>
                    </select>
                </div>
                <div class="mgmt-toolbar-right">
                    <button class="btn btn-filled" onclick="openModal('createModal'); resetCreateForm();">+ 수업 만들기</button>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="mgmt-filter-bar">
                <span class="small-text" id="classCount">로딩 중...</span>
            </div>

            <!-- Data Table -->
            <div class="table-wrapper">
                <table class="data-table" data-card-view>
                    <thead>
                        <tr>
                            <th>날짜</th>
                            <th>수업명</th>
                            <th>강좌</th>
                            <th>상태</th>
                            <th>출석</th>
                            <th>관리</th>
                        </tr>
                    </thead>
                    <tbody id="classTableBody">
                        <tr><td colspan="6" style="text-align:center;padding:var(--space-7);color:var(--text-tertiary)">로딩 중...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-bar" id="pagination"></div>

            <!-- Create Class Modal -->
            <div class="modal-overlay" id="createModal">
                <div class="modal" style="max-width:560px">
                    <h2>➕ 새 원격수업 만들기</h2>
                    <div class="form-group">
                        <label>수업명 *</label>
                        <input class="form-input" id="classTitle" placeholder="예: 3월 1주차 문법 수업">
                    </div>
                    <div class="form-group">
                        <label>강좌 *</label>
                        <select class="form-select" id="classCourse"><option value="">강좌 선택...</option></select>
                    </div>
                    <div class="form-group">
                        <label>설명</label>
                        <textarea class="form-textarea" id="classDescription" placeholder="수업 설명을 입력하세요" rows="3"></textarea>
                    </div>
                    <div class="form-row-3">
                        <div class="form-group">
                            <label>날짜 *</label>
                            <input class="form-input" type="date" id="classDate">
                        </div>
                        <div class="form-group">
                            <label>시간 *</label>
                            <input class="form-input" type="time" id="classTime">
                        </div>
                        <div class="form-group">
                            <label>수업 시간 (분)</label>
                            <input class="form-input" type="number" id="classDuration" value="45" min="10" max="180">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>최대 참여자</label>
                        <input class="form-input" type="number" id="classMaxParticipants" value="30" min="1" max="200">
                    </div>
                    <div class="modal-actions">
                        <button class="btn btn-outline" onclick="closeModal('createModal')">취소</button>
                        <button class="btn btn-filled" onclick="createClass()">수업 만들기</button>
                    </div>
                </div>
            </div>

            <!-- Attendance Modal -->
            <div class="modal-overlay" id="attendanceModal">
                <div class="modal" style="max-width:600px">
                    <h2>📋 출석 현황</h2>
                    <p class="small-text mb-16" id="attendanceModalTitle">-</p>
                    <div class="table-wrapper">
                        <table class="data-table" data-card-view>
                            <thead><tr><th>학생</th><th>상태</th><th>시간</th></tr></thead>
                            <tbody id="attendanceBody"><tr><td colspan="3" style="text-align:center;color:var(--text-tertiary)">로딩 중...</td></tr></tbody>
                        </table>
                    </div>
                    <div class="modal-actions">
                        <button class="btn btn-outline" onclick="closeModal('attendanceModal')">취소</button>
                    </div>
                </div>
            </div>
        </main>

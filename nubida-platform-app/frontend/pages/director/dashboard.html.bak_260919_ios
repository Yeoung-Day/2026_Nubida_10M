    <style>
    /* ============================================================
       원장 대시보드 — Professional Minimal Redesign (override layer)
       기존 공통 클래스(stats-grid, stat-card, card, data-table, btn 등)를
       덮어써서 전문적·세련된 미니멀 톤으로 재구성한다.
       ============================================================ */
    .main-content {
        background: linear-gradient(180deg, #FBFCFE 0%, #F6F8FC 100%);
        min-height: 100vh;
    }
    /* ---- Top nav ---- */
    .top-nav {
        padding: 22px 28px 16px;
        background: transparent !important;
        border-bottom: none !important;
    }
    .top-nav-left h1 {
        font-size: 21px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1F2437;
    }
    .top-nav-left { gap: 12px; }
    .hamburger-btn {
        background: #fff;
        border: 1px solid #E8ECF5;
        border-radius: 10px;
        color: #1F2437;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .hamburger-btn svg { display: block; }
    .top-nav-right .small-text {
        font-size: 12.5px;
        color: #98A1B2;
        font-weight: 500;
        letter-spacing: -0.01em;
    }
    .section-divider {
        height: 0;
        background: none;
        border-bottom: 1px solid #E8ECF5;
        margin: 0 28px 4px;
        opacity: 1;
    }

    /* ---- Stats grid ---- */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        padding: 20px 28px 0;
        margin: 0;
    }
    .stats-grid + .stats-grid { padding-top: 16px; }

    /* ---- Stat card: icon badge + label + big number ---- */
    .stat-card,
    .stat-card.stat-card-accent {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: #FFFFFF;
        border: 1px solid #E8ECF5;
        border-left: 1px solid #E8ECF5 !important;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 2px rgba(31, 36, 55, 0.04), 0 8px 24px -12px rgba(31, 36, 55, 0.10);
        transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease;
        overflow: hidden;
    }
    .stat-card:hover {
        transform: translateY(-2px);
        border-color: #DCE2F0;
        box-shadow: 0 2px 4px rgba(31, 36, 55, 0.05), 0 16px 32px -16px rgba(31, 36, 55, 0.16);
    }
    .stat-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #4F5EF8, #7C86FF);
        opacity: 0;
        transition: opacity .18s ease;
    }
    .stat-card:hover::before { opacity: 1; }

    .stat-card .stat-label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #98A1B2;
        order: 2;
    }
    .stat-card .stat-label svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        stroke: #4F5EF8;
        stroke-width: 1.9;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .stat-card .stat-value {
        order: 1;
        font-size: 30px;
        line-height: 1.05;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #1F2437;
        font-variant-numeric: tabular-nums;
    }
    /* accent variants recolor the icon badge stroke only (keep it clean) */
    .stat-card.info  .stat-label svg { stroke: #3B82F6; }
    .stat-card.success .stat-label svg { stroke: #10B981; }
    .stat-card.warning .stat-label svg { stroke: #4F5EF8; }
    .stat-card.danger  .stat-label svg { stroke: #EF4444; }

    /* ---- Cards ---- */
    .card {
        background: #FFFFFF;
        border: 1px solid #E8ECF5;
        border-radius: 16px;
        box-shadow: 0 1px 2px rgba(31, 36, 55, 0.04), 0 8px 24px -14px rgba(31, 36, 55, 0.10);
        overflow: hidden;
        margin: 0 28px;
    }
    .card + .card { margin-top: 16px; }
    .hover-glow { box-shadow: 0 1px 2px rgba(31,36,55,0.04), 0 8px 24px -14px rgba(31,36,55,0.10) !important; }
    .hover-glow:hover { box-shadow: 0 2px 4px rgba(31,36,55,0.05), 0 18px 34px -18px rgba(31,36,55,0.16) !important; }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        border-bottom: 1px solid #E8ECF5;
        background: linear-gradient(180deg, #FFFFFF 0%, #FDFDFF 100%);
    }
    .card-header h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #1F2437;
    }
    .card-header h2 svg {
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        stroke: #4F5EF8;
        stroke-width: 1.9;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .card-body { padding: 18px 22px; }

    /* ---- Grid layouts ---- */
    .grid-2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin: 16px 0;
    }
    .grid-2 .card { margin: 0; }

    /* ---- Data table ---- */
    .table-wrapper { width: 100%; overflow-x: auto; }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }
    .data-table thead th {
        text-align: left;
        padding: 12px 22px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #98A1B2;
        background: #F9FAFD;
        border-bottom: 1px solid #E8ECF5;
        white-space: nowrap;
    }
    .data-table tbody td {
        padding: 13px 22px;
        color: #1F2437;
        border-bottom: 1px solid #F0F3FA;
        vertical-align: middle;
    }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr { transition: background .14s ease; }
    .data-table tbody tr:hover { background: #F7F9FE; }
    .data-table tbody td:first-child { font-weight: 600; }
    .data-table tbody td[colspan] { color: #98A1B2 !important; }

    /* ---- Badges (status) ---- */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        border: 1px solid transparent;
    }
    .badge-success { background: #ECFDF5; color: #059669; border-color: #D1FAE5; }
    .badge-warning { background: #FFF7ED; color: #B45309; border-color: #FED7AA; }
    .badge-danger  { background: #FEF2F2; color: #DC2626; border-color: #FECACA; }
    .badge-info    { background: #EEF2FF; color: #4F5EF8; border-color: #E0E7FF; }

    /* ---- Quick action buttons ---- */
    .card-body.flex { gap: 10px !important; }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 12px;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition: background .16s ease, border-color .16s ease, box-shadow .16s ease, color .16s ease, transform .16s ease;
    }
    .btn.btn-outline {
        background: #FFFFFF;
        border: 1px solid #E8ECF5;
        color: #384056;
        box-shadow: 0 1px 2px rgba(31, 36, 55, 0.03);
    }
    .btn.btn-outline:hover {
        background: #F7F9FE;
        border-color: #C9D2E6;
        color: #4F5EF8;
        box-shadow: 0 6px 16px -10px rgba(79, 94, 248, 0.35);
    }
    .btn.btn-outline svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        stroke-width: 1.9;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }
    .btn-sm { padding: 9px 15px; font-size: 13px; }
    .hover-lift:hover { transform: translateY(-1px); }

    /* ---- Sidebar polish ---- */
    .sidebar .nav-section {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6A7183;
        padding: 14px 20px 5px;
    }
    .sidebar .nav-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 20px !important;
        margin: 2px 10px;
        border-radius: 10px;
        font-size: 13.5px;
        color: #C7CBD6;
        transition: background .15s ease, color .15s ease;
    }
    .sidebar .nav-item .icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }
    .sidebar .nav-item .icon svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
        stroke-width: 1.8;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .sidebar .nav-item:hover { background: rgba(255,255,255,0.06); color: #FFFFFF; }
    .sidebar .nav-item.active {
        background: rgba(79, 94, 248, 0.16) !important;
        color: #FFFFFF !important;
    }
    .sidebar .nav-item.active .icon { color: #8E96FF; }
    .sidebar-footer {
        border-top: 1px solid rgba(255,255,255,0.06);
        padding: 16px 20px;
    }
    .sidebar .user-name { font-weight: 600; color: #FFFFFF; }
    .sidebar .user-role { font-size: 12px; color: #8A90A0; }
    .sidebar .logout-btn {
        margin-top: 10px;
        width: 100%;
        padding: 9px;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        color: #C7CBD6;
        font-weight: 500;
        transition: background .15s ease, color .15s ease;
    }
    .sidebar .logout-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* ---- Responsive ---- */
    @media (max-width: 1024px) {
        .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
        .top-nav { padding: 16px 16px 12px; }
        .section-divider { margin: 0 16px 4px; }
        .stats-grid { grid-template-columns: 1fr; padding: 16px 16px 0; }
        .card { margin: 0 16px; }
        .card-body.flex { flex-direction: column; }
        .card-body.flex .btn { width: 100%; justify-content: center; }
    }
    </style>

<style>
    /* ── 교육 자료 (원장) 전용 ── */
    .edu-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
    .edu-toolbar-left, .edu-toolbar-right { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .edu-card { background:var(--card-bg,#fff); border:1px solid var(--border,#e5e7eb); border-radius:12px; padding:6px 4px; box-shadow:var(--shadow-sm,0 1px 3px rgba(0,0,0,.05)); }
    .edu-table { width:100%; border-collapse:collapse; }
    .edu-table th { text-align:left; padding:10px 12px; font-size:12px; font-weight:600; color:var(--text-tertiary,#9ca3af); border-bottom:1px solid var(--border,#eee); white-space:nowrap; }
    .edu-table td { padding:11px 12px; font-size:13px; border-bottom:1px solid #f3f4f6; vertical-align:middle; }
    .edu-table tr:last-child td { border-bottom:none; }
    .edu-table tr:hover td { background:#fafbff; }
    .edu-title { font-weight:600; color:var(--text-primary,#111827); cursor:pointer; }
    .edu-title:hover { color:var(--primary,#4F5EF8); }
    .edu-desc { font-size:11px; color:var(--text-tertiary,#9ca3af); margin-top:2px; max-width:420px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .badge-type { display:inline-flex; align-items:center; gap:4px; padding:2px 10px; border-radius:20px; font-size:11px; font-weight:500; }
    .badge-type.document { background:#E3F2FD; color:#1565C0; }
    .badge-type.video { background:#F3E5F5; color:#7B1FA2; }
    .badge-type.image { background:#E8F5E9; color:#2E7D32; }
    .badge-type.link { background:#FFF3E0; color:#E65100; }
    .file-cell { font-size:11px; color:var(--text-secondary,#4b5563); }
    .action-btn { border:1px solid var(--border,#e5e7eb); background:#fff; border-radius:6px; padding:3px 8px; font-size:11px; cursor:pointer; color:var(--text-secondary,#374151); }
    .action-btn:hover { border-color:var(--primary,#4F5EF8); color:var(--primary,#4F5EF8); }
    .empty-cell { text-align:center; color:var(--text-tertiary,#9ca3af); padding:32px 0 !important; font-size:13px; }
    .pagination-wrap { display:flex; justify-content:center; gap:4px; padding:14px 0 8px; }
    .pagination-wrap button { min-width:30px; height:30px; border:1px solid var(--border,#e5e7eb); background:#fff; border-radius:6px; cursor:pointer; font-size:12px; color:var(--text-secondary,#374151); }
    .pagination-wrap button.active { background:var(--primary,#4F5EF8); border-color:var(--primary,#4F5EF8); color:#fff; }
    .pagination-wrap button:disabled { opacity:.4; cursor:default; }
    .edu-detail-modal { max-width:860px; width:92vw; }
    .detail-meta { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:12px; font-size:12px; color:var(--text-tertiary,#9ca3af); }
    .detail-meta .cat-pill { background:#EEF2FF; color:#4F5EF8; padding:2px 10px; border-radius:20px; font-weight:500; }
    /* 교육명(과목) 컬러 칩 */
    .subject-pill { display:inline-flex; align-items:center; padding:2px 10px; border-radius:20px; font-size:11px; font-weight:600; line-height:1.5; white-space:nowrap; }
    .subject-pill.sp-0 { background:#FCE7F3; color:#9D174D; } /* 국어 */
    .subject-pill.sp-1 { background:#DBEAFE; color:#1D4ED8; } /* 수학 */
    .subject-pill.sp-2 { background:#DCFCE7; color:#15803D; } /* 영어 */
    .subject-pill.sp-3 { background:#CFFAFE; color:#0E7490; } /* 과학 */
    .subject-pill.sp-4 { background:#FEF3C7; color:#B45309; } /* 사회 */
    .subject-pill.sp-5 { background:#E0E7FF; color:#4338CA; } /* 코딩 */
    .subject-pill.sp-6 { background:#FFEDD5; color:#C2410C; } /* 메이커 */
    .subject-pill.sp-7 { background:#F3E8FF; color:#7E22CE; } /* AI */
    .subject-pill.sp-8 { background:#F1F5F9; color:#475569; } /* 기타 */
    .subject-pill.sp-9 { background:#F1F5F9; color:#6B7280; font-weight:500; } /* 기존(레거시) */
    /* ── 과목 탭 한 줄 네비게이션 ── */
    .subject-tabs-wrap { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin:0 0 12px; }
    .subject-tabs { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .subject-tab { border:1px solid var(--border,#e5e7eb); background:#fff; border-radius:20px; padding:6px 14px; font-size:12px; font-weight:600; color:var(--text-secondary,#374151); cursor:pointer; transition:all .15s ease; white-space:nowrap; }
    .subject-tab:hover { border-color:var(--primary,#4F5EF8); color:var(--primary,#4F5EF8); }
    .subject-tab.active { background:var(--primary,#4F5EF8); border-color:var(--primary,#4F5EF8); color:#fff; }
    .subject-manage-btn { flex-shrink:0; }

    .detail-content { border:1px solid var(--border,#e5e7eb); border-radius:10px; overflow:hidden; min-height:260px; background:#fff; }
    .viewer-placeholder { display:flex; align-items:center; justify-content:center; min-height:260px; color:var(--text-tertiary,#9ca3af); font-size:13px; }
    .detail-content video, .detail-content img { width:100%; max-height:62vh; object-fit:contain; display:block; background:#111; }

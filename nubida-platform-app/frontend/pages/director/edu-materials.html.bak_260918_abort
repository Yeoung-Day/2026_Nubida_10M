    /* 슬라이드 뷰어 */
    .slide-viewer { width:100%; max-width:100%; background:#1a1a2e; overflow:hidden; position:relative; }
    .slide-viewer .slide-display { position:relative; width:100%; aspect-ratio:16/9; min-height:220px; background:#16213e; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .slide-viewer .slide-display img { max-width:100%; max-height:100%; object-fit:contain; display:block; transition:opacity .25s ease; }
    .slide-viewer .slide-nav { position:absolute; top:50%; transform:translateY(-50%); width:36px; height:36px; border-radius:50%; background:rgba(156,163,175,.55); border:1px solid rgba(156,163,175,.3); color:#374151; font-size:16px; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:10; transition:all .15s ease; }
    .slide-viewer .slide-nav:hover { background:rgba(156,163,175,.8); }
    .slide-viewer .slide-nav.prev { left:10px; }
    .slide-viewer .slide-nav.next { right:10px; }
    .slide-viewer .slide-nav:disabled { opacity:.2; cursor:default; pointer-events:none; }
    .slide-viewer .slide-footer { display:flex; align-items:center; justify-content:space-between; padding:8px 14px; background:rgba(15,52,96,.9); color:#fff; border-top:1px solid rgba(255,255,255,.06); }
    .slide-viewer .slide-counter { font-size:12px; font-weight:500; opacity:.7; }
    .slide-viewer .slide-loading { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,.6); font-size:13px; background:#16213e; z-index:5; }
    .slide-viewer.fullscreen { position:fixed; top:0; left:0; width:100vw; height:100vh; max-width:none; border-radius:0; z-index:10000; background:#0a0a1a; border:none; }
    .slide-viewer.fullscreen .slide-display { aspect-ratio:auto; flex:1; height:calc(100vh - 46px); }
    .slide-viewer.fullscreen .slide-footer { background:rgba(0,0,0,.6); }
</style>
<script>
    // ============================================================
    // 교육 자료 (원장 뷰) — 본사 발행 자료 열람/뷰어/다운로드
    // ============================================================
    // ============================================================
    // 교육 자료 (원장 뷰) — 본사 발행 자료 열람/뷰어/다운로드 + 과목별 과정(강좌)
    // ============================================================
    let allMaterials = [];
    let currentPage = 1;
    let totalPages = 1;
    let _currentDetail = null;
    const PER_PAGE = 15;
    // ── 과목(교육명) 마스터 (본사 관리 → 원장 화면 탭/필터 기준) ──
    let subjectMaster = [];
    let activeSubject = '';       // '' = 전체
    let _legacyCategoryValues = []; // 마스터 외 기존 등록분(레거시) — 필터에서도 유지
    const SUBJECT_COLORS = [
        ['#FCE7F3', '#9D174D'], ['#DBEAFE', '#1D4ED8'], ['#DCFCE7', '#15803D'],
        ['#CFFAFE', '#0E7490'], ['#FEF3C7', '#B45309'], ['#E0E7FF', '#4338CA'],
        ['#FFEDD5', '#C2410C'], ['#F3E8FF', '#7E22CE'], ['#F1F5F9', '#475569'],
        ['#FFE4E6', '#BE123C'], ['#E0F2FE', '#0369A1'], ['#FEF9C3', '#A16207']
    ];

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof requireAuth === 'function') requireAuth();
        if (typeof renderSidebarUser === 'function') renderSidebarUser();
        const td = document.getElementById('todayDate');
        if (td) {
            const d = new Date();
            td.textContent = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
        loadSubjects();
    });

    // ══════════════════════════════════════════════
    // 과목 마스터 — 탭/필터의 단일 소스 (원장은 조회만)
    // ══════════════════════════════════════════════
    function isMasterName(name) {
        return subjectMaster.some(s => s.name === name);
    }

    function subjectNames() {
        return subjectMaster.slice().sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id).map(s => s.name);
    }

    async function loadSubjects() {
        try {
            const res = await apiGet('/subjects');
            subjectMaster = (res.data && res.data.items) ? res.data.items : [];
        } catch (e) {
            subjectMaster = [];
        }
        renderSubjectTabs();
        renderCategoryFilter();
        loadMaterials(1);
    }

    // ── 화면 상단 과목 탭 (한 줄 네비게이션) ──
    function renderSubjectTabs() {
        const wrap = document.getElementById('subjectTabs');
        if (!wrap) return;
        const subs = subjectMaster.filter(s => s.is_active !== false).sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id);
        let html = '<button type="button" class="subject-tab' + (activeSubject === '' ? ' active' : '') + '" onclick="selectSubjectTab(\'\')">전체</button>';
        subs.forEach(s => {
            html += '<button type="button" class="subject-tab' + (activeSubject === s.name ? ' active' : '') + '" data-sid="' + s.id + '" onclick="selectSubjectById(' + s.id + ')">' + escHtml(s.name) + '</button>';
        });
        wrap.innerHTML = html;
    }

    function selectSubjectById(id) {
        const s = subjectMaster.find(x => x.id === id);
        selectSubjectTab(s ? s.name : '');
    }

    function selectSubjectTab(name) {
        activeSubject = name || '';
        const sel = document.getElementById('categoryFilter');
        if (sel && subjectNames().indexOf(activeSubject) >= 0) sel.value = activeSubject;
        renderSubjectTabs();
        loadMaterials(1);
    }

    function onCategorySelectChange() {
        const sel = document.getElementById('categoryFilter');
        selectSubjectTab(sel ? sel.value : '');
    }

    const TYPE_META = {
        document: { icon: '📄', label: '문서', cls: 'document' },
        video: { icon: '🎬', label: '영상', cls: 'video' },
        image: { icon: '🖼️', label: '이미지', cls: 'image' },
        link: { icon: '🔗', label: '링크', cls: 'link' }
    };

    async function loadMaterials(page) {
        currentPage = page || 1;
        const search = encodeURIComponent(document.getElementById('searchInput').value.trim());
        const category = encodeURIComponent(document.getElementById('categoryFilter').value);
        const mtype = encodeURIComponent(document.getElementById('typeFilter').value);
        const tb = document.getElementById('materialTableBody');
        tb.innerHTML = '<tr><td colspan="7" class="empty-cell">자료를 불러오는 중...</td></tr>';
        try {
            const res = await apiGet('/director/edu-materials?search=' + search +
                '&category=' + category + '&material_type=' + mtype +
                '&page=' + currentPage + '&page_size=' + PER_PAGE);
            const data = res.data || {};
            allMaterials = data.items || [];
            const total = data.total || 0;
            totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
            document.getElementById('materialCount').textContent = total + '개';
            renderMaterials();
            renderPaginationUI();
            refreshCategoryOptions();
        } catch (e) {
            tb.innerHTML = '<tr><td colspan="7" class="empty-cell">⚠️ ' + escHtml(e.message || '로드 실패') + '</td></tr>';
        }
    }

    function renderMaterials() {
        const tb = document.getElementById('materialTableBody');
        if (!allMaterials.length) {
            tb.innerHTML = '<tr><td colspan="7" class="empty-cell">📭 아직 발행된 교육 자료가 없습니다.<br>본사에서 자료를 발행하면 이곳에 표시됩니다.</td></tr>';
            return;
        }
        tb.innerHTML = allMaterials.map(m => {
            const tm = TYPE_META[m.material_type] || TYPE_META.document;
            const fileTxt = m.file_url ? extName(m.file_url) + (m.file_size ? ' ' + fmtSize(m.file_size) : '') : '';
            return '<tr>' +
                '<td><div class="edu-title" onclick="openDetail(' + m.id + ')">' + escHtml(m.title) + '</div>' +
                (m.description ? '<div class="edu-desc">' + escHtml(m.description) + '</div>' : '') + '</td>' +
                '<td>' + subjectPillHtml(m.category) + '</td>' +
                '<td><span class="badge-type ' + tm.cls + '">' + tm.icon + ' ' + tm.label + '</span></td>' +
                '<td><span class="file-cell">' + (m.material_type === 'link' ? '🔗 외부 링크' : (m.file_url ? '📎 ' + fileTxt : '-')) + '</span></td>' +
                '<td>' + (m.view_count || 0) + '</td>' +
                '<td>' + fmtDate(m.created_at) + '</td>' +
                '<td><div style="display:flex;gap:4px;">' +
                '<button class="action-btn" onclick="openDetail(' + m.id + ')">👁 열기</button>' +
                (m.material_type !== 'link' && m.file_url ? '<button class="action-btn" onclick="downloadMaterial(' + m.id + ')">⬇ 저장</button>' : '') +
                '</div></td></tr>';
        }).join('');
    }

    // ── 상세/뷰어 ──
    function isViewableDoc(m) {
        if (m.material_type !== 'document' || !m.file_url) return false;
        return /\.(pdf|pptx?)$/i.test(m.file_url);
    }

    async function openDetail(id) {
        const m = allMaterials.find(x => x.id === id);
        if (!m) return;
        // link → 새 탭
        if (m.material_type === 'link') {
            window.open(m.file_url, '_blank');
            return;
        }
        _currentDetail = m;
        document.getElementById('detailTitle').textContent = TYPE_META[m.material_type].icon + ' ' + m.title;
        document.getElementById('detailMeta').innerHTML =
            (m.category ? subjectPillHtml(m.category) : '') +
            '<span>등록일 ' + fmtDate(m.created_at) + '</span>' +
            '<span>조회 ' + (m.view_count + 1) + '</span>';
        const btnDl = document.getElementById('btnDetailDownload');
        btnDl.style.display = (m.material_type !== 'link' && m.file_url) ? '' : 'none';
        document.getElementById('detailHint').textContent = m.file_url ? ('📎 ' + m.file_url.replace('/uploads/edu/', '')) : '';
        openModal('detailModal');
        const body = document.getElementById('detailContent');
        body.innerHTML = '<div class="viewer-placeholder">👁 자료를 여는 중...</div>';
        try {
            // 조회수 증가 겸 상세 조회
            const detail = await apiGet('/director/edu-materials/' + id);
            _currentDetail = detail.data || m;
        } catch (e) { /* 조회수 증가 실패는 무시 */ }
        await renderContentView(m);
    }

    async function renderContentView(m) {
        const body = document.getElementById('detailContent');
        let html = '';
        if (m.material_type === 'image' && m.file_url) {
            html = '<img src="' + escHtml(withToken(m.file_url)) + '" alt="' + escHtml(m.title) + '" onerror="this.parentElement.innerHTML=\'<div class=viewer-placeholder>⚠️ 이미지를 불러올 수 없습니다</div>\'">';
        } else if (m.material_type === 'video' && m.file_url) {
            html = '<video controls playsinline preload="metadata" src="' + escHtml(withToken(m.file_url)) + '"></video>';
        } else if (isViewableDoc(m)) {
            body.innerHTML = '<div class="viewer-placeholder">🔄 슬라이드 변환 준비 중...</div>';
            loadDocViewer(m);
            return;
        } else {
            html = '<div class="viewer-placeholder">📄 ' + (m.description ? '' : '이 자료는 미리보기를 지원하지 않습니다.') + '<br>⬇ 하단 [다운로드] 버튼으로 파일을 내려받아 확인해주세요.</div>';
        }
        html += (m.description ? '<div class="detail-desc">' + escHtml(m.description) + '</div>' : '');
        body.innerHTML = html;
    }

    // ── 문서 슬라이드 뷰어 (check → convert → polling) ──
    let slideState = null;
    let slidePollTimer = null;

    function loadDocViewer(m) {
        clearInterval(slidePollTimer);
        const fileUrl = m.file_url;
        const body = document.getElementById('detailContent');
        body.innerHTML =
            '<div class="slide-viewer" id="slideViewer">' +
            '<div class="slide-display"><div class="slide-loading" id="slideLoading"><span>🔄 변환 준비 중...</span></div>' +
            '<img id="slideImage" alt="슬라이드" style="display:none;">' +
            '<button class="slide-nav prev" id="slidePrev" onclick="navSlide(-1)" disabled>‹</button>' +
            '<button class="slide-nav next" id="slideNext" onclick="navSlide(1)" disabled>›</button></div>' +
            '<div class="slide-footer"><span class="slide-counter" id="slideCounter">0 / 0</span>' +
            '<span style="font-size:11px;opacity:.8;">' + escHtml(m.title) + '</span>' +
            '<button class="slide-fullscreen" onclick="toggleFullscreen()" style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff;padding:3px 10px;border-radius:6px;cursor:pointer;font-size:11px;">⛶ 전체화면</button></div>' +
            '</div>' +
            (m.description ? '<div class="detail-desc">' + escHtml(m.description) + '</div>' : '');
        slideState = { slides: [], current: 0 };
        apiGet('/viewer/check?file_path=' + encodeURIComponent(fileUrl))
            .then(function (data) {
                if (data.status === 'ready') { renderSlides(data); return; }
                if (data.status === 'processing') { setLoading('🔄 변환 중입니다... 잠시만 기다려주세요'); startPolling(fileUrl); return; }
                setLoading('🔄 변환을 시작합니다...');
                return apiPost('/viewer/convert?file_path=' + encodeURIComponent(fileUrl))
                    .then(function (d2) {
                        if (d2.status === 'ready') { renderSlides(d2); return; }
                        setLoading('🔄 변환 중입니다... (파일 크기에 따라 수 분 소요)');
                        startPolling(fileUrl);
                    });
            })
            .catch(function (e) {
                setLoading('⚠️ 변환 오류: ' + (e.message || '알 수 없음'));
            });
    }

    function setLoading(txt) {
        const l = document.getElementById('slideLoading');
        if (l) { l.style.display = 'flex'; l.querySelector('span').textContent = txt; }
    }

    function startPolling(fileUrl) {
        clearInterval(slidePollTimer);
        slidePollTimer = setInterval(function () {
            apiGet('/viewer/check?file_path=' + encodeURIComponent(fileUrl))
                .then(function (data) {
                    if (data.status === 'ready') {
                        clearInterval(slidePollTimer);
                        renderSlides(data);
                    }
                })
                .catch(function () {});
            }, 1000);  // 1초마다 폴링
    }

    function renderSlides(data) {
        const st = slideState;
        if (!st) return;
        st.slides = data.slides || [];
        st.current = 0;
        const loading = document.getElementById('slideLoading');
        const img = document.getElementById('slideImage');
        const counter = document.getElementById('slideCounter');
        const prev = document.getElementById('slidePrev');
        const next = document.getElementById('slideNext');
        if (!img || !st.slides.length) {
            if (loading) loading.innerHTML = '<span>⚠️ 변환된 슬라이드가 없습니다. 다운로드로 확인해주세요.</span>';
            return;
        }
        loading.style.display = 'none';
        img.style.display = 'block';
        img.src = withToken(st.slides[0]);
        counter.textContent = '1 / ' + st.slides.length;
        prev.disabled = true;
        next.disabled = st.slides.length <= 1;
    }

    function navSlide(dir) {
        const st = slideState;
        if (!st || !st.slides.length) return;
        const ni = st.current + dir;
        if (ni < 0 || ni >= st.slides.length) return;
        st.current = ni;
        const img = document.getElementById('slideImage');
        const counter = document.getElementById('slideCounter');
        const prev = document.getElementById('slidePrev');
        const next = document.getElementById('slideNext');
        if (img) img.src = withToken(st.slides[ni]);
        if (counter) counter.textContent = (ni + 1) + ' / ' + st.slides.length;
        if (prev) prev.disabled = ni === 0;
        if (next) next.disabled = ni === st.slides.length - 1;
    }

    function toggleFullscreen() {
        const v = document.getElementById('slideViewer');
        if (!v) return;
        if (v.classList.contains('fullscreen')) {
            v.classList.remove('fullscreen');
        } else {
            v.classList.add('fullscreen');
        }
    }

    function withToken(url) {
        if (!url) return url;
        const token = localStorage.getItem('token') || localStorage.getItem('access_token');
        if (!token) return url;
        return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'token=' + encodeURIComponent(token);
    }

    function closeDetail() {
        clearInterval(slidePollTimer);
        slideState = null;
        _currentDetail = null;
        closeModal('detailModal');
    }

    // ── 다운로드 ──
    function downloadCurrent() {
        if (_currentDetail) downloadMaterial(_currentDetail.id);
    }

    async function downloadMaterial(id) {
        const m = allMaterials.find(x => x.id === id) || _currentDetail;
        if (!m) return;
        try {
            const token = localStorage.getItem('token') || localStorage.getItem('access_token');
            const res = await fetch('/api/v1/director/edu-materials/' + id + '/download', {
                headers: token ? { 'Authorization': 'Bearer ' + token } : {}
            });
            if (!res.ok) {
                let msg = '다운로드 실패';
                try { const j = await res.json(); msg = j.message || j.detail || msg; } catch (e) {}
                throw new Error(msg);
            }
            const blob = await res.blob();
            const cd = res.headers.get('Content-Disposition') || '';
            let fname = 'download';
            const um = cd.match(/filename\*=UTF-8''([^;]+)/i);
            if (um) { try { fname = decodeURIComponent(um[1]); } catch (e) { fname = um[1]; } }
            else { const fm = cd.match(/filename="?([^";]+)"?/i); if (fm) fname = fm[1]; }
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = fname;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '다운로드 실패'), 'error');
        }
    }

    // ── 유틸 ──
    function fmtSize(bytes) {
        if (!bytes) return '';
        if (bytes < 1024) return bytes + 'B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + 'KB';
        return (bytes / 1024 / 1024).toFixed(1) + 'MB';
    }

    function extName(url) {
        if (!url) return '';
        const m = url.match(/\.([A-Za-z0-9]+)(\?.*)?$/);
        return m ? m[1].toUpperCase() : '';
    }

    function fmtDate(iso) {
        if (!iso) return '-';
        const d = new Date(iso);
        if (isNaN(d.getTime())) return '-';
        const p = n => String(n).padStart(2, '0');
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function escHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    let searchTimer = null;
    function debounceSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => loadMaterials(1), 350);
    }

    function refreshCategoryOptions() {
        // 현재 페이지에서 보이는 레거시(마스터 외) 값도 필터에 보존
        (allMaterials || []).forEach(m => {
            const c = (m.category || '').trim();
            if (c && !isMasterName(c) && _legacyCategoryValues.indexOf(c) < 0) _legacyCategoryValues.push(c);
        });
        renderCategoryFilter();
    }

    // ── 교육명(과목) 옵션/칩 헬퍼 ──
    function subjectPillHtml(c) {
        if (!c) return '<span style="color:#d1d5db;">-</span>';
        const i = subjectMaster.findIndex(s => s.name === c);
        if (i >= 0) {
            const colors = SUBJECT_COLORS[i % SUBJECT_COLORS.length];
            return '<span class="subject-pill" style="background:' + colors[0] + ';color:' + colors[1] + ';">' + escHtml(c) + '</span>';
        }
        return '<span class="subject-pill" style="background:#F1F5F9;color:#6B7280;font-weight:500;">' + escHtml(c) + '</span>';
    }

    function renderCategoryFilter() {
        const sel = document.getElementById('categoryFilter');
        if (!sel) return;
        const cur = sel.value;
        const masters = subjectNames();
        let html = '<option value="">전체 교육명</option>';
        if (masters.length) {
            html += '<optgroup label="과목">' + masters.map(c => '<option value="' + escHtml(c) + '">' + escHtml(c) + '</option>').join('') + '</optgroup>';
        }
        if (_legacyCategoryValues.length) {
            html += '<optgroup label="기존 등록분">' + _legacyCategoryValues.map(c => '<option value="' + escHtml(c) + '">' + escHtml(c) + '</option>').join('') + '</optgroup>';
        }
        sel.innerHTML = html;
        if (cur) {
            const ok = Array.prototype.some.call(sel.options, o => o.value === cur);
            if (ok) sel.value = cur;
        }
    }

    // 전체 발행 자료(모든 페이지)를 훑어 레거시 교육명(과목) 값 수집 → 필터 옵션 유지
    async function collectAllCategories() {
        try {
            const seen = [];
            let page = 1, total = 1;
            while (seen.length < total && page <= 20) {
                const res = await apiGet('/director/edu-materials?search=&category=&material_type=&page=' + page + '&page_size=200');
                const d = res.data || {};
                total = d.total || 0;
                (d.items || []).forEach(m => {
                    const c = (m.category || '').trim();
                    if (c && !isMasterName(c) && seen.indexOf(c) < 0) seen.push(c);
                });
                if (!(d.items || []).length) break;
                page += 1;
            }
            _legacyCategoryValues = seen.sort();
            renderCategoryFilter();
        } catch (e) { /* 필터 옵션은 현재 페이지 기준으로도 유지됨 */ }
    }

    async function syncCategoryOptions() {
        await collectAllCategories();
        renderCategoryFilter();
    }

    function renderPaginationUI() {
        const wrap = document.getElementById('paginationWrap');
        let html = '';
        html += (currentPage > 1) ? '<button onclick="loadMaterials(1)">«</button><button onclick="loadMaterials(' + (currentPage - 1) + ')">‹</button>' : '<button disabled>«</button><button disabled>‹</button>';
        const start = Math.max(1, currentPage - 2);
        const end = Math.min(totalPages, currentPage + 2);
        for (let i = start; i <= end; i++) {
            html += '<button class="' + (i === currentPage ? 'active' : '') + '" onclick="loadMaterials(' + i + ')">' + i + '</button>';
        }
        html += (currentPage < totalPages) ? '<button onclick="loadMaterials(' + (currentPage + 1) + ')">›</button><button onclick="loadMaterials(' + totalPages + ')">»</button>' : '<button disabled>›</button><button disabled>»</button>';
        wrap.innerHTML = html;
    }
</script>
</body>
</html>

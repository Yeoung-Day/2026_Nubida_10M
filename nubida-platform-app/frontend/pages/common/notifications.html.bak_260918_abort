    <script src="/common/js/api.js?v=20260910login"></script>
    <script>function esc(s){if(typeof s!=="string")s=String(s||"");return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");}</script>
    <script src="/common/js/auth.js?v=20260908a"></script>
    <script src="/common/js/utils.js?v=20260804b"></script>
    <script>
    let currentPage = 1, totalPages = 1;
    const PER_PAGE = 30;
    const typeIcons = {
        'test': '🔔', 'general': '📢', 'broadcast': '📢',
        'portfolio_submitted': '🎨', 'approval': '✅',
        'payment': '💰', 'system': '⚙️',
    };
    const typeClasses = {
        'test': 'info', 'general': 'info', 'broadcast': 'broadcast',
        'portfolio_submitted': 'success', 'approval': 'warning',
        'payment': 'info', 'system': 'warning',
    };
    document.addEventListener('DOMContentLoaded', function() {
        requireAuth();
        renderSidebarUser();
        // 역할에 맞는 CSS/사이드바 로드
        const user = getCurrentUser();
        const role = user?.role || '';
        const cssMap = {
            'super_admin': 'headquarters', 'admin': 'headquarters',
            'branch_admin': 'branch', 'branch_manager': 'branch',
            'director': 'headquarters',
            'student': 'student', 'parent': 'parent',
        };
        const cssRole = cssMap[role] || 'headquarters';
        document.getElementById('roleCss').href = '/common/css/pages/' + cssRole + '/style.css?v=20260804c';
        loadNotifications(1);
        setupSSE();
    });
    // ===== SSE 실시간 알림 =====
    function setupSSE() {
        const token = localStorage.getItem('token') || localStorage.getItem('access_token');
        if (!token) return;
        const evtSource = new EventSource('/api/v1/sse/stream?token=' + encodeURIComponent(token));
        evtSource.addEventListener('message', function(e) {
            try {
                const data = JSON.parse(e.data);
                if (data.type === 'notification') {
                    // 새 알림 도착 → 목록 갱신
                    loadNotifications(1);
                }
            } catch(e) {}
        });
        evtSource.addEventListener('error', function() {
            // 자동 재연결
        });
    }
    // ===== 알림 목록 조회 =====
    async function loadNotifications(page) {
        currentPage = page || 1;
        const container = document.getElementById('notifList');
        try {
            const res = await apiGet('/sse/notifications?limit=' + (PER_PAGE * currentPage));
            const data = res.data || {};
            const notifications = data.notifications || [];
            totalPages = Math.max(1, Math.ceil((data.total || notifications.length) / PER_PAGE));
            renderNotifications(notifications, page);
        } catch (e) {
            container.innerHTML = '<div class="notif-empty"><div class="icon">⚠️</div><h3>알림을 불러올 수 없습니다</h3></div>';
        }
    }
    function renderNotifications(notifications, page) {
        const container = document.getElementById('notifList');
        const start = (page - 1) * PER_PAGE;
        const pageItems = notifications.slice(start, start + PER_PAGE);
        if (!pageItems || pageItems.length === 0) {
            container.innerHTML = '<div class="notif-empty"><div class="icon">🔔</div><h3>알림이 없습니다</h3></div>';
            renderPagination();
            return;
        }
        let html = '';
        pageItems.forEach(function(n) {
            const icon = typeIcons[n.type] || '📢';
            const cls = typeClasses[n.type] || 'info';
            const unreadClass = n.is_read === false ? ' unread' : ' read';
            const time = n.created_at ? n.created_at.replace('T', ' ').substring(0, 16) : '';
            html += '<div class="notif-item' + unreadClass + '" onclick="markRead(' + n.id + ', this)">';
            html += '<div class="notif-icon ' + cls + '">' + icon + '</div>';
            html += '<div class="notif-body">';
            html += '<div class="notif-title">' + esc(n.title || '알림') + '</div>';
            if (n.content) html += '<div class="notif-body-text">' + esc(n.content) + '</div>';
            html += '<div class="notif-time">' + time + '</div>';
            html += '</div>';
            if (n.is_read === false) {
                html += '<button class="notif-read-btn" onclick="event.stopPropagation();markRead(' + n.id + ', this.closest(\'.notif-item\'))">✓ 읽음</button>';
            }
            html += '</div>';
        });
        container.innerHTML = html;
        renderPagination();
    }
    function renderPagination() {
        const wrap = document.getElementById('notifPagination');
        if (totalPages <= 1) { wrap.innerHTML = ''; return; }
        let html = '';
        if (currentPage > 1) html += '<button onclick="loadNotifications(' + (currentPage - 1) + ')">‹</button>';
        for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
            html += '<button class="' + (i === currentPage ? 'active' : '') + '" onclick="loadNotifications(' + i + ')">' + i + '</button>';
        }
        if (currentPage < totalPages) html += '<button onclick="loadNotifications(' + (currentPage + 1) + ')">›</button>';
        wrap.innerHTML = html;
    }
    // ===== 읽음 처리 =====
    async function markRead(notifId, el) {
        try {
            await apiPost('/sse/notifications/' + notifId + '/read');
            if (el) {
                el.classList.remove('unread');
                el.classList.add('read');
                const btn = el.querySelector('.notif-read-btn');
                if (btn) btn.remove();
            }
        } catch (e) {
            console.log('Mark read error:', e);
        }
    }
    async function markAllRead() {
        try {
            await apiPost('/sse/notifications/read-all');
            document.querySelectorAll('.notif-item.unread').forEach(function(el) {
                el.classList.remove('unread');
                el.classList.add('read');
                const btn = el.querySelector('.notif-read-btn');
                if (btn) btn.remove();
            });
            showAlert('✅ 모든 알림을 읽음 처리했습니다.', 'success');
        } catch (e) {
            showAlert('처리 중 오류가 발생했습니다.', 'error');
        }
    }
    </script>
    

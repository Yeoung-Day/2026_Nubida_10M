    <style>
        /* Progress page specific styles */
        .progress-bar-track {
            width: 100%;
            height: 10px;
            background: var(--bg-subtle);
            border-radius: var(--radius-full);
            overflow: hidden;
            position: relative;
        }
        .progress-bar-fill {
            height: 100%;
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
            background: linear-gradient(90deg, var(--md-primary), #6c7bff);
        }
        .progress-bar-fill.high { background: linear-gradient(90deg, var(--md-success), #4ade80); }
        .progress-bar-fill.medium { background: linear-gradient(90deg, var(--md-warning), #fbbf24); }
        .progress-bar-fill.low { background: linear-gradient(90deg, var(--md-danger), #f87171); }
        .progress-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: var(--text-sm);
            margin-bottom: var(--space-1);
        }
        .progress-label .course-name {
            font-weight: var(--weight-medium);
            color: var(--text-primary);
        }
        .progress-label .course-pct {
            font-weight: var(--weight-semibold);
            color: var(--text-secondary);
        }
        .child-progress-card {
            margin-bottom: var(--space-6);
        }
        .child-progress-card:last-child {
            margin-bottom: 0;
        }
        .child-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding-bottom: var(--space-4);
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: var(--space-5);
        }
        .child-avatar {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-full);
            background: linear-gradient(135deg, var(--md-primary), #6c7bff);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.25rem;
            font-weight: 700;
            flex-shrink: 0;
        }
        .child-info h2 {
            margin: 0;
            font-size: var(--text-lg);
            font-weight: var(--weight-semibold);
        }
        .child-info .child-meta {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
            margin-top: 2px;
        }
        .course-item {
            padding: var(--space-4) 0;
            border-bottom: 1px solid var(--border-subtle);
        }
        .course-item:last-child {
            border-bottom: none;
        }
        .portfolio-mini-list {
            margin-top: var(--space-4);
            padding-top: var(--space-4);
            border-top: 1px dashed var(--border-subtle);
        }
        .portfolio-mini-list .mini-title {
            font-size: var(--text-xs);
            font-weight: var(--weight-medium);
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: var(--space-3);
        }
        .portfolio-mini-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-2) 0;
            font-size: var(--text-sm);
        }
        .portfolio-mini-item .portfolio-title {
            font-weight: var(--weight-medium);
            color: var(--text-primary);
        }
        .portfolio-mini-item .portfolio-meta {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            color: var(--text-tertiary);
            font-size: var(--text-xs);
        }
        .empty-progress {
            text-align: center;
            padding: var(--space-9);
            color: var(--text-tertiary);
        }
        .empty-progress .empty-icon {
            font-size: 3rem;
            margin-bottom: var(--space-4);
        }
        .stats-row {
            display: flex;
            gap: var(--space-6);
            flex-wrap: wrap;
            margin-bottom: var(--space-5);
            padding: var(--space-4) var(--space-5);
            background: var(--bg-surface);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-subtle);
        }
        .stats-row .stat-item {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            font-size: var(--text-sm);
        }
        .stats-row .stat-item .stat-label {
            color: var(--text-tertiary);
        }
        .stats-row .stat-item .stat-value {
            font-weight: var(--weight-semibold);
            color: var(--text-primary);
        }
    </style>

<script>
// 모달 닫기 통일: .active 클래스 제거 + 인라인 none (둘 다 처리)
function closeModal(id) {
    const el = document.getElementById(id);
    if (el) {
        el.classList.remove('active');
        el.style.display = 'none';
    }
}
let currentUser = null;
let chatRooms = [];
let currentRoomId = null;
let currentWs = null;
let msgOffset = 0;
let isLoadingMessages = false;
let hasMoreMessages = true;
let selectedUsers = new Set();
let availableUsers = [];
let typingTimeout = null;
let isTyping = false;
document.addEventListener('DOMContentLoaded', async () => {
    try {
        requireAuth();
        renderSidebarUser();
        const now = new Date();
        document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', { year:'numeric', month:'long', day:'numeric', weekday:'long' });
        // Get current user info from localStorage
        const stored = localStorage.getItem('user');
        if (stored) {
            currentUser = JSON.parse(stored);
        }
        await loadRooms();
        setupInfiniteScroll();
    } catch (e) {
        console.error('Init error:', e);
    }
});
async function loadRooms() {
    try {
        const res = await apiGet('/chat/rooms');
        chatRooms = res?.data || [];
        renderRoomList();
    } catch (e) {
        console.error('Load rooms error:', e);
    }
}
function renderRoomList() {
    const container = document.getElementById('roomList');
    const searchVal = (document.getElementById('roomSearch').value || '').toLowerCase();
    let filtered = chatRooms;
    if (searchVal) {
        filtered = chatRooms.filter(r => r.name.toLowerCase().includes(searchVal));
    }
    if (!filtered.length) {
        container.innerHTML = '<div class="chat-empty" style="padding:40px 0"><p>채팅방이 없습니다.</p></div>';
        return;
    }
    container.innerHTML = filtered.map(r => {
        const isActive = r.id === currentRoomId;
        const time = r.last_message?.created_at ? formatChatTime(r.last_message.created_at) : '';
        const preview = r.last_message?.content || '';
        const badge = r.unread_count > 0 ? `<div class="cri-badge">${r.unread_count > 99 ? '99+' : r.unread_count}</div>` : '';
        return `<div class="chat-room-item ${isActive ? 'active' : ''}" onclick="selectRoom(${r.id})">
            <div class="cri-header">
                <div class="cri-name">${esc(r.name)}</div>
                <div class="cri-time">${time}</div>
            </div>
            <div class="cri-preview">${esc(preview)}</div>
            ${badge}
        </div>`;
    }).join('');
}
function selectRoom(roomId) {
    if (currentRoomId === roomId) return;
    
    // Disconnect old WS
    if (currentWs) {
        currentWs.close();
        currentWs = null;
    }
    
    currentRoomId = roomId;
    msgOffset = 0;
    hasMoreMessages = true;
    
    // Update UI
    renderRoomList();
    
    // Find room
    const room = chatRooms.find(r => r.id === roomId);
    document.getElementById('currentRoomName').textContent = room ? room.name : '채팅방';
    document.getElementById('currentRoomMeta').textContent = room ? `${room.room_type === 'direct' ? '1:1' : room.room_type === 'group' ? '그룹' : '공지'} · ${room.participant_count}명` : '';
    const participantsBtn = document.getElementById('participantsBtn');
    if (participantsBtn) participantsBtn.style.display = 'inline-flex';
    document.getElementById('participantCount').textContent = room?.participant_count || 0;
    
    // Show action buttons (모든 채팅방에서 표시)
    const db = document.getElementById('deleteBtn');
    const rb = document.getElementById('renameBtn');
    const pb = document.getElementById('participantsBtn');
    if (room) {
        if (db) db.style.display = 'inline-flex';
        if (rb) rb.style.display = 'inline-flex';
        if (pb) pb.style.display = 'inline-flex';
    } else {
        if (db) db.style.display = 'none';
        if (rb) rb.style.display = 'none';
        if (pb) pb.style.display = 'none';
    }
    
    // Clear messages
    document.getElementById('messageContainer').innerHTML = '';
    const emptyChat = document.getElementById('emptyChat');
    if (emptyChat) {
        emptyChat.style.display = 'block';
        const p = emptyChat.querySelector('p');
        if (p) p.textContent = '메시지를 불러오는 중...';
    }
    
    // Show chat main (mobile)
    document.getElementById('chatMain').classList.remove('hidden');
    document.getElementById('chatSidebar').classList.add('hidden');
    
    // Load messages
    loadMessages();
    
    // Connect WebSocket
    connectWebSocket(roomId);
}
function showRoomList() {
    document.getElementById('chatMain').classList.add('hidden');
    document.getElementById('chatSidebar').classList.remove('hidden');
}
async function loadMessages() {
    if (!currentRoomId || isLoadingMessages || !hasMoreMessages) return;
    isLoadingMessages = true;
    
    try {
        let url = `/chat/rooms/${currentRoomId}/messages?limit=50`;
        if (msgOffset > 0) url += `&before=${msgOffset}`;
        
        const res = await apiGet(url);
        const messages = res?.data || [];
        
        if (messages.length < 50) hasMoreMessages = false;
        const isInitialLoad = msgOffset === 0;
        if (messages.length > 0) {
            msgOffset = messages[0].id;
        }
        
        const container = document.getElementById('messageContainer');
        let emptyEl = document.getElementById('emptyChat');
        
        // emptyChat이 없으면 새로 생성 (selectRoom에서 innerHTML=''로 삭제된 경우)
        if (!emptyEl) {
            emptyEl = document.createElement('div');
            emptyEl.className = 'chat-empty';
            emptyEl.id = 'emptyChat';
            emptyEl.style.display = 'none';
            const iconDiv = document.createElement('div');
            iconDiv.className = 'icon';
            iconDiv.textContent = '💬';
            const p = document.createElement('p');
            p.textContent = '대화를 시작해보세요';
            emptyEl.appendChild(iconDiv);
            emptyEl.appendChild(p);
            container.prepend(emptyEl);
        }
        
        if (messages.length === 0 && msgOffset === 0) {
            emptyEl.style.display = 'flex';
            emptyEl.querySelector('p').textContent = '대화를 시작해보세요';
            return;
        }
        
        emptyEl.style.display = 'none';
        
        // Prepend messages (입장/퇴장 제외)
        const filteredMessages = messages.filter(m => !(m.message_type === 'system' && (m.content.includes('입장') || m.content.includes('퇴장'))));
        if (filteredMessages.length === 0) return;
        const fragment = document.createDocumentFragment();
        // We use temporary div to generate HTML and insert at top
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = filteredMessages.map(m => renderMessage(m, false)).join('');
        
        if (!isInitialLoad && filteredMessages.length > 0) {
            // Insert before first child
            while (tempDiv.firstChild) {
                container.insertBefore(tempDiv.firstChild, container.firstChild);
            }
        } else {
            container.innerHTML = filteredMessages.map(m => renderMessage(m, false)).join('');
            // Re-create emptyChat if it was destroyed by innerHTML
            if (!document.getElementById('emptyChat')) {
                const emptyEl = document.createElement('div');
                emptyEl.className = 'chat-empty';
                emptyEl.id = 'emptyChat';
                emptyEl.style.display = 'none';
                const iconDiv = document.createElement('div');
                iconDiv.className = 'icon';
                iconDiv.textContent = '💬';
                const p = document.createElement('p');
                p.textContent = '대화를 시작해보세요';
                emptyEl.appendChild(iconDiv);
                emptyEl.appendChild(p);
                container.appendChild(emptyEl);
            }
        }
        
        // Scroll to bottom on initial load
        if (isInitialLoad) {
            scrollToBottom();
        }
        
        // Auto mark as read
        if (messages.length > 0) {
            const maxId = Math.max(...messages.map(m => m.id));
            markRead(maxId);
        }
    } catch (e) {
        console.error('Load messages error:', e);
    } finally {
        isLoadingMessages = false;
    }
}
function renderMessage(m, withTime) {
    const isMine = m.sender_id === currentUser?.id;
    const isAdmin = currentUser?.role === 'super_admin' || currentUser?.role === 'admin';
    const isSystem = m.message_type === 'system';
    const isFile = m.message_type === 'file';
    const time = m.created_at ? formatChatTime(m.created_at) : '';
    
    if (isSystem) {
        return `<div class="chat-msg-wrap system"><div class="chat-msg-bubble">${esc(m.content)}</div></div>`;
    }
    
    const readMark = isMine ? '<span class="chat-msg-read">✓</span>' : '';
    let contentHtml = '';
    
    if (isFile) {
        const fileIcon = getFileIcon(m.file_name || '');
        const fileSize = m.file_size ? formatFileSize(m.file_size) : '';
        contentHtml = `<div class="chat-msg-file">
            <span class="file-icon">${fileIcon}</span>
            <div class="file-info">
                <div class="file-name">${esc(m.file_name || m.content || '파일')}</div>
                ${fileSize ? '<div class="file-size">' + fileSize + '</div>' : ''}
            </div>
            ${m.file_url ? '<a class="file-dl" href="' + m.file_url + '" target="_blank" rel="noopener">⬇ 다운로드</a>' : ''}
        </div>`;
    } else {
        contentHtml = esc(m.content);
    }
    
    const actions = (isMine || isAdmin) && !isFile
        ? `<span class="msg-actions">
            <span class="msg-action" onclick="event.stopPropagation();editMsg(${m.id},${m.sender_id})" title="수정">✏️</span>
            <span class="msg-action" onclick="event.stopPropagation();deleteMsg(${m.id},${m.sender_id})" title="삭제">🗑️</span>
          </span>`
        : '';
    
    return `<div class="chat-msg-wrap ${isMine ? 'mine' : ''}" data-msg-id="${m.id}">
        ${!isMine ? `<div class="chat-msg-sender">${esc(m.sender_name)}</div>` : ''}
        <div class="chat-msg-bubble">
            ${contentHtml}${actions}
            <div class="chat-msg-time">${time}${readMark}</div>
        </div>
    </div>`;
}
function getFileIcon(filename) {
    const ext = (filename || '').split('.').pop().toLowerCase();
    const icons = {
        'pdf': '📄', 'hwp': '📝', 'doc': '📝', 'docx': '📝',
        'xls': '📊', 'xlsx': '📊', 'csv': '📊',
        'ppt': '📽️', 'pptx': '📽️',

                </div>
                <button type="button" class="eb-x" onclick="ebCloseInstructor()" aria-label="닫기">✕</button>
            </div>
            <div class="eb-modal-body">
                <div id="ebInstFormWrap">
                    <div class="eb-err" id="ebInstErr"></div>

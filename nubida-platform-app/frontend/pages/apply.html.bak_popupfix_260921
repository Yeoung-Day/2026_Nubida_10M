                        </div>
                        <div class="eb-row eb-row-2">
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebIRegion">지역<span class="opt">선택</span></label>
                                <input class="eb-input" type="text" id="ebIRegion" maxlength="80" placeholder="예: 서울 강남">
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebIOrg">소속<span class="opt">선택</span></label>
                                <input class="eb-input" type="text" id="ebIOrg" maxlength="120" placeholder="예: 누비다테스트학원">

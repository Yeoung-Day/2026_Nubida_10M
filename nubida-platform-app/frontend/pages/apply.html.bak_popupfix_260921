    <!-- ===== 신청 모달 ===== -->
    <div class="eb-modal" id="ebApplyModal">
        <div class="eb-modal-box">
            <div class="eb-modal-head">
                <div>
                    <h3 id="ebApplyTitle">교육 신청</h3>
                    <p>아래 항목을 작성하시면 담당자가 확인 후 순차적으로 연락드립니다.</p>
                </div>
                <button type="button" class="eb-x" onclick="ebCloseApply()" aria-label="닫기">✕</button>
            </div>
            <div class="eb-modal-body">
                <div id="ebApplyFormWrap">
                    <div class="eb-err" id="ebApplyErr"></div>
                    <form id="ebApplyForm" novalidate>
                        <input type="hidden" id="ebProgramId">
                        <div class="eb-row eb-row-2">
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebAName">이름<span class="req">*</span></label>
                                <input class="eb-input" type="text" id="ebAName" maxlength="50" placeholder="홍길동" required>
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebAPhone">연락처<span class="req">*</span></label>
                                <input class="eb-input" type="tel" id="ebAPhone" maxlength="20" placeholder="010-1234-5678" required>
                            </div>
                        </div>
                        <div class="eb-row eb-row-2">
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebAEmail">이메일<span class="opt">선택</span></label>
                                <input class="eb-input" type="email" id="ebAEmail" maxlength="120" placeholder="name@example.com">
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebARegion">지역<span class="opt">선택</span></label>
                                <input class="eb-input" type="text" id="ebARegion" maxlength="80" placeholder="예: 서울 강남">
                            </div>
                        </div>
                        <div class="eb-row">
                            <label class="eb-label" for="ebAOrg">소속<span class="opt">선택</span></label>
                            <input class="eb-input" type="text" id="ebAOrg" maxlength="120" placeholder="예: 누비다테스트학원 / 소속 없음">
                        </div>
                        <div class="eb-row">
                            <label class="eb-label" for="ebAMemo">비고<span class="opt">선택</span></label>
                            <textarea class="eb-textarea" id="ebAMemo" maxlength="4000" placeholder="교육 희망 일정, 궁금한 점 등을 자유롭게 적어 주세요."></textarea>
                        </div>
                        <button class="eb-submit" type="submit" id="ebApplyBtn">신청하기</button>
                    </form>
                </div>
                <div class="eb-ok" id="ebApplyOk" style="display:none;">
                    <div class="ok-ico">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <h3>신청이 접수되었습니다</h3>
                    <p id="ebApplyOkMsg">확인 후 순차적으로 연락드리겠습니다.<br>감사합니다.</p>
                    <button class="eb-again" type="button" onclick="ebCloseApply()">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== 소속 강사 신청 모달 ===== -->
    <div class="eb-modal" id="ebInstModal">
        <div class="eb-modal-box">
            <div class="eb-modal-head">
                <div>
                    <h3>🎓 소속 강사 신청</h3>

                                <label class="eb-label" for="ebIName">이름<span class="req">*</span></label>
                                <input class="eb-input" type="text" id="ebIName" maxlength="50" placeholder="홍길동" required>
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebIPhone">연락처<span class="req">*</span></label>
                                <input class="eb-input" type="tel" id="ebIPhone" maxlength="20" placeholder="010-1234-5678" required>
                            </div>
                        </div>
                        <div class="eb-row eb-row-2">
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebIEmail">이메일<span class="opt">선택</span></label>
                                <input class="eb-input" type="email" id="ebIEmail" maxlength="120" placeholder="name@example.com">
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebIBirth">생년월일<span class="opt">선택</span></label>

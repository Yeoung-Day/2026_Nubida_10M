    <style>
    /* ===== 교육 신청 게시판 ===== */
    .eb-wrap { max-width: 800px; margin: 0 auto; padding: 0 20px 80px; }
    .eb-panel {
        background:#fff; border:1px solid #E9EDF3; border-radius:18px;
        padding:8px 0; margin-top:-40px; position:relative; z-index:3;
        box-shadow:0 18px 44px rgba(15,23,42,.07); overflow:hidden;
    }
    /* 지역 필터 */
    .eb-filter {
        display:flex; align-items:center; gap:8px; flex-wrap:wrap;
        padding:18px 22px 16px; border-bottom:1px solid #F1F5F9;
    }
    .eb-filter-label { font-size:12.5px; font-weight:700; color:#64748B; letter-spacing:-.01em; margin-right:2px; }
    .eb-chip {
        font-family:inherit; font-size:12.5px; font-weight:600; color:#475569;
        background:#F8FAFC; border:1px solid #E4E9F0; border-radius:20px;
        padding:6px 13px; cursor:pointer; transition:all .16s;
    }
    .eb-chip:hover { background:#F1F5F9; border-color:#CBD5E1; }
    .eb-chip.on { color:#fff; background:#18181B; border-color:#18181B; }
    .eb-chip .cnt { opacity:.6; margin-left:4px; font-size:11.5px; }

    /* 공고 항목 */
    .eb-item { border-bottom:1px solid #F1F5F9; }
    .eb-item:last-child { border-bottom:0; }
    .eb-head {
        display:flex; align-items:flex-start; gap:14px;
        padding:20px 22px; cursor:pointer; transition:background .16s;
    }
    .eb-head:hover { background:#FCFDFF; }
    .eb-main { flex:1 1 auto; min-width:0; }
    .eb-top { display:flex; align-items:center; gap:7px; flex-wrap:wrap; margin-bottom:7px; }
    .eb-cat {
        font-size:11.5px; font-weight:700; color:#4F46E5; background:#EEF2FF;
        padding:3px 9px; border-radius:6px; letter-spacing:-.01em;
    }
    .eb-pin { font-size:11.5px; font-weight:700; color:#B45309; background:#FEF3C7; padding:3px 8px; border-radius:6px; }
    .eb-badge { font-size:11.5px; font-weight:700; padding:3px 9px; border-radius:6px; }
    .eb-badge.open { color:#047857; background:#ECFDF5; }
    .eb-badge.closed { color:#64748B; background:#F1F5F9; }
    .eb-badge.full { color:#B91C1C; background:#FEF2F2; }
    .eb-title {
        font-size:16.5px; font-weight:700; color:#0F172A; letter-spacing:-.02em;
        margin:0 0 6px; line-height:1.45;
    }
    .eb-sum { font-size:13.5px; color:#5A6472; line-height:1.6; margin:0 0 9px; }
    .eb-meta { display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:12.5px; color:#8A95A5; }
    .eb-meta b { color:#475569; font-weight:600; }
    .eb-chev {
        flex:0 0 auto; width:22px; height:22px; margin-top:4px;
        color:#B0BAC7; transition:transform .2s;
    }
    .eb-item.open .eb-chev { transform:rotate(180deg); }

    /* 펼침 본문 */
    .eb-body { display:none; padding:0 22px 24px; }
    .eb-item.open .eb-body { display:block; }
    .eb-content {
        font-size:14.5px; color:#3F4A5A; line-height:1.85; white-space:pre-wrap;
        background:#FAFBFD; border:1px solid #F1F5F9; border-radius:13px;
        padding:20px 22px; margin-bottom:18px;
    }
    .eb-info { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:18px; }
    .eb-info div {
        font-size:13px; color:#5A6472; background:#F8FAFC; border:1px solid #F1F5F9;
        border-radius:10px; padding:11px 14px; line-height:1.5;
    }
    .eb-info div span { display:block; font-size:11.5px; font-weight:700; color:#94A3B8; margin-bottom:3px; }
    .eb-apply {
        width:100%; font-family:inherit; font-size:15px; font-weight:700; letter-spacing:-.01em;
        color:#fff; background:#4F46E5; border:0; border-radius:12px;
        padding:15px; cursor:pointer; transition:background .16s, transform .1s;
    }
    .eb-apply:hover { background:#4338CA; }
    .eb-apply:active { transform:scale(.988); }
    .eb-apply:disabled { background:#CBD5E1; cursor:default; transform:none; }

    .eb-empty { text-align:center; padding:64px 24px; }
    .eb-empty .ico { font-size:34px; margin-bottom:14px; opacity:.4; }
    .eb-empty p { font-size:14.5px; color:#8A95A5; line-height:1.7; margin:0; }

    /* 강사 신청 배너 */
    .eb-inst {
        margin-top:24px; padding:20px 22px; border-radius:15px;
        background:linear-gradient(135deg,#F8FAFF 0%,#F1F4FE 100%);
        border:1.5px solid #E0E7FF; display:flex; align-items:center;
        gap:18px; justify-content:space-between; flex-wrap:wrap;
    }
    .eb-inst-txt { flex:1 1 240px; }
    .eb-inst-txt strong { display:block; font-size:15px; font-weight:800; color:#0F172A; margin-bottom:5px; letter-spacing:-.015em; }
    .eb-inst-txt span { font-size:13px; color:#5A6472; line-height:1.6; }
    .eb-inst-btn {
        flex:0 0 auto; font-family:inherit; font-size:14px; font-weight:700;
        color:#fff; background:#18181B; border:0; border-radius:11px;
        padding:13px 24px; cursor:pointer; transition:background .16s, transform .1s; letter-spacing:-.01em;
    }
    .eb-inst-btn:hover { background:#27272A; }
    .eb-inst-btn:active { transform:scale(.98); }

    /* ===== 모달 공통 ===== */
    .eb-modal {
        display:none; position:fixed; inset:0; z-index:999;
        background:rgba(15,23,42,.52); padding:24px 16px;
        overflow-y:auto; -webkit-overflow-scrolling:touch;
    }
    .eb-modal.show { display:block; }
    .eb-modal-box {
        max-width:600px; margin:0 auto; background:#fff; border-radius:18px;
        box-shadow:0 24px 64px rgba(15,23,42,.24); overflow:hidden;
        animation:ebUp .22s ease-out;
    }
    @keyframes ebUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }
    .eb-modal-head {
        display:flex; align-items:flex-start; justify-content:space-between; gap:14px;
        padding:24px 26px 18px; border-bottom:1px solid #F1F5F9;
    }
    .eb-modal-head h3 { font-size:18px; font-weight:800; color:#0F172A; margin:0 0 5px; letter-spacing:-.02em; }
    .eb-modal-head p { font-size:13px; color:#8A95A5; margin:0; line-height:1.55; }
    .eb-x {
        flex:0 0 auto; width:32px; height:32px; border:0; background:#F1F5F9;
        border-radius:9px; cursor:pointer; color:#64748B; font-size:17px; line-height:1;
        transition:background .16s;
    }
    .eb-x:hover { background:#E4E9F0; }
    .eb-modal-body { padding:24px 26px 28px; max-height:calc(100vh - 220px); overflow-y:auto; }

    /* 폼 요소 */
    .eb-row { margin-bottom:18px; }
    .eb-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .eb-label { display:block; font-size:13.5px; font-weight:700; color:#0F172A; margin-bottom:7px; letter-spacing:-.01em; }
    .eb-label .req { color:#E11D48; margin-left:2px; }
    .eb-label .opt { color:#94A3B8; font-weight:500; font-size:12px; margin-left:5px; background:#F1F5F9; padding:1px 7px; border-radius:5px; }
    .eb-input, .eb-textarea, .eb-select {
        width:100%; box-sizing:border-box; font-family:inherit; font-size:14.5px;
        color:#0F172A; background:#FBFCFE; border:1.5px solid #E4E9F0;
        border-radius:11px; padding:12px 14px; transition:border-color .16s, background .16s, box-shadow .16s;
    }
    .eb-input::placeholder, .eb-textarea::placeholder { color:#A8B4C4; }
    .eb-input:focus, .eb-textarea:focus, .eb-select:focus {
        outline:none; border-color:#4F46E5; background:#fff; box-shadow:0 0 0 3.5px rgba(79,70,229,.11);
    }
    .eb-textarea { resize:vertical; min-height:92px; line-height:1.65; }
    .eb-hint { font-size:12.5px; color:#8A95A5; margin-top:6px; line-height:1.55; }
    .eb-file {
        width:100%; box-sizing:border-box; font-family:inherit; font-size:13.5px; color:#5A6472;
        background:#FBFCFE; border:1.5px dashed #D6DEE9; border-radius:11px; padding:14px;
    }
    .eb-submit {
        width:100%; font-family:inherit; font-size:15.5px; font-weight:700; letter-spacing:-.01em;
        color:#fff; background:#18181B; border:0; border-radius:12px;
        padding:15px; cursor:pointer; margin-top:6px; transition:background .16s, transform .1s, opacity .16s;
    }
    .eb-submit:hover { background:#27272A; }
    .eb-submit:active { transform:scale(.988); }
    .eb-submit:disabled { opacity:.5; cursor:default; transform:none; }
    .eb-err {
        display:none; font-size:13.5px; color:#B91C1C; background:#FEF2F2;
        border:1px solid #FECDD3; border-radius:10px; padding:12px 15px; margin-bottom:18px; line-height:1.6;
    }
    .eb-ok { text-align:center; padding:40px 22px; }
    .eb-ok .ok-ico {
        width:62px; height:62px; margin:0 auto 18px; border-radius:50%;
        background:#ECFDF5; border:1.5px solid #A7F3D0; display:flex; align-items:center; justify-content:center;
    }
    .eb-ok h3 { font-size:20px; font-weight:800; color:#0F172A; margin:0 0 10px; letter-spacing:-.02em; }
    .eb-ok p { font-size:14.5px; color:#5A6472; line-height:1.75; margin:0 0 24px; }
    .eb-again {
        font-family:inherit; font-size:14px; font-weight:600; color:#334155;
        background:#F1F5F9; border:1px solid #E4E9F0; border-radius:10px; padding:11px 22px; cursor:pointer;
    }
    .eb-again:hover { background:#E8EDF4; }

    @media (max-width:640px) {
        .eb-wrap { padding:0 16px 60px; }
        .eb-panel { margin-top:-28px; border-radius:15px; }
        .eb-head { padding:17px 17px; }
        .eb-body { padding:0 17px 20px; }
        .eb-content { padding:16px 17px; }
        .eb-info { grid-template-columns:1fr; }
        .eb-filter { padding:15px 17px 13px; }
        .eb-modal { padding:14px 10px; }
        .eb-modal-head { padding:19px 18px 15px; }
        .eb-modal-body { padding:19px 18px 24px; max-height:calc(100vh - 160px); }
        .eb-row-2 { grid-template-columns:1fr; gap:0; }
        .eb-row-2 .eb-row { margin-bottom:18px; }
        .eb-inst { padding:17px 17px; }
        .eb-inst-btn { width:100%; text-align:center; }
    }
    </style>
</head>

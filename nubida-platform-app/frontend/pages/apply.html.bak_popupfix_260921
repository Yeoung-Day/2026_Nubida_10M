                        </div>
                        <div class="eb-row eb-row-2">
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebICert">자격증 유무<span class="opt">선택</span></label>
                                <select class="eb-select" id="ebICert">
                                    <option value="">선택 안 함</option>
                                    <option value="yes">있음</option>
                                    <option value="no">없음</option>
                                </select>
                            </div>
                            <div class="eb-row" style="margin:0;">
                                <label class="eb-label" for="ebICertDetail">자격증 종류<span class="opt">선택</span></label>
                                <input class="eb-input" type="text" id="ebICertDetail" maxlength="200" placeholder="예: 코딩지도사 2급">
                            </div>
                        </div>
                        <div class="eb-row">
                            <label class="eb-label" for="ebICareer">경력사항<span class="opt">선택</span></label>
                            <textarea class="eb-textarea" id="ebICareer" maxlength="4000" placeholder="교육 경력, 근무 이력 등을 자유롭게 적어 주세요."></textarea>

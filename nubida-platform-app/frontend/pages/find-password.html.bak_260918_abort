<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>비밀번호 찾기 — 누비다플랫폼</title><link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/common/css/reset.css?v=20260804b">
    <link rel="stylesheet" href="/common/css/variables.css?v=20260804b">
    <link rel="stylesheet" href="/common/css/common.css?v=20260804b">
    <link rel="stylesheet" href="/common/css/responsive.css?v=20260805c">
    <link rel="stylesheet" href="/common/css/pages/login.css?v=20260804b">
    <meta name="theme-color" content="#4F5EF8">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <style>
        .find-tabs { display:flex; gap:0; margin-bottom:20px; border-bottom:2px solid var(--border); }
        .find-tab { flex:1; padding:10px; text-align:center; font-size:13px; font-weight:500; color:var(--text-tertiary); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; transition:all .2s; }
        .find-tab:hover { color:var(--text-primary); }
        .find-tab.active { color:var(--accent); border-bottom-color:var(--accent); }
        .find-panel { display:none; }
        .find-panel.active { display:block; animation:fadeIn .3s ease; }
        @keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
        .reset-step { display:none; }
        .reset-step.active { display:block; animation:fadeIn .3s ease; }
        .step-indicator { display:flex; gap:0; margin-bottom:20px; }
        .step-dot { flex:1; text-align:center; padding:8px 0; font-size:12px; font-weight:500; color:#94A3B8; border-bottom:3px solid #E2E8F0; transition:all .3s; }
        .step-dot.active { color:#4F5EF8; border-bottom-color:#4F5EF8; }
        .step-dot.done { color:#166534; border-bottom-color:#22C55E; }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-wrapper">
            <div class="login-header">
                <a href="/" class="login-logo" aria-label="누비다플랫폼 홈으로" style="margin-bottom:16px;display:block;"><img src="/common/assets/brand/nubida-logo-light.png" alt="누비다플랫폼" style="height:34px;width:auto;display:block;margin:0 auto;"></a>
                <h1>누비다플랫폼</h1>
                <p>비밀번호 찾기</p>
            </div>
            <div class="login-card">
                <div class="step-indicator" id="stepIndicator">
                    <div class="step-dot active" data-step="1">1. 본인 확인</div>
                    <div class="step-dot" data-step="2">2. 재설정</div>
                    <div class="step-dot" data-step="3">3. 완료</div>
                </div>

                <div class="login-error" id="findPwError" style="display:none"></div>

                <!-- Step 1: 본인 확인 -->
                <div class="reset-step active" id="step1Content">
                    <h2 style="font-size:18px;margin-bottom:4px">본인 확인</h2>
                    <p class="subtitle" style="margin-bottom:16px">가입한 아이디와 인증 정보를 입력해주세요.</p>

                    <div class="find-tabs">
                        <div class="find-tab active" onclick="switchPwTab('email')" id="pwTabEmail">📧 이메일로 인증</div>
                        <div class="find-tab" onclick="switchPwTab('phone')" id="pwTabPhone">📱 휴대전화로 인증</div>
                    </div>

                    <!-- 이메일 인증 -->
                    <div class="find-panel active" id="pwPanelEmail">
                        <form id="findByEmailForm" onsubmit="return false;">
                            <div class="form-group">
                                <label>아이디</label>
                                <input type="text" class="form-input" id="emailUsername" placeholder="아이디를 입력하세요" autocomplete="username">
                            </div>
                            <div class="form-group">
                                <label>이름</label>
                                <input type="text" class="form-input" id="emailName" placeholder="가입 시 등록한 실명" autocomplete="name">
                            </div>
                            <div class="form-group">
                                <label>이메일</label>
                                <input type="email" class="form-input" id="emailAddr" placeholder="가입 시 등록한 이메일" autocomplete="email">
                            </div>
                            <button type="submit" class="login-btn" id="verifyEmailBtn">
                                <span class="spinner"></span>
                                <span class="btn-text">본인 확인</span>
                            </button>
                        </form>
                    </div>

                    <!-- 휴대전화 인증 -->
                    <div class="find-panel" id="pwPanelPhone">
                        <form id="findByPhoneForm" onsubmit="return false;">
                            <div class="form-group">
                                <label>아이디</label>
                                <input type="text" class="form-input" id="phoneUsername" placeholder="아이디를 입력하세요" autocomplete="username">
                            </div>
                            <div class="form-group">
                                <label>이름</label>
                                <input type="text" class="form-input" id="phoneName" placeholder="가입 시 등록한 실명" autocomplete="name">
                            </div>
                            <div class="form-group">
                                <label>휴대전화</label>
                                <input type="tel" class="form-input" id="phoneNum" placeholder="- 없이 숫자만 (예: 01012345678)" autocomplete="tel">
                            </div>
                            <button type="submit" class="login-btn" id="verifyPhoneBtn">
                                <span class="spinner"></span>
                                <span class="btn-text">본인 확인</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Step 2: 비밀번호 재설정 -->
                <div class="reset-step" id="step2Content">
                    <h2 style="font-size:18px;margin-bottom:4px">비밀번호 재설정</h2>
                    <p class="subtitle" style="margin-bottom:16px">본인 확인이 완료되었습니다. 새로운 비밀번호를 입력해주세요.</p>
                    <div style="display:flex;align-items:center;gap:8px;padding:11px 14px;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:10px;margin-bottom:16px;">
                        <span style="font-size:15px">✅</span>
                        <span style="font-size:13px;color:#166534;">본인 확인 완료 — <strong id="resetTargetId">-</strong></span>
                    </div>
                    <form id="resetPwForm" onsubmit="return false;">
                        <div class="form-group">
                            <label>새 비밀번호</label>
                            <input type="password" class="form-input" id="newPassword" placeholder="비밀번호 (8자 이상)" required>
                        </div>
                        <div class="form-group">
                            <label>비밀번호 확인</label>
                            <input type="password" class="form-input" id="newPasswordConfirm" placeholder="비밀번호 재입력" required>
                        </div>
                        <button type="submit" class="login-btn" id="resetBtn">
                            <span class="spinner"></span>
                            <span class="btn-text">비밀번호 변경</span>
                        </button>
                    </form>
                    <div style="text-align:center;margin-top:14px">
                        <a href="#" onclick="goPwStep(1);return false" style="font-size:13px;color:var(--text-secondary);">← 이전 단계</a>
                    </div>
                </div>

                <!-- Step 3: 완료 -->
                <div class="reset-step" id="step3Content">
                    <div style="text-align:center;padding:20px 0">
                        <div style="font-size:48px;margin-bottom:12px">🎉</div>
                        <h2 style="font-size:20px;margin-bottom:8px;color:#166534">비밀번호가 변경되었습니다!</h2>
                        <p style="font-size:14px;color:#6B7280;margin-bottom:20px">새로운 비밀번호로 로그인해주세요.</p>
                        <a href="/pages/login.html" class="login-btn" style="display:inline-block;text-align:center;text-decoration:none;padding:14px 40px;border-radius:10px;">
                            <span class="btn-text">로그인하러 가기</span>
                        </a>
                    </div>
                </div>

                <div style="text-align:center;margin-top:16px;font-size:13px;color:#64748B;">
                    <a href="/pages/login.html" style="color:#4F5EF8;text-decoration:none;font-weight:500;">← 로그인 페이지로</a>
                </div>
            </div>
            <div class="login-footer">&copy; 2026 누비다플랫폼. All rights reserved.</div>
        </div>
    </div>
    <script src="/common/js/api.js?v=20260910login"></script>
    <script>
        let _resetToken = '';
        let _resetUsername = '';
        let _pwActiveTab = 'email';

        function switchPwTab(tab) {
            _pwActiveTab = tab;
            document.querySelectorAll('#step1Content .find-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('#step1Content .find-panel').forEach(p => p.classList.remove('active'));
            document.getElementById('pwTab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
            document.getElementById('pwPanel' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
            document.getElementById('findPwError').style.display = 'none';
        }

        function goPwStep(step) {
            document.querySelectorAll('.reset-step').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.step-dot').forEach(el => el.classList.remove('active', 'done'));
            document.getElementById('step' + step + 'Content').classList.add('active');
            document.querySelectorAll('.step-dot').forEach(el => {
                const s = parseInt(el.dataset.step);
                if (s < step) el.classList.add('done');
                if (s === step) el.classList.add('active');
            });
        }

        // Step 1: Verify identity
        async function verifyIdentity(username, email, phone, name) {
            const btn = _pwActiveTab === 'email' ? document.getElementById('verifyEmailBtn') : document.getElementById('verifyPhoneBtn');
            const err = document.getElementById('findPwError');

            btn.classList.add('loading');
            btn.disabled = true;
            err.style.display = 'none';

            try {
                const payload = { username };
                if (email) payload.email = email;
                if (phone) payload.phone = phone;
                if (name) payload.name = name;
                const res = await apiPost('/auth/find-password', payload);
                const tok = res?.data?.reset_token || res?.data?.debug_token;
                if (res && res.status === 'success' && tok) {
                    _resetToken = tok;
                    _resetUsername = res?.data?.username || username;
                    document.getElementById('resetTargetId').textContent = _resetUsername;
                    goPwStep(2);
                } else {
                    err.textContent = res?.message || '입력하신 정보와 일치하는 계정을 찾을 수 없습니다.';
                    err.style.display = 'block';
                }
            } catch(e) {
                err.textContent = e.message || '입력하신 정보와 일치하는 계정을 찾을 수 없습니다.';
                err.style.display = 'block';
            } finally {
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }

        document.getElementById('findByEmailForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const username = document.getElementById('emailUsername').value.trim();
            const name = document.getElementById('emailName').value.trim();
            const email = document.getElementById('emailAddr').value.trim();
            if (!username || !name || !email) {
                document.getElementById('findPwError').textContent = '아이디, 이름, 이메일을 모두 입력해주세요.';
                document.getElementById('findPwError').style.display = 'block';
                return;
            }
            verifyIdentity(username, email, '', name);
        });

        document.getElementById('findByPhoneForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const username = document.getElementById('phoneUsername').value.trim();
            const name = document.getElementById('phoneName').value.trim();
            const phone = document.getElementById('phoneNum').value.trim();
            if (!username || !name || !phone) {
                document.getElementById('findPwError').textContent = '아이디, 이름, 휴대전화를 모두 입력해주세요.';
                document.getElementById('findPwError').style.display = 'block';
                return;
            }
            verifyIdentity(username, '', phone, name);
        });

        // Step 2: Reset password
        document.getElementById('resetPwForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('resetBtn');
            const err = document.getElementById('findPwError');
            const newPw = document.getElementById('newPassword').value;
            const newPwConfirm = document.getElementById('newPasswordConfirm').value;

            if (!newPw || newPw.length < 8) {
                err.textContent = '비밀번호는 8자 이상이어야 합니다.';
                err.style.display = 'block';
                return;
            }
            if (newPw !== newPwConfirm) {
                err.textContent = '비밀번호가 일치하지 않습니다.';
                err.style.display = 'block';
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;
            err.style.display = 'none';

            try {
                const res = await apiPost('/auth/reset-password', {
                    token: _resetToken,
                    new_password: newPw
                });
                if (res && res.status === 'success') {
                    goPwStep(3);
                } else {
                    err.textContent = res?.message || '비밀번호 변경에 실패했습니다.';
                    err.style.display = 'block';
                }
            } catch(e) {
                err.textContent = e.message || '비밀번호 변경에 실패했습니다.';
                err.style.display = 'block';
            } finally {
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>

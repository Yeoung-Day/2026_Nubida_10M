        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeContactModal(); });

        // ===== 지사 목록 fetch =====
        function fetchBranches() {
            fetch(API_URL, { cache: 'no-store' })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (json) {
                    var list = (json && json.data) || [];
                    branches = list;
                    displayBranches = branches;   // 초기: 전체 대상
                    renderStats();
                    renderChips();
                    renderList(branches);
                    if (kakaoReady && branches.length) placeMarkers();
                })
                .catch(function (err) {
                    // 지사 API 실패/빈 DB여도 본사는 항상 목록·지도에 노출한다
                    branches = [];
                    displayBranches = branches;
                    renderStats();
                    renderChips();
                    renderList(branches);
                    $('#branchList').insertAdjacentHTML('beforeend',
                        '<div class="list-empty" style="padding-top:8px;">지사(교육센터) 정보를 불러오지 못했어요.<br>잠시 후 다시 시도해 주세요.<br><br><span style="font-size:11px;color:#A1A1AA;">(' + err.message + ')</span></div>'
                    );
                    if (kakaoReady && branches.length) placeMarkers();
                });
        }

        function renderStats() {
            var regions = {};
            branches.forEach(function (b) { if (b.region) regions[b.region] = true; });
            $('#stat-branch').textContent = branches.length;
            $('#stat-region').textContent = Object.keys(regions).length;
        }

        // 유형에 맞는 기관만 추리기 (지역 + 유형 교차 필터)
        function filterBranches() {
            return branches.filter(function (b) {
                if (b.kind !== 'academy' && b.kind !== 'educare') return false; // 보수적
                if (currentKind !== 'all' && b.kind !== currentKind) return false;
                if (currentRegion && b.region !== currentRegion) return false;
                return true;
            });
        }

        function bindTypeNav() {
            var nav = $('#typeNav');
            if (!nav || nav.dataset.bound) return;
            nav.dataset.bound = '1';
            nav.querySelectorAll('.type-nav-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentKind = btn.getAttribute('data-kind') || 'all';
                    nav.querySelectorAll('.type-nav-btn').forEach(function (c) { c.classList.toggle('active', c === btn); });
                    applyListFilter();
                });
            });
        }

        // 현재 지역+유형 필터를 목록·지도에 일괄 반영
        function applyListFilter() {
            displayBranches = filterBranches();  // 현재 필터(지역+유형) 대상 → 지도에 그린다
            renderList(displayBranches);
            if (kakaoReady && mapObj) {
                if (displayBranches.length) {
                    placeMarkers();               // 대상 기관만 다시 마커 배치
                } else {
                    clearMarkers();
                    maybeFitAll();                // 기관 없어도 본사 최소 배치
                }
            }
        }

        function renderChips() {
            var seen = {};
            branches.forEach(function (b) { if (b.region && !seen[b.region]) seen[b.region] = true; });
            var html = '<button class="region-chip active" data-region="">전체</button>';
            Object.keys(seen).sort().forEach(function (r) {
                html += '<button class="region-chip" data-region="' + escapeHtml(r) + '">' + escapeHtml(r) + '</button>';
            });
            $('#regionChips').innerHTML = html;
            $('#regionChips').querySelectorAll('.region-chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    currentRegion = chip.getAttribute('data-region') || '';
                    $('#regionChips').querySelectorAll('.region-chip').forEach(function (c) {
                        c.classList.toggle('active', c === chip);
                    });
                    applyListFilter();
                });
            });
            bindTypeNav();
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, function (m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
            });
        }

        function typeLabel(t) { return t === 'franchise' ? '프랜차이즈' : '직영'; }

        // 기관 유형 라벨: 백엔드가 확정 유형(edu=에듀케어 / academy=학원)을 주면 그대로,
        // 아직 없으면 기존 contract_type(direct 직영-학원계열 / franchise 프랜차이즈-에듀케어계열)으로 라벨링.
        function typeLabel2(b) {
            var t = b.branch_type;
            if (t === 'edu' || t === 'educare') return '에듀케어';
            if (t === 'academy' || t === 'director') return '학원';
            if (t === 'franchise') return '에듀케어';
            return '학원'; // direct 계열 기본
        }

        function hqItemHtml() {
            return '<div class="branch-item hq-item" data-key="__hq__">'
                + '<div class="row1"><span class="hq-star">★</span><span class="name">' + escapeHtml(HQ.name) + '</span><span class="hq-tag">본사</span></div>'
                + '<div class="addr"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4F5EF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>' + escapeHtml(HQ.address) + '</span></div>'
                + '<div class="hq-note">누비다플랫폼 본사 · 가맹/개원 상담 안내</div>'
                + '</div>';
        }

        function renderList(list) {
            var el = $('#branchList');
            // 본사 항목 항상 최상단 (지역/유형 필터와 무관)
            var html = hqItemHtml();
            var items = (list || []).slice();
            if (!items.length) {
                // 본사(hq-item)는 위에 항상 렌더되므로 empty 문구는 '센터 없음 + 본사 상담 유도'
                var msg = currentRegion ? '이 지역에 오픈 예정인 교육센터가 아직 없어요.<br>가맹/개원 상담은 위 ★ 본사로 문의해 주세요.' : '아직 오픈한 교육센터가 없어요.<br>가맹/개원 상담은 위 ★ 본사로 문의해 주세요.';
                html += '<div class="list-empty">' + msg + '</div>';
            } else {
                // 지역(시·도) 헤더 그룹으로 목록을 나눈다
                var groups = {};
                items.forEach(function (b) {
                    var key = b.region || '기타';
                    (groups[key] = groups[key] || []).push(b);
                });
                var keys = Object.keys(groups);
                // 선택된 지역을 맨 앞으로, 그 외는 시/도명 순 정렬 (기타는 끝)
                keys.sort(function (a, b) {
                    var ae = a === '기타' ? 1 : 0, be = b === '기타' ? 1 : 0;
                    if (ae !== be) return ae - be;
                    if (currentRegion === a) return -1;
                    if (currentRegion === b) return 1;
                    return a.localeCompare(b, 'ko');
                });
                keys.forEach(function (region) {
                    html += '<div class="list-group-title">' + escapeHtml(region) + '</div>';
                    groups[region].forEach(function (b) {
                        var badgeCls = b.kind === 'academy' ? 'academy' : 'educare'; // 학원=보라 / 에듀케어=주황
                        var typeName = typeLabel2(b);
                        var key = b.key || (b.kind + '-' + b.id);
                        html += '<div class="branch-item is-soon" data-key="' + escapeHtml(key) + '">'
                            + '<div class="row1"><span class="name">' + escapeHtml(b.name) + '</span>'
                            + '<span class="branch-type ' + badgeCls + '">' + typeName + '</span></div>'
                            + '<div class="soon-line"><span class="soon-badge">오픈 예정</span><span class="soon-text">센터 준비 중입니다 · 상담은 본사로 문의해 주세요</span></div>'
                            + '</div>';
                    });
                });
            }
            el.innerHTML = html;
            // 목록 클릭 → key 기반 라우팅
            el.querySelectorAll('.branch-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    var k = item.getAttribute('data-key');
                    if (k === '__hq__' || item.classList.contains('hq-item')) { selectHQ(); return; }
                    selectByKey(k);
                });
            });
        }

        function phoneSafe(p) { return String(p || '').replace(/[^0-9+]/g, ''); }

        function findBranch(id) {
            for (var i = 0; i < branches.length; i++) if (branches[i].id === id) return branches[i];
            return null;
        }

        // ===== 카카오 맵 =====
        function loadKakaoMap() {
            var script = document.createElement('script');
            script.src = '//dapi.kakao.com/v2/maps/sdk.js?appkey=' + KAKAO_APP_KEY + '&libraries=services&autoload=false';
            script.onload = function () {
                // autoload=false SDK: 로드 직후 kakao.maps는 아직 정의되지 않으므로
                // kakao.maps.load(callback)로 초기화를 완료해야 한다.
                try {
                    if (window.kakao && window.kakao.maps && window.kakao.maps.load) {
                        window.kakao.maps.load(function () {
                            kakaoReady = true;
                            initMap();
                        });
                    } else {
                        showMapFail('지도 SDK를 불러오지 못했어요.<br>관리자에게 도메인 등록 상태를 확인해 주세요.');
                    }
                } catch (e) {
                    showMapFail('지도 SDK 오류가 발생했습니다.<br>관리자에게 도메인 등록 상태를 확인해 주세요.');
                }
            };
            script.onerror = function () {
                showMapFail('지도 서비스 연결에 실패했습니다.');
            };
            document.head.appendChild(script);
            setTimeout(function () {
                if (!window.kakao || !window.kakao.maps) showMapFail('지도 서비스 응답이 없습니다.<br>도메인 등록 상태를 확인해 주세요.');
            }, 12000);
        }

        function initMap() {
            window.kakao.maps.load(function () {
                kakaoReady = true;
                var center = new kakao.maps.LatLng(NATION_CENTER.lat, NATION_CENTER.lng); // 전국 중심
                var opts = { center: center, level: NATION_LEVEL };
                mapObj = new kakao.maps.Map($('#map'), opts);
                geocoder = new kakao.maps.services.Geocoder();
                $('#mapLoading').classList.add('hidden');
                geocodeHQ(); // 본사 지오코딩 시작 — 지사 유무와 무관, 실패 시 fallback 좌표
                if (branches.length) {
                    placeMarkers();
                } else {
                    maybeFitAll(); // 지사가 없어도 본사만으로 지도 배치
                }
            });
        }

        function placeMarkers() {
            clearMarkers();
            branchMarkersDone = false;
            var coords = {};
            var pending = 0;
            var list = displayBranches; // 현재 지도 대상 (필터 반영)
            list.forEach(function (b) {
                if (!b.address) { b._lat = null; return; }
                pending++;
                (function (branch) {
                    geocoder.addressSearch(branch.address, function (result, status) {
                        pending--;
                        if (status === kakao.maps.services.Status.OK && result && result.length) {
                            branch._lat = parseFloat(result[0].y);
                            branch._lng = parseFloat(result[0].x);
                        } else {
                            branch._lat = null;
                        }
                        if (pending === 0) {
                            drawMarkers();
                            branchMarkersDone = true;
                            maybeFitAll();
                        }
                    });
                })(b);
            });
            if (pending === 0) { drawMarkers(); branchMarkersDone = true; maybeFitAll(); }
        }

        function clearMarkers() {
            markers.forEach(function (m) { m.setMap(null); });
            markers = [];
        }

        function drawMarkers() {
            clearMarkers();
            var pin = {
                educare: makePin('#F59E0B'),  // 에듀케어(지사) 주황
                academy: makePin('#7C3AED'),  // 학원 보라
                hq: makePin('#4F5EF8')        // 공통/직영 남색 폴백
            };
            displayBranches.forEach(function (b) {
                if (b._lat == null || b._lng == null) return;
                var kind = b.kind;
                var img = pin[kind === 'educare' ? 'educare' : (kind === 'academy' ? 'academy' : 'hq')];
                var marker = new kakao.maps.Marker({
                    map: mapObj,
                    position: new kakao.maps.LatLng(b._lat, b._lng),
                    image: img,
                    clickable: true
                });
                var iw = makeInfoWindow(b);
                kakao.maps.event.addListener(marker, 'click', function () { openInfo(iw, marker, b); });
                b._marker = marker;
                markers.push(marker);
            });
        }

        function makePin(hex) {
            var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 26 32">'
                + '<path d="M13 1C7.1 1 2.5 5.6 2.5 11.4 2.5 19.4 13 31 13 31s10.5-11.6 10.5-19.6C23.5 5.6 18.9 1 13 1z" fill="' + hex + '" stroke="#fff" stroke-width="2"/>'
                + '<circle cx="13" cy="11.4" r="4" fill="#fff"/></svg>';
            var blob = new Blob([svg], { type: 'image/svg+xml' });
            var url = URL.createObjectURL(blob);
            var size = new kakao.maps.Size(26, 32);
            var opt = { offset: new kakao.maps.Point(13, 31), shape: 'circle', coords: ['13', '11', '6'] };
            return new kakao.maps.MarkerImage(url, size, opt);
        }

        // ===== 본사 전용 =====
        // 일반 지사 핀(26x32)보다 크게 만든 강조 핀(34x42) — 브랜드색 + 별 (대표님 지시 2026-09-07: 전체 축소)
        function makeHQPin() {
            var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="42" viewBox="0 0 34 42">'
                + '<path d="M17 1C9.1 1 2.6 7.1 2.6 14.8 2.6 24.9 17 41 17 41s14.4-16.1 14.4-26.1C31.4 7.1 24.9 1 17 1z" fill="#4F5EF8" stroke="#fff" stroke-width="2"/>'
                + '<circle cx="17" cy="14.8" r="6.2" fill="#fff"/>'
                + '<polygon points="17,9.5 18.3,13 22,13.1 19.1,15.5 20.2,19.2 17,17 13.8,19.2 14.9,15.5 12,13.1 15.7,13" fill="#4F5EF8"/></svg>';
            var blob = new Blob([svg], { type: 'image/svg+xml' });
            var url = URL.createObjectURL(blob);
            var size = new kakao.maps.Size(34, 42);
            var opt = { offset: new kakao.maps.Point(17, 41), shape: 'circle', coords: ['17', '14', '7'] };
            return new kakao.maps.MarkerImage(url, size, opt);
        }

        // 본사 주소 → 좌표 (실패 시 HQ_FALLBACK 상수 사용)
        function geocodeHQ() {
            geocoder.addressSearch(HQ.address, function (result, status) {
                if (status === kakao.maps.services.Status.OK && result && result.length) {
                    hqLatLng = { lat: parseFloat(result[0].y), lng: parseFloat(result[0].x) };
                    console.log('[본사] 지오코딩 성공: ' + HQ.address + ' → lat=' + hqLatLng.lat + ', lng=' + hqLatLng.lng);
                } else {
                    hqLatLng = { lat: HQ_FALLBACK.lat, lng: HQ_FALLBACK.lng };
                    console.warn('[본사] 지오코딩 실패 → fallback 좌표 사용: ' + HQ_FALLBACK.lat + ', ' + HQ_FALLBACK.lng);
                }
                hqGeocodeDone = true;
                drawHQMarker();
                maybeFitAll();
            });
        }

        function drawHQMarker() {
            if (!kakaoReady || !mapObj || !hqLatLng) return;
            if (hqMarker) hqMarker.setMap(null);
            hqMarker = new kakao.maps.Marker({
                map: mapObj,
                position: new kakao.maps.LatLng(hqLatLng.lat, hqLatLng.lng),
                image: makeHQPin(),
                clickable: true,
                zIndex: 10
            });
            hqInfo = makeHQInfoWindow();
            kakao.maps.event.addListener(hqMarker, 'click', function () { openHQInfo(); });
        }

        function makeHQInfoWindow() {
            var html = '<div style="padding:14px 18px;font-family:Inter,\'Noto Sans KR\',sans-serif;min-width:250px;max-width:360px;width:max-content;box-sizing:border-box;font-size:13px;line-height:1.55;">'
                + '<div style="display:flex;align-items:center;gap:7px;font-weight:800;font-size:15px;color:#3E4BD8;white-space:normal;overflow-wrap:anywhere;word-break:keep-all;">' + escapeHtml(HQ.label) + '</div>'
                + '<div style="color:#71717A;margin-top:6px;line-height:1.55;white-space:normal;overflow-wrap:anywhere;word-break:keep-all;">' + escapeHtml(HQ.address) + '</div>'
                + '<div style="margin-top:8px;padding-top:8px;border-top:1px solid #F0F0F4;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">'
                + '<span style="display:inline-flex;align-items:center;gap:5px;color:#71717A;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>' + escapeHtml(HQ.phone) + '</span>'
                + '<span style="margin-left:auto;display:inline-block;background:#EEF0FF;color:#4F5EF8;font-weight:700;font-size:10px;padding:2px 8px;border-radius:999px;">본사</span>'
                + '</div></div>';
            return new kakao.maps.InfoWindow({ content: html, zIndex: 30 });
        }

        // 본사 좌표 확정 && 지사 마커 배치(필요시) 완료 → 최종 fit
        function maybeFitAll() {
            if (!kakaoReady || !hqGeocodeDone) return;
            if (branches.length && !branchMarkersDone) return;
            // 지역 필터가 없을 때는 항상 전국 뷰 (특정 지역으로 튀지 않도록)
            if (!currentRegion) { fitNationwide(); return; }
            fitToBranches(branches.filter(function (x) { return x.region === currentRegion; }));
        }

        // ===== 전국 뷰 =====
        function fitNationwide() {
            if (!kakaoReady || !mapObj) return;
            mapObj.setCenter(new kakao.maps.LatLng(NATION_CENTER.lat, NATION_CENTER.lng));
            mapObj.setLevel(NATION_LEVEL);
        }

        function makeInfoWindow(b) {
            var html = '<div style="padding:12px 16px;font-family:Inter,\'Noto Sans KR\',sans-serif;min-width:220px;max-width:340px;width:max-content;box-sizing:border-box;font-size:13px;line-height:1.55;">'
                + '<div style="font-weight:700;font-size:14px;display:flex;align-items:center;gap:6px;min-width:0;white-space:normal;overflow-wrap:anywhere;word-break:keep-all;">' + '<span style="overflow-wrap:anywhere;word-break:keep-all;">' + escapeHtml(b.name) + '</span>' + '</div>'
                + '<div style="color:#71717A;margin-top:5px;">오픈 예정 센터입니다. 상담은 본사로 문의해 주세요.</div>'
                + '<div style="margin-top:6px;"><span style="display:inline-block;background:' + (b.branch_type==='edu'?'#E7F6FF;color:#0E7490':b.branch_type==='academy'?'#F5EBFF;color:#7E22CE':'#EEF0FF;color:#4F5EF8') + ';font-weight:700;font-size:10px;padding:2.5px 9px;border-radius:999px;">' + typeLabel2(b) + '</span> <span style="display:inline-block;background:#FEF6E7;color:#B45309;font-weight:700;font-size:10px;padding:2.5px 9px;border-radius:999px;">오픈 예정</span></div>'
                + '</div>';
            return new kakao.maps.InfoWindow({ content: html, zIndex: 20 });
        }

        var ACTIVE_HQ = '__hq__';

        // key로 엔트리 찾기 (id 충돌 없이 kind+id 유일 키 사용)
        function findByKey(key) {
            for (var i = 0; i < branches.length; i++) {
                if (branches[i].key === key) return branches[i];
            }
            return null;
        }

        function openInfo(iw, marker, b) {
            var k = b.key || (b.kind + '-' + b.id);
            if (activeMarkerKey != null && activeMarkerKey !== k) {
                if (activeMarkerKey === ACTIVE_HQ) {
                    if (hqInfo) hqInfo.close();
                } else {
                    var prev = findByKey(activeMarkerKey);
                    if (prev && prev._iw) prev._iw.close();
                }
            }
            iw.open(mapObj, marker);
            b._iw = iw;
            activeMarkerKey = k;
            highlightList(k);
        }

        function selectByKey(k) {
            var b = findByKey(k);
            if (!b) return;
            // 클릭한 기관이 현재 지역 필터 밖이면 필터를 그 지역으로 재적용
            if (currentRegion && b.region !== currentRegion) {
                currentRegion = b.region || '';
                $('#regionChips').querySelectorAll('.region-chip').forEach(function (c) {
                    c.classList.toggle('active', c.getAttribute('data-region') === currentRegion);
                });
                applyListFilter();
                b = findByKey(k); // 목록 재렌더 후에도 keek 객체 유지(마커생성 대기 중일 수 있어 코랄릭스)
            }
            if (kakaoReady && b._lat != null && b._marker) {
                mapObj.panTo(new kakao.maps.LatLng(b._lat, b._lng));
                mapObj.setLevel(4);
                openInfo(b._iw || makeInfoWindow(b), b._marker, b);
            } else {
                if (kakaoReady && b._lat != null) mapObj.panTo(new kakao.maps.LatLng(b._lat, b._lng));
                highlightList(k);
            }
        }

        // ===== 본사 선택/하이라이트 =====
        function selectHQ() {
            if (kakaoReady && hqLatLng) {
                mapObj.panTo(new kakao.maps.LatLng(hqLatLng.lat, hqLatLng.lng));
                mapObj.setLevel(4);
                openHQInfo();
            } else {
                highlightList(ACTIVE_HQ);
            }
        }

        function openHQInfo() {
            if (activeMarkerKey != null && activeMarkerKey !== ACTIVE_HQ) {
                var prev = findByKey(activeMarkerKey);
                if (prev && prev._iw) prev._iw.close();
            }
            if (hqMarker) { hqInfo.open(mapObj, hqMarker); }
            activeMarkerKey = ACTIVE_HQ;
            highlightList(ACTIVE_HQ);
        }

        function highlightList(id) {
            document.querySelectorAll('.branch-item').forEach(function (item) {
                var matched = (id === ACTIVE_HQ) ? item.classList.contains('hq-item')
                    : item.getAttribute('data-key') === id;
                item.classList.toggle('active', matched);
            });
            var act = document.querySelector('.branch-item.active');
            if (act && act.scrollIntoView) act.scrollIntoView({ block: 'nearest' });
        }

        function fitToBranches(list) {
            if (!kakaoReady || !mapObj) return;
            var pts = [];
            list.forEach(function (b) { if (b._lat != null && b._lng != null) pts.push(new kakao.maps.LatLng(b._lat, b._lng)); });
            // 지사가 1개 이하면 전국 뷰 유지 (특정 지역으로 줌인하지 않음)
            if (pts.length <= 1) { mapObj.setCenter(new kakao.maps.LatLng(NATION_CENTER.lat, NATION_CENTER.lng)); mapObj.setLevel(NATION_LEVEL); return; }
            var bounds = new kakao.maps.LatLngBounds();
            pts.forEach(function (p) { bounds.extend(p); });
            mapObj.setBounds(bounds, 80, 80);
            // 전국보다 더 넓게(축소) 보이지 않도록 상한 캡
            if (mapObj.getLevel() > NATION_LEVEL) mapObj.setLevel(NATION_LEVEL);
        }

        // ===== 실패 처리 =====
        function showMapFail(msg) {
            $('#mapLoading').classList.add('hidden');
            var fb = $('#mapFallback');
            fb.classList.remove('hidden');
            $('#mapFallbackText').innerHTML = msg + '<br><br><b style="color:#18181B;">카카오 지도</b> 도메인/키 오류이면<br>관리자에게 <code>JavaScript 키</code> 등록을 요청해 주세요.';
        }

        // ===== Init =====
        fetchBranches();
        loadKakaoMap();
    </script>

        var markers = [];
        var currentRegion = '';          // 지역(시·도) 필터
        var currentKind = 'all';         // 기관 유형 필터: 'all' | 'educare' | 'academy'
        var displayBranches = [];        // 지도에 그려야 할 대상 (필터 반영)

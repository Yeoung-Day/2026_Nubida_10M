    <script>
        // ===== 상수 =====
        var KAKAO_APP_KEY = 'baa294fcf6b3312e9ced6b08ce10d1c6';
        var API_URL = '/api/v1/headquarters/branches/public-map';

        // ===== 본사 상수 =====
        // 대표님 본사 주소(2026-09-07 접수): 부산광역시 사상구 사상로 349번길 59, 3층
        var HQ = {
            id: 'hq',
            name: '누비다플랫폼',
            label: '누비다플랫폼 [본사]',
            address: '부산광역시 사상구 사상로 349번길 59, 3층',
            region: '부산광역시',
            phone: '1661-0000'
        };
        // 본사 지오코딩 실패 시 fallback 좌표 — 부산 사상구 사상로 349번길 일대(사상구청 인근) 약좌표
        var HQ_FALLBACK = { lat: 35.1527, lng: 128.9914 };

        // ===== 상태 =====

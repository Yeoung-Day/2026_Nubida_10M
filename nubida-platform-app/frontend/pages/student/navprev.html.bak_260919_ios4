            // Non-critical — don't block user
        }
    }

    // ===== Mark Complete (파일 자료 + 콘텐츠 블록 공용) =====
    async function markComplete() {
        // ── 콘텐츠 블록(코드/이미지/영상) 완료 처리 ──
        if (currentBlockIndex != null) {
            const item = allItems.find(x => x.id === currentItemId);
            if (!item || item.progress?.is_completed) return;

            const btn = document.getElementById('completeBtn');
            btn.textContent = '처리 중...';
            btn.disabled = true;

            try {
                await apiPost(`/courses/${currentCourseId}/progress`, {
                    block_index: currentBlockIndex,
                    is_completed: true,
                    progress_percent: 100
                });

                // Update local state
                item.progress = { is_completed: true, progress_percent: 100 };

                // Update UI
                updateBlockCompletionUI(item);

                // Refresh stats
                await refreshStats();

                // Re-render material list (블록 ✓ 체크 반영)
                renderMaterialList();

                showAlert('학습 완료 처리되었습니다!', 'success');
            } catch (err) {
                console.error('Failed to mark block complete:', err);
                showAlert('완료 처리 중 오류가 발생했습니다.', 'danger');
                btn.textContent = '✓ 학습 완료';
                btn.disabled = false;
            }
            return;
        }

        // ── 첨부 파일 자료 완료 처리 (기존) ──
        if (!currentMaterial || currentMaterial.progress?.is_completed) return;

        const btn = document.getElementById('completeBtn');
        btn.textContent = '처리 중...';
        btn.disabled = true;

        try {
            const res = await apiPost(`/courses/${currentCourseId}/progress`, {
                material_id: currentMaterial.id,
                is_completed: true,
                progress_percent: 100
            });

            // Update local state (progress object)
            currentMaterial.progress = currentMaterial.progress || {};
            currentMaterial.progress.is_completed = true;
            currentMaterial.progress.progress_percent = 100;

            // Update UI
            updateCompletionUI(currentMaterial);

            // Refresh stats
            await refreshStats();

            // Re-render material list
            renderMaterialList();

            // Show success feedback
            showAlert('학습 완료 처리되었습니다!', 'success');

        } catch (err) {
            console.error('Failed to mark complete:', err);
            showAlert('완료 처리 중 오류가 발생했습니다.', 'danger');
            btn.textContent = '✓ 학습 완료';
            btn.disabled = false;
        }
    }

    // ===== Refresh Stats =====
    async function refreshStats() {
        try {
            const res = await apiGet(`/courses/${currentCourseId}/progress/stats`);
            currentStats = res.data || res || {};

            // Update progress bar — API returns 'completion_rate'
            const pct = currentStats.completion_rate || 0;
            document.getElementById('courseProgressFill').style.width = pct + '%';
            document.getElementById('courseProgressText').textContent = pct + '%';

            // Update stats
            renderStats();

        } catch (err) {
            console.error('Failed to refresh stats:', err);
        }
    }


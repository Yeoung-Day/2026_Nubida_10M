        else if (lang === 'sql') commentRe = /--[^\n]*/g;
        else commentRe = /\/\/[^\n]*/g;
        out = out.replace(commentRe, function(m) {
            commentHolders.push(m);
            return '\u0002C' + (commentHolders.length - 1) + '\u0002';
        });
        out = out.replace(/("[^"\n]*"|'[^'\n]*')/g, function(m) {
            strHolders.push(m);
            return '\u0001S' + (strHolders.length - 1) + '\u0001';
        });
        out = out.replace(/(\b\d+(\.\d+)?\b)/g, function(m) {
            numHolders.push(m);
            return '\u0003N' + (numHolders.length - 1) + '\u0003';
        });
        // 키워드
        var kwRe = new RegExp('\\b(' + kw.join('|') + ')\\b', 'g');
        out = out.replace(kwRe, '<span class="tok-keyword">$1</span>');
        // 타입
        if (ty.length) {
            var tyRe = new RegExp('\\b(' + ty.join('|') + ')\\b', 'g');
            out = out.replace(tyRe, '<span class="tok-type">$1</span>');
        }
        // 내장 함수/상수
        if (bi.length) {
            var biRe = new RegExp('\\b(' + bi.join('|') + ')\\b', 'g');
            out = out.replace(biRe, '<span class="tok-builtin">$1</span>');
        }
        // 숫자 홀더 복원
        out = out.replace(/\u0003N(\d+)\u0003/g, function(m, idx) {
            return '<span class="tok-number">' + numHolders[parseInt(idx, 10)] + '</span>';
        });
        // 문자열 홀더 복원
        out = out.replace(/\u0001S(\d+)\u0001/g, function(m, idx) {
            return '<span class="tok-string">' + strHolders[parseInt(idx, 10)] + '</span>';
        });
        // 주석 홀더 복원
        out = out.replace(/\u0002C(\d+)\u0002/g, function(m, idx) {
            return '<span class="tok-comment">' + commentHolders[parseInt(idx, 10)] + '</span>';
        });
        return out;
    }

    // ===== Block → HTML (단일 블록 렌더링, 뷰어/목록 공용) =====
    // ===== 콘텐츠 블록 url 유효성 검사 (쓰레기 값/상대경로 404 방지) =====
    // 허용: /uploads/, /files/ 경로, http(s)://, data: / 빈 값(빈 값은 materials fallback)
    function isValidMediaUrl(url) {
        if (!url || typeof url !== 'string') return false;
        var u = url.trim();
        if (!u) return false;
        if (/^(https?:\/\/|data:|blob:)/i.test(u)) return true;
        if (u.charAt(0) === '/' && !/^\/pages\//i.test(u)) return true;  // /uploads, /files 등 서버 경로 (단 /pages/ 이동 링크는 제외)
        return false;
    }

    function blockToHtml(block) {
        var h = '';
        if (block.type === 'text') {
            h += '<div class="block-text" style="font-size:15px;line-height:1.8;color:#374151;margin-bottom:16px;">' + (block.content || '') + '</div>';
        } else if (block.type === 'heading') {
            var level = block.level || 3;
            var size = level === 1 ? '24px' : (level === 2 ? '20px' : '17px');
            h += '<h' + level + ' style="font-size:' + size + ';font-weight:700;color:#111827;margin:24px 0 12px 0;letter-spacing:-0.01em;">' + (block.content || '') + '</h' + level + '>';
        } else if (block.type === 'image') {
            // url이 비어 있으면 해당 강좌 materials의 이미지 파일로 fallback (PDF/이미지 자료와 중복되지 않도록 이미지 타입만)
            var imgUrl = block.url || '';
            if (!imgUrl && materials && materials.length) {
                for (var _mi = 0; _mi < materials.length; _mi++) {
                    if (materials[_mi].material_type === 'image' && materials[_mi].file_url) {
                        imgUrl = materials[_mi].file_url;
                        break;
                    }
                }
            }
            h += '<div class="block-image" style="margin:16px 0;text-align:center;">';
            if (imgUrl && isValidMediaUrl(imgUrl)) {
                h += '<img src="' + esc(imgUrl) + '" alt="' + esc(block.caption || '') + '" style="max-width:100%;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">';
            }
            if (block.caption) h += '<p style="font-size:12px;color:#9CA3AF;margin-top:6px;">' + esc(block.caption) + '</p>';
            h += '</div>';
        } else if (block.type === 'video') {
            // url이 비어 있으면 materials의 video 파일로 fallback
            var vidUrl = block.url || '';
            if (!vidUrl && materials && materials.length) {
                for (var _vi = 0; _vi < materials.length; _vi++) {
                    if (materials[_vi].material_type === 'video' && materials[_vi].file_url) {
                        vidUrl = materials[_vi].file_url;
                        break;
                    }
                }
            }
            h += '<div class="block-video" style="margin:16px 0;">';
            if (vidUrl && isValidMediaUrl(vidUrl)) {
                h += '<video controls style="width:100%;border-radius:12px;" src="' + esc(vidUrl) + '"></video>';
            } else if (vidUrl) {
                // 무효 url(숫자값 등) → 404 유발 방지: "영상 없음" 표시
                h += '<div style="padding:28px 16px;text-align:center;background:#F9FAFB;border:1px dashed #E5E7EB;border-radius:12px;color:#9CA3AF;font-size:13px;"><svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/></svg><span style="display:inline-block;margin-left:6px;vertical-align:middle;">영상 없음 (주소 오류 — 본사에서 영상 주소를 확인해 주세요)</span></div>';
            } else {
                // url이 비어 있고 materials fallback도 없으면 안내 표시
                h += '<div style="padding:28px 16px;text-align:center;background:#F9FAFB;border:1px dashed #E5E7EB;border-radius:12px;color:#9CA3AF;font-size:13px;"><svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/></svg><span style="display:inline-block;margin-left:6px;vertical-align:middle;">영상 없음 (영상이 등록되지 않았습니다)</span></div>';
            }
            if (block.caption) h += '<p style="font-size:12px;color:#9CA3AF;margin-top:6px;">' + esc(block.caption) + '</p>';
            h += '</div>';
        } else if (block.type === 'embed') {
            h += '<div class="block-embed" style="margin:16px 0;position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;">';
            if (block.url && isValidMediaUrl(block.url)) {
                h += '<iframe src="' + esc(block.url) + '" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;" allowfullscreen></iframe>';
            } else {
                // 무효/빈 embed url → 빈 화면 대신 안내 표시 (404 iframe 방지)
                h += '<div style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#F9FAFB;color:#9CA3AF;font-size:13px;">🔗 영상 없음 (주소 오류)</div>';
            }
            h += '</div>';
        } else if (block.type === 'divider') {
            h += '<hr style="margin:24px 0;border:none;border-top:1px solid #E5E7EB;">';
        } else if (block.type === 'code') {
            var codeLang = block.language || 'cpp';
            h += '<div class="block-code" style="margin:16px 0;max-width:100%;min-width:0;width:100%;box-sizing:border-box;">';
            h += '<div style="font-size:11px;color:#9CA3AF;margin-bottom:4px;text-transform:uppercase;">' + esc(codeLang) + '</div>';
            h += '<pre style="background:#1e1e2e;color:#e0e0e0;border-radius:8px;padding:12px 14px;overflow-x:auto;font-family:monospace;font-size:11px;line-height:1.6;margin:0;width:100%;max-width:100%;box-sizing:border-box;white-space:pre-wrap;word-break:break-word;overflow-wrap:break-word;"><code>' + highlightCode(block.code || '', codeLang) + '</code></pre>';
            h += '</div>';
        }
        return h;
    }

    // ===== Show Error =====
    function showError(message) {
        document.getElementById('materialList').innerHTML = `
            <div class="material-error">
                <p>${esc(message)}</p>
                <button class="btn btn-secondary btn-sm mt-16" onclick="loadCourseData()">다시 시도</button>
            </div>
        `;
        document.getElementById('materialViewerBody').style.display = 'none';
    }

    // ===== Utility: Format File Size =====
    function formatFileSize(bytes) {
        if (!bytes) return '';
        const units = ['B', 'KB', 'MB', 'GB'];
        let i = 0;
        let size = bytes;
        while (size >= 1024 && i < units.length - 1) {
            size /= 1024;
            i++;
        }
        return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }

    // ===== Nubida Slide Viewer Engine (자체 슬라이드쇼, 비동기 변환) =====
    const slideViewerState = {};

    function createSlideViewer(materialId, fileUrl) {
        slideViewerState[materialId] = {
            slides: [],
            currentSlide: 0,
            loading: true,
            fileUrl: fileUrl,
            pollTimer: null,
        };

        const img = document.getElementById('slideImage_' + materialId);
        const prevBtn = document.getElementById('slidePrev_' + materialId);
        const nextBtn = document.getElementById('slideNext_' + materialId);
        const counter = document.getElementById('slideCounter_' + materialId);
        const loading = document.getElementById('slideLoading_' + materialId);
        if (!img) return;

        const state = slideViewerState[materialId];
        loading.innerHTML = '<span>🔄 변환 준비 중...</span>';
        loading.style.display = 'flex';

        // 1단계: 캐시 확인 (빠름)
        var baseUrl = '/api/v1/viewer/check?file_path=' + encodeURIComponent(fileUrl);

        apiGet('/viewer/check?file_path=' + encodeURIComponent(fileUrl))
        .then(function(r) { return r; })
        .then(function(data) {
            if (data.status === 'ready') {
                // 캐시됨! 즉시 표시
                showSlides(materialId, data.slides, data.pages);
            } else if (data.status === 'processing') {
                // 변환 중 → 폴링
                loading.innerHTML = '<span>🔄 변환 중입니다... 잠시만 기다려주세요</span>';
                startPolling(materialId, fileUrl);
            } else {
                // 변환 필요 → 변환 요청
                loading.innerHTML = '<span>🔄 변환을 시작합니다...</span>';
                startConversion(materialId, fileUrl);
            }
        })
        .catch(function(err) {
            loading.innerHTML = '<span>⚠️ 오류: ' + (err.message || '알 수 없음') + '</span>';
        });
    }

    function startPolling(materialId, fileUrl) {
        var state = slideViewerState[materialId];
        if (!state) return;

        state.pollTimer = setInterval(function() {
            var checkUrl = '/api/v1/viewer/check?file_path=' + encodeURIComponent(fileUrl);
            apiGet('/viewer/check?file_path=' + encodeURIComponent(fileUrl))
            .then(function(r) { return r; })
            .then(function(data) {
                if (data.status === 'ready') {
                    clearInterval(state.pollTimer);
                    state.pollTimer = null;
                    showSlides(materialId, data.slides, data.pages);
                }
            })
            .catch(function() { /* 재시도 */ });
        }, 2000);  // 2초마다 폴링
    }

    function startConversion(materialId, fileUrl) {
        var convertUrl = '/api/v1/viewer/convert?file_path=' + encodeURIComponent(fileUrl) + '&dpi=150';
        var loading = document.getElementById('slideLoading_' + materialId);

        apiPost('/viewer/convert?file_path=' + encodeURIComponent(fileUrl) + '&dpi=150')
        .then(function(r) { return r; })
        .then(function(data) {
            if (data.status === 'ready') {
                showSlides(materialId, data.slides, data.pages);
            } else if (data.status === 'processing') {
                loading.innerHTML = '<span>🔄 변환 중입니다... 잠시만 기다려주세요</span>';
                startPolling(materialId, fileUrl);
            } else {
                loading.innerHTML = '<span>⚠️ 변환 실패</span>';
            }
        })
        .catch(function(err) {
            loading.innerHTML = '<span>⚠️ 변환 오류: ' + (err.message || '알 수 없음') + '</span>';
        });
    }

    function showSlides(materialId, slides, totalPages) {
        var state = slideViewerState[materialId];
        if (!state) return;

        state.slides = slides || [];
        state.currentSlide = 0;
        state.loading = false;

        var loading = document.getElementById('slideLoading_' + materialId);
        var img = document.getElementById('slideImage_' + materialId);
        var prevBtn = document.getElementById('slidePrev_' + materialId);
        var nextBtn = document.getElementById('slideNext_' + materialId);
        var counter = document.getElementById('slideCounter_' + materialId);

        if (!img || slides.length === 0) {
            if (loading) loading.innerHTML = '<span>⚠️ 슬라이드가 없습니다</span>';
            return;
        }

        loading.style.display = 'none';
        img.src = getSlideUrlWithToken(slides[0]);
        img.style.opacity = '1';
        counter.textContent = '1 / ' + slides.length;
        prevBtn.disabled = true;
        nextBtn.disabled = slides.length <= 1;
    }

    function navigateSlideFn(materialId, direction) {
        var state = slideViewerState[materialId];
        if (!state || state.slides.length === 0) return;

        var newIdx = state.currentSlide + direction;
        if (newIdx < 0 || newIdx >= state.slides.length) return;

        state.currentSlide = newIdx;

        var img = document.getElementById('slideImage_' + materialId);
        var prevBtn = document.getElementById('slidePrev_' + materialId);
        var nextBtn = document.getElementById('slideNext_' + materialId);
        var counter = document.getElementById('slideCounter_' + materialId);
        if (!img) return;

        img.style.opacity = '0';
        setTimeout(function() {
            img.src = getSlideUrlWithToken(state.slides[newIdx]);
            img.style.opacity = '1';
        }, 150);

        counter.textContent = (newIdx + 1) + ' / ' + state.slides.length;
        prevBtn.disabled = newIdx === 0;
        nextBtn.disabled = newIdx === state.slides.length - 1;
    }

    function toggleFullscreenFn(materialId) {
        var viewer = document.getElementById('slideViewer_' + materialId);
        if (!viewer) return;
        var btn = document.getElementById('slideFsBtn_' + materialId);

        // 이미 fullscreen CSS 클래스가 적용되어 있으면 → 닫기
        if (viewer.classList.contains('fullscreen')) {
            // 브라우저 전체화면 종료
            if (document.fullscreenElement || document.webkitFullscreenElement) {
                if (document.exitFullscreen) document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            }
            viewer.classList.remove('fullscreen');
            if (btn) btn.textContent = '⛶ 전체화면';
            setTimeout(function() { viewer.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 300);
            return;
        }

        // 브라우저 Fullscreen API 사용 (우선)
        var el = viewer;
        viewer.classList.add('fullscreen');
        if (btn) btn.textContent = '✕ 닫기';

        if (el.requestFullscreen) {
            el.requestFullscreen().catch(function() {});
        } else if (el.webkitRequestFullscreen) {
            el.webkitRequestFullscreen();
        }
    }

    // 브라우저 전체화면 종료 시 CSS 클래스 정리
    document.addEventListener('fullscreenchange', function() {
        if (!document.fullscreenElement) {
            document.querySelectorAll('.slide-viewer.fullscreen').forEach(function(el) {
                el.classList.remove('fullscreen');
                var bid = el.id;
                var btn = bid ? document.getElementById('slideFsBtn_' + bid.replace('slideViewer_', '')) : null;
                if (btn) btn.textContent = '⛶ 전체화면';
            });
        }
    });
    document.addEventListener('webkitfullscreenchange', function() {
        if (!document.webkitFullscreenElement) {
            document.querySelectorAll('.slide-viewer.fullscreen').forEach(function(el) {
                el.classList.remove('fullscreen');
                var bid = el.id;
                var btn = bid ? document.getElementById('slideFsBtn_' + bid.replace('slideViewer_', '')) : null;
                if (btn) btn.textContent = '⛶ 전체화면';
            });
        }
    });

    // 각 materialId별 전역 함수 등록 (onclick에서 호출)
    function getSlideUrlWithToken(url) {
        if (!url) return url;
        var token = localStorage.getItem('token') || localStorage.getItem('access_token');
        if (!token) return url;
        var sep = url.indexOf('?') >= 0 ? '&' : '?';
        return url + sep + 'token=' + encodeURIComponent(token);
    }

    function initSlideViewer(materialId, fileUrl) {
        // 함수 등록
        window['initSlideViewer_' + materialId] = function(fu) {
            createSlideViewer(materialId, fu);
        };
        window['navigateSlide_' + materialId] = function(dir) {
            navigateSlideFn(materialId, dir);
        };
        window['toggleFullscreen_' + materialId] = function() {
            toggleFullscreenFn(materialId);
        };
        window['handleSlideError_' + materialId] = function() {
            var loading = document.getElementById('slideLoading_' + materialId);
            if (loading) { loading.innerHTML = '<span>⚠️ 슬라이드를 불러올 수 없습니다</span>'; loading.style.display = 'flex'; }
        };
        // 실행
        createSlideViewer(materialId, fileUrl);
    }

        embed:    `<svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>`
    };

    const TYPE_LABEL_MAP = {
        document: '문서',
        video:    '영상',
        image:    '이미지',
        link:     '링크',
        embed:    '임베드'
    };

    // ===== Initialization =====
    document.addEventListener('DOMContentLoaded', async function() {
        requireAuth();
        renderSidebarUser();

        // Get course_id from URL
        const params = new URLSearchParams(window.location.search);
        courseId = params.get('course_id');

        if (!courseId) {
            showCourseSelectUI();
            return;
        }

        currentCourseId = courseId;
        await loadCourseData();
    });

    // ===== Course Selection UI (when no course_id) =====
    function showCourseSelectUI() {
        document.getElementById('courseTitle').textContent = '강좌를 선택해주세요';
        document.getElementById('materialList').innerHTML = `
            <div class="material-empty">
                <div class="empty-icon">📖</div>
                <p>URL에 강좌 ID가 필요합니다.<br>수강 강좌 페이지에서 강좌를 선택해주세요.</p>
                <button class="btn btn-primary btn-sm mt-16" onclick="window.location.href='courses.html'">강좌 목록으로 이동</button>
            </div>
        `;
        document.getElementById('materialEmpty').style.display = 'block';
        document.getElementById('materialViewerBody').style.display = 'none';
    }

    // ===== Load Course Data =====
    async function loadCourseData() {
        try {
            // Load materials, stats, and content blocks in parallel
            const [materialsRes, statsRes, blocksRes] = await Promise.all([
                apiGet(`/courses/${currentCourseId}/materials`),
                apiGet(`/courses/${currentCourseId}/progress/stats`),
                apiGet(`/headquarters/courses/${currentCourseId}/blocks`).catch((e) => {
                    // 블록 로드 실패를 조용히 삼키지 않고 콘솔에 기록 (디버깅 가능하게)
                    console.error('[learning] blocks 로드 실패:', e && e.message ? e.message : e);
                    return null;
                })
            ]);

            materials = materialsRes.data || materialsRes || [];
            currentStats = statsRes.data || statsRes || {};
            const blocksData = blocksRes?.data || blocksRes || null;
            contentBlocks = blocksData?.content_blocks || null;
            blockProgressMap = blocksData?.block_progress || null;

            // materials + content_blocks 통합 목록 구성 (총 자료수/자료 목록에 전 유형 포함)
            buildAllItems();

            // If content_blocks exist, render them as main content first
            if (contentBlocks && contentBlocks.length > 0) {
                renderContentBlocks(contentBlocks);
            }

            // Build chapters from unified items
            buildChapters();

            renderHeader();
            renderMaterialList();
            renderStats();

            // Auto-select first material (only if no blocks are shown as main content)
            if (!contentBlocks || contentBlocks.length === 0) {
                if (materials.length > 0) {
                    selectMaterial(materials[0].id);
                } else {
                    showEmptyMaterials();
                }
            }

        } catch (err) {
            console.error('Failed to load course data:', err);
            showError('자료를 불러오는데 실패했습니다. 다시 시도해주세요.');
        }
    }

    // ===== Build Unified Items (materials + content blocks) =====
    function buildAllItems() {
        allItems = [];
        // 첨부 파일 자료 (sort_order 기준, 없으면 인덱스)
        (materials || []).forEach(function(m, i) {
            allItems.push({
                kind: 'material',
                id: 'm' + m.id,
                sort: (m.sort_order != null ? m.sort_order : i * 10),
                material: m
            });
        });
        // 콘텐츠 블록 (코드/이미지/영상 등 — _morder 기준, 없으면 뒤에 배치)
        // divider(구분선)는 자료 항목이 아니므로 목록/통계에서 제외
        if (contentBlocks && contentBlocks.length) {
            contentBlocks.forEach(function(b, i) {
                if (b && b.type === 'divider') return;  // 구분선 제외
                var bp = (blockProgressMap && blockProgressMap[i]) || {};
                allItems.push({
                    kind: 'block',
                    id: 'b' + i,
                    sort: (b._morder != null ? b._morder : 1000 + i),
                    block: b,
                    blockIndex: i,
                    progress: {
                        is_completed: bp.is_completed === true,
                        progress_percent: bp.progress_percent || 0
                    }
                });
            });
        }
        // sort 오름차순 정렬
        allItems.sort(function(a, b) { return (a.sort || 0) - (b.sort || 0); });
    }

    // ===== Build Chapters =====
    function buildChapters() {
        // 챕터별 그룹핑: item.block.chapter / item.material.chapter 필드 기준으로 분류.
        // 챕터가 없는 항목은 미분류로, 항상 마지막에 배치한다.
        chapters = [];
        if (!allItems || allItems.length === 0) return;

        var groups = {};
        var order = [];
        allItems.forEach(function(item) {
            var chName = (item.block && item.block.chapter) || (item.material && item.material.chapter) || '';
            if (chName && !groups.hasOwnProperty(chName)) {
                groups[chName] = { label: chName, materials: [] };
                order.push(chName);
            }
            if (!chName && !groups.hasOwnProperty('__unclassified__')) {
                groups['__unclassified__'] = { label: '미분류', materials: [] };
                order.push('__unclassified__');
            }
            var key = chName || '__unclassified__';
            groups[key].materials.push(item);
        });

        // 정의된 챕터 먼저, 미분류는 마지막
        order.forEach(function(key) {
            chapters.push(groups[key]);
        });
    }

    // ===== Render Header =====
    function renderHeader() {
        // Try to get course name from stats or first material
        const courseName = currentStats?.course_name || materials[0]?.course_name || '학습 콘텐츠';
        document.getElementById('courseTitle').textContent = courseName;

        // Update progress bar — API returns 'completion_rate'
        const pct = currentStats?.completion_rate || 0;
        document.getElementById('courseProgressFill').style.width = pct + '%';
        document.getElementById('courseProgressText').textContent = pct + '%';
    }

    // ===== Render Stats =====
    function renderStats() {
        // 실시간 집계: 화면의 자료 목록(allItems)과 항상 일치하도록 프론트에서 직접 계산
        // (백엔드 stats는 삭제된 자료의 잔여 progress 레코드 때문에 실제 목록과 어긋날 수 있어
        //  표시 목록 기준으로 계산한다 — 새로고침/학습 진행 시 즉시 반영)
        const total = allItems.length || 0;
        let completed = 0;
        let inProgress = 0;
        allItems.forEach(function(item) {
            let p = null;
            if (item.kind === 'material') {
                const m = item.material || {};
                p = m.progress || null;
                // 로컬에서 progress_percent로 직접 갱신한 경우도 반영
                if (!p && (m.progress_percent || 0) > 0) {
                    p = { is_completed: false, progress_percent: m.progress_percent };
                }
            } else if (item.kind === 'block') {
                p = item.progress || null;
            }
            if (p) {
                if (p.is_completed === true) completed++;
                else if ((p.progress_percent || 0) > 0) inProgress++;
            }
        });
        const pct = total ? Math.round(completed / total * 100) : 0;

        document.getElementById('statTotal').textContent = total;
        document.getElementById('statCompleted').textContent = completed;
        document.getElementById('statInProgress').textContent = inProgress;
        document.getElementById('materialCount').textContent = total + '개';

        // 진행률 바도 동일 기준으로 실시간 갱신
        const fill = document.getElementById('courseProgressFill');
        if (fill) fill.style.width = pct + '%';
        const txt = document.getElementById('courseProgressText');
        if (txt) txt.textContent = pct + '%';
    }

    // ===== Render Material List (with chapters) =====
    function renderMaterialList() {

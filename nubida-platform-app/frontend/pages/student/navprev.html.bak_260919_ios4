    // ===== Select Material / Block (unified) =====
    function selectMaterial(itemId) {
        const item = allItems.find(x => x.id === itemId);
        if (!item) return;

        // 콘텐츠 블록(코드/이미지/영상) 선택
        if (item.kind === 'block') {
            selectBlock(item);
            return;
        }

        const material = item.material;

        currentMaterial = material;
        currentBlockIndex = null;  // 블록 선택 상태 해제
        currentItemId = item.id;

        // Update active state in list
        document.querySelectorAll('.material-item').forEach(el => {
            el.classList.toggle('active', el.dataset.id === itemId);
        });

        // Show viewer, hide empty state
        document.getElementById('materialEmpty').style.display = 'none';
        document.getElementById('materialViewerBody').style.display = 'flex';
        document.getElementById('materialViewerBody').style.flexDirection = 'column';
        document.getElementById('materialViewerBody').style.width = '100%';

        // 파일 자료는 완료 버튼(footer) 표시
        var footer = document.getElementById('viewerFooter');
        if (footer) footer.style.display = '';


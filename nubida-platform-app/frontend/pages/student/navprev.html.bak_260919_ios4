    // ===== 블록 완료 UI 업데이트 =====
    function updateBlockCompletionUI(item) {
        const statusEl = document.getElementById('completionStatus');
        const btn = document.getElementById('completeBtn');
        const isCompleted = item.progress?.is_completed === true;

        if (isCompleted) {
            statusEl.innerHTML = '<span>✓</span> 학습 완료';
            statusEl.className = 'completion-status completed';
            btn.textContent = '✓ 이미 완료됨';
            btn.disabled = true;
            btn.className = 'btn btn-complete completed';
        } else {
            statusEl.innerHTML = '<span>●</span> 미완료';
            statusEl.className = 'completion-status';
            btn.textContent = '✓ 학습 완료';
            btn.disabled = false;
            btn.className = 'btn btn-primary btn-complete';
        }
    }

    // ===== 블록 첫 조회 시 진행률 50% 기록 =====
    async function updateProgressOnBlock(item) {
        if (item.progress?.is_completed) return;
        if (item.progress?.progress_percent && item.progress.progress_percent > 0) return;

        try {
            await apiPost(`/courses/${currentCourseId}/progress`, {
                block_index: item.blockIndex,
                is_completed: false,
                progress_percent: 50
            });
            item.progress = { is_completed: false, progress_percent: 50 };

            // Refresh stats
            await refreshStats();

            // Re-render material list to show progress ring
            renderMaterialList();
        } catch (err) {
            console.error('Failed to update block progress:', err);
            // Non-critical — don't block user
        }
    }

    // ===== Update Toolbar (download, external link) =====
    function updateToolbar(material) {
        // 다운로드/외부열기 버튼 제거 — 뷰어 전용
        // toolbar DOM 자체가 제거되었으므로 아무 동작 안 함
    }

    // ===== Check if a file URL can be embedded =====
    function isEmbeddableFile(url) {
        const ext = url.split('.').pop().toLowerCase().split('?')[0];
        // PDF can be embedded via browser's native viewer
        // Images and videos are handled separately
        return ['pdf', 'jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'mp4', 'webm'].includes(ext);
    }

    // ===== Download File =====
    function downloadFile(url, filename) {
        if (!url || url === '#') {
            showAlert('다운로드할 파일이 없습니다.', 'warning');
            return;
        }
        // If it's a same-origin URL, trigger download
        if (url.startsWith('/')) {
            const a = document.createElement('a');
            a.href = url;
            a.download = filename || 'download';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        } else {
            // External URL — open in new tab
            window.open(url, '_blank', 'noopener,noreferrer');
        }
    }

    // ===== Download Current Material =====
    function downloadCurrentMaterial() {
        if (!currentMaterial) return;
        const fileUrl = currentMaterial.file_url || '';
        downloadFile(fileUrl, currentMaterial.title || 'download');
    }

    // ===== Render Viewer Content =====
    function renderViewerContent(material) {
        const body = document.getElementById('viewerBody');
        const type = (material.material_type || 'document').toLowerCase();

        let html = '';

        // Show description if present
        if (material.description) {
            html += `<div class="material-description"><p>${esc(material.description)}</p></div>`;
        }

        switch (type) {
            case 'document':
                html += renderDocumentViewer(material);
                break;
            case 'video':
                html += renderVideoViewer(material);
                break;
            case 'image':
                html += renderImageViewer(material);
                break;
            case 'link':
                html += renderLinkViewer(material);
                break;
            case 'embed':
                html += renderEmbedViewer(material);
                break;
            default:
                html += renderDocumentViewer(material);
        }

        body.innerHTML = html;

        // 슬라이드 뷰어 자동 초기화 (DOM에 추가된 후)
        var slideViewers = document.querySelectorAll('.slide-viewer[data-fileurl]');
        slideViewers.forEach(function(el) {
            var mid = el.getAttribute('data-material-id');
            var fu = el.getAttribute('data-fileurl');
            if (mid && fu) {
                // 전역 함수 등록
                window['initSlideViewer_' + mid] = function(f) { createSlideViewer(mid, f); };
                window['navigateSlide_' + mid] = function(d) { navigateSlideFn(mid, d); };
                window['toggleFullscreen_' + mid] = function() { toggleFullscreenFn(mid); };
                window['handleSlideError_' + mid] = function() {
                    var l = document.getElementById('slideLoading_' + mid);
                    if (l) { l.innerHTML = '<span>⚠️ 슬라이드를 불러올 수 없습니다</span>'; l.style.display = 'flex'; }
                };
                // 초기화
                createSlideViewer(mid, fu);
            }
        });
    }

    // ===== Document Viewer (PDF/PPT → 통합 슬라이드쇼 뷰어) =====
    function renderDocumentViewer(material) {
        const fileUrl = material.file_url || '';
        const embedUrl = material.embed_url || '';
        const fileName = material.file_name || material.title || '문서';
        const fileSize = material.file_size ? formatFileSize(material.file_size) : '';
        const materialId = material.id;

        // Determine file type from URL or file_name
        const ext = (fileUrl || fileName).toLowerCase();
        const isPdf = ext.includes('.pdf');
        const isPpt = ext.includes('.ppt');

        // Description
        let html = '';
        // description은 이미 renderViewerContent에서 별도 처리

        // === Case 1: Has embed_url (Google Slides 전용) ===
        if (embedUrl && embedUrl.includes('docs.google.com/presentation')) {
            // 진짜 Google Slides embed만 여기서 처리
            html += `

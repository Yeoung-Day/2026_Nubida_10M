    // ===== Update Progress on View =====
    async function updateProgressOnView(material) {
        // Only update if not completed and progress is 0 (first view)
        if (material.progress?.is_completed) return;
        if (material.progress?.progress_percent && material.progress.progress_percent > 0) return;

        try {
            const res = await apiPost(`/courses/${currentCourseId}/progress`, {
                material_id: material.id,
                is_completed: false,

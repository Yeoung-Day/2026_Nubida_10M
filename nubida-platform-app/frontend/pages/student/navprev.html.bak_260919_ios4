    // ===== Check if a URL can be embedded in an iframe =====
    function isEmbeddableLink(url) {
        try {
            const u = new URL(url);
            const host = u.hostname.toLowerCase();
            // Embeddable domains
            const embeddableDomains = [
                'docs.google.com', 'slides.google.com',
                'youtube.com', 'www.youtube.com', 'youtu.be',
                'player.vimeo.com', 'vimeo.com',
                'codepen.io', 'codesandbox.io',
                'jsfiddle.net', 'canva.com',
                'google.com', 'drive.google.com',
                'onedrive.live.com',
                'notion.so', 'www.notion.so',
                'figma.com', 'www.figma.com',
                'miro.com', 'app.miro.com',
                'padlet.com', 'padlet.org',
            ];
            // Allow same-origin and common embedding services
            if (host.includes('localhost') || host === '127.0.0.1' || !host.includes('.')) {
                return true;
            }
            return embeddableDomains.some(d => host === d || host.endsWith('.' + d));
        } catch (e) {
            return false;
        }
    }


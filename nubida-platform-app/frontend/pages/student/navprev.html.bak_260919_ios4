    // ===== Render Single Material Item (unified: material | block) =====
    function renderMaterialItem(item) {
        // 콘텐츠 블록(코드/이미지/영상) 항목
        if (item.kind === 'block') return renderBlockItem(item);

        const m = item.material;
        const type = (m.material_type || 'document').toLowerCase();
        const config = TYPE_CONFIG[type] || TYPE_CONFIG.document;
        const isActive = currentItemId === item.id || (currentMaterial && currentMaterial.id === m.id);
        const isCompleted = m.progress?.is_completed === true;
        const progress = m.progress?.progress_percent || 0;
        const isInProgress = !isCompleted && progress > 0;

        // Determine sub-badge for documents (PPT/PDF)
        let badgeHtml = '';
        if (type === 'document') {
            const fileName = (m.file_url || m.file_name || '').toLowerCase();
            if (fileName.includes('.ppt') || fileName.includes('.pptx')) {
                badgeHtml = `<span class="material-badge type-ppt">PPT</span>`;
            } else if (fileName.includes('.pdf')) {
                badgeHtml = `<span class="material-badge type-pdf">PDF</span>`;
            }
        } else if (type === 'video') {
            badgeHtml = `<span class="material-badge type-video">HD</span>`;
        } else if (type === 'embed') {
            badgeHtml = `<span class="material-badge type-embed">EMB</span>`;
        }

        // Status indicator
        let statusHtml = '';
        if (isCompleted) {
            statusHtml = `<div class="material-status"><span class="check-icon">✓</span></div>`;
        } else if (isInProgress) {
            const r = 8;
            const circumference = 2 * Math.PI * r;
            const offset = circumference - (progress / 100) * circumference;
            statusHtml = `
                <div class="material-status">
                    <div class="progress-ring">
                        <svg width="20" height="20" viewBox="0 0 20 20">
                            <circle class="bg-circle" cx="10" cy="10" r="${r}" />
                            <circle class="fg-circle" cx="10" cy="10" r="${r}"
                                stroke-dasharray="${circumference}"
                                stroke-dashoffset="${offset}" />
                        </svg>
                    </div>
                </div>
            `;
        } else {
            statusHtml = `<div class="material-status"><div class="pending-dot"></div></div>`;
        }

        return `
            <div class="material-item ${isActive ? 'active' : ''}" data-id="${item.id}" onclick="selectMaterial('${item.id}')">
                <div class="material-icon ${config.bgClass}">${config.icon}</div>
                <div class="material-info">
                    <div class="material-title">${esc(m.title || '제목 없음')} ${badgeHtml}</div>
                    <div class="material-type-label">${config.label}</div>
                </div>
                ${statusHtml}
            </div>
        `;
    }

    // ===== Render Block Item (코드/이미지/영상 등 콘텐츠 블록) =====
    function renderBlockItem(item) {
        const b = item.block || {};
        // 구분선(divider)은 학습 자료가 아니므로 목록/진행링/카운트에서 완전 제외 (안전장치)
        if (b.type === 'divider') return '';
        const cfg = BLOCK_VIEW_CONFIG[b.type] || { icon: `<svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7L12 12l8.7-5"/><path d="M12 22V12"/></svg>`, label: b.type || '블록' };

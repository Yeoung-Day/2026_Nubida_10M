     <!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>학습 콘텐츠 — 누비다플랫폼</title>
    <link rel="stylesheet" href="/common/css/nubida-bundle.css?v=20260919ios">
    <link rel="manifest" href="/manifest.json?v=20260804b">
    <meta name="theme-color" content="#4F5EF8">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="누비다">

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">

    <!-- ===== 학습 콘텐츠 전용 CSS (정돈 박스) ===== -->
    <style>
    /* ============================================================
       학습 콘텐츠 페이지 — 260913 전문 디자인 (누비다 브랜드 통일)
       포인트 컬러 #4F5EF8 / 카드 14~16px radius / 부드러운 그림자
       ※ 구조·id·class·script·onclick·href 전부 보존 (CSS 전용)
       ============================================================ */
    :root {
        --point: #4F5EF8;
        --point-soft: #EEF2FF;
        --point-line: #E0E7FF;
        --ink: #1F2437;
        --ink-2: #5A6478;
        --ink-3: #98A1B2;
        --line: #E8ECF5;
        --card-shadow: 0 1px 2px rgba(31,36,55,.04), 0 1px 3px rgba(31,36,55,.03);
        --card-shadow-lg: 0 4px 20px rgba(31,36,55,.06);
        /* 이 페이지에 한해 틸(teal) → 브랜드 블루로 통일.
           남아있는 var(--accent)/var(--primary) 참조가 전부 블루가 된다. */
        --accent: #4F5EF8;
        --accent-light: #7C8CFF;
        --accent-dark: #4350E8;
        --accent-bg: #EEF2FF;
        --primary: #4F5EF8;
        --primary-light: #7C8CFF;
        --primary-dark: #4350E8;
        --text-link: #4F5EF8;
        --border-focus: #4F5EF8;
        --accent-ring: rgba(79, 94, 248, 0.18);
        --warning: #F59E0B;
        --warning-bg: #FFFBEB;
    }

    /* ===== 코드 하이라이팅 토큰 (VS Code 스타일) ===== */
    .tok-keyword { color:#C678DD; font-weight:600 }
    .tok-string  { color:#98C379 }
    .tok-number  { color:#D19A66 }
    .tok-comment { color:#7F848E; font-style:italic }
    .tok-type    { color:#E5C07B }
    .tok-builtin { color:#56B6C2 }

    /* ===== 학습 헤더 (컴팩트 카드) ===== */
    .learning-header {
        background: #FFFFFF; border-radius: 16px;
        border: 1px solid var(--line); padding: 18px 22px;
        margin-bottom: 14px; box-shadow: var(--card-shadow);
        position: relative; overflow: hidden;
    }
    .learning-header::before {
        content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
        background: linear-gradient(180deg, var(--point), #7C8CFF);
    }
    .learning-header .course-title {
        font-size: 18px; font-weight: 800; margin: 0 0 12px;
        color: var(--ink); line-height: 1.35; letter-spacing: -0.02em;
        padding-left: 10px;
    }
    .course-progress-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; padding-left: 10px; }
    .course-progress-bar { flex: 1; height: 6px; background: #EEF1F7; border-radius: 50px; overflow: hidden; }
    .course-progress-fill {
        height: 100%; border-radius: 50px; transition: width .5s ease;
        background: linear-gradient(90deg, var(--point), #7C8CFF);
  }
    .course-progress-text {
        font-size: 12px; font-weight: 700; color: var(--point); min-width: 36px; text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* ===== 통계 행 ===== */
    .learning-stats {
        display: flex; gap: 0; padding: 14px 0 2px;
        border-top: 1px solid #F1F4FA;
    }
    .learning-stat {
        flex: 1; text-align: center;
        border-right: 1px solid #F1F4FA; padding: 2px 0;
    }
    .learning-stat:last-child { border-right: none; }
    .learning-stat .stat-num {
        display: block; font-size: 22px; font-weight: 800; color: var(--ink);
        line-height: 1.25; letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
    }
    .learning-stat .stat-num.accent { color: var(--point); }
    .learning-stat .stat-num.success { color: #10B981; }
    .learning-stat span:last-child {
        font-size: 11px; color: var(--ink-3); display: block; margin-top: 3px; font-weight: 600;
    }

    /* ===== 2단 레이아웃 ===== */
    .learning-layout { display: grid; grid-template-columns: auto 1fr; gap: 16px; min-height: 50vh; align-items: start; }
    @media (max-width: 768px) { .learning-layout { grid-template-columns: 1fr; } }

    /* 공용 번들(width:320px)보다 좁은 사이드바로 뷰어 폭 확보 */
    .material-sidebar { width: 268px !important; min-width: 268px !important; }

    /* ===== 사이드바 (고정폭 카드) ===== */
    .material-sidebar {
        background: #FFFFFF; border-radius: 16px;
        border: 1px solid var(--line); overflow: hidden;
        display: flex; flex-direction: column;
        max-height: calc(100vh - 168px);
        box-shadow: var(--card-shadow);
    }
    .material-sidebar-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 15px 18px; border-bottom: 1px solid #F1F4FA;
        background: linear-gradient(180deg, #FCFDFF, #FFFFFF);
    }
    .material-sidebar-header h3 {
        font-size: 13.5px; font-weight: 800; color: var(--ink); margin: 0;
        letter-spacing: -0.01em;
    }
    .material-count {
        font-size: 11px; font-weight: 700; color: var(--point);
        background: var(--point-soft); padding: 3px 10px; border-radius: 50px;
    }
    .material-list { flex: 1; overflow-y: auto; padding: 8px; }
    .material-list::-webkit-scrollbar { width: 6px; }
    .material-list::-webkit-scrollbar-thumb { background: #DDE3EE; border-radius: 50px; }
    .material-list::-webkit-scrollbar-thumb:hover { background: #C7D0E0; }

    /* ===== 자료 아이템 ===== */
    .material-item {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 11px; border-radius: 11px;
        cursor: pointer; transition: all .13s ease;
        margin-bottom: 2px; line-height: 1.5;
        border: 1px solid transparent;
    }
    .material-item:hover { background: #F7F9FD; border-color: #EEF1F8; }
    .material-item.active {
        background: var(--point-soft); border-color: var(--point-line);
        box-shadow: inset 3px 0 0 var(--point);
    }
    .material-item.coding-launch {
        background: linear-gradient(135deg, #EEF2FF, #F8FAFF);
        border: 1px solid var(--point-line); margin-bottom: 10px; border-radius: 12px;
    }
    .material-item.coding-launch:hover {
        background: linear-gradient(135deg, #E4EAFF, #F3F6FF);
        border-color: #C7D2FE;
    }
    .material-divider { height: 1px; background: #F1F4FA; margin: 8px 12px; }
    .material-icon {
        width: 34px; height: 34px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; flex-shrink: 0; background: #F4F6FB;
    }
    /* ===== SVG 자료 아이콘 ===== */
    .material-icon svg, .material-icon .mico { width: 17px; height: 17px; }
    .material-item .material-icon svg { width: 17px; height: 17px; }
    .material-item .material-icon.type-coding svg { width: 17px; height: 17px; }
    .empty-icon svg, .empty-icon .mico { width: 34px; height: 34px; opacity: .85; }
    .material-empty .empty-icon svg { width: 34px; height: 34px; }
    .video-meta svg { width: 13px; height: 13px; vertical-align: -2px; }
    .material-icon.type-coding svg { stroke: currentColor; }
    .material-info { flex: 1; min-width: 0; }
    .material-title {
        font-size: 13px; font-weight: 600; color: var(--ink);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.4;
    }
    .material-type-label { font-size: 10.5px; color: var(--ink-3); margin-top: 2px; line-height: 1.3; font-weight: 500; }
    .material-status { width: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .material-status .check-icon { color: #10B981; font-weight: 700; font-size: 13px; }
    .material-status .pending-dot { width: 6px; height: 6px; border-radius: 50%; background: #CBD3E0; }
    .material-status .coding-icon { color: var(--point); font-size: 13px; }

    /* ===== 진행률 링 ===== */
    .progress-ring .bg-circle { fill: none; stroke: #EEF1F7; stroke-width: 2; }
    .progress-ring .fg-circle {
        fill: none; stroke: var(--point); stroke-width: 2; stroke-linecap: round;
        transform: rotate(-90deg); transform-origin: 10px 10px;
        transition: stroke-dashoffset .3s ease;
    }

    /* ===== 챕터 ===== */
    .chapter-group { margin-bottom: 10px; }
    .chapter-header {
        display: flex; align-items: center; gap: 7px;
        padding: 7px 14px; font-size: 10.5px; font-weight: 800;
        color: var(--ink-3); text-transform: uppercase; letter-spacing: .08em;
        margin: 14px 0 4px 0;
    }
    .chapter-header:first-child { margin-top: 2px; }
    .chapter-header .chapter-dot {
        width: 6px; height: 6px; border-radius: 50%; background: var(--point);
    }

    /* ===== 자료 뱃지 ===== */
    .material-item .material-badge {
        font-size: 9px; padding: 1.5px 6px; border-radius: 50px;
        background: #F1F4FA; color: var(--ink-3); font-weight: 700;
        margin-left: 3px; letter-spacing: .02em; vertical-align: middle;
    }
    .material-item .material-badge.type-ppt { background: #FFF7ED; color: #C2410C; }
    .material-item .material-badge.type-pdf { background: #FEF2F2; color: #DC2626; }
    .material-item .material-badge.type-video { background: #EEF2FF; color: #4F5EF8; }
    .material-item .material-badge.type-embed { background: #F5F3FF; color: #7C3AED; }

    /* ===== 자료 컨텐츠 영역 (오른쪽 뷰어) ===== */
    .material-content-area {
        background: #FFFFFF; border-radius: 16px;
        border: 1px solid var(--line); overflow: hidden;
        display: flex; flex-direction: column;
        box-shadow: var(--card-shadow);
        min-width: 0;
    }
    .material-viewer { display: flex; flex-direction: column; flex: 1; min-width: 0; overflow: hidden; }
    .material-empty {
        padding: 72px 24px; text-align: center; color: var(--ink-3);
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
    }
    .material-empty .empty-icon {
        font-size: 30px; margin-bottom: 16px;
        width: 66px; height: 66px; border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, var(--point-soft), #F8FAFF);
        border: 1px solid var(--point-line);
    }
    .material-empty h3 { font-size: 15px; font-weight: 800; color: var(--ink-2); margin: 0 0 6px 0; letter-spacing: -0.01em; }
    .material-empty p { font-size: 13px; color: var(--ink-3); max-width: 300px; margin: 0; line-height: 1.65; }

    /* 뷰어 헤더 (고정) */
    .material-viewer-header {
        padding: 15px 20px;
        border-bottom: 1px solid #F1F4FA;
        display: flex; align-items: center; justify-content: space-between;
        background: linear-gradient(180deg, #FCFDFF, #FFFFFF);
    }
    .material-viewer-title { display: flex; align-items: center; gap: 9px; min-width: 0; max-width: 100%; flex: 1; }
    .material-viewer-title h2 {
        font-size: 13.5px; font-weight: 800; color: var(--ink);
        margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        letter-spacing: -0.01em;
    }
    .material-viewer-type {
        font-size: 10px; font-weight: 700; color: var(--point); background: var(--point-soft);
        padding: 3px 9px; border-radius: 50px; flex-shrink: 0;
    }
    /* 번들 CSS(.material-viewer-title .material-viewer-type)의 회색 규칙을 이긴다 */
    .material-viewer-title .material-viewer-type {
        color: var(--point); background: var(--point-soft); font-weight: 700;
    }
    /* 사이드바 활성 항목 — 이 페이지에서만 브랜드 블루 (다른 페이지 불변) */
    .sidebar-nav .nav-item.active { background: var(--point); }
    .sidebar-nav .nav-item.active .nav-label,
    .sidebar-nav .nav-item.active .icon { color: #fff; }
    /* 자료 아이콘/제목 계열의 남은 틸 참조 정리 */
    .material-icon.type-coding { background: var(--point-soft); color: var(--point); }
    /* 뷰어 바디 (유동) */
    .material-viewer-body {
        flex: 1; display: flex; flex-direction: column; min-height: 0;
        min-width: 0; max-width: 100%;
        overflow-x: hidden; overflow-y: auto;
    }
    /* 콘텐츠 블록 뷰어 — 코드 줄바꿈 */
    .material-viewer-body .content-blocks-viewer .block-code pre,
    #materialViewerBody .content-blocks-viewer .block-code pre {
        width: 100%; max-width: 100%; box-sizing: border-box;
        white-space: pre-wrap; word-break: break-word; overflow-wrap: break-word;
    }

    /* 뷰어 내부 컨텐츠 — 패딩 없이 꽉 채움 */
    .material-viewer-body .slide-viewer,
    .material-viewer-body .image-viewer,
    .material-viewer-body .ppt-viewer,
    .material-viewer-body .embed-viewer,
    .material-viewer-body .video-viewer {
        flex: 1; display: flex; flex-direction: column;
        margin: 0; max-width: 100%; border-radius: 0; border: none;
        min-width: 0;
    }
    .material-viewer-body .slide-viewer .slide-display {
        flex: 1; aspect-ratio: auto; min-height: 300px; max-height: none;
    }
    .material-viewer-body .image-viewer {
        padding: 20px; background: #F9FAFC;
        align-items: center; justify-content: center;
        min-height: 300px; flex: 1;
    }
    .material-viewer-body .image-viewer img {
        max-height: none; max-width: 100%; object-fit: contain; border-radius: 10px;
    }
    .material-viewer-body .video-player { padding: 20px; max-width: none; margin: 0; }
    .material-viewer-body .material-description {
        margin: 0 auto; padding: 18px 22px 0; max-width: none;
    }
    .material-viewer-body .ppt-embed-wrapper,
    .material-viewer-body .embed-iframe-wrapper {
        border-radius: 0; border: none; flex: 1;
    }

    /* 뷰어 푸터 (고정) */
    .material-viewer-footer {
        display: flex; align-items: center; justify-content: space-between;
        padding: 13px 20px; border-top: 1px solid #F1F4FA;
        background: linear-gradient(0deg, #FCFDFF, #FFFFFF);
    }
    .completion-status { font-size: 13px; color: var(--ink-3); display: flex; align-items: center; gap: 6px; font-weight: 600; }
    .completion-status span { font-size: 10px; }
    .completion-status.completed { color: #10B981; font-weight: 700; }

    /* ===== 뷰어 타입별 ===== */
    .document-viewer { width: 100%; }
    .ppt-viewer { width: 100%; max-width: 100%; margin: 0; }
    .ppt-embed-wrapper { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; background: #F9FAFC; border: 1px solid var(--line); }
    .ppt-embed-wrapper iframe, .ppt-embed-wrapper embed, .ppt-embed-wrapper object { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
    .video-viewer { width: 100%; }
    .video-viewer .video-embed-wrapper { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; border: 1px solid var(--line); background: #000; }
    .video-viewer .video-embed-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
    .video-player { width: 100%; max-width: 800px; margin: 0 auto; }
    .video-player video { width: 100%; border-radius: 12px; background: #000; box-shadow: 0 4px 24px rgba(31,36,55,.12); }
    .video-player-tag { width: 100%; border-radius: 12px; }
    .video-meta { text-align: left; margin-bottom: 12px; font-size: 12px; color: var(--ink-3); }
    .image-viewer { display: flex; align-items: center; justify-content: center; padding: 20px; background: #F9FAFC; border-radius: 12px; }
    .image-viewer img { max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 10px; box-shadow: 0 2px 16px rgba(31,36,55,.06); }
    .link-preview-card { max-width: 600px; margin: 0 auto; background: #F9FAFC; border-radius: 14px; border: 1px solid var(--line); padding: 22px; }
    .link-header { display: flex; align-items: flex-start; gap: 12px; }
    .link-icon { font-size: 24px; flex-shrink: 0; }
    .link-info { flex: 1; min-width: 0; }
    .link-title { font-size: 13.5px; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
    .link-url { font-size: 12px; color: var(--point); word-break: break-all; margin-bottom: 4px; }
    .link-description { font-size: 12px; color: var(--ink-3); margin-top: 4px; }
    .embed-viewer { width: 100%; max-width: 100%; margin: 0; }
    .embed-iframe-wrapper { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; border: 1px solid var(--line); background: #fff; }
    .embed-iframe-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
    .embed-viewer.full-height .embed-iframe-wrapper { padding-bottom: 75vh; }
    .link-iframe-wrapper { padding-bottom: 75vh !important; }
    .material-description { width: 100%; max-width: 800px; margin: 0 auto 20px auto; font-size: 13px; color: var(--ink-2); line-height: 1.75; text-align: left; padding: 0 18px; }
    .material-description p { margin-bottom: 8px; }

    /* ===== 슬라이드 뷰어 (다크) ===== */
    .slide-viewer { width: 100%; max-width: 100%; margin: 0; background: #131A2E; border-radius: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.06); position: relative; }
    .slide-viewer .slide-display { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #0E1729; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .slide-viewer .slide-display img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; transition: opacity .25s ease; }
    .slide-viewer .slide-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.2); color: #fff; font-size: 16px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .15s ease; z-index: 10; backdrop-filter: blur(6px); box-shadow: 0 2px 8px rgba(0,0,0,.2); }
    .slide-viewer .slide-nav:hover { background: rgba(255,255,255,.24); border-color: rgba(255,255,255,.34); }
    .slide-viewer .slide-nav.prev { left: 12px; }
    .slide-viewer .slide-nav.next { right: 12px; }
    .slide-viewer .slide-nav:disabled { opacity: .2; cursor: default; pointer-events: none; }
    .slide-viewer .slide-footer { display: flex; align-items: center; justify-content: space-between; padding: 9px 16px; background: rgba(19,26,46,.96); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
    .slide-viewer .slide-counter { font-size: 12px; font-weight: 600; opacity: .72; font-variant-numeric: tabular-nums; }
    .slide-viewer .slide-fullscreen { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.16); color: #fff; padding: 4px 11px; border-radius: 7px; cursor: pointer; font-size: 11px; font-weight: 600; transition: all .15s ease; }
    .slide-viewer .slide-fullscreen:hover { background: rgba(255,255,255,.18); }
    .slide-viewer .slide-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.35); font-size: 13px; background: #0E1729; }
    .slide-viewer.fullscreen { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; max-width: none; border-radius: 0; z-index: 10000; border: none; background: #0a0a1a; }
    .slide-viewer.fullscreen .slide-display { aspect-ratio: auto; flex: 1; height: calc(100vh - 48px); }
    .slide-viewer.fullscreen .slide-footer { background: rgba(0,0,0,.6); }

    /* ===== 완료 버튼 ===== */
    .btn-complete {
        min-width: 110px; font-size: 12.5px; font-weight: 700; padding: 8px 18px; border-radius: 10px;
        transition: all .15s ease; background: var(--point); border-color: var(--point);
    }
    .btn-complete:hover { background: #4350E8; border-color: #4350E8; }
    .btn-complete.completed { background: #10B981; color: #fff; border-color: #10B981; opacity: .7; cursor: default; }
    .btn-complete.completed:hover { opacity: .7; transform: none; }

    /* ===== 반응형 ===== */
    @media (max-width: 768px) {
        .material-description { padding: 0 10px; }
        .material-viewer-body .slide-viewer .slide-display { max-height: 40vh; min-height: 200px; }
        .learning-stats { gap: 12px; }
        .material-sidebar { max-height: 35vh; width: 100% !important; min-width: 0 !important; }
        .material-viewer-body .image-viewer { min-height: 200px; padding: 10px; }
        .learning-header .course-title { font-size: 16px; }
        .learning-header { padding: 15px 16px; }
        .learning-stat .stat-num { font-size: 19px; }
    }
    </style>
<script src="/common/js/popup.js?v=20260805a"></script>

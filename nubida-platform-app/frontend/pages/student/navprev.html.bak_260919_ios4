        } else if (b.type === 'image') {
            title = b.caption || '이미지';
        } else if (b.type === 'video') {
            title = b.caption || '영상';
        } else if (b.type === 'text') {
            title = String(b.content || '텍스트').slice(0, 25);
        } else if (b.type === 'heading') {
            title = String(b.content || '제목').slice(0, 25);
        }

        // 진행 상태 표시 (파일 자료와 동일: ✓ 완료 / 진행 링 / 대기)
        const isCompleted = item.progress?.is_completed === true;
        const progress = item.progress?.progress_percent || 0;
        const isInProgress = !isCompleted && progress > 0;

        let statusHtml = '';
        if (isCompleted) {
            statusHtml = `<div class="material-status"><span class="check-icon">✓</span></div>`;
        } else if (isInProgress) {
            const r = 8;
            const circumference = 2 * Math.PI * r;
            const offset = circumference - (progress / 100) * circumference;
            statusHtml = `
                <div class="material-status">
                    <div class="progress-ring">
                        <svg width="20" height="20" viewBox="0 0 20 20">
                            <circle class="bg-circle" cx="10" cy="10" r="${r}" />

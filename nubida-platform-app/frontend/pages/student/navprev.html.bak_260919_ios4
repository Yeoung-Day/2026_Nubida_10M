    };

    // 콘텐츠 블록 타입 설정 (자료 목록 + 뷰어 라벨)
    const BLOCK_VIEW_CONFIG = {
        code:    { icon: `<svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6"/><path d="M8 6l-6 6 6 6"/></svg>`, label: '코드' },

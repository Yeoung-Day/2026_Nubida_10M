        if (vt) vt.textContent = material.title || '제목 없음';
        var vty = document.getElementById('viewerType');
        if (vty) vty.textContent = config.label;

        // Update toolbar
        updateToolbar(material);

        // Render type-specific content
        renderViewerContent(material);

        // Update completion status
        updateCompletionUI(material);

        // Auto-update progress on view
        updateProgressOnView(material);
    }

    // ===== Select Content Block (코드/이미지/영상 등) =====
    function selectBlock(item) {
        const b = item.block || {};
        const cfg = BLOCK_VIEW_CONFIG[b.type] || { icon: `<svg class="mico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7L12 12l8.7-5"/><path d="M12 22V12"/></svg>`, label: b.type || '블록' };


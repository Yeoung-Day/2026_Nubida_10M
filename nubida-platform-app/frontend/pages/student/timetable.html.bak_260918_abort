    <script>
    // ============================================================
    // Timetable Page - Personal Schedule Management
    // ============================================================

    let personalSchedules = [];

    // ---- View Switching ----
    function switchTimetableView(view) {
        document.querySelectorAll('.tt-view-tab').forEach(t => t.classList.remove('active'));
        document.querySelector(`.tt-view-tab[data-view="${view}"]`).classList.add('active');
        document.getElementById('ttWeekView').style.display = view === 'week' ? '' : 'none';
        document.getElementById('ttListView').style.display = view === 'list' ? '' : 'none';
        if (view === 'list') loadPersonalSchedules();
    }

    // ---- Load Personal Schedules ----
    async function loadPersonalSchedules() {
        try {
            const res = await apiGet('/student/my-schedule');
            personalSchedules = Array.isArray(res) ? res : (res?.data || []);
            renderPersonalSchedules();
        } catch(e) {
            console.error('Personal schedule load error:', e);
            document.getElementById('personalScheduleList').innerHTML = 
                '<div class="tt-empty"><div class="tt-empty-icon">⚠️</div><h3>일정을 불러올 수 없습니다</h3></div>';
        }
    }

    function renderPersonalSchedules() {
        const container = document.getElementById('personalScheduleList');
        const countEl = document.getElementById('scheduleCount');
        if (!container) return;

        const count = personalSchedules.length;
        if (countEl) countEl.textContent = count + '개';

        if (count === 0) {
            container.innerHTML = `
                <div class="tt-empty">
                    <div class="tt-empty-icon">📅</div>
                    <h3>등록된 일정이 없습니다</h3>
                    <p>새 일정을 추가하여 학습 계획을 관리해보세요.</p>
                    <button class="btn btn-secondary btn-sm mt-16" onclick="openAddScheduleModal()">✚ 첫 일정 추가</button>
                </div>
            `;
            return;
        }

        // Group by date
        const grouped = {};
        personalSchedules.forEach(s => {
            const dateKey = s.date || '';
            if (!grouped[dateKey]) grouped[dateKey] = [];
            grouped[dateKey].push(s);
        });

        // Sort dates descending
        const sortedDates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));

        const weekdays = ['일', '월', '화', '수', '목', '금', '토'];

        container.innerHTML = sortedDates.map(dateKey => {
            const items = grouped[dateKey];
            const d = new Date(dateKey + 'T00:00:00');
            const dayName = weekdays[d.getDay()] || '';
            const month = d.getMonth() + 1;
            const day = d.getDate();
            const today = new Date();
            const isToday = d.toDateString() === today.toDateString();

            return `
                <div class="tt-date-group">
                    <div class="tt-date-header" style="${isToday ? 'border-bottom-color: var(--secondary);' : ''}">
                        <div class="tt-date-badge" style="${isToday ? 'background: var(--secondary);' : ''}">${day}</div>
                        <div class="tt-date-info">
                            <div class="tt-date-dayname">${isToday ? '오늘' : dayName + '요일'} · ${month}월</div>
                            <div class="tt-date-full">${dateKey}</div>
                        </div>
                        <div class="tt-date-count">${items.length}개</div>
                    </div>
                    ${items.map(s => renderScheduleCard(s)).join('')}
                </div>
            `;
        }).join('');
    }

    function renderScheduleCard(s) {
        const timeStr = (s.start_time || s.end_time) 
            ? `<span class="tt-schedule-time">🕐 ${s.start_time || ''}${s.start_time && s.end_time ? ' ~ ' : ''}${s.end_time || ''}</span>`
            : '';
        const memoStr = s.memo 
            ? `<div class="tt-schedule-memo">${esc(s.memo)}</div>` 
            : '';
        const color = s.color || '#4F5EF8';

        return `
            <div class="tt-schedule-card" style="cursor:default">
                <div class="tt-schedule-color-dot" style="background:${color}"></div>
                <div class="tt-schedule-body">
                    <div class="tt-schedule-title">${esc(s.title)}</div>
                    ${timeStr}
                    ${memoStr}
                </div>
                <div class="tt-schedule-actions">
                    <button class="tt-schedule-action-btn" onclick="event.stopPropagation(); openEditScheduleModal('${s.id}')" title="수정">✏️</button>
                    <button class="tt-schedule-action-btn danger" onclick="event.stopPropagation(); deletePersonalSchedule('${s.id}')" title="삭제">🗑️</button>
                </div>
            </div>
        `;
    }

    // ---- Add Schedule Modal ----
    function openAddScheduleModal() {
        document.getElementById('personalScheduleModalTitle').textContent = '✚ 일정 추가';
        document.getElementById('editScheduleId').value = '';
        document.getElementById('psTitle').value = '';
        document.getElementById('psDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('psStartTime').value = '';
        document.getElementById('psEndTime').value = '';
        document.getElementById('psMemo').value = '';
        document.getElementById('psColor').value = '#4F5EF8';
        document.querySelectorAll('.tt-color-option').forEach(el => el.classList.remove('active'));
        document.querySelector('.tt-color-option[data-color="#4F5EF8"]').classList.add('active');
        document.getElementById('personalScheduleSubmitBtn').textContent = '저장';
        openModal('personalScheduleModal');
    }

    function openEditScheduleModal(id) {
        const s = personalSchedules.find(x => String(x.id) === String(id));
        if (!s) return;

        document.getElementById('personalScheduleModalTitle').textContent = '✏️ 일정 수정';
        document.getElementById('editScheduleId').value = s.id;
        document.getElementById('psTitle').value = s.title || '';
        document.getElementById('psDate').value = s.date || '';
        document.getElementById('psStartTime').value = s.start_time || '';
        document.getElementById('psEndTime').value = s.end_time || '';
        document.getElementById('psMemo').value = s.memo || '';

        const color = s.color || '#4F5EF8';
        document.getElementById('psColor').value = color;
        document.querySelectorAll('.tt-color-option').forEach(el => {
            el.classList.toggle('active', el.dataset.color === color);
        });

        document.getElementById('personalScheduleSubmitBtn').textContent = '수정';
        openModal('personalScheduleModal');
    }

    function selectScheduleColor(el) {
        document.querySelectorAll('.tt-color-option').forEach(e => e.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('psColor').value = el.dataset.color;
    }

    // ---- Save Schedule ----
    async function savePersonalSchedule(event) {
        event.preventDefault();
        const id = document.getElementById('editScheduleId').value;
        const title = document.getElementById('psTitle').value.trim();
        const date = document.getElementById('psDate').value;
        const startTime = document.getElementById('psStartTime').value;
        const endTime = document.getElementById('psEndTime').value;
        const memo = document.getElementById('psMemo').value.trim();
        const color = document.getElementById('psColor').value;

        if (!title) {
            showAlert('일정 제목을 입력해주세요.', 'danger');
            return;
        }
        if (!date) {
            showAlert('날짜를 선택해주세요.', 'danger');
            return;
        }

        const data = { title, date, start_time: startTime || null, end_time: endTime || null, memo, color };

        try {
            if (id) {
                await apiPut(`/student/my-schedule/${id}`, data);
                showAlert('일정이 수정되었습니다.', 'success');
            } else {
                await apiPost('/student/my-schedule', data);
                showAlert('일정이 추가되었습니다.', 'success');
            }
            closeModal('personalScheduleModal');
            await loadPersonalSchedules();
        } catch(e) {
            console.error('Save schedule error:', e);
            showAlert('저장 중 오류가 발생했습니다.', 'danger');
        }
    }

    // ---- Delete Schedule ----
    async function deletePersonalSchedule(id) {
        if (!confirm('정말 이 일정을 삭제하시겠습니까?')) return;
        try {
            await apiDelete(`/student/my-schedule/${id}`);
            showAlert('일정이 삭제되었습니다.', 'success');
            await loadPersonalSchedules();
        } catch(e) {
            console.error('Delete schedule error:', e);
            showAlert('삭제 중 오류가 발생했습니다.', 'danger');
        }
    }


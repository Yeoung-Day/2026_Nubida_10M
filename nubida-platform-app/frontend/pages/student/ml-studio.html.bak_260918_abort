            <button class="btn btn-primary" onclick="openCreateProject()">＋ 첫 프로젝트 만들기</button>
        </div>

        <!-- 스튜디오 3열 레이아웃 -->
        <div id="studioBox" style="display:none;">
            <div class="ml-studio-grid">

                <!-- 좌: 카메라/수집 -->
                <div class="card card-premium ml-panel">
                    <div class="ml-panel-title" id="panelTitle">샘플 수집</div>
                    <!-- 입력 모드 전환 (이미지/음성) -->
                    <div class="ml-mode-switch">
                        <button class="ml-mode-btn active" id="modeBtnImage" onclick="initStudio('image')">이미지</button>
                        <button class="ml-mode-btn" id="modeBtnAudio" onclick="initStudio('audio')">음성</button>
                    </div>
                    <!-- 성능: 저사양 고정 (선택 UI 제거 — 260913 윤비스 지시) -->
                    <!-- 이미지 패널 -->
                    <div id="cameraPanel">
                        <div class="ml-camera-wrap">
                            <video id="cameraVideo" autoplay playsinline muted></video>
                            <canvas id="captureCanvas" width="224" height="224" style="display:none;"></canvas>
                            <div class="ml-camera-overlay" id="cameraOverlay">
                                <div class="ml-camera-hint" id="cameraHint">카메라를 켜려면 [카메라 켜기]를 누르세요</div>
                            </div>
                            <div class="ml-camera-badge" id="cameraBadge" style="display:none;">● LIVE</div>
                        </div>
                        <div class="ml-camera-actions">
                            <button class="btn btn-secondary btn-sm" id="btnCameraToggle" onclick="toggleCamera()">📷 카메라 켜기</button>
                            <button class="btn btn-secondary btn-sm" id="btnCameraFlip" onclick="flipCamera()" style="display:none;">🔄 전환</button>
                            <button class="btn btn-primary btn-sm" id="btnCapture" onclick="captureSample()" disabled>📸 촬영</button>
                            <label class="btn btn-secondary btn-sm ml-file-btn">📁 파일<input type="file" id="fileInput" accept="image/*" multiple style="display:none;" onchange="handleFiles(this.files)"></label>
                        </div>
                        <div class="ml-capture-hold" id="holdCapture" style="display:none;">
                            <button class="btn btn-accent ml-hold-btn" id="btnHold"
                                onmousedown="startHoldCapture()" onmouseup="stopHoldCapture()" onmouseleave="stopHoldCapture()"
                                ontouchstart="startHoldCapture()" ontouchend="stopHoldCapture()" ontouchcancel="stopHoldCapture()">🎯 꾹 눌러 다중 수집</button>
                            <span class="ml-hold-count" id="holdCount">0장</span>
                        </div>
                        <!-- BLE 연결 — 카메라 모드에서도 이 화면에서 바로 연결+분류 (260913 윤비스 지시) -->
                        <div class="ml-serial-box" id="serialBoxStudioCam" style="margin-top:12px;">
                            <div class="ml-serial-head">
                                <span class="ml-serial-status" id="serialStatusStudioCam" style="margin-bottom:0;">📡 블루투스 미연결</span>
                                <button class="btn btn-primary btn-sm" id="btnSerialStudioCam" onclick="toggleSerialStudio()">🔗 아두이노 연결 (연결 후 카메라 분류)</button>
                            </div>
                        </div>
                    </div>
                    <!-- 음성 패널 (마이크 입력 — 스펙트로그램 기반) -->
                    <div id="audioPanel" style="display:none;">
                        <div class="ml-audio-wrap">
                            <canvas id="audioWaveCanvas" width="448" height="64"></canvas>
                            <canvas id="audioSpecCanvas" width="224" height="224"></canvas>
                            <div class="ml-camera-overlay" id="audioOverlay">
                                <div class="ml-camera-hint" id="audioHint">마이크가 꺼져 있어요. [🎙️ 마이크 시작]을 누르면 소리를 녹음할 수 있어요.</div>
                            </div>
                            <div class="ml-camera-badge" id="audioBadge" style="display:none;">● MIC</div>
                        </div>
                        <!-- 특징 방식: MFCC 고정 (스펙트로그램 토글 제거 — 260913 윤비스 지시) -->
                        <div class="ml-camera-actions">
                            <button class="btn btn-secondary btn-sm" id="btnMicToggle" onclick="toggleMic()">🎙️ 마이크 시작</button>
                            <button class="btn btn-primary btn-sm" id="btnAudioCapture" onclick="captureSample()" disabled>🔴 3초 녹음</button>
                            <button class="btn btn-secondary btn-sm" id="btnAudioPlay" onclick="playLastRecording()" disabled>▶️ 재생</button>
                        </div>
                        <!-- BLE 연결 — 음성 모드에서도 이 화면에서 바로 연결+분류 (260913 윤비스 지시) -->
                        <div class="ml-serial-box" id="serialBoxStudioAudio" style="margin-top:12px;">
                            <div class="ml-serial-head">
                                <span class="ml-serial-status" id="serialStatusStudioAudio" style="margin-bottom:0;">📡 블루투스 미연결</span>
                                <button class="btn btn-primary btn-sm" id="btnSerialStudioAudio" onclick="toggleSerialStudio()">🔗 아두이노 연결 (연결 후 바로 분류)</button>
                            </div>
                        </div>
                    </div>
                    <p class="ml-help" id="panelHelp">클래스를 선택한 뒤 촬영/녹음하면 샘플이 쌓여요. 클래스당 20장 이상 권장!</p>
                </div>

                <!-- 좌하/중앙: 클래스 목록 -->
                <div class="card card-premium ml-panel">
                    <div class="ml-panel-title">클래스 (라벨)</div>
                    <div class="ml-classes-head">
                        <button class="btn btn-secondary btn-sm" onclick="addClass()">＋ 클래스 추가</button>
                        <button class="btn btn-accent btn-sm" id="btnPreset" onclick="openPresetModal()" title="수업 시작 전 바로 학습할 수 있는 기본 샘플 세트를 불러와요">사전학습 세트</button>
                        <span class="ml-class-total" id="classTotal">샘플 0장</span>
                    </div>
                    <div class="ml-class-list" id="classList"></div>
                </div>

                <!-- 중앙: 학습 -->
                <div class="card card-premium ml-panel">
                    <div class="ml-panel-title">학습</div>
                    <div class="ml-train-info" id="trainInfo">클래스를 2개 이상 만들고, 각각 5장 이상 수집하면 학습할 수 있어요.</div>
                    <button class="btn btn-primary btn-block" id="btnTrain" onclick="trainModel()" disabled>⚙️ 모델 학습 시작</button>
                    <div class="ml-progress" id="trainProgress" style="display:none;">
                        <div class="ml-progress-label"><span id="trainStatus">준비 중...</span><span id="trainPct">0%</span></div>
                        <div class="ml-progress-bar"><div class="ml-progress-fill" id="trainFill" style="width:0%"></div></div>
                        <canvas id="lossCanvas" width="260" height="80" style="width:100%;height:80px;margin-top:8px;"></canvas>
                    </div>
                    <div id="trainDone" class="ml-train-done" style="display:none;">
                        <p>🎉 학습 완료! 실시간 분류를 테스트해 보세요.</p>
                        <!-- ★ 10차: 학습 완료 시 모델이 서버에 자동 저장되므로
                             [💾 모델 저장] 버튼은 기본적으로 숨긴다. 서버 저장에 실패한
                             경우에만 JS(saveModelToServerCore 실패 경로)가 이 버튼을 노출한다. -->
                        <button id="btnSaveModelManual" class="btn btn-secondary btn-sm" style="display:none;" onclick="saveModelToServer()">💾 모델 저장 (재시도)</button>
                    </div>
                </div>

                <!-- 우: 실시간 분류 -->
                <div class="card card-premium ml-panel">
                    <div class="ml-panel-title">실시간 분류</div>
                    <button class="btn btn-primary btn-block" id="btnClassify" onclick="toggleClassify()" disabled>🎯 분류 시작</button>
                    <div class="ml-result" id="resultBox">
                        <div class="ml-result-empty">학습 완료 후 분류를 시작하면<br>여기에 결과가 표시돼요.</div>
                    </div>
                    <div class="ml-result-top" id="resultTop" style="display:none;">
                        <div class="ml-result-label" id="resultLabel">—</div>
                        <div class="ml-result-pct" id="resultPct">0%</div>
                    </div>
                    <!-- BLE 연결 — 이 버튼 하나로 연결 + 분류 시작까지 (하단 공용 박스) -->
                    <div class="ml-serial-box" id="serialBoxStudio" style="margin-top:12px;">
                        <div class="ml-serial-head">
                            <span class="ml-serial-status" id="serialStatusStudio" style="margin-bottom:0;">📡 블루투스 미연결</span>
                            <button class="btn btn-primary btn-sm" id="btnSerialStudio" onclick="toggleSerialStudio()">🔗 아두이노 연결 (연결 후 바로 분류)</button>
                        </div>
                        <!-- 📡 아두이노 통신 로그 — 진단용(260914). 스마트폰에서 바로 확인 가능 -->
                        <details class="ml-comm-log" id="studioCommWrap">
                            <summary>📡 아두이노 통신 로그 <span id="studioCommCount">(0)</span>
                                <span style="font-weight:400;color:#6B7280;">— 필요할 때 펼쳐서 확인</span>
                            </summary>
                            <div class="ml-comm-log-body" id="studioCommLog"></div>
                            <div class="ml-comm-log-actions">
                                <button type="button" class="btn btn-secondary btn-sm" onclick="clearStudioCommLog()">지우기</button>
                                <button type="button" class="btn btn-secondary btn-sm" onclick="copyStudioCommLog()">복사</button>
                            </div>
                        </details>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

<!-- 프로젝트 생성 모달 -->
<div class="modal-overlay" id="createProjectModal" style="display:none;">
    <div class="modal">
        <div class="modal-header"><h3>새 프로젝트</h3></div>
        <div class="modal-body">
            <label class="form-label">프로젝트 이름</label>
            <input type="text" id="newProjectTitle" class="form-input" maxlength="60" placeholder="예: 가위바위보 인식기">
            <label class="form-label">설명 (선택)</label>
            <input type="text" id="newProjectDesc" class="form-input" maxlength="200" placeholder="어떤 것을 학습하나요?">
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeCreateProject()">취소</button>
            <button class="btn btn-primary" onclick="createProject()">만들기</button>
        </div>
    </div>
</div>

<!-- 클래스 추가 모달 (네이티브 prompt 대체 — 헤드리스/모바일 호환) -->
<div class="modal-overlay" id="classModal" style="display:none;">
    <div class="modal">
        <div class="modal-header"><h3>새 클래스 추가</h3></div>
        <div class="modal-body">
            <label class="form-label">클래스(라벨) 이름</label>
            <input type="text" id="classModalInput" class="form-input" maxlength="50" placeholder="예: 440Hz, 880Hz, 손, 주먹">
            <p class="form-help" style="margin-top:6px;font-size:12px;color:#8a8f98;">같은 이름의 클래스는 중복 생성할 수 없어요.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeClassModal()">취소</button>
            <button class="btn btn-primary" onclick="confirmAddClass()">추가</button>
        </div>
    </div>
</div>

<!-- 사전학습(기본) 세트 불러오기 모달 -->
<div class="modal-overlay" id="presetModal" style="display:none;">
    <div class="modal">
        <div class="modal-header"><h3>사전학습 세트</h3></div>
        <div class="modal-body">
            <div id="presetChips" style="display:none;flex-wrap:wrap;gap:6px;margin:0 0 10px;"></div>
            <p id="presetDesc" style="margin:0 0 10px;font-size:13px;color:#555;"></p>
            <div id="presetSetList"></div>
            <div id="presetProgress" style="display:none;margin-top:12px;">
                <div class="ml-progress-label"><span id="presetStatus">준비 중...</span><span id="presetPct">0%</span></div>
                <div class="ml-progress-bar"><div class="ml-progress-fill" id="presetFill" style="width:0%"></div></div>
            </div>
            <p class="form-help" style="margin:10px 0 0;">이미 같은 이름의 클래스가 있으면 건너뛰고, 새 클래스만 추가돼요. 추가된 샘플은 직접 수집한 샘플과 동일하게 학습에 사용됩니다.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" id="presetBtnCancel" onclick="closePresetModal()">취소</button>
            <button class="btn btn-primary" id="presetBtnLoad" onclick="confirmLoadPreset()">불러오기</button>
        </div>
    </div>
</div>

<!-- 삭제 확인 모달 (네이티브 confirm 대체) -->
<div class="modal-overlay" id="confirmModal" style="display:none;">
    <div class="modal">
        <div class="modal-header"><h3>삭제 확인</h3></div>
        <div class="modal-body">
            <p id="confirmModalMsg" style="margin:0;">삭제할까요?</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeConfirmModal()">취소</button>
            <button class="btn btn-danger" onclick="confirmRemoveClass()">삭제</button>
        </div>
    </div>
</div>


}
.ml-hold-btn:not(:disabled):hover { background: #4553E8 !important; }

/* ── 경고 안내문 — 노랑 제거, 뉴트럴 블루 ───────────────────────── */
.ml-train-info.ml-train-warn {
    background: #F7F9FD !important;

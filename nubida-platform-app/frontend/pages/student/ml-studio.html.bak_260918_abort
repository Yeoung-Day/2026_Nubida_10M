    color: #1F2437 !important;
}
.ml-panel .btn-accent,
.ml-empty .btn-accent {
    background: #EEF2FF !important;
    color: #4F5EF8 !important;
    border: 1px solid #DCE3FF !important;
    box-shadow: none !important;
}
.ml-panel .btn-accent:hover:not(:disabled) {
    background: #E3E9FF !important;
    border-color: #C7D2FE !important;
}
.ml-panel .btn-primary:disabled,
.ml-panel .btn-secondary:disabled,
.ml-panel .btn-accent:disabled {

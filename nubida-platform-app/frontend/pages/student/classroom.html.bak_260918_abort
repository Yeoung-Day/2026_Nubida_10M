    <script>
        // Placeholder handlers (safety net for buttons)
        function switchClassTab(tab, btn) { showAlert('원격수업 탭 전환: ' + tab, 'info'); }
        function leaveSession() { showAlert('수업에서 나갑니다.', 'info'); }
        function checkinAttendance() { showAlert('출석이 확인되었습니다.', 'success'); }
        function confirmJoin() { showAlert('수업에 참여합니다.', 'info'); }
    </script>
    

        <main class="main-content">
            <div class="top-nav"><div class="top-nav-left"><button class="hamburger-btn" id="hamburgerBtn" aria-label="메뉴 열기">☰</button><h1>🎥 원격수업</h1></div>
                <div class="top-nav-right">
                    <span class="small-text" id="todayDate"></span>
                </div>
            </div>

            <!-- Tab Bar -->
            <div class="class-tab-bar">
                <button class="class-tab-item active" onclick="switchClassTab('upcoming', this)">📅 예정된 수업</button>
                <button class="class-tab-item" onclick="switchClassTab('past', this)">📋 지난 수업</button>
            </div>

            <!-- List View -->
            <div class="list-view" id="listView">
                <!-- Upcoming Classes -->
                <div id="upcomingTab">
                    <div class="flex-between mb-24">
                        <p class="small-text" id="upcomingCount">다가오는 수업</p>
                    </div>
                    <div class="class-grid" id="upcomingClasses">
                        <div class="empty-state"><div class="empty-icon">⏳</div><h3>로딩 중...</h3></div>
                    </div>
                </div>

                <!-- Past Classes -->
                <div id="pastTab" style="display:none">
                    <div class="flex-between mb-24">
                        <p class="small-text" id="pastCount">지난 수업</p>
                    </div>
                    <div class="class-grid" id="pastClasses">
                        <div class="empty-state"><div class="empty-icon">⏳</div><h3>로딩 중...</h3></div>
                    </div>
                </div>
            </div>

            <!-- In-Session View -->
            <div class="session-view" id="sessionView">
                <div class="flex-between mb-16">
                    <button class="back-btn" onclick="leaveSession()">← 목록으로 돌아가기</button>
                    <div>
                        <span class="badge badge-success" id="sessionStatusBadge">📡 진행중</span>
                        <span class="small-text ml-8" id="sessionTimer"></span>
                    </div>
                </div>
                <div class="session-layout">
                    <div class="video-area" id="videoArea">
                        <div class="video-placeholder">
                            <div class="video-icon">📺</div>
                            <p><strong>수업 화면</strong></p>
                            <p class="small-text" id="sessionTitleDisplay">수업 제목</p>
                            <p class="small-text" style="margin-top:var(--space-3);color:var(--sidebar-text-secondary)">🔒 WebRTC 연결 대기 중...</p>
                        </div>
                        <div class="video-controls">
                            <button class="vc-btn" title="마이크" id="micBtn">🎤</button>
                            <button class="vc-btn" title="카메라" id="camBtn">📹</button>
                            <button class="vc-btn" title="화면 공유">🖥️</button>
                            <button class="vc-btn danger" title="나가기" onclick="leaveSession()">📞</button>
                        </div>
                    </div>
                    <div class="session-side-panel">
                        <div class="attendance-checkin" id="checkinArea">
                            <span class="checkin-status pending" id="checkinStatus">✅ 출석 체크 필요</span>
                            <button class="btn btn-filled btn-sm" id="checkinBtn" onclick="checkinAttendance()">출석하기</button>
                        </div>
                        <div class="panel-card">
                            <div class="panel-header">📎 수업 자료</div>
                            <div class="panel-body" id="sessionMaterials">
                                <div class="small-text" style="color:var(--text-tertiary)">자료가 없습니다</div>
                            </div>
                        </div>
                        <div class="panel-card">
                            <div class="panel-header">📝 실시간 노트</div>
                            <div class="panel-body" id="sessionNotes">
                                <div class="small-text" style="color:var(--text-tertiary)">아직 노트가 없습니다</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Join Confirmation Modal -->
            <div class="modal-overlay" id="joinModal">
                <div class="modal">
                    <h2>🔗 수업 참여</h2>
                    <p class="small-text mb-16" id="joinModalInfo">수업에 참여하시겠습니까?</p>
                    <div class="card p-16 mb-16" style="background:var(--bg-subtle)">
                        <div class="flex-between"><span class="small-text">수업명</span><strong id="joinTitle">-</strong></div>
                        <div class="flex-between mt-8"><span class="small-text">강좌</span><span id="joinCourse">-</span></div>
                        <div class="flex-between mt-8"><span class="small-text">시간</span><span id="joinTime">-</span></div>
                    </div>
                    <div class="modal-actions">
                        <button class="btn btn-outline" onclick="closeModal('joinModal')">취소</button>
                        <button class="btn btn-filled" onclick="confirmJoin()">참여하기</button>
                    </div>
                </div>
            </div>

            <!-- View Recording Modal -->
            <div class="modal-overlay" id="recordingModal">
                <div class="modal" style="max-width:560px">
                    <h2>📹 녹화 영상</h2>
                    <div class="card p-16 mb-16" style="background:var(--bg-subtle);min-height:200px;display:flex;align-items:center;justify-content:center">
                        <div class="empty-state"><div class="empty-icon" style="font-size:32px">🎬</div><p>영상 플레이어 영역</p></div>
                    </div>
                    <div id="recordingInfo"></div>
                    <div class="modal-actions">
                        <button class="btn btn-outline" onclick="closeModal('recordingModal')">취소</button>
                    </div>
                </div>
            </div>
        </main>
    </div>


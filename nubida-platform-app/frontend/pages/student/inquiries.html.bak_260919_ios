    <script src="/common/js/utils.js?v=20260804b"></script>
    <script>
        let uploadedImages = [];

        function esc(s) {
            if (s == null) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function nl2br(s) {
            if (!s) return '';
            return esc(s).replace(/\n/g, '<br>');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const user = getCurrentUser();
            if (user) {
                document.getElementById('sidebarUserName').textContent = user.name || user.username || '사용자';
                document.getElementById('sidebarUserRole').textContent = '학생';
            }
            const now = new Date();
            document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });
            loadMyInquiries();

            // 이미지 업로드 핸들러
            document.getElementById('imageInput').addEventListener('change', handleImageUpload);
        });

        // 이미지 업로드 처리
        async function handleImageUpload(e) {
            const files = e.target.files;
            if (!files.length) return;

            const btn = document.getElementById('imageUploadBtn');
            btn.classList.add('uploading');
            btn.textContent = '업로드 중...';

            for (const file of files) {
                if (file.size > 10 * 1024 * 1024) {
                    alert('파일 크기는 10MB 이하여야 합니다: ' + file.name);
                    continue;
                }

                try {
                    const formData = new FormData();
                    formData.append('file', file);

                    const token = localStorage.getItem('token') || localStorage.getItem('access_token');
                    const res = await fetch('/api/v1/inquiries/upload-image', {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}` },
                        body: formData,
                    });
                    const json = await res.json();
                    if (json.status === 'success') {
                        const url = json.data.url;
                        uploadedImages.push(url);
                        addPreviewImage(url);
                    } else {
                        alert('업로드 실패: ' + (json.message || ''));
                    }
                } catch(err) {
                    alert('업로드 오류: ' + err.message);
                }
            }

            btn.classList.remove('uploading');
            btn.innerHTML = '사진 추가';
            e.target.value = '';
        }

        function addPreviewImage(url) {
            const wrap = document.getElementById('imagePreviewWrap');
            const div = document.createElement('div');
            div.className = 'image-preview-item';
            div.innerHTML = `<img src="${url}"><button class="remove-img" onclick="removeImage(this)">✕</button>`;
            div.dataset.url = url;
            wrap.appendChild(div);
        }

        function removeImage(btn) {
            const item = btn.parentElement;
            const url = item.dataset.url;
            uploadedImages = uploadedImages.filter(u => u !== url);
            item.remove();
        }

        function setQuick(title, content) {
            document.getElementById('inquiryTitle').value = title;
            document.getElementById('inquiryContent').value = content;
            document.getElementById('inquiryContent').focus();
        }

        async function submitInquiry() {
            const title = document.getElementById('inquiryTitle').value.trim();
            const content = document.getElementById('inquiryContent').value.trim();

            if (!title) { alert('제목을 입력해주세요.'); return; }
            if (!content) { alert('내용을 입력해주세요.'); return; }

            const btn = document.querySelector('.btn-primary');
            btn.disabled = true;
            btn.textContent = '전송 중...';

            try {
                const params = new URLSearchParams({ title, content });
                // 이미지가 있으면 image_path에 첫 번째 이미지 URL 전달
                if (uploadedImages.length > 0) {
                    params.set('image_path', uploadedImages[0]);
                }
                const res = await apiPost('/inquiries/create?' + params.toString());
                if (res && res.status === 'success') {
                    alert('✅ Q&A가 등록되었습니다.\n본사에서 확인 후 답변드리겠습니다.');
                    document.getElementById('inquiryTitle').value = '';
                    document.getElementById('inquiryContent').value = '';
                    document.getElementById('imagePreviewWrap').innerHTML = '';
                    uploadedImages = [];
                    loadMyInquiries();
                } else {
                    alert('❌ ' + (res.message || '등록에 실패했습니다.'));
                }
            } catch(e) {
                alert('❌ 오류가 발생했습니다: ' + (e.message || '알 수 없는 오류'));
            } finally {
                btn.disabled = false;
                btn.textContent = '질문 보내기';
            }
        }

        async function loadMyInquiries() {
            try {
                const res = await apiGet('/inquiries/my');
                const items = res && res.data;
                const el = document.getElementById('inquiryListBody');

                if (!items || items.length === 0) {
                    el.innerHTML = '<div class="empty-state"><div class="big-icon">📝</div><div class="text">아직 Q&A 내역이 없습니다</div><div style="font-size:12px;color:#D1D5DB;margin-top:4px;">위 폼에서 질문을 등록해보세요</div></div>';
                    document.getElementById('inquiryCount').textContent = '0건';
                    return;
                }

                document.getElementById('inquiryCount').textContent = items.length + '건';

                el.innerHTML = items.map(item => {
                    const isAnswered = item.status === 'answered';
                    const hasImage = item.image_path && item.image_path !== 'null';
                    const previewText = esc((item.content || '').slice(0, 100));
                    return `<div class="inquiry-card" onclick="openInquiryDetail(${item.id})">
                        <div class="ic-top">
                            <div class="ic-title">${esc(item.title)}</div>
                            <div class="ic-status"><span class="${isAnswered ? 'badge-answered' : 'badge-pending'}">${isAnswered ? '답변완료' : '대기중'}</span></div>
                        </div>
                        <div class="ic-preview">${previewText}${(item.content || '').length > 100 ? '...' : ''}</div>
                        ${hasImage ? `<div style="margin-top:6px;"><img src="${esc(item.image_path)}" class="inquiry-attach" style="max-width:200px;max-height:120px;border-radius:6px;border:1px solid #E5E7EB;" onclick="event.stopPropagation();window.open('${esc(item.image_path)}','_blank')"></div>` : ''}
                        <div class="ic-date">${item.created_at ? new Date(item.created_at).toLocaleString('ko-KR') : ''}</div>
                        ${isAnswered ? `<div class="ic-answer"><div class="label">본사 답변</div><div class="text">${nl2br(item.answer)}</div><div class="meta">${item.answered_by_name || '본사'} · ${item.answered_at ? new Date(item.answered_at).toLocaleString('ko-KR') : ''}</div></div>` : ''}
                    </div>`;
                }).join('');
            } catch(e) {
                console.error('Load error:', e);
            }
        }

        // 간단한 상세 보기 모달 (선택)
        function openInquiryDetail(id) {
            // 현재는 클릭 가능하도록만 설정 (추후 확장)
        }

        function handleLogout() {
            localStorage.removeItem('token');
            localStorage.removeItem('access_token');
            localStorage.removeItem('user');
            window.location.href = '/pages/login.html';
        }
    </script>

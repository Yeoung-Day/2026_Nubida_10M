    <style id="inq-design">
        /* ==== Nubida student Q&A — refined design tokens ==== */
        :root {
            --point:#4F5EF8;
            --point-soft:#EEF2FF;
            --border:#E8ECF5;
            --label:#98A1B2;
            --text:#1F2437;
            --text-2:#5A6478;
            --shadow-soft:0 1px 2px rgba(31,36,55,.04), 0 1px 3px rgba(31,36,55,.03);
        }

        /* page backdrop */
        .main-content {
            background:linear-gradient(180deg,#FBFCFE 0%,#F6F8FC 100%);
        }

        /* ---- top nav heading ---- */
        .top-nav h1 {
            font-size:20px;
            font-weight:700;
            letter-spacing:-0.01em;
            color:var(--text);
            display:inline-flex;
            align-items:center;
            gap:8px;
        }
        .top-nav h1::before {
            content:"";
            width:20px; height:20px;
            background:no-repeat center/contain url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234F5EF8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.7'/><circle cx='12' cy='17' r='.6' fill='%234F5EF8'/></svg>");
            flex:none;
        }
        .small-text { color:var(--label); font-size:12px; }

        /* ================= 작성 폼 (form card) ================= */
        .inquiry-form {
            position:relative;
            background:#fff;
            border:1px solid var(--border);
            border-radius:16px;
            padding:28px 28px 24px;
            margin-bottom:22px;
            box-shadow:var(--shadow-soft);
        }
        .inquiry-form h3 {
            font-size:16px;
            font-weight:700;
            letter-spacing:-0.01em;
            color:var(--text);
            margin:0 0 8px 0;
            display:flex;
            align-items:center;
            gap:9px;
        }
        .inquiry-form h3::before {
            content:"";
            width:26px; height:26px;
            border-radius:8px;
            background:var(--point-soft);
            background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234F5EF8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20h9'/><path d='M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z'/></svg>");
            background-repeat:no-repeat;
            background-position:center;
            background-size:15px 15px;
            flex:none;
        }
        .inquiry-form > p {
            font-size:12.5px !important;
            color:var(--text-2) !important;
            line-height:1.6;
            margin:0 0 22px 0 !important;
            padding-bottom:20px;
            border-bottom:1px solid var(--border);
        }
        .inquiry-form .form-group { margin-bottom:18px; }
        .inquiry-form label {
            display:block;
            font-size:12px;
            font-weight:600;
            letter-spacing:0.01em;
            color:var(--label);
            margin-bottom:7px;
        }
        .inquiry-form input.form-input,
        .inquiry-form textarea.form-input {
            width:100%;
            box-sizing:border-box;
            font-size:14px;
            color:var(--text);
            background:#fff;
            border:1px solid var(--border);
            border-radius:10px;
            padding:11px 14px;
            line-height:1.6;
            transition:border-color .16s ease, box-shadow .16s ease, background .16s ease;
            font-family:inherit;
        }
        .inquiry-form input.form-input::placeholder,
        .inquiry-form textarea.form-input::placeholder { color:#AEB6C6; }
        .inquiry-form input.form-input:hover,
        .inquiry-form textarea.form-input:hover { border-color:#D8DEEB; }
        .inquiry-form input.form-input:focus,
        .inquiry-form textarea.form-input:focus {
            outline:none;
            border-color:var(--point);
            box-shadow:0 0 0 3px rgba(79,94,248,.1);
        }
        .inquiry-form textarea.form-input { min-height:130px; resize:vertical; }

        /* 이미지 업로드 */
        .image-upload-area {
            display:flex;
            gap:12px;
            align-items:center;
            flex-wrap:wrap;
        }
        .image-upload-btn {
            display:inline-flex;
            align-items:center;
            gap:7px;
            padding:9px 16px;
            border:1px dashed #D3DAE8;
            border-radius:10px;
            cursor:pointer;
            font-size:12.5px;
            font-weight:500;
            color:var(--text-2);
            transition:all .16s ease;
            background:#FCFDFF;
        }
        .image-upload-btn::before {
            content:"";
            width:15px; height:15px;
            background:no-repeat center/contain url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235A6478' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='16' rx='2.5'/><circle cx='8.5' cy='9.5' r='1.5'/><path d='M21 16l-5-5-4 4-3-3-6 6'/></svg>");
            flex:none;
        }
        .image-upload-btn:hover {
            border-color:var(--point);
            color:var(--point);
            background:var(--point-soft);
        }
        .image-upload-btn:hover::before {
            background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234F5EF8' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='16' rx='2.5'/><circle cx='8.5' cy='9.5' r='1.5'/><path d='M21 16l-5-5-4 4-3-3-6 6'/></svg>");
        }
        .image-upload-btn.uploading { opacity:.55; pointer-events:none; }
        .image-upload-area > span {
            font-size:11.5px !important;
            color:var(--label) !important;
            align-self:center;
        }
        .image-preview-wrap { display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; }
        .image-preview-item {
            position:relative;
            width:82px; height:82px;
            border-radius:10px;
            overflow:hidden;
            border:1px solid var(--border);
            box-shadow:var(--shadow-soft);
        }
        .image-preview-item img { width:100%; height:100%; object-fit:cover; display:block; }
        .image-preview-item .remove-img {
            position:absolute; top:4px; right:4px;
            width:20px; height:20px;
            background:rgba(31,36,55,.62);
            backdrop-filter:blur(2px);
            border:none; border-radius:50%;
            color:#fff; font-size:11px; line-height:1;
            cursor:pointer;
            display:flex; align-items:center; justify-content:center;
            transition:background .15s ease;
        }
        .image-preview-item .remove-img:hover { background:rgba(31,36,55,.85); }

        /* 제출 버튼 행 */
        .inquiry-form > div:last-child {
            margin-top:6px;
            padding-top:18px;
            border-top:1px solid var(--border);
        }
        .inquiry-form .btn {
            padding:11px 22px;
            font-size:13.5px;
            font-weight:600;
            border-radius:10px;
            transition:all .16s ease;
        }
        .inquiry-form .btn-primary {
            background:var(--point);
            color:#fff;
            border:1px solid var(--point);
            box-shadow:0 1px 2px rgba(79,94,248,.22);
        }
        .inquiry-form .btn-primary:hover:not(:disabled) {
            background:#4351E8;
            border-color:#4351E8;
            box-shadow:0 3px 10px rgba(79,94,248,.28);
            transform:translateY(-1px);
        }
        .inquiry-form .btn-primary:disabled { opacity:.55; cursor:not-allowed; box-shadow:none; transform:none; }

        /* ================= 내 Q&A 내역 (list card) ================= */
        .inquiry-list {
            background:#fff;
            border:1px solid var(--border);
            border-radius:16px;
            overflow:hidden;
            box-shadow:var(--shadow-soft);
        }
        .inquiry-list-header {
            padding:17px 24px;
            border-bottom:1px solid var(--border);
            font-size:14.5px;
            font-weight:700;
            letter-spacing:-0.01em;
            color:var(--text);
            display:flex;
            justify-content:space-between;
            align-items:center;
            background:linear-gradient(180deg,#FDFEFF 0%,#FAFBFE 100%);
        }
        .inquiry-list-header > span:first-child {
            display:inline-flex;
            align-items:center;
            gap:9px;
        }
        .inquiry-list-header > span:first-child::before {
            content:"";
            width:4px; height:16px;
            border-radius:3px;
            background:var(--point);
            flex:none;
        }
        .inquiry-list-header .small-text {
            font-size:12px;
            font-weight:600;
            color:var(--text-2);
            background:var(--point-soft);
            padding:3px 10px;
            border-radius:20px;
        }

        .inquiry-card {
            border-bottom:1px solid #F1F4FA;
            padding:18px 24px;
            cursor:pointer;
            transition:background .16s ease, box-shadow .16s ease;
            position:relative;
        }
        .inquiry-card:last-child { border-bottom:none; }
        .inquiry-card:hover { background:#FAFBFF; }
        .inquiry-card:hover::before {
            content:"";
            position:absolute; left:0; top:0; bottom:0;
            width:3px;
            background:var(--point);
            opacity:.7;
        }
        .inquiry-card .ic-top {
            display:flex;
            justify-content:space-between;
            align-items:flex-start;
            gap:14px;
        }
        .inquiry-card .ic-title {
            font-size:14.5px;
            font-weight:600;
            letter-spacing:-0.005em;
            color:var(--text);
            flex:1;
            line-height:1.5;
        }
        .inquiry-card .ic-status { white-space:nowrap; }
        .inquiry-card .ic-date {
            font-size:11.5px;
            color:var(--label);
            margin-top:6px;
            letter-spacing:0.01em;
        }
        .inquiry-card .ic-preview {
            font-size:12.5px;
            color:var(--text-2);
            line-height:1.6;
            margin-top:7px;
            overflow:hidden;
            text-overflow:ellipsis;
            white-space:nowrap;
            max-width:100%;
        }

        /* 답변 박스 */
        .inquiry-card .ic-answer {
            margin-top:14px;
            padding:14px 16px;
            background:#F8FAFF;
            border:1px solid #E9EEFC;
            border-radius:12px;
        }
        .inquiry-card .ic-answer .label {
            font-size:11.5px;
            font-weight:700;
            letter-spacing:0.02em;
            color:var(--point);
            margin-bottom:6px;
            display:flex;
            align-items:center;
            gap:6px;
        }
        .inquiry-card .ic-answer .label::before {
            content:"";
            width:5px; height:5px;
            border-radius:50%;
            background:var(--point);
            flex:none;
        }
        .inquiry-card .ic-answer .text {
            font-size:13px;
            color:#333B52;
            line-height:1.72;
        }
        .inquiry-card .ic-answer .meta {
            font-size:11px;
            color:var(--label);
            margin-top:9px;
            padding-top:8px;
            border-top:1px solid #EDF1FB;
        }

        /* 첨부 이미지 */
        img.inquiry-attach {
            border-radius:10px !important;
            border:1px solid var(--border) !important;
            box-shadow:var(--shadow-soft);
        }

        /* ================= 상태 배지 (pill + dot) ================= */
        .badge-pending,
        .badge-answered {
            display:inline-flex;
            align-items:center;
            gap:6px;
            padding:4px 11px 4px 10px;
            border-radius:20px;
            font-size:11px;
            font-weight:600;
            letter-spacing:0.01em;
            line-height:1.4;
            white-space:nowrap;
        }
        .badge-pending::before,
        .badge-answered::before {
            content:"";
            width:6px; height:6px;
            border-radius:50%;
            flex:none;
        }
        .badge-pending {
            background:#FFF7ED;
            color:#D97706;
            border:1px solid #FDEBD0;
        }
        .badge-pending::before { background:#D97706; }
        .badge-answered {
            background:#F0FDF4;
            color:#16A34A;
            border:1px solid #DCFCE7;
        }
        .badge-answered::before { background:#16A34A; }

        /* ================= 빈 상태 ================= */
        .empty-state {
            text-align:center;
            padding:64px 24px;
            color:var(--label);
        }
        .empty-state .big-icon {
            display:none;
        }
        .empty-state .text {
            font-size:14px;
            font-weight:600;
            color:var(--text-2);
            letter-spacing:-0.005em;
        }
        .empty-state > div[style] {
            font-size:12px !important;
            color:var(--label) !important;
            margin-top:6px !important;
        }

        /* ================= quick-questions: CSS로 숨김 ================= */
        .quick-questions { display:none !important; }
        .quick-btn { display:none !important; }

        /* ================= 반응형 ================= */
        @media (max-width:1100px) {
            .inquiry-form { padding:24px 22px 20px; }
            .inquiry-card { padding:16px 20px; }
            .inquiry-list-header { padding:16px 20px; }
        }
        @media (max-width:820px) {
            .inquiry-form { padding:22px 18px 18px; border-radius:14px; }
            .inquiry-form h3 { font-size:15px; }
            .inquiry-card .ic-top { flex-direction:column; align-items:flex-start; gap:8px; }
            .inquiry-card .ic-status { align-self:flex-start; }
            .inquiry-card .ic-preview { white-space:normal; }
            .image-preview-item { width:72px; height:72px; }
        }
        @media (max-width:560px) {
            .inquiry-form { padding:20px 16px 16px; }
            .inquiry-form > p { font-size:12px !important; margin-bottom:18px !important; padding-bottom:16px; }
            .inquiry-list-header { padding:14px 16px; font-size:13.5px; }
            .inquiry-card { padding:15px 16px; }
            .inquiry-card .ic-answer { padding:12px 13px; }
            .inquiry-form > div:last-child { justify-content:stretch !important; }
            .inquiry-form .btn { width:100%; justify-content:center; }
            .image-upload-area { gap:10px; }
        }
    </style>
<script src="/common/js/popup.js?v=20260805a"></script>

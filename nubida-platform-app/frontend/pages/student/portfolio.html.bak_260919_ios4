<div class="modal-overlay" id="portfolioModal">
<div class="modal modal-lg pf-sheet">

  <div class="pf-sheet-head">
    <div class="pf-sheet-head-l">
      <h2 id="modalTitle">✏️ 새 학습 기록</h2>
      <p class="pf-sheet-sub">배운 내용을 정리하면 복습과 성장이 확실해집니다.</p>
    </div>
    <input type="hidden" id="editId">
    <input type="hidden" id="imageUrls" value="[]">
  </div>

  <!-- 템플릿 유형 선택 -->
  <div class="template-type-toggle no-print" id="templateTypeToggle">
    <button type="button" class="active" data-template="daily" onclick="switchTemplateType('daily')">📘 이론/제작 템플릿</button>
    <button type="button" data-template="weekly" onclick="switchTemplateType('weekly')">💻 코딩 템플릿</button>
  </div>

  <div class="pf-sheet-body">

    <!-- ====== 이론/제작 템플릿 ====== -->
    <div id="dailyTemplateArea">
      <section class="pf-sec">
        <header class="pf-sec-hd"><span class="pf-num">1</span><span class="pf-sec-t">기본 정보</span></header>
        <div class="pf-sec-bd">
          <div class="pf-fields two">
            <div class="pf-field">
              <label>📚 강좌 선택</label>
              <select class="form-select" id="portSubject"><option value="">강좌를 선택하세요</option></select>
            </div>
            <div class="pf-field">
              <label>📅 날짜</label>
              <input type="date" class="form-input" id="portDate">
            </div>
          </div>
          <div class="pf-field">
            <label>📌 제목</label>
            <input type="text" class="form-input" id="portTitle" placeholder="학습 기록 제목을 입력하세요">
          </div>
        </div>
      </section>

      <section class="pf-sec">
        <header class="pf-sec-hd"><span class="pf-num">2</span><span class="pf-sec-t">학습 내용</span></header>
        <div class="pf-sec-bd">
          <div class="pf-memo">
            <div class="pf-memo-hd"><span>📝</span> 오늘 배운 내용</div>
            <textarea class="pf-memo-tx" id="portContentToday" rows="3" placeholder="오늘 배운 내용을 입력하세요..."></textarea>
          </div>
          <div class="pf-memo">
            <div class="pf-memo-hd"><span>💡</span> 새로 알게 된 점</div>
            <textarea class="pf-memo-tx" id="portContentNew" rows="3" placeholder="새로 알게 된 점을 입력하세요..."></textarea>
          </div>
          <div class="pf-memo">
            <div class="pf-memo-hd"><span>🤔</span> 어려웠던 점</div>
            <textarea class="pf-memo-tx" id="portContentDiff" rows="3" placeholder="어려웠던 점을 입력하세요..."></textarea>
          </div>
          <!-- hidden combined content -->
          <textarea id="portContent" style="display:none"></textarea>
        </div>
      </section>

      <div class="pf-pubrow">
        <label class="pf-pub"><input type="checkbox" id="portPublic" checked><span><b>공개 발행</b><small>원장님이 확인할 수 있도록 공개합니다.</small></span></label>
      </div>
    </div><!-- /dailyTemplateArea -->

    <!-- ====== 코딩 템플릿 ====== -->
    <div id="weeklyTemplateArea" style="display:none;">
      <section class="pf-sec">
        <header class="pf-sec-hd"><span class="pf-num">1</span><span class="pf-sec-t">기본 정보</span></header>
        <div class="pf-sec-bd">
          <div class="pf-fields two">
            <div class="pf-field">
              <label>📚 강좌 선택</label>
              <select class="form-select" id="weeklyCourse"><option value="">강좌를 선택하세요</option></select>
            </div>
            <div class="pf-field">
              <label>📅 날짜</label>
              <input type="text" class="form-input" id="weeklyPortWeek" placeholder="오늘 날짜가 자동 입력됩니다">
            </div>
          </div>
          <div class="pf-field">
            <label>📌 제목</label>
            <input type="text" class="form-input" id="weeklyPortTitle" placeholder="주별 학습 기록 제목">
          </div>
        </div>
      </section>

      <section class="pf-sec">
        <header class="pf-sec-hd"><span class="pf-num">2</span><span class="pf-sec-t">학습 일지</span></header>
        <div class="pf-sec-bd">
          <div class="pf-wcard is-content">
            <div class="pf-wcard-hd"><span>📝</span> 학습 내용 요약</div>
            <textarea class="template-textarea form-textarea" id="weeklyContent" rows="3" placeholder="이번 주 학습 내용을 요약하세요..."></textarea>
          </div>
          <div class="pf-wcard is-code">
            <div class="pf-wcard-hd is-dark"><span>💻</span> 코드 작성 <em class="pf-wcard-sub">Python</em></div>
            <textarea class="template-textarea form-textarea" id="weeklyCodeEditor" rows="8" placeholder="# 코드를 입력하세요&#10;# 예: print('Hello World')"></textarea>
          </div>
          <input type="hidden" id="weeklyCodeContent">
          <div class="pf-wcard is-output">
            <div class="pf-wcard-hd is-light"><span>⚙️</span> 실행 결과</div>
            <textarea class="template-textarea form-textarea" id="weeklyCodeOutput" rows="3" placeholder="코드 실행 결과를 입력하세요..."></textarea>
          </div>
          <div class="pf-wcard is-algo">
            <div class="pf-wcard-hd is-light"><span>🔍</span> 알고리즘 분석</div>
            <textarea class="template-textarea form-textarea" id="weeklyAlgoEditor" rows="4" placeholder="사용한 알고리즘에 대해 설명해주세요..."></textarea>
          </div>
          <input type="hidden" id="weeklyAlgoDescription">
          <div class="pf-wcard is-reflect">
            <div class="pf-wcard-hd is-light"><span>💭</span> 회고 / 느낀 점</div>
            <textarea class="template-textarea form-textarea" id="weeklyReflection" rows="3" placeholder="이번 주 학습에 대한 회고를 작성하세요..."></textarea>
          </div>
        </div>
      </section>

      <div class="pf-pubrow">
        <label class="pf-pub"><input type="checkbox" id="weeklyPublic" checked><span><b>공개 발행</b><small>원장님이 확인할 수 있도록 공개합니다.</small></span></label>
      </div>
    </div><!-- /weeklyTemplateArea -->

    <!-- 업로드 영역 -->
    <section class="pf-sec no-print" id="uploadSection">
      <header class="pf-sec-hd"><span class="pf-num">3</span><span class="pf-sec-t">사진 첨부 <em class="pf-sec-note">선택</em></span></header>
      <div class="pf-sec-bd">
        <div class="upload-dropzone" id="dropzone" onclick="document.getElementById('fileInput').click()">
          <div class="upload-icon">☁️</div>
          <p>클릭하거나 드래그하여 사진 추가</p>
          <p class="small-text">JPG, PNG (최대 10장)</p>
        </div>
        <input type="file" id="fileInput" accept="image/*" multiple style="display:none" onchange="handleFiles(this.files)">
        <div class="photo-grid-preview" id="imagePreviewContainer"></div>
        <p class="photo-count-label" id="photoCount">선택된 사진 없음</p>
      </div>
    </section>

  </div>

  <div class="modal-actions pf-sheet-actions">
    <button class="btn btn-text" onclick="closeModal('portfolioModal')">취소</button>
    <button class="btn btn-filled" id="saveBtn" onclick="savePortfolio()">💾 저장</button>
  </div>

</div>
</div><!-- /portfolioModal -->

</main>
</div><!-- /app-layout -->

<div class="modal-overlay" id="imageModal" onclick="closeModal('imageModal')">
  <div class="modal modal-lg" style="max-width:90vw;background:transparent;box-shadow:none;padding:0">
    <img id="imageModalContent" src="" alt="확대 이미지" style="width:100%;border-radius:12px">
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>


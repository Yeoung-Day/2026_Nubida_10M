   <script src="/common/js/utils.js?v=20260911nav"></script>

   <script>
   const MONTH_LABELS = ['1월','2월','3월','4월','5월','6월','7월','8월','9월','10월','11월','12월'];

   // ---- XSS Helper (utils.js 미로드 대비) ----
   function escHtml(s) {
     if (s == null) return '';
     const d = document.createElement('div');
     d.textContent = s;
     return d.innerHTML;
   }

   // ---- Helpers ----
   function fmtNum(n) { return (n || 0).toLocaleString(); }
   function fmtWon(n) { return '₩' + ((n || 0)).toLocaleString(); }
   function timeAgo(dateStr) {
   if (!dateStr) return '';
   const d = new Date(dateStr);
   if (isNaN(d.getTime())) return dateStr;
   const now = new Date();
   const diff = Math.floor((now - d) / 1000);
   if (diff < 60) return '방금 전';
   if (diff < 3600) return Math.floor(diff / 60) + '분 전';
   if (diff < 86400) return Math.floor(diff / 3600) + '시간 전';
   if (diff < 604800) return Math.floor(diff / 86400) + '일 전';
   return d.toLocaleDateString('ko-KR', { month:'short', day:'numeric' });
   }
   function getDotClass(type) {
   if (type === 'enrollment' || type === 'signup') return 'success';
   if (type === 'revenue' || type === 'payment') return 'gold';
   if (type === 'warning' || type === 'alert') return 'warning';
   return 'info';
   }
   function getActivityIcon(type) {
   if (type === 'enrollment') return '📖';
   if (type === 'signup') return '👤';
   if (type === 'revenue' || type === 'payment') return '💰';
   if (type === 'warning' || type === 'alert') return '⚠️';
   return '📌';
   }

   // ===== 월별 강좌 통계 차트 렌더링 =====
   function renderCourseChart(months) {
   const barsContainer = document.getElementById('chartBars');
   const totalEl = document.getElementById('chartTotal');
   if (!barsContainer) return;
   if (!months || months.length === 0) {
   barsContainer.innerHTML = '<div class="chart-loading">📊 통계 데이터가 없습니다</div>';
   if (totalEl) totalEl.innerHTML = '총 <strong>0</strong>개';
   return;
   }
   const total = months.reduce((s, m) => s + (m.count || 0), 0);
   if (totalEl) totalEl.innerHTML = '총 <strong>' + fmtNum(total) + '</strong>개';
   const maxCount = Math.max(...months.map(m => m.count || 0), 1);
   const html = months.map(m => {
   const cnt = m.count || 0;
   const height = Math.max(cnt > 0 ? Math.round((cnt / maxCount) * 160) : 4, 4);
   const monthLabel = (m.month || '').replace(/^\d{4}-/, '') + '월';
   return `<div class="chart-bar-item">
   <div class="chart-bar" style="height:${height}px;background:linear-gradient(180deg,var(--accent),#6C7AFF)"><span class="bar-val ${cnt === maxCount ? 'peek' : ''}">${fmtNum(cnt)}</span></div>
   <div class="chart-bar-label">${escHtml(monthLabel)}</div>
   </div>`;
   }).join('');
   barsContainer.innerHTML = html;
   }

   // ===== 지표 카드 렌더링 (초기 로드 + 자동 갱신 공용) =====
   function applyStats(d) {
   // Main stat cards
   const totalUsers = d.total_users || 0;
   const activeBranches = d.active_branches || 0;
   const totalBranches = d.total_branches || 0;
   const totalEnrollments = d.total_enrollments || 0;
   const totalRevenue = d.total_revenue || 0;
   const monthlyRevenue = d.monthly_revenue || 0;
   const todaySignups = d.today_signups || 0;
   const revenueToday = d.revenue_today || 0;

   document.getElementById('statUsers').textContent = fmtNum(totalUsers);
   document.getElementById('statBranches').textContent = fmtNum(activeBranches) + '/' + fmtNum(totalBranches);
   document.getElementById('statEnrollments').textContent = fmtNum(totalEnrollments);
   document.getElementById('statRevenue').textContent = fmtWon(totalRevenue);

   // Change indicators
   const uChange = document.getElementById('statUsersChange');
   if (todaySignups > 0) {
   uChange.textContent = '↑ 오늘 +' + fmtNum(todaySignups) + '명';
   uChange.className = 'stat-change up';
   }
   const bChange = document.getElementById('statBranchesChange');
   const inactiveBranches = (totalBranches || 0) - activeBranches;
   if (inactiveBranches > 0) {
   bChange.textContent = inactiveBranches + '개 에듀케어 미운영';
   bChange.className = 'stat-change down';
   } else {
   bChange.textContent = '전 에듀케어 운영 중';
   bChange.className = 'stat-change up';
   }
   const eChange = document.getElementById('statEnrollmentsChange');
   if (d.today_enrollments) {
   eChange.textContent = '↑ 오늘 +' + fmtNum(d.today_enrollments) + '건';
   eChange.className = 'stat-change up';
   }
   const rChange = document.getElementById('statRevenueChange');
   if (revenueToday > 0) {
   const pct = monthlyRevenue > 0 ? Math.round((revenueToday / (monthlyRevenue / 30)) * 100) : 0;
   rChange.textContent = '오늘 ₩' + fmtNum(revenueToday) + ' (일평균 ' + pct + '%)';
   rChange.className = 'stat-change up';
   }

   // Quick Stats row
   document.getElementById('qsTodaySignups').textContent = fmtNum(todaySignups) + '명';
   document.getElementById('qsRevenueToday').textContent = fmtWon(revenueToday);
   document.getElementById('qsActiveBranches').textContent = fmtNum(activeBranches) + '/' + fmtNum(totalBranches);
   document.getElementById('qsTodayEnrollments').textContent = fmtNum(d.today_enrollments || todaySignups);

   // Daily report
   document.getElementById('dailyEnrollments').textContent = fmtNum(todaySignups);
   document.getElementById('dailyRevenue').textContent = fmtWon(revenueToday);

   // Monthly report
   document.getElementById('monthlyRevenue').textContent = fmtWon(monthlyRevenue);
   document.getElementById('todaySignups').textContent = fmtNum(todaySignups) + '명';

   // Revenue comparison
   document.getElementById('cmpToday').textContent = fmtWon(revenueToday);
   document.getElementById('cmpMonthly').textContent = fmtWon(monthlyRevenue);
   const avgDaily = monthlyRevenue > 0 ? Math.round(monthlyRevenue / 30) : 0;
   const vsAvg = avgDaily > 0 ? Math.round((revenueToday / avgDaily) * 100) : 0;
   document.getElementById('cmpTodayDetail').textContent = '일평균 대비 ' + vsAvg + '%';
   document.getElementById('cmpMonthlyDetail').textContent = '월 누적 매출';

   // Recent Activity
   const activities = d.recent_activities || [];
   const activityList = document.getElementById('activityList');
   if (activities.length > 0) {
   activityList.innerHTML = activities.slice(0, 10).map(a => {
   const type = a.type || 'info';
   const dotClass = getDotClass(type);
   const icon = getActivityIcon(type);
   const label = a.label || a.message || a.description || '';
   const time = timeAgo(a.created_at || a.timestamp || a.date);
   return `<li class="activity-item">
   <span class="activity-dot ${dotClass}"></span>
   <span class="activity-text">${icon} ${escHtml(label)}</span>
   <span class="activity-time">${escHtml(time)}</span>
   </li>`;
   }).join('');
   } else {
   activityList.innerHTML = '<li class="activity-empty">📭 최근 활동이 없습니다</li>';
   }

   // Branch Mini Table
   const branches = d.branches || [];
   const branchContent = document.getElementById('branchContent');
   if (branches.length > 0) {
   let rows = branches.slice(0, 8).map(b => {
   const name = b.name || b.branch_name || '—';
   const status = (b.status === 'active' || b.active === true) ? 'active' : 'inactive';
   const statusLabel = status === 'active' ? '운영중' : '미운영';
   const enrollments = fmtNum(b.enrollment_count || b.enrollments || b.total_enrollments || 0);
   const revenue = b.revenue || b.monthly_revenue || 0;
   return `<tr>
   <td class="branch-name">${escHtml(name)}</td>
   <td><span class="branch-status ${status}">${statusLabel}</span></td>
   <td>${enrollments}</td>
   <td>${fmtWon(revenue)}</td>
   </tr>`;
   }).join('');
   branchContent.innerHTML = `<table class="branch-table">
   <thead><tr>
   <th>에듀케어</th>
   <th>상태</th>
   <th>수강생</th>
   <th>매출</th>
   </tr></thead>
   <tbody>${rows}</tbody>
   </table>`;
   } else {
   branchContent.innerHTML = '<div class="branch-empty">📊 에듀케어 데이터가 없습니다</div>';
   }
   }

   // ===== 전체 통계 로드 (초기 + 자동 갱신 공용) =====
   async function loadAllStats() {
   // --- 1. Dashboard Stats ---
   try {
   const stats = await apiGet('/headquarters/dashboard/stats');
   applyStats(stats.data || {});
   } catch(e) {
   console.error('Stats load error:', e);
   ['statUsers','statBranches','statEnrollments','statRevenue',
   'qsTodaySignups','qsRevenueToday','qsActiveBranches','qsTodayEnrollments',
   'dailyEnrollments','dailyRevenue','monthlyRevenue','todaySignups',
   'cmpToday','cmpMonthly'].forEach(id => {
   const el = document.getElementById(id);
   if (el) el.textContent = '—';
   });
   }

   // --- 2. Course Monthly Stats Chart ---
   try {
   const monthsRes = await apiGet('/headquarters/courses/stats/months');
   renderCourseChart(monthsRes.data || []);
   } catch(e) {
   console.error('Chart load error:', e);
   const barsContainer = document.getElementById('chartBars');
   if (barsContainer) barsContainer.innerHTML = '<div class="chart-loading">❌ 차트를 불러올 수 없습니다</div>';
   }

   // 자동 갱신 시간 표시
   const info = document.getElementById('autoRefreshInfo');
   if (info) info.textContent = '🔄 자동 갱신: ' + new Date().toLocaleTimeString('ko-KR', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
   }

   // ===== Main =====
   document.addEventListener('DOMContentLoaded', async () => {
   requireAuth();
   const user = getCurrentUser();
   if (user) document.getElementById('sidebarUserName').textContent = user.name || '관리자';
   document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});

   await loadAllStats();

   // 통계 실시간 반영 — 60초마다 자동 갱신
   setInterval(loadAllStats, 60000);
   });
   </script>

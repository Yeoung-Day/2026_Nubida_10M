   <!-- ===== 월별 강좌 통계 (Bar Chart) ===== -->
   <div class="chart-container" id="courseChart">
   <div class="chart-header">
   <h3>📈 월별 강좌 통계</h3>
   <span class="chart-total" id="chartTotal">총 <strong>0</strong>개</span>
   </div>
   <div class="chart-bar-wrap" id="chartBars">
   <div class="chart-loading">📊 차트를 불러오는 중...</div>
   </div>
   </div>

   <!-- ===== 에듀케어별 통계 (Branch Mini Table) ===== -->
   <div class="branch-table-wrap" id="branchStats">
   <h3>🏢 에듀케어별 현황</h3>
   <div id="branchContent">
   <div class="branch-empty">로딩 중...</div>
   </div>
   </div>

   <!-- ===== 최근 활동 (Recent Activity) ===== -->
   <div class="activity-card" id="recentActivity">
   <h3>🕐 최근 활동</h3>
   <ul class="activity-list" id="activityList">
   <li class="activity-empty">로딩 중...</li>
   </ul>
   </div>

   </main>
   </div>


<style>
/* ── 토글 메뉴 스타일 ── */
.nav-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--sidebar-text);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: all var(--transition-fast);
    margin-bottom: 1px;
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    font-family: inherit;
}
.nav-toggle:hover {
    background: var(--sidebar-hover);
    color: var(--sidebar-text);
}
.nav-toggle .toggle-arrow {
    margin-left: auto;
    transition: transform var(--transition-fast);
    font-size: 12px;
    color: var(--sidebar-text-secondary);
}
.nav-toggle.open .toggle-arrow {
    transform: rotate(90deg);
}
.nav-submenu {
    display: none;
    overflow: hidden;
}
.nav-submenu.open {
    display: block;
}
.nav-submenu .nav-item.sub {
    padding-left: 48px !important;
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
}
.nav-submenu .nav-item.sub .icon {
    font-size: var(--text-base);
    width: 18px;
}
.nav-item.top-item {
    font-weight: var(--weight-semibold);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 현재 페이지 확인하여 해당 섹션 열기
    const currentPage = window.location.pathname.split('/').pop();
    
    // 섹션 매핑
    const sectionMap = {
        'branches.html': 'operations', 'categories.html': 'operations',
        'academy-management.html': 'eduops', 
        'courses.html': 'eduops', 'users.html': 'eduops',
        'payments.html': 'finance', 'revenue-approval.html': 'finance', 'statistics.html': 'finance',
        'point-management.html': 'point', 'point-settings.html': 'point', 
        'gifticon-settings.html': 'point', 'gifticon-management.html': 'point',
        'director-reports.html': 'report', 'notices.html': 'report', 
        'portfolio.html': 'report',
        'approvals.html': 'system', 'settings.html': 'system', 'chat.html': 'system',
        'category-manager.html': 'system', 'category.html': 'system',
    };
    
    const currentSection = sectionMap[currentPage];
    if (currentSection) {
        const toggle = document.querySelector(`.nav-toggle[data-section="${currentSection}"]`);
        if (toggle) {
            toggle.classList.add('open');
            const sub = document.getElementById(`sub-${currentSection}`);
            if (sub) sub.classList.add('open');
        }
    }

    // 토글 버튼 클릭 이벤트
    document.querySelectorAll('.nav-toggle').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const section = this.dataset.section;
            const sub = document.getElementById(`sub-${section}`);
            const isOpen = sub.classList.contains('open');
            
            // 닫기
            if (isOpen) {
                sub.classList.remove('open');
                this.classList.remove('open');
            } else {
                // 열기 (다른 열린 섹션은 자동으로 닫힘 - 선택사항)
                // 모든 섹션 닫기
                document.querySelectorAll('.nav-submenu.open').forEach(el => el.classList.remove('open'));
                document.querySelectorAll('.nav-toggle.open').forEach(el => el.classList.remove('open'));
                // 현재 섹션 열기
                sub.classList.add('open');
                this.classList.add('open');
            }
        });
    });

    // active 표시
    document.querySelectorAll('.nav-item').forEach(item => {
        const href = item.getAttribute('href');
        if (href && href === currentPage) {
            item.classList.add('active');
        }
    });
});
</script>

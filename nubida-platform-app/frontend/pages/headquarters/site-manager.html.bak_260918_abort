    <style>
    /* ===== 공개사이트 관리 전용 (①~③ 콘텐츠 + ④ 페이지 본문) ===== */
    .sm-tabs { display:inline-flex; gap:4px; background:#F1F3F6; padding:4px; border-radius:12px; margin:2px 0 18px; }
    .sm-tab { border:0; background:transparent; padding:9px 18px; border-radius:9px; font-size:13.5px; font-weight:600; color:#6B7280; cursor:pointer; display:inline-flex; align-items:center; gap:7px; transition:all .15s ease; }
    .sm-tab:hover { color:#111827; }
    .sm-tab.active { background:#fff; color:#111827; box-shadow:0 1px 4px rgba(16,24,40,.14); }
    .sm-tab .sm-badge { font-size:11px; font-weight:700; background:#EEF0F4; color:#6B7280; border-radius:999px; padding:1px 8px; }
    .sm-tab.active .sm-badge { background:#4F5EF8; color:#fff; }
    .sm-panel { display:none; }
    .sm-panel.active { display:block; }

    /* 링크 행 (네비/푸터) */
    .sc-rows-head { display:grid; grid-template-columns:minmax(150px,1fr) minmax(220px,1.7fr) 118px; gap:8px; padding:0 2px 6px; font-size:11.5px; font-weight:600; color:#9CA3AF; }
    .sc-row { display:grid; grid-template-columns:minmax(150px,1fr) minmax(220px,1.7fr) 118px; gap:8px; margin-bottom:8px; align-items:center; }
    .sc-row .input { font-size:13px; }
    .sc-row-actions { display:flex; gap:4px; justify-content:flex-end; }
    .sc-del { width:30px; height:30px; border:1px solid #E5E7EB; background:#fff; color:#6B7280; border-radius:8px; font-size:12px; cursor:pointer; transition:all .12s ease; display:inline-flex; align-items:center; justify-content:center; padding:0; }
    .sc-del:hover { border-color:#F87171; color:#DC2626; background:#FEF2F2; }
    .sc-del.sc-move:hover { border-color:#6366F1; color:#4F46E5; background:#EEF2FF; }
    .sc-empty { font-size:12.5px; color:#9CA3AF; padding:10px 2px; }

    /* 콘텐츠 저장 바 */
    .sm-actions { display:flex; align-items:center; justify-content:flex-end; gap:10px; margin:4px 0 26px; padding:14px 18px; background:#fff; border:1px solid #E5E7EB; border-radius:14px; box-shadow:0 1px 3px rgba(16,24,40,.05); }
    .sm-actions .sm-status { margin-right:auto; font-size:12.5px; color:var(--text-secondary,#6B7280); }

    /* 페이지 카드 그리드 */
    .sc-pagegrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(258px,1fr)); gap:14px; margin-top:14px; }
    .sc-pcard { position:relative; background:#fff; border:1px solid #E5E7EB; border-radius:14px; padding:16px; display:flex; flex-direction:column; gap:7px; box-shadow:0 1px 2px rgba(16,24,40,.04); transition:box-shadow .15s ease, transform .15s ease; }
    .sc-pcard:hover { box-shadow:0 8px 22px rgba(16,24,40,.09); transform:translateY(-1px); }
    .sc-pc-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
    .sc-pc-name { font-size:14.5px; font-weight:600; color:#111827; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .sc-pc-slug { font-size:10.5px; color:#6B7280; background:#F3F4F6; border:1px solid #EEF0F4; padding:1px 7px; border-radius:999px; font-weight:600; letter-spacing:.2px; }
    .sc-pc-tag { font-size:10px; font-weight:700; color:#4F5EF8; background:#EEF2FF; padding:1px 7px; border-radius:999px; }
    .sc-pc-desc { font-size:12.5px; color:#6B7280; line-height:1.5; min-height:36px; }
    .sc-pc-meta { font-size:11.5px; color:#9CA3AF; }
    .sc-pc-foot { margin-top:auto; display:flex; gap:6px; align-items:center; justify-content:flex-end; padding-top:4px; }
    .sc-del-card { position:absolute; top:12px; right:12px; width:28px; height:28px; border:1px solid #E5E7EB; background:#fff; color:#9CA3AF; border-radius:8px; font-size:12px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition:all .12s ease; }
    .sc-del-card:hover { border-color:#F87171; color:#DC2626; background:#FEF2F2; }
    .sc-addcard { border:1.5px dashed #D4D8E0; background:#FAFBFC; color:#6B7280; border-radius:14px; min-height:158px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; cursor:pointer; transition:all .15s ease; font-size:13px; font-weight:600; }
    .sc-addcard:hover { border-color:#4F5EF8; color:#4F5EF8; background:#F8F9FF; }
    .sc-addcard .plus { font-size:26px; line-height:1; font-weight:300; }

    /* 공통 모달 오버레이 */

<script>
// ===== 공개사이트 관리 — ① 네비 ② 푸터 ③ 상담 ④ 페이지 본문 =====
var _sc = null;
var _scBackup = null;
var _EDITOR_URL = '/pages/headquarters/site-editor.html';

// 기본(보호) 페이지 정의 — 삭제 불가, 항상 카드 노출
var _DEF_ORDER = ['company', 'policy', 'partnership', 'contact'];
var _DEF_META = {
  company:    { name: '회사소개',  icon: '🏢', desc: '누비다플랫폼 소개 — 히스토리·핵심가치·비전' },
  policy:     { name: '약관 · 정책', icon: '📄', desc: '이용약관·개인정보처리방침·위치정보 동의' },
  partnership:{ name: '파트너십',  icon: '🤝', desc: '가맹·제휴·투자 안내 및 문의 연결' },
  contact:    { name: '문의하기',  icon: '📮', desc: '상담 문의·오시는 길·연락 방법' }
};

function scEsc(v) {
  return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function setMsg(elId, text, ok) {
  var el = document.getElementById(elId);
  if (!el) return;
  el.textContent = text || '';
  el.style.color = ok ? 'var(--success,#10B981)' : 'var(--danger,#DC2626)';
}

// ============ 공통 로드 (콘텐츠 ①~③ + 페이지 ④) ============
async function loadSiteContent() {
  try {
    var res = await apiGet('/headquarters/site-content');
    var d = res.data || {};
    if (!Array.isArray(d.nav)) d.nav = [];
    if (!Array.isArray(d.footer_links)) d.footer_links = [];
    if (!d.contact || typeof d.contact !== 'object') d.contact = {};
    if (!d.pages || typeof d.pages !== 'object') d.pages = {};
    _sc = JSON.parse(JSON.stringify(d));
    _scBackup = JSON.parse(JSON.stringify(d));
    renderScAll();
    renderPageCards();
  } catch (e) {
    console.error('공개사이트 콘텐츠 로드 실패:', e);
    setMsg('pageStatus', '로드 실패: ' + (e.message || '오류'), false);
  }
}

// ============ ①~③ 콘텐츠 렌더 ============
function renderScAll() {
  if (!_sc) return;
  renderScLinks('nav', document.getElementById('scNavRows'));
  renderScLinks('footer', document.getElementById('scFooterRows'));
  var c = _sc.contact;
  document.getElementById('scPhone').value = c.phone || '';
  document.getElementById('scEmail').value = c.email || '';
  document.getElementById('scAddress').value = c.address || '';
  document.getElementById('scHours').value = c.hours || '';
  document.getElementById('scModalTitle').value = c.modal_title || '';
  document.getElementById('scModalSub').value = c.modal_sub || '';
  document.getElementById('scModalNote').value = c.modal_note || '';
}

function renderScLinks(kind, box) {
  if (!box || !_sc) return;
  var arr = kind === 'nav' ? _sc.nav : _sc.footer_links;
  box.innerHTML = '';
  if (!arr.length) {
    box.innerHTML = '<div class="sc-empty">아직 링크가 없습니다. 아래 [+ 추가]로 등록하세요.</div>';
    return;
  }
  for (var i = 0; i < arr.length; i++) {
    var item = arr[i] || {};
    var row = document.createElement('div');
    row.className = 'sc-row';
    row.innerHTML =
      '<input type="text" class="input" value="' + scEsc(item.title) + '" placeholder="링크 이름 (예: 회사소개)" oninput="scSet(\'' + kind + '\',' + i + ',\'title\',this.value)">' +
      '<input type="text" class="input" value="' + scEsc(item.url) + '" placeholder="/pages/xxx.html" oninput="scSet(\'' + kind + '\',' + i + ',\'url\',this.value)">' +
      '<div class="sc-row-actions">' +
      '<button type="button" class="sc-del sc-move" title="위로" onclick="moveScRow(\'' + kind + '\',' + i + ',-1)">↑</button>' +
      '<button type="button" class="sc-del sc-move" title="아래로" onclick="moveScRow(\'' + kind + '\',' + i + ',1)">↓</button>' +
      '<button type="button" class="sc-del" title="삭제" onclick="delScRow(\'' + kind + '\',' + i + ')">✕</button>' +
      '</div>';
    box.appendChild(row);
  }
}

function scSet(kind, idx, field, val) {
  if (!_sc) return;
  var arr = kind === 'nav' ? _sc.nav : _sc.footer_links;
  if (arr[idx]) arr[idx][field] = val;
}
function addScRow(kind) {
  if (!_sc) return;
  var arr = kind === 'nav' ? _sc.nav : _sc.footer_links;
  arr.push({ title: '', url: '' });
  renderScLinks(kind, document.getElementById(kind === 'nav' ? 'scNavRows' : 'scFooterRows'));
}
function delScRow(kind, idx) {
  if (!_sc) return;
  var arr = kind === 'nav' ? _sc.nav : _sc.footer_links;
  arr.splice(idx, 1);
  renderScLinks(kind, document.getElementById(kind === 'nav' ? 'scNavRows' : 'scFooterRows'));
}
function moveScRow(kind, idx, dir) {
  if (!_sc) return;
  var arr = kind === 'nav' ? _sc.nav : _sc.footer_links;
  var j = idx + dir;
  if (j < 0 || j >= arr.length) return;
  var t = arr[idx]; arr[idx] = arr[j]; arr[j] = t;
  renderScLinks(kind, document.getElementById(kind === 'nav' ? 'scNavRows' : 'scFooterRows'));
}

// 상담/메타 input 실시간 반영 (이벤트 위임 — id로 구분)
document.addEventListener('input', function (e) {
  if (!_sc) return;
  var id = e.target && e.target.id;
  if (!id) return;
  var c = _sc.contact;
  if (id === 'scPhone') c.phone = e.target.value;
  else if (id === 'scEmail') c.email = e.target.value;
  else if (id === 'scAddress') c.address = e.target.value;
  else if (id === 'scHours') c.hours = e.target.value;
  else if (id === 'scModalTitle') c.modal_title = e.target.value;
  else if (id === 'scModalSub') c.modal_sub = e.target.value;
  else if (id === 'scModalNote') c.modal_note = e.target.value;
});

// 일괄 저장 / 되돌리기 (①~③ — pages 는 ④ 전용 저장에 위임)
async function saveSiteContent() {
  if (!_sc) { alert('콘텐츠를 아직 불러오지 못했습니다. 새로고침 후 다시 시도해주세요.'); return; }
  setMsg('siteContentStatus', '⏳ 저장 중...', true);
  try {
    var payload = JSON.parse(JSON.stringify(_sc));
    delete payload.pages;  // 페이지 본문은 [페이지 본문] 탭 전용 에디터에서 저장 (덮어쓰기 방지)
    await apiPut('/headquarters/site-content', payload);
    _scBackup = JSON.parse(JSON.stringify(_sc));
    setMsg('siteContentStatus', '✅ 저장 완료 — 공개 페이지(네비·푸터·상담)에 반영되었습니다', true);
    setTimeout(function () { setMsg('siteContentStatus', ''); }, 4000);
  } catch (e) {
    setMsg('siteContentStatus', '저장 실패: ' + (e.message || '오류'), false);
  }
}
function resetSiteContentForm() {
  if (!_scBackup) return;
  _sc = JSON.parse(JSON.stringify(_scBackup));
  renderScAll();
  setMsg('siteContentStatus', '↺ 마지막 저장 값으로 되돌렸습니다', true);
  setTimeout(function () { setMsg('siteContentStatus', ''); }, 3000);
}

// ============ ④ 페이지 카드 그리드 ============
function _pageTitle(slug, pg) {
  if (pg && pg.title) return String(pg.title);
  return (_DEF_META[slug] && _DEF_META[slug].name) || slug;
}
function _pageDesc(slug, pg) {
  if (_DEF_META[slug]) return _DEF_META[slug].desc;
  if (pg && Array.isArray(pg.blocks)) {
    for (var i = 0; i < pg.blocks.length; i++) {
      var b = pg.blocks[i];
      if (b && b.type === 'text' && b.p) {
        var t = String(b.p).trim();
        return t.length > 70 ? t.slice(0, 70) + '…' : t;
      }
    }
  }
  return '사용자 정의 페이지 — [✎ 에디터 열기]로 본문을 구성하세요';
}

function renderPageCards() {
  var box = document.getElementById('scPageCards');
  if (!box) return;
  box.innerHTML = '';
  if (!_sc) return;
  var pages = _sc.pages || {};
  var slugs = _DEF_ORDER.filter(function (k) { return pages[k]; });
  Object.keys(pages).forEach(function (k) {
    if (_DEF_ORDER.indexOf(k) < 0) slugs.push(k);
  });
  slugs.sort(function (a, b) {
    var ia = _DEF_ORDER.indexOf(a), ib = _DEF_ORDER.indexOf(b);
    if (ia >= 0 && ib >= 0) return ia - ib;
    if (ia >= 0) return -1;
    if (ib >= 0) return 1;
    return a < b ? -1 : (a > b ? 1 : 0);
  });
  var badge = document.getElementById('badgePages');
  if (badge) badge.textContent = slugs.length;

  // 새 페이지 추가 카드
  var add = document.createElement('div');
  add.className = 'sc-addcard';
  add.innerHTML = '<span class="plus">+</span><span>새 페이지 추가</span>';
  add.addEventListener('click', openNewPageModal);
  box.appendChild(add);

  slugs.forEach(function (slug) {
    var pg = pages[slug] || {};
    var meta = _DEF_META[slug] || { icon: '📄' };
    var nBlocks = Array.isArray(pg.blocks) ? pg.blocks.length : 0;
    var hasHero = !!(pg.hero_image || '');
    var isDefault = _DEF_ORDER.indexOf(slug) >= 0;
    var card = document.createElement('div');
    card.className = 'sc-pcard';
    var delBtn = isDefault ? '' :
      '<button type="button" class="sc-del-card" title="페이지 삭제" onclick="deleteSitePage(\'' + slug + '\')">🗑</button>';
    card.innerHTML =
      '<div class="sc-pc-top"><div class="sc-pc-name">' + meta.icon + ' ' + scEsc(_pageTitle(slug, pg)) +
      '<span class="sc-pc-slug">' + scEsc(slug) + '</span>' +
      (isDefault ? '<span class="sc-pc-tag">기본</span>' : '') +
      '</div>' + delBtn + '</div>' +
      '<div class="sc-pc-desc">' + scEsc(_pageDesc(slug, pg)) + '</div>' +
      '<div class="sc-pc-meta">본문 ' + nBlocks + '개 블록' + (hasHero ? ' · 히어로 이미지 있음' : '') + ' · /pages/' + scEsc(slug) + '.html</div>' +
      '<div class="sc-pc-foot">' +
      '<a class="btn btn-outline btn-sm" href="/pages/' + scEsc(slug) + '.html" target="_blank" rel="noopener">↗ 미리보기</a>' +
      '<button type="button" class="btn btn-primary btn-sm" onclick="openSiteEditor(\'' + slug + '\')">✎ 에디터 열기</button>' +
      '</div>';
    box.appendChild(card);
  });
}

// ============ 새 페이지 생성 / 삭제 ============
function openNewPageModal() {
  document.getElementById('npErr').textContent = '';
  document.getElementById('npSlug').value = '';
  document.getElementById('npTitle').value = '';
  document.getElementById('npDesc').value = '';
  document.getElementById('npSlugPreview').textContent = '영문주소';
  document.getElementById('newPageOverlay').classList.add('active');
  document.body.style.overflow = 'hidden';
  setTimeout(function () { document.getElementById('npSlug').focus(); }, 60);
}
function closeNewPageModal() {
  document.getElementById('newPageOverlay').classList.remove('active');
  document.body.style.overflow = '';
}
function slugPreview() {
  var v = document.getElementById('npSlug').value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
  document.getElementById('npSlug').value = v;
  document.getElementById('npSlugPreview').textContent = v || '영문주소';
}
async function createNewPage() {
  var slug = document.getElementById('npSlug').value.trim().toLowerCase();
  var title = document.getElementById('npTitle').value.trim();
  var desc = document.getElementById('npDesc').value.trim();
  var err = document.getElementById('npErr');
  if (!/^[a-z][a-z0-9-]{0,39}$/.test(slug)) {
    err.textContent = '영문 소문자로 시작하는 주소를 입력하세요. (영문·숫자·하이픈, 최대 40자)';
    return;
  }
  if (!title) { err.textContent = '표시 이름(제목)을 입력하세요.'; return; }
  var btn = document.getElementById('npCreateBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 생성 중...';
  try {
    var res = await apiPost('/headquarters/site-content/pages', { slug: slug, title: title, desc: desc });
    closeNewPageModal();
    setMsg('pageStatus', '✅ ' + slug + ' 페이지가 생성되었습니다 — 이어서 에디터를 엽니다.', true);
    setTimeout(function () { setMsg('pageStatus', ''); }, 5000);
    await loadSiteContent();
    switchTab('pages');
    openSiteEditor(slug);
  } catch (e) {
    err.textContent = (e && e.message) ? e.message : '생성 실패. 다시 시도해주세요.';
  } finally {
    btn.disabled = false;
    btn.textContent = '＋ 페이지 생성';
  }
}
async function deleteSitePage(slug) {
  if (!confirm('「' + slug + '」 페이지를 삭제할까요?\n자동 생성된 HTML 파일과 연결된 네비/푸터 링크도 함께 제거됩니다.')) return;
  try {
    var res = await apiDelete('/headquarters/site-content/pages/' + encodeURIComponent(slug));
    setMsg('pageStatus', '🗑 ' + (res.message || '삭제되었습니다.'), true);
    setTimeout(function () { setMsg('pageStatus', ''); }, 5000);
    await loadSiteContent();
  } catch (e) {
    setMsg('pageStatus', '삭제 실패: ' + (e.message || '오류'), false);
  }
}

// ============ 탭 전환 ============
function switchTab(name) {
  document.querySelectorAll('.sm-tab').forEach(function (t) {
    t.classList.toggle('active', t.getAttribute('data-panel') === name);
  });
  document.querySelectorAll('.sm-panel').forEach(function (p) {
    p.classList.toggle('active', p.id === 'panel-' + name);
  });
}
document.querySelectorAll('.sm-tab').forEach(function (t) {
  t.addEventListener('click', function () { switchTab(t.getAttribute('data-panel')); });
});

// ============ 에디터(iframe) 오버레이 ============
function openSiteEditor(slug) {
  var ov = document.getElementById('siteEditorOverlay');
  var fr = document.getElementById('siteEditorFrame');
  if (!ov || !fr) return;
  var pg = (_sc && _sc.pages && _sc.pages[slug]) || {};
  var name = pg.title || ((_DEF_META[slug] || {}).name) || slug;
  document.getElementById('seSlug').textContent = name + ' (' + slug + ')';
  fr.src = _EDITOR_URL + '?slug=' + encodeURIComponent(slug) + '&v=20260908g';
  ov.classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeSiteEditor() {
  var ov = document.getElementById('siteEditorOverlay');
  if (!ov) return;
  ov.classList.remove('active');
  document.body.style.overflow = '';
  var fr = document.getElementById('siteEditorFrame');
  if (fr) fr.src = 'about:blank';
}

// 에디터(iframe) ↔ 관리 페이지 통신
window.addEventListener('message', function (ev) {
  var d = ev.data;
  if (!d || typeof d !== 'object') return;
  if (d.type === 'nubida-site-editor-saved') {
    setMsg('pageStatus', '✅ ' + (d.slug || '') + ' 페이지 저장 완료 — 공개 페이지에 반영되었습니다', true);
    setTimeout(function () { setMsg('pageStatus', ''); }, 4000);
    loadSiteContent();
  } else if (d.type === 'nubida-site-editor-close') {
    closeSiteEditor();
  }
});

// 새 페이지 모달 — slug 입력 실시간 미리보기
document.getElementById('npSlug').addEventListener('input', slugPreview);
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') {
    if (document.getElementById('newPageOverlay').classList.contains('active')) closeNewPageModal();
    var ov = document.getElementById('siteEditorOverlay');
    if (ov && ov.classList.contains('active')) closeSiteEditor();
  }
});
document.getElementById('newPageOverlay').addEventListener('click', function (e) {
  if (e.target === this) closeNewPageModal();
});

// ============ 초기화 ============
document.addEventListener('DOMContentLoaded', async function () {
  requireAuth();
  var user = getCurrentUser();
  if (user) {
    var un = document.getElementById('sidebarUserName');
    var ur = document.getElementById('sidebarUserRole');
    if (un) un.textContent = user.name || '관리자';
    if (ur) ur.textContent = '본사';
  }
  var now = new Date();
  var todayEl = document.getElementById('todayDate');
  if (todayEl) todayEl.textContent = now.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
  await loadSiteContent();
});

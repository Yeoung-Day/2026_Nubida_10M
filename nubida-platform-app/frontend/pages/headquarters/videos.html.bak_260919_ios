    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            requireAuth();
            const user = getCurrentUser();
            if (user) {
                document.getElementById('sidebarUserName').textContent = user.name || '관리자';
                document.getElementById('sidebarUserRole').textContent = '본사';
            }
            const now = new Date();
            document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });

            filterVideos('all', document.querySelector('.filter-tab[data-filter="all"]'));

            let searchTimer;
            document.getElementById('videoSearch').addEventListener('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => loadVideos(currentFilter), 300);
            });
        });

        async function loadVideos(filter) {
            const gallery = document.getElementById('videoGallery');
            try {
                const search = document.getElementById('videoSearch').value.trim();
                let url = '/videos?per_page=50';
                if (search) url += '&q=' + encodeURIComponent(search);
                const res = await apiGet(url);
                let items = res.data?.items || res.data || [];

                // Apply filter
                if (filter && filter !== 'all') {
                    items = items.filter(v => (v.subject || v.category) === filter);
                }

                if (!items.length) {
                    gallery.innerHTML = '<div class="empty-state" style="grid-column:1/-1"><div class="icon">🎥</div><p>등록된 영상이 없습니다</p></div>';
                } else {
                    gallery.innerHTML = items.map((v, i) => {
                        const date = v.created_at ? new Date(v.created_at).toLocaleDateString('ko-KR') : '-';
                        const subject = v.subject || v.category || '기타';
                        const subjectIcons = {'국어':'📖','영어':'🔤','수학':'🔢','과학':'🔬','사회':'🌏','기타':'📦'};
                        const icon = subjectIcons[subject] || '🎥';
                        return `<div class="gallery-card animate-fade-up delay-${(i % 5) + 1}">
                            <div class="card-thumb">
                                <span>${icon}</span>
                                <span class="badge badge-info badge-pos">${subject}</span>
                            </div>
                            <div class="card-body">
                                <h4>${escHtml(v.title || v.name || '-')}</h4>
                                <p>${date} · ${v.duration || '00:00'}</p>
                                <div style="margin-top:12px;display:flex;gap:6px">
                                    <button class="btn btn-sm btn-outline" onclick="alert('재생: ${escHtml(v.title || '')}')">▶ 재생</button>
                                    <button class="btn btn-sm btn-ghost" onclick="deleteVideo(${v.id})">🗑️</button>
                                </div>
                            </div>
                        </div>`;
                    }).join('');
                }
            } catch(e) {
                gallery.innerHTML = '<div class="empty-state" style="grid-column:1/-1;color:var(--danger)"><div class="icon">⚠️</div><p>' + escHtml('로딩 실패: ' + (e.message || '오류')) + '</p></div>';
            }
        }

        let currentFilter = 'all';
        function filterVideos(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            if (btn) btn.classList.add('active');
            loadVideos(filter);
        }

        function openUploadModal() {
            document.getElementById('uploadModal').style.display = 'flex';
            document.getElementById('videoTitle').value = '';
            document.getElementById('videoSubject').value = '';
            document.getElementById('videoFile').value = '';
        }

        function closeUploadModal() {
            document.getElementById('uploadModal').style.display = 'none';
        }

        async function uploadVideo() {
            const title = document.getElementById('videoTitle').value.trim();
            const subject = document.getElementById('videoSubject').value;
            const fileInput = document.getElementById('videoFile');
            
            // 입력 검증: 각 필드별 안내
            var errors = [];
            if (!title) errors.push('제목');
            if (!subject) errors.push('과목');
            if (!fileInput.files.length) errors.push('영상 파일');
            if (errors.length > 0) {
                alert('다음 항목을 입력해주세요: ' + errors.join(', '));
                return;
            }
            
            // 로딩 상태 표시
            var uploadBtn = document.querySelector('#uploadModal .btn-primary');
            var origText = uploadBtn.textContent;
            uploadBtn.textContent = '⏳ 업로드 중...';
            uploadBtn.disabled = true;
            
            const formData = new FormData();
            formData.append('title', title);
            formData.append('subject', subject);
            formData.append('file', fileInput.files[0]);
            try {
                const token = localStorage.getItem('token') || localStorage.getItem('access_token');
                const res = await fetch('/api/v1/videos/upload', {
                    method: 'POST',
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                    body: formData
                });
                const text = await res.text();
                let json;
                try { json = JSON.parse(text); } catch(e) { throw new Error(text || '업로드 실패'); }
                if (!res.ok) throw new Error(json.message || json.detail || '업로드 실패');
                closeUploadModal();
                await loadVideos(currentFilter);
            } catch(e) {
                alert('업로드 실패: ' + (e.message || '오류'));
                closeUploadModal();
            } finally {
                uploadBtn.textContent = origText;
                uploadBtn.disabled = false;
            }
        }

        async function deleteVideo(id) {
            if (!confirm('정말 삭제하시겠습니까?')) return;
            try {
                await apiDelete('/videos/' + id);
                await loadVideos();
            } catch(e) {
                alert('삭제 실패');
            }
        }

        function escHtml(s) {
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }
    </script>
    

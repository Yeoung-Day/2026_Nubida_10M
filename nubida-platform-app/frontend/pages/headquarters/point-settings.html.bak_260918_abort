   async function loadSettings() {
   const type = document.getElementById('filterType').value;
   const res = await apiGet('/headquarters/point-settings' + (type ? '?target_type='+type : ''));
   const data = res.data || [];
   document.getElementById('settingsTable').innerHTML = data.map(s => `
   <tr>
   <td><span class="badge badge-${s.target_type === 'course' ? 'primary' : 'warning'}">${s.target_type === 'course' ? '교육' : '포트폴리오'}</span></td>
   <td>${s.target_id || '<span style="color:#9CA3AF">전체 기본</span>'}</td>
   <td><strong>${s.points.toLocaleString()}p</strong></td>
   <td><span class="badge badge-success">${s.is_active ? '활성' : '비활성'}</span></td>
   <td style="font-size:12px;color:#9CA3AF">${s.created_at || ''}</td>
   <td>
   <button class="btn btn-sm btn-primary" onclick="editSetting(${s.id},'${s.target_type}',${s.target_id || 'null'},${s.points})">수정</button>
   <button class="btn btn-sm btn-danger" onclick="deleteSetting(${s.id})">삭제</button>
   </td>
   </tr>
   `).join('');
   }

   function openCreateModal() {
   editingId = null;
   document.getElementById('modalTitle').textContent = '포인트 설정 추가';
   document.getElementById('editTargetType').value = 'course';
   document.getElementById('editTargetId').value = '';
   document.getElementById('editPoints').value = '';
   document.getElementById('createModal').classList.add('active');
   document.getElementById('sidebarOverlay').classList.add('active');
   }

   function editSetting(id, type, targetId, points) {
   editingId = id;
   document.getElementById('modalTitle').textContent = '포인트 설정 수정';
   document.getElementById('editTargetType').value = type;
   document.getElementById('editTargetId').value = targetId || '';
   document.getElementById('editPoints').value = points;
   document.getElementById('createModal').classList.add('active');
   document.getElementById('sidebarOverlay').classList.add('active');
   }

   function closeModal() {
   document.getElementById('createModal').classList.remove('active');
   document.getElementById('sidebarOverlay').classList.remove('active');
   }

   async function saveSetting() {
   const type = document.getElementById('editTargetType').value;
   const tid = document.getElementById('editTargetId').value;
   const points = parseInt(document.getElementById('editPoints').value);
   if (!points || points < 0) { alert('포인트를 입력해주세요.'); return; }
   try {
   if (editingId) {
   await apiPut('/headquarters/point-settings/' + editingId, { points });
   } else {
   await apiPost('/headquarters/point-settings', { target_type: type, target_id: tid ? parseInt(tid) : null, points });
   }
   closeModal(); loadSettings();
   } catch(e) { alert(e.message || '오류'); }
   }

   async function deleteSetting(id) {
   if (!confirm('삭제하시겠습니까?')) return;
   try { await apiDelete('/headquarters/point-settings/' + id); loadSettings(); }
   catch(e) { alert(e.message); }
   }
   </script>
   </body>
   </html>

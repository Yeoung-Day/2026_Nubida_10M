async function loadContracts(page) {
    currentContractPage = page || 1;
    const tbody = document.getElementById('contractTableBody');
    tbody.innerHTML = '<tr><td class="ctr-empty" colspan="9">로딩 중...</td></tr>';
    try {
        const params = { page: currentContractPage, per_page: 20 };
        const status = document.getElementById('cStatusFilter').value;
        const search = document.getElementById('cSearchInput').value.trim();
        if (status) params.status = status;
        if (search) params.search = search;
        console.log('[branches] loadContracts 호출:', params);
        const res = await apiGet('/headquarters/contracts?' + new URLSearchParams(params));
        console.log('[branches] loadContracts 응답:', res);
        // 응답 데이터 검증 강화
        const data = res && res.data;
        allContracts = Array.isArray(data) ? data : [];
        const total = (res && typeof res.total === 'number') ? res.total : allContracts.length;
        totalContractPages = Math.max(1, Math.ceil(total / 20));
        document.getElementById('contractCount').textContent = total + '건';
        const direct = allContracts.filter(c => c.contract_type === 'direct').length;
        const franchise = allContracts.filter(c => c.contract_type === 'franchise').length;
        const expiring = allContracts.filter(c => {
            if (!c.end_date) return false;
            const days = (new Date(c.end_date) - new Date()) / (1000 * 60 * 60 * 24);
            return days >= 0 && days <= 30;
        }).length;
        document.getElementById('statDirect').textContent = direct + '명';
        document.getElementById('statFranchise').textContent = franchise + '명';
        document.getElementById('statExpiring').textContent = expiring + '건';
        document.getElementById('statTotal').textContent = total + '건';
        if (!allContracts.length) {
            tbody.innerHTML = '<tr><td class="ctr-empty" colspan="9">등록된 계약이 없습니다.</td></tr>';
            renderContractPagination();
            return;
        }
        tbody.innerHTML = allContracts.map(c => {
            const statusBadge = getContractStatusBadge(c.status);
            const periodStr = c.start_date ? formatDate(c.start_date) + ' ~ ' + formatDate(c.end_date) : '-';
            const typeLabel = c.contract_type === 'direct' ? '직영' : c.contract_type === 'franchise' ? '프랜차이즈' : (c.contract_type || '-');
            return '<tr>' +
                '<td>' + c.id + '</td>' +
                '<td>' + esc(c.branch_name || '-') + '</td>' +
                '<td><strong>' + esc(c.director_name || '-') + '</strong></td>' +
                '<td>' + typeLabel + '</td>' +
                '<td style="font-size:12px">' + periodStr + '</td>' +
                '<td>' + formatAmount(c.monthly_fee) + '</td>' +
                '<td>' + (c.royalty_rate != null ? c.royalty_rate + '%' : '-') + '</td>' +
                '<td>' + statusBadge + '</td>' +
                '<td><div style="display:flex;gap:4px">' +
                '<button class="btn btn-ghost btn-sm" onclick="openEditContractModal(' + c.id + ')" style="font-size:11px">✏️</button>' +
                '<button class="btn btn-danger btn-sm" onclick="deleteContract(' + c.id + ')" style="font-size:11px">🗑️</button>' +
                '</div></td></tr>';
        }).join('');
        renderContractPagination();
    } catch (e) {
        console.error('[branches] loadContracts 실패:', e, e.stack);
        tbody.innerHTML = '<tr><td class="ctr-empty" colspan="9">불러오기 실패: ' + esc(e.message) + '</td></tr>';
        showToast('데이터를 불러올 수 없습니다', 'error');
    }
}


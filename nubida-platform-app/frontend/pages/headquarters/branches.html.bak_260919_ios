/* 3.3% vs 10% 실수령액 비교 (확정 전 의사결정용) */
function renderDeductCompare() {
    const box = document.getElementById('deductCompare');
    if (!box) return;
    const num = (id, dflt) => {
        const v = parseFloat((document.getElementById(id) || {}).value);
        return isNaN(v) ? dflt : v;
    };
    const royaltyRate = num('editRoyaltyRate', 45);
    const profitRate = num('editProfitRate', 7);
    const current = num('editIncomeTaxRate', 3.3);

    const SAMPLE = 1000000;
    const taxBase = SAMPLE / 1.1;
    const profit = taxBase * profitRate / 100;

    const calc = (r) => {
        const deduct = Math.round(profit * r / 100);
        return { deduct: deduct, net: Math.round(profit) - deduct };
    };
    const a = calc(3.3);
    const b = calc(10);
    const cur = calc(current);

    const rowHtml = (label, r, o, highlight) => {
        const badge = highlight ? ' <span style="color:var(--primary,#2563eb);font-weight:700">← 적용 중</span>' : '';
        return '<div style="display:flex;justify-content:space-between;' + (highlight ? 'font-weight:700;color:var(--text-primary)' : '') + '">' +
            '<span>' + label + '</span>' +
            '<span>공제 -' + fmtWon(o.deduct) + ' → <b>' + fmtWon(o.net) + '</b>' + badge + '</span>' +
            '</div>';
    };

    box.innerHTML =
        '<div style="font-weight:600;color:var(--text-primary);margin-bottom:6px">📊 실수령액 비교 (매출 100만원 · 순수익률 ' + profitRate + '% 기준)</div>' +
        rowHtml('3.3% 공제 (사업소득세)', 3.3, a, Math.abs(current - 3.3) < 0.001) +
        rowHtml('10% 공제', 10, b, Math.abs(current - 10) < 0.001) +
        (Math.abs(current - 3.3) > 0.001 && Math.abs(current - 10) > 0.001 ? rowHtml(current + '% 공제 (직접입력)', current, cur, true) : '') +
        '<div style="margin-top:6px;font-size:11.5px;color:var(--text-tertiary)">차이: 3.3% 대비 10%는 실수령액이 <b>' + fmtWon(b.net - a.net) + '</b> 적습니다.</div>';
}

/* 정산 설정 미리보기 — 매출 100만원 기준 실시간 계산 */
function renderSettlementPreview() {
    const box = document.getElementById('editSettlementPreview');
    if (!box) return;
    const num = (id, dflt) => {
        const v = parseFloat((document.getElementById(id) || {}).value);
        return isNaN(v) ? dflt : v;
    };
    const royaltyRate = num('editRoyaltyRate', 45);
    const profitRate = num('editProfitRate', 7);
    const taxRate = num('editIncomeTaxRate', 3.3);

    const SAMPLE = 1000000;                       // 매출 100만원 기준
    const taxBase = SAMPLE / 1.1;                 // 과세표준 (부가세 10% 제외)
    const vat = SAMPLE - taxBase;
    const royalty = taxBase * royaltyRate / 100;  // 본사 로열티
    const profit = taxBase * profitRate / 100;    // 에듀케어 순수익
    const incomeTax = profit * taxRate / 100;     // 사업소득세 (원천징수)
    const netDeposit = profit - incomeTax;        // 실수령액 (본사 → 에듀케어)
    const directorIncome = taxBase * (100 - royaltyRate) / 100;

    box.innerHTML =
        '<div style="font-weight:600;color:var(--text-primary);margin-bottom:6px">매출 100만원 기준</div>' +
        '<div style="display:flex;justify-content:space-between"><span>과세표준 (부가세 ' + fmtWon(vat) + ' 제외)</span><b>' + fmtWon(taxBase) + '</b></div>' +
        '<div style="display:flex;justify-content:space-between"><span>본사 로열티 ' + royaltyRate + '%</span><b>' + fmtWon(royalty) + '</b></div>' +
        '<div style="display:flex;justify-content:space-between"><span>원장 수익 ' + (100 - royaltyRate).toFixed(1) + '%</span><b>' + fmtWon(directorIncome) + '</b></div>' +
        '<div style="display:flex;justify-content:space-between"><span>에듀케어 순수익 ' + profitRate + '%</span><b>' + fmtWon(profit) + '</b></div>' +
        '<div style="display:flex;justify-content:space-between;color:var(--danger,#dc2626)"><span>순수익 공제 ' + taxRate + '%</span><b>-' + fmtWon(incomeTax) + '</b></div>' +
        '<div style="display:flex;justify-content:space-between;border-top:1px solid var(--border-default);margin-top:6px;padding-top:6px;font-weight:700;color:var(--primary,#2563eb)"><span>본사 → 에듀케어 입금액</span><b>' + fmtWon(netDeposit) + '</b></div>';
}

/* 금액 포맷 (원) */
function fmtWon(v) {
    const n = Math.round(v || 0);
    return n.toLocaleString('ko-KR') + '원';
}

async function updateBranch() {
    const id = document.getElementById('editBranchId').value;
    const name = document.getElementById('editName').value.trim();
    const status = document.getElementById('editStatus').value;
    const address = document.getElementById('editAddress').value.trim();

        renderBranchPagination();
    } catch (e) {
        clearTimeout(fallbackTimer);
        var ol = document.getElementById('pageLoading');
        if (ol) ol.classList.add('hide');
        console.error('[branches] loadBranches 실패:', e, e.stack);
        tbody.innerHTML = '<tr class="branch-empty"><td colspan="10">불러오기 실패: ' + esc(e.message) + '</td></tr>';

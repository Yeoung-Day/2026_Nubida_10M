async function createContract() {
    const director_id = document.getElementById('newContractDirector').value;
    const typeEl = document.querySelector('input[name="newContractType"]:checked');
    const contract_type = typeEl ? typeEl.value : 'direct';
    const branch_id = document.getElementById('newContractBranch').value;
    const start_date = document.getElementById('newContractStart').value;
    const end_date = document.getElementById('newContractEnd').value;
    const monthly_fee = parseInt(document.getElementById('newContractFee').value) || 0;
    const royalty_rate = parseFloat(document.getElementById('newContractRoyalty').value) || 0;
    const memo = document.getElementById('newContractMemo').value.trim();
    if (!director_id) { showToast('원장을 선택하세요', 'error'); return; }
    if (contract_type === 'franchise' && !branch_id) { showToast('소속 에듀케어를 선택하세요', 'error'); return; }
    if (!start_date) { showToast('계약 시작일을 선택하세요', 'error'); return; }
    if (!end_date) { showToast('계약 종료일을 선택하세요', 'error'); return; }
    const payload = { director_id: parseInt(director_id), contract_type, start_date, end_date, monthly_fee, royalty_rate, memo };
    if (contract_type === 'franchise' && branch_id) payload.branch_id = parseInt(branch_id);
    try {
        await apiPost('/headquarters/contracts', payload);
        showToast('계약이 생성되었습니다', 'success');
        document.getElementById('createContractModal').style.display = 'none';
        loadContracts(1);
    } catch (e) { showToast('생성 실패: ' + (e.message || ''), 'error'); }
}

function toggleEditBranchSelect() {
    const type = document.querySelector('input[name="editContractType"]:checked');
    document.getElementById('editContractBranchGroup').style.display = (type && type.value === 'franchise') ? '' : 'none';
}

async function openEditContractModal(id) {
    try {
        const res = await apiGet('/headquarters/contracts/' + id);
        const c = res.data || res;
        document.getElementById('editContractId').value = c.id;
        document.getElementById('editContractDirector').value = c.director_name || '';
        document.querySelectorAll('input[name="editContractType"]').forEach(r => { r.checked = r.value === c.contract_type; });
        toggleEditBranchSelect();
        try {
            const branchRes = await apiGet('/headquarters/branches?per_page=100');
            const branches = branchRes.data || [];
            const select = document.getElementById('editContractBranch');
            select.innerHTML = '<option value="">에듀케어를 선택하세요</option>' +
                branches.map(b => '<option value="' + b.id + '" ' + (b.id === c.branch_id ? 'selected' : '') + '>' + esc(b.name) + '</option>').join('');
        } catch (e) {}
        document.getElementById('editContractStart').value = c.start_date ? c.start_date.split('T')[0] : '';
        document.getElementById('editContractEnd').value = c.end_date ? c.end_date.split('T')[0] : '';
        document.getElementById('editContractFee').value = c.monthly_fee || 0;
        document.getElementById('editContractRoyalty').value = c.royalty_rate || 0;
        document.getElementById('editContractMemo').value = c.memo || '';
        document.getElementById('editContractModal').style.display = 'flex';
    } catch (e) { showToast('정보를 불러올 수 없습니다', 'error'); }
}

async function updateContract() {
    const id = document.getElementById('editContractId').value;
    const typeEl = document.querySelector('input[name="editContractType"]:checked');
    const contract_type = typeEl ? typeEl.value : 'direct';
    const branch_id = document.getElementById('editContractBranch').value;
    const start_date = document.getElementById('editContractStart').value;
    const end_date = document.getElementById('editContractEnd').value;
    const monthly_fee = parseInt(document.getElementById('editContractFee').value) || 0;
    const royalty_rate = parseFloat(document.getElementById('editContractRoyalty').value) || 0;
    const memo = document.getElementById('editContractMemo').value.trim();
    const payload = { contract_type, start_date, end_date, monthly_fee, royalty_rate, memo };
    if (contract_type === 'franchise' && branch_id) payload.branch_id = parseInt(branch_id);
    try {
        await apiPut('/headquarters/contracts/' + id, payload);
        showToast('계약이 수정되었습니다', 'success');
        document.getElementById('editContractModal').style.display = 'none';
        loadContracts(currentContractPage);
    } catch (e) { showToast('수정 실패: ' + (e.message || ''), 'error'); }
}

async function deleteContract(id) {
    if (!confirm('정말 이 계약을 삭제하시겠습니까?')) return;
    try {
        await apiDelete('/headquarters/contracts/' + id);
        showToast('계약이 삭제되었습니다', 'success');
        loadContracts(currentContractPage);
    } catch (e) { showToast('삭제 실패: ' + (e.message || ''), 'error'); }
}

/* ===== 카테고리 권한 ===== */
async function loadBranchSelectForCategories() {
    try {
        console.log('[branches] loadBranchSelectForCategories 호출');
        const res = await apiGet('/headquarters/branches?per_page=100');
        console.log('[branches] loadBranchSelectForCategories 응답:', res);
        const data = res && res.data;
        const branches = Array.isArray(data) ? data : [];
        const select = document.getElementById('branchCategorySelect');
        select.innerHTML = '<option value="">← 학원을 선택하세요</option>' +
            branches.map(b => '<option value="' + b.id + '">' + esc(b.name) + '</option>').join('');
        if (selectedCategoriesBranchId) {
            select.value = selectedCategoriesBranchId;
            onBranchSelectForCategories();
        } else {
            document.getElementById('categoryPermissionPanel').style.display = 'none';
            document.getElementById('categoryPermEmpty').style.display = '';
        }
    } catch (e) {
        console.error('[branches] loadBranchSelectForCategories 실패:', e, e.stack);
        showToast('에듀케어 목록을 불러올 수 없습니다', 'error');
    }
}

async function onBranchSelectForCategories() {
    const branchId = document.getElementById('branchCategorySelect').value;
    if (!branchId) {
        document.getElementById('categoryPermissionPanel').style.display = 'none';
        document.getElementById('categoryPermEmpty').style.display = '';
        selectedCategoriesBranchId = null;
        return;
    }
    selectedCategoriesBranchId = parseInt(branchId);
    document.getElementById('categoryPermEmpty').style.display = 'none';
    document.getElementById('categoryPermissionPanel').style.display = '';
    try {
        console.log('[branches] onBranchSelectForCategories - 브랜치 상세 요청:', branchId);
        const res = await apiGet('/headquarters/branches/' + branchId);
        console.log('[branches] 브랜치 상세 응답:', res);
        const b = res && (res.data || res);
        document.getElementById('selectedBranchInfo').textContent = esc(b.name || '') + ' (' + esc(b.code || '') + ')';
        document.getElementById('catPermTitle').textContent = '📚 강좌 카테고리 권한 설정 — ' + esc(b.name || '');
    } catch (e) {
        console.error('[branches] 브랜치 상세 로드 실패:', e, e.stack);
    }
    try {
        console.log('[branches] 카테고리/권한 로드 시작');
        const [catRes, permRes] = await Promise.all([
            apiGet('/headquarters/categories?per_page=100'),
            apiGet('/headquarters/branches/' + branchId + '/categories')
        ]);
        console.log('[branches] 카테고리 응답:', catRes);
        console.log('[branches] 권한 응답:', permRes);
        const catData = catRes && catRes.data;
        allCategories = Array.isArray(catData) ? catData : [];
        // GET /headquarters/branches/{id}/categories returns {branch_id, branch_name, categories: [...]}
        const permData = permRes && (permRes.data || permRes);
        const categories = (permData && (Array.isArray(permData.categories) ? permData.categories : null)) || [];
        const permittedKeys = new Set(
            categories
                .filter(function(c) { return c && c.is_active_for_branch; })
                .map(function(c) { return c.key; })
        );
        const list = document.getElementById('categoryToggleList');
        if (!allCategories.length) {
            list.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--text-tertiary)">등록된 카테고리가 없습니다.</div>';
            return;
        }
        list.innerHTML = allCategories.map(cat => {
            const checked = cat && cat.key && permittedKeys.has(cat.key) ? 'checked' : '';
            return '<label class="cat-toggle" style="display:flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid var(--border-subtle);border-radius:var(--radius-md);cursor:pointer;background:var(--bg-canvas)">' +
                '<input type="checkbox" class="cat-checkbox" data-cat-key="' + esc(cat.key) + '" ' + checked + ' style="width:18px;height:18px">' +
                '<span>' + esc(cat.name) + '</span></label>';
        }).join('');
        const checkedCount = document.querySelectorAll('.cat-checkbox:checked').length;
        document.getElementById('catCountInfo').textContent = '선택: ' + checkedCount + '/' + allCategories.length + '개';
    } catch (e) {
        console.error('[branches] 카테고리 권한 로드 실패:', e, e.stack);
        showToast('카테고리 정보를 불러올 수 없습니다', 'error');
    }
}

function selectAllCategories(select) {
    document.querySelectorAll('.cat-checkbox').forEach(cb => cb.checked = select);
    const checkedCount = document.querySelectorAll('.cat-checkbox:checked').length;
    document.getElementById('catCountInfo').textContent = '선택: ' + checkedCount + '/' + allCategories.length + '개';
}

async function saveCategoryPermissions() {
    if (!selectedCategoriesBranchId) { showToast('학원을 선택하세요', 'error'); return; }
    const checkedKeys = [];
    document.querySelectorAll('.cat-checkbox:checked').forEach(cb => checkedKeys.push(cb.dataset.catKey));
    try {
        // PUT /headquarters/branches/{id}/categories expects {categories: [{key: "...", ...}]}
        await apiPut('/headquarters/branches/' + selectedCategoriesBranchId + '/categories', {
            categories: checkedKeys.map(function(key) { return { key: key }; })
        });
        showToast('카테고리 권한이 저장되었습니다', 'success');
    } catch (e) { showToast('저장 실패: ' + (e.message || ''), 'error'); }
}

/* ===== 공통 모달 함수 ===== */
function closeCustomModal(id) { document.getElementById(id).style.display = 'none'; }

// ============================================================
// 우측 패널: 에듀케어 상세 대시보드
// ============================================================
let selectedBranchId = null;
let selectedDirectorId = null;
let branchDirectors = [];
let branchStudents = [];
let branchPayments = [];

async function showBranchDetail(branchId) {
    selectedBranchId = branchId;
    selectedDirectorId = null;
    
    // Highlight row
    document.querySelectorAll('#branchTableBody tr').forEach(r => r.classList.remove('branch-row-active'));
    const row = document.querySelector(`#branchTableBody tr[data-branch-id="${branchId}"]`);
    if (row) row.classList.add('branch-row-active');
    
    // Show the right panel
    document.getElementById('detailEmpty').style.display = 'none';
    document.getElementById('detailContent').style.display = 'block';
    
    // Set loading state
    document.getElementById('detailTitle').innerHTML = `🏢 로딩 중...`;
    document.getElementById('directorCards').innerHTML = '<div class="empty-detail" style="padding:20px;"><div class="text">⏳ 불러오는 중...</div></div>';
    
    try {
        // SINGLE API CALL — get all data at once
        const res = await apiGet('/headquarters/branches/' + branchId + '/overview');
        const data = res && res.data;
        if (!data) throw new Error('No data');
        
        // Branch info
        const b = data.branch || {};
        document.getElementById('detailTitle').innerHTML = `🏢 ${esc(b.name || '')}`;
        const badge = document.getElementById('detailStatusBadge');
        badge.style.display = 'inline-block';
        badge.innerHTML = getStatusBadge(b.status || 'active');
        
        // Stats
        document.getElementById('detailStats').style.display = 'flex';
        document.getElementById('detailStats').innerHTML = `
            <span>👤 원장 <strong>${data.directors ? data.directors.length : 0}명</strong></span>
            <span>👥 학생 <strong>${data.students ? data.students.length : 0}명</strong></span>
            <span>💳 결제 <strong>${data.payments ? data.payments.total_count : 0}건</strong></span>
        `;
        
        // Store data
        branchDirectors = data.directors || [];
        branchStudents = data.students || [];
        const payData = data.payments || {};
        branchPayments = payData.list || [];
        
        // Render directors
        renderDirectorCards();
        
        // Render payments
        document.getElementById('paymentCount').textContent = (payData.total_count || 0) + '건';
        document.getElementById('totalPaymentAmount').textContent = '₩' + Number(payData.total_amount || 0).toLocaleString();
        document.getElementById('completedPaymentCount').textContent = (payData.completed_count || 0) + '건';
        document.getElementById('pendingPaymentCount').textContent = (payData.pending_count || 0) + '건';
        renderPaymentList();
        
        // Render students
        renderStudentList();
        
    } catch(e) {
        console.error('Branch overview load error:', e);
        document.getElementById('detailTitle').innerHTML = `🏢 에듀케어 로딩 실패`;
        document.getElementById('directorCards').innerHTML = '<div class="empty-detail" style="padding:20px;"><div class="text">데이터를 불러올 수 없습니다</div></div>';
    }

    // 모바일/태블릿(1열 레이아웃): 상세 패널이 목록 아래로 밀리지 않도록
    // 선택 즉시 화면 상단으로 부드럽게 스크롤해 시야에 들어오게 함
    if (window.innerWidth <= 1200) {
        const detailPanel = document.getElementById('rightPanel');
        if (detailPanel) {
            setTimeout(() => detailPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
        }
    }
}

function renderDirectorCards() {
    const container = document.getElementById('directorCards');
    document.getElementById('directorCount').textContent = branchDirectors.length + '명';
    
    if (branchDirectors.length === 0) {
        container.innerHTML = '<div class="empty-detail" style="padding:20px;"><div class="text">연결된 원장이 없습니다</div></div>';
        return;
    }
    
    container.innerHTML = branchDirectors.map(d => {
        const isSelected = selectedDirectorId === d.id;
        const locked = !!d.nubida_machine_locked;
        const badgeHtml = locked
            ? '<span class="ml-badge locked">🔒 머신 잠금</span>'
            : '<span class="ml-badge normal">머신 정상</span>';
        const btnHtml = locked
            ? '<button class="ml-lock-btn is-locked" onclick="event.stopPropagation(); toggleMachineLock(' + d.id + ')">🔓 잠금 해제</button>'
            : '<button class="ml-lock-btn" onclick="event.stopPropagation(); toggleMachineLock(' + d.id + ')">🔒 머신 잠금</button>';
        return `<div class="director-card ${isSelected ? 'selected' : ''}" onclick="selectDirector(${d.id})">
            <div class="dc-name">👤 ${esc(d.name || '')}${badgeHtml}</div>
            <div class="dc-info">
                <span>📞 ${esc(d.phone || '-')}</span>
                <span>🏫 ${esc(d.academy_type || '-')}</span>
                <span>📍 ${esc(d.region || '-')}</span>
            </div>
            <div class="dc-stats">
                <div class="dc-stat"><span class="num">${d.student_count || 0}명</span>학생</div>
                <div class="dc-stat"><span class="num">₩${Number(d.total_payment || 0).toLocaleString()}</span>결제</div>
            </div>
            <div class="dc-lock-row">${btnHtml}</div>
        </div>`;
    }).join('');
}

/* 누비다머신 잠금 토글 — 원장 1명 + 소속 학생 전체에 즉시 적용 */
async function toggleMachineLock(directorId) {
    const d = branchDirectors.find(x => x.id === directorId);
    if (!d) return;
    const next = !d.nubida_machine_locked;
    const actionLabel = next ? '잠금 설정' : '잠금 해제';
    if (!confirm(`'${d.name || '원장'}' 원장의 누비다머신을 ${actionLabel}하시겠습니까?\n\n잠금 시 해당 원장과 소속 학생은 AI 어시스턴트·ML 스튜디오·아두이노 실습을 사용할 수 없습니다.`)) return;
    try {
        const res = await apiPut('/headquarters/users/' + directorId + '/nubida-machine-lock', { nubida_machine_locked: next });
        if (res && res.success === false) throw new Error(res.message || 'API 오류');
        d.nubida_machine_locked = next;
        renderDirectorCards();
        showToast(next ? '🔒 누비다머신이 잠금 처리되었습니다' : '🔓 누비다머신 잠금이 해제되었습니다', next ? 'error' : 'success');
    } catch (e) {
        console.error('[branches] Machine lock toggle error:', e);
        showToast('잠금 상태 변경에 실패했습니다: ' + (e.message || ''), 'error');
    }
}

function renderPaymentList(filterDirectorId) {
    const list = document.getElementById('paymentList');
    let filtered = branchPayments;
    
    if (filterDirectorId) {
        // Filter payments by students belonging to this director
        const dirStudentIds = branchStudents
            .filter(s => s.director_id == filterDirectorId)
            .map(s => s.id);
        filtered = branchPayments.filter(p => dirStudentIds.includes(p.student_id));
    }
    
    if (filtered.length === 0) {
        list.innerHTML = '<p class="text-muted" style="text-align:center;padding:12px;">결제 내역이 없습니다</p>';
        return;
    }
    
    list.innerHTML = filtered.slice(0, 10).map(p => `
        <div class="payment-mini-item">
            <div class="pmi-left">
                <span class="pmi-date">${formatDate(p.paid_at)}</span>
                <span>${esc(p.student_name || '-')}</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <span class="pmi-amount">₩${Number(p.amount || 0).toLocaleString()}</span>
                <span class="badge ${p.status === 'completed' ? 'badge-success' : 'badge-warning'}">${p.status === 'completed' ? '완료' : '대기'}</span>
            </div>
        </div>
    `).join('');
}

function renderStudentList(filterDirectorId) {
    const tbody = document.getElementById('studentTableBody');
    let filtered = branchStudents;
    
    if (filterDirectorId) {
        filtered = branchStudents.filter(s => s.director_id == filterDirectorId);
    }
    
    document.getElementById('studentCount').textContent = filtered.length + '명';
    
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;color:#9CA3AF;">학생이 없습니다</td></tr>';
        return;
    }
    
    tbody.innerHTML = filtered.map(s => {
        const courseNames = (s.enrollments || []).map(e => e.course_name).filter(Boolean).join(', ') || '-';
        return `<tr>
            <td>${s.id}</td>
            <td><strong>${esc(s.name || '')}</strong></td>
            <td>${esc(s.phone || '-')}</td>
            <td>${esc(s.director_name || '-')}</td>
            <td><span class="badge ${s.is_active ? 'badge-success' : 'badge-inactive'}">${s.is_active ? '활성' : '비활성'}</span></td>
        </tr>`;
    }).join('');
}

function selectDirector(directorId) {
    selectedDirectorId = directorId;
    
    // Update card highlight
    document.querySelectorAll('.director-card').forEach(c => c.classList.remove('selected'));
    const cards = document.querySelectorAll('.director-card');
    for (let i = 0; i < branchDirectors.length; i++) {
        if (branchDirectors[i].id === directorId && cards[i]) {
            cards[i].classList.add('selected');
            break;
        }
    }
    
    // Update payment list filtered
    renderPaymentList(directorId);
    
    // Update student list filtered
    renderStudentList(directorId);
}


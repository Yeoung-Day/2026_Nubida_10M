            <h3 id="courseModalTitle">➕ 강좌 추가</h3>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editCourseId" value="">
            <div class="form-group">
                <label>강좌명</label>
                <input type="text" class="input" id="editCourseName" placeholder="예: AI로봇 창의코딩">
            </div>
            <div class="form-group">
                <label>카테고리</label>
                <select class="input" id="editCourseCategory">
                    <option value="ai_robot">🤖 AI로봇</option>
                    <option value="ai_art">🎨 AI미술</option>
                    <option value="general">📚 일반</option>
                </select>
            </div>
        </div>
        <div class="modal-footer" style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid #E5E7EB;">
            <button class="btn btn-secondary" onclick="closeCourseModal()">취소</button>
            <button class="btn btn-primary" id="btnSaveCourse" onclick="saveCourse()">저장</button>
        </div>
    </div>
</div>

<script src="/common/js/api.js?v=20260918abort"></script>
<script src="/common/js/auth.js?v=20260908a"></script>
<script src="/common/js/hamburger.js?v=20260610b"></script>
<script src="/common/js/nav.js?v=20260913nav"></script>
<script>
    // ============================================================
    // STATE
    // ============================================================
    let courses = [];
    let templates = [];
    let selectedCourseId = null;
    let editingTemplateId = null;
    let formFields = [];

    const FIELD_ICONS = {
        text: '🔤', textarea: '📄', image: '🖼️', file: '📎',
        video: '🎬', code: '💻', rating: '⭐',
    };
    const FIELD_LABELS = {
        text: '텍스트', textarea: '텍스트영역', image: '이미지',
        file: '파일', video: '영상 링크', code: '코드', rating: '만족도',
    };
    const FIELD_COLORS = {
        text: '#374151', textarea: '#374151', image: '#7C3AED',
        file: '#2563EB', video: '#DC2626', code: '#059669', rating: '#D97706',
    };

    // ============================================================
    // INIT
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        requireAuth();
        renderSidebarUser();
        const u = JSON.parse(localStorage.getItem('user') || '{}');
        if (u.name) document.getElementById('sidebarUserName').textContent = u.name;
        document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});
        loadCourses();
    });

    // ============================================================
    // COURSES
    // ============================================================
    async function loadCourses(retryCount = 3) {
        for (let attempt = 1; attempt <= retryCount; attempt++) {
            try {
                const res = await apiGet('/headquarters/courses');
                const data = res.data || res || [];
                courses = Array.isArray(data) ? data : (data.courses || data.data || []);
                if (courses.length === 0 && res.data && res.data.courses) courses = res.data.courses;
                renderCourseList();
                if (courses.length > 0) selectCourse(courses[0].id);
                return;
            } catch(e) {
                console.error(`Course load error (attempt ${attempt}/${retryCount}):`, e);
                if (attempt < retryCount) {
                    document.getElementById('courseList').innerHTML =
                        '<div class="empty-state"><div class="empty-icon">⏳</div><div class="empty-text">강좌 로딩 중... (' + attempt + '/' + retryCount + ')</div></div>';
                    await new Promise(r => setTimeout(r, 3000 * attempt));
                } else {
                    document.getElementById('courseList').innerHTML =
                        '<div class="empty-state"><div class="empty-icon">⚠️</div><div class="empty-text">강좌 로딩 실패</div><div class="empty-sub">페이지를 새로고침 해주세요</div></div>';
                }
            }
        }
    }

    function renderCourseList() {
        const el = document.getElementById('courseList');
        el.innerHTML = courses.map(c => {
            const tmplCount = templates.filter(t => t.course_id === c.id).length;
            return `<div class="course-item ${selectedCourseId === c.id ? 'active' : ''}" onclick="selectCourse(${c.id})">
                <div class="ci-icon" style="background:${c.category === 'ai_robot' ? '#ECFEFF' : c.category === 'ai_art' ? '#F5F3FF' : '#FEF3C7'}">
                    ${c.category === 'ai_robot' ? '🤖' : c.category === 'ai_art' ? '🎨' : '📚'}
                </div>
                <div class="ci-info">
                    <div class="ci-name">${c.name}</div>
                    <div class="ci-meta">${c.category || '일반'}</div>
                </div>
                <div class="ci-count">${tmplCount}개</div>
                <div style="display:flex;gap:2px;flex-shrink:0;margin-left:4px;">
                    <button onclick="event.stopPropagation();showCourseModal(${c.id})" title="수정" style="background:none;border:none;cursor:pointer;font-size:14px;padding:2px;opacity:0.5;transition:0.15s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.5">✏️</button>
                    <button onclick="event.stopPropagation();deleteCourse(${c.id})" title="삭제" style="background:none;border:none;cursor:pointer;font-size:14px;padding:2px;opacity:0.5;transition:0.15s;color:#DC2626;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.5">🗑️</button>
                </div>
            </div>`;
        }).join('');
        if (courses.length === 0) {
            el.innerHTML = '<div class="empty-state"><div class="empty-icon">📭</div><div class="empty-text">강좌가 없습니다</div></div>';
        }
    }

    // ============================================================
    // SELECT COURSE → LOAD TEMPLATES (with schedule)
    // ============================================================
    const WEEK_LABELS = ['', '첫째주', '둘째주', '셋째주', '넷째주', '다섯째주'];
    const DAY_LABELS = ['', '월', '화', '수', '목', '금', '토', '일'];

    function formatSchedule(t) {
        const w = (t.weeks || []).map(w => WEEK_LABELS[w] || '').filter(Boolean).join('+');
        const d = (t.days || []).filter(Boolean).join(', ');
        if (!w && !d) return '';
        return ' 📅 ' + [w ? '(' + w + ')' : '', d].filter(Boolean).join(' ');
    }

    function setScheduleCheckboxes(weeks, days) {
        document.querySelectorAll('.week-cb').forEach(cb => cb.checked = (weeks || []).includes(parseInt(cb.value)));
        document.querySelectorAll('.day-cb').forEach(cb => cb.checked = (days || []).includes(cb.value));
    }

    function getScheduleWeeks() {
        return Array.from(document.querySelectorAll('.week-cb:checked')).map(cb => parseInt(cb.value));
    }

    function getScheduleDays() {
        return Array.from(document.querySelectorAll('.day-cb:checked')).map(cb => cb.value);
    }

    async function selectCourse(courseId) {
        selectedCourseId = courseId;
        editingTemplateId = null;
        formFields = [];
        document.querySelectorAll('.course-item').forEach(el => el.classList.remove('active'));
        document.querySelector(`.course-item[onclick*="${courseId}"]`)?.classList.add('active');

        const course = courses.find(c => c.id === courseId);
        document.getElementById('editorTitle').textContent = course ? `📝 ${course.name}` : '강좌 선택됨';

        // Load templates for this course
        try {
            const res = await apiGet('/portfolio-templates?course_id=' + courseId + '&per_page=50');
            const data = res.data || {};
            templates = data.templates || [];
        } catch(e) {
            templates = [];
        }

        renderTemplatesList();
        showEditorForm();

        // Auto-select first template if exists
        if (templates.length > 0) {
            selectTemplate(templates[0].id);
        } else {
            clearForm();
        }

        // Update course list counts
        renderCourseList();
    }

    // ============================================================
    // TEMPLATES LIST
    // ============================================================
    function renderTemplatesList() {
        const el = document.getElementById('templatesList');
        el.innerHTML = templates.map(t => {
            const isActive = editingTemplateId === t.id;
            return `
            <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid #E5E7EB;border-radius:8px;margin-bottom:6px;cursor:pointer;${isActive ? 'background:#EEF0FF;border-color:#4F5EF8;' : ''}" onclick="selectTemplate(${t.id})">
                <div style="flex:1;min-width:0;">
                    <span style="font-size:13px;font-weight:600;color:#111827;">${t.title}</span>
                    <span style="font-size:11px;color:#9CA3AF;margin-left:8px;">${(t.form_fields||[]).length}개 항목</span>
                    <span style="font-size:11px;color:#6366F1;">${formatSchedule(t)}</span>
                </div>
                <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                    <span class="badge ${t.is_active ? 'badge-success' : 'badge-inactive'}">${t.is_active ? '활성' : '비활성'}</span>
                    <button onclick="event.stopPropagation();selectTemplate(${t.id})" title="편집" style="background:none;border:none;cursor:pointer;font-size:14px;padding:2px 4px;opacity:0.5;transition:0.15s;border-radius:4px;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.5">✏️</button>
                    <button onclick="event.stopPropagation();deleteTemplateById(${t.id})" title="삭제" style="background:none;border:none;cursor:pointer;font-size:14px;padding:2px 4px;opacity:0.5;transition:0.15s;border-radius:4px;color:#DC2626;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.5">🗑️</button>
                </div>
            </div>`;
        }).join('');
        if (templates.length === 0) {
            el.innerHTML = '<p class="text-muted">저장된 템플릿이 없습니다. "➕ 새 템플릿" 버튼으로 만들어보세요.</p>';
        }
    }

    // ============================================================
    // SELECT TEMPLATE
    // ============================================================
    function selectTemplate(tid) {
        const t = templates.find(tm => tm.id === tid);
        if (!t) return;
        editingTemplateId = t.id;
        document.getElementById('editTitle').value = t.title || '포트폴리오';
        document.getElementById('editDescription').value = t.description || '';
        document.getElementById('editGuideText').value = t.guide_text || '';
        setScheduleCheckboxes(t.weeks, t.days);
        var sortEl = document.getElementById('editSortOrder');
        if (sortEl) sortEl.value = t.sort_order || 0;
        formFields = (t.form_fields && Array.isArray(t.form_fields)) ? JSON.parse(JSON.stringify(t.form_fields)) : [];
        renderFields();
        document.getElementById('btnSaveTemplate').style.display = 'inline-block';
        document.getElementById('btnSaveTemplate').textContent = '💾 수정 저장';
        document.getElementById('btnDeleteTemplate').style.display = 'inline-block';
        document.getElementById('editorTitle').textContent = `📝 ${(courses.find(c => c.id === selectedCourseId)||{}).name || ''}`;
        renderTemplatesList();
    }

    // ============================================================
    // CLEAR FORM
    // ============================================================
    function clearForm() {
        editingTemplateId = null;
        document.getElementById('editTitle').value = '포트폴리오';
        document.getElementById('editDescription').value = '';
        document.getElementById('editGuideText').value = '';
        setScheduleCheckboxes([], []);
        var sortEl = document.getElementById('editSortOrder');
        if (sortEl) sortEl.value = '0';
        formFields = [];
        renderFields();
        document.getElementById('btnSaveTemplate').style.display = 'inline-block';
        document.getElementById('btnSaveTemplate').textContent = '💾 새 템플릿 저장';
        document.getElementById('btnDeleteTemplate').style.display = 'none';
    }

    function showEditorForm() {
        document.getElementById('editorBody').querySelector('.no-course-selected').style.display = 'none';
        document.getElementById('editorForm').style.display = 'block';
        document.getElementById('btnSaveTemplate').style.display = 'inline-block';
    }

    // ============================================================
    // FIELDS BUILDER
    // ============================================================
    function addField(type) {
        const field = {
            type: type,
            label: FIELD_LABELS[type] || type,
            required: type === 'text' || type === 'textarea',
            placeholder: '',
        };
        if (type === 'image' || type === 'file') field.max_count = 10;
        if (type === 'rating') field.max = 5;
        formFields.push(field);
        renderFields();
    }

    function removeField(index) {
        formFields.splice(index, 1);
        renderFields();
    }

    function moveField(index, direction) {
        const newIndex = index + direction;
        if (newIndex < 0 || newIndex >= formFields.length) return;
        [formFields[index], formFields[newIndex]] = [formFields[newIndex], formFields[index]];
        renderFields();
    }

    function updateFieldLabel(index, value) {
        formFields[index].label = value;
    }

    function toggleRequired(index) {
        formFields[index].required = !formFields[index].required;
        renderFields();
    }

    function updateMaxCount(index, value) {
        formFields[index].max_count = parseInt(value) || 10;
    }

    function renderFields() {
        const el = document.getElementById('fieldsContainer');
        document.getElementById('fieldsEmptyMsg').style.display = formFields.length === 0 ? 'block' : 'none';

        el.innerHTML = formFields.map((f, i) => {
            let options = `
                <div class="field-options">
                    <label><input type="checkbox" ${f.required ? 'checked' : ''} onchange="toggleRequired(${i})"> 필수</label>`;
            if (f.type === 'image' || f.type === 'file') {
                options += `<label>최대 <input type="number" value="${f.max_count || 10}" min="1" max="50" onchange="updateMaxCount(${i}, this.value)" style="width:50px;">개</label>`;
            }
            if (f.type === 'rating') {
                options += `<label>최대 <input type="number" value="${f.max || 5}" min="1" max="10" style="width:50px;">점</label>`;
            }
            options += `</div>`;

            return `<div class="field-item">
                <div class="field-item-header">
                    <span class="field-drag" title="드래그로 순서 변경 (↑↓ 버튼 사용)">⠿</span>
                    <span class="field-type-badge">${FIELD_ICONS[f.type]||''} ${FIELD_LABELS[f.type]||f.type}</span>
                    <input class="field-label-input" value="${f.label}" placeholder="항목명" onchange="updateFieldLabel(${i}, this.value)">
                    <div class="field-actions">
                        <button onclick="moveField(${i}, -1)" title="위로 이동">↑</button>
                        <button onclick="moveField(${i}, 1)" title="아래로 이동">↓</button>
                        <button onclick="removeField(${i})" title="삭제" style="color:#DC2626;">✕</button>
                    </div>
                </div>
                ${options}
            </div>`;
        }).join('');
    }

    // ============================================================
    // NEW / DELETE BY ID
    // ============================================================
    function newTemplate() {
        // Clear form and set up for creating a new template
        editingTemplateId = null;
        clearForm();
        document.getElementById('editorTitle').textContent = `📝 새 템플릿 — ${(courses.find(c => c.id === selectedCourseId)||{}).name || ''}`;
        document.getElementById('btnSaveTemplate').textContent = '💾 템플릿 저장';
        renderTemplatesList();
        // Scroll to editor
        document.querySelector('.editor-card')?.scrollIntoView({ behavior: 'smooth' });
    }

    async function deleteTemplateById(tid) {
        if (!confirm('정말 이 템플릿을 삭제하시겠습니까?')) return;
        try {
            await apiDelete('/portfolio-templates/' + tid);
            if (editingTemplateId === tid) {
                editingTemplateId = null;
                clearForm();
            }
            await selectCourse(selectedCourseId);
        } catch(e) {
            alert('❌ ' + (e.message || '삭제 실패'));
        }
    }

    // ============================================================
    // SAVE TEMPLATE
    // ============================================================
    async function saveTemplate() {
        const title = document.getElementById('editTitle').value.trim();
        if (!title) { alert('템플릿 제목을 입력해주세요.'); return; }
        if (!selectedCourseId) { alert('강좌를 먼저 선택해주세요.'); return; }

        const body = {
            course_id: selectedCourseId,
            title: title,
            description: document.getElementById('editDescription').value.trim(),
            guide_text: document.getElementById('editGuideText').value.trim(),
            form_fields: formFields,
            is_active: true,
            weeks: getScheduleWeeks(),
            days: getScheduleDays(),
            sort_order: parseInt((document.getElementById('editSortOrder') || {}).value) || 0,
        };

        try {
            if (editingTemplateId) {
                await apiPut('/portfolio-templates/' + editingTemplateId, body);
                alert('✅ 템플릿이 수정되었습니다.');
            } else {
                const res = await apiPost('/portfolio-templates', body);
                alert('✅ 새 템플릿이 생성되었습니다.');
            }
            // Reload templates
            await selectCourse(selectedCourseId);
        } catch(e) {
            alert('❌ ' + (e.message || '저장 실패'));
        }
    }

    // ============================================================
    // DELETE TEMPLATE
    // ============================================================
    async function deleteTemplate() {
        if (!editingTemplateId) return;
        if (!confirm('정말 이 템플릿을 삭제하시겠습니까?')) return;
        try {
            await apiDelete('/portfolio-templates/' + editingTemplateId);
            alert('🗑️ 템플릿이 삭제되었습니다.');
            await selectCourse(selectedCourseId);
        } catch(e) {
            alert('❌ ' + (e.message || '삭제 실패'));
        }
    }

    // ============================================================
    // COURSE CRUD (추가/수정/삭제)
    // ============================================================
    function showCourseModal(courseId) {
        if (courseId) {
            // 수정 모드
            document.getElementById('courseModalTitle').textContent = '✏️ 강좌 수정';
            document.getElementById('btnSaveCourse').textContent = '수정';
            const c = courses.find(x => x.id === courseId);
            if (c) {
                document.getElementById('editCourseId').value = c.id;
                document.getElementById('editCourseName').value = c.name;
                document.getElementById('editCourseCategory').value = c.category || 'general';
            }
        } else {
            // 추가 모드
            document.getElementById('courseModalTitle').textContent = '➕ 강좌 추가';
            document.getElementById('btnSaveCourse').textContent = '저장';
            document.getElementById('editCourseId').value = '';
            document.getElementById('editCourseName').value = '';
            document.getElementById('editCourseCategory').value = 'general';
        }
        document.getElementById('courseModal').style.display = 'flex';
    }

    function closeCourseModal() {
        document.getElementById('courseModal').style.display = 'none';
    }

    async function saveCourse() {
        const name = document.getElementById('editCourseName').value.trim();
        if (!name) { alert('강좌명을 입력해주세요.'); return; }
        const category = document.getElementById('editCourseCategory').value;
        const courseId = document.getElementById('editCourseId').value;
        const body = { title: name, category: category };
        try {
            if (courseId) {
                // 수정
                await apiPut('/headquarters/courses/' + courseId, body);
                alert('✅ 강좌가 수정되었습니다.');
            } else {
                // 추가
                await apiPost('/headquarters/courses', body);
                alert('✅ 새 강좌가 추가되었습니다.');
            }
            closeCourseModal();
            await loadCourses();
        } catch(e) {
            alert('❌ ' + (e.message || '실패'));
        }
    }

    async function deleteCourse(courseId) {
        const c = courses.find(x => x.id === courseId);
        if (!confirm(`정말 "${c ? c.name : '이 강좌'}"를 삭제하시겠습니까?\n연결된 모든 템플릿도 함께 삭제됩니다.`)) return;
        try {
            await apiDelete('/headquarters/courses/' + courseId);
            alert('🗑️ 강좌가 삭제되었습니다.');
            // 삭제된 강좌가 선택 중이었다면 첫 번째 강좌로 이동
            if (selectedCourseId === courseId) {
                selectedCourseId = null;
            }
            await loadCourses();
            // 강좌 목록 다시 로드 후 첫 번째 선택
            if (courses.length > 0) {
                selectCourse(courses[0].id);
            } else {
                document.getElementById('editorTitle').textContent = '강좌를 선택해주세요';
                document.getElementById('editorForm').style.display = 'none';
                document.querySelector('.no-course-selected').style.display = 'block';
            }
        } catch(e) {
            alert('❌ ' + (e.message || '삭제 실패'));
        }
    }

    // ============================================================
    // LOGOUT
    // ============================================================
    function handleLogout() {
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        window.location.href = '/pages/login.html';
    }
</script>
</body>
</html>

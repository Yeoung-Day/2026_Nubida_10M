        .course-list-body { max-height:600px; overflow-y:auto; }
        .course-item { display:flex; align-items:center; gap:12px; padding:14px 20px; cursor:pointer; border-left:3px solid transparent; transition:all 0.15s; }
        .course-item:hover { background:#F9FAFB; }
        .course-item.active { background:#EEF0FF; border-left-color:#4F5EF8; }
        .course-item .ci-icon { width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
        .course-item .ci-info { flex:1; min-width:0; }
        .course-item .ci-name { font-size:14px; font-weight:600; color:#111827; }
        .course-item .ci-meta { font-size:11px; color:#9CA3AF; margin-top:2px; }
        .course-item .ci-count { font-size:11px; background:#F3F4F6; padding:2px 8px; border-radius:10px; color:#6B7280; white-space:nowrap; }

        /* ── Editor Panel ── */
        .editor-card { background:#fff; border:1px solid #E5E7EB; border-radius:12px; overflow:hidden; }
        .editor-header { display:flex; justify-content:space-between; align-items:center; padding:16px 24px; border-bottom:1px solid #E5E7EB; }
        .editor-header h2 { font-size:16px; font-weight:700; margin:0; }
        .editor-body { padding:24px; }

        /* ── Form Fields Builder ── */
        .fields-section { margin-top:20px; border-top:1px solid #E5E7EB; padding-top:20px; }
        .fields-section h3 { font-size:13px; font-weight:600; color:#374151; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
        .fields-grid { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
        .field-type-btn { padding:8px 14px; border:1px solid #D1D5DB; border-radius:8px; background:#fff; cursor:pointer; font-size:13px; transition:all 0.15s; display:flex; align-items:center; gap:4px; }
        .field-type-btn:hover { border-color:#4F5EF8; background:#EEF0FF; }

        .field-item { background:#F9FAFB; border:1px solid #E5E7EB; border-radius:10px; padding:16px; margin-bottom:12px; position:relative; }
        .field-item-header { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
        .field-drag { cursor:grab; color:#9CA3AF; font-size:16px; }
        .field-item .field-type-badge { font-size:10px; padding:2px 8px; border-radius:4px; background:#DBEAFE; color:#1E40AF; font-weight:600; white-space:nowrap; }
        .field-item .field-label-input { flex:1; border:1px solid #D1D5DB; border-radius:6px; padding:6px 10px; font-size:13px; }
        .field-item .field-actions { display:flex; gap:4px; }
        .field-item .field-actions button { background:none; border:none; cursor:pointer; font-size:14px; padding:4px; border-radius:4px; opacity:0.5; transition:all 0.15s; }
        .field-item .field-actions button:hover { opacity:1; background:#E5E7EB; }
        .field-options { display:flex; gap:16px; flex-wrap:wrap; padding-left:24px; }
        .field-options label { display:flex; align-items:center; gap:4px; font-size:12px; color:#6B7280; cursor:pointer; }
        .field-options input[type="checkbox"] { accent-color:#4F5EF8; }
        .field-options input[type="number"] { width:60px; padding:4px 6px; border:1px solid #D1D5DB; border-radius:4px; font-size:12px; }

        .empty-state { text-align:center; padding:40px 20px; color:#9CA3AF; }
        .empty-state .empty-icon { font-size:48px; margin-bottom:12px; }
        .empty-state .empty-text { font-size:14px; }

        .no-course-selected { text-align:center; padding:60px 20px; color:#9CA3AF; }
        .no-course-selected .big-icon { font-size:64px; margin-bottom:16px; }

        /* ── Status ── */
        .form-group-inline { display:flex; gap:12px; flex-wrap:wrap; }
        .form-group-inline .form-group { flex:1; min-width:180px; }

        /* reset badge overrides */

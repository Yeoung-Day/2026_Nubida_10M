   if (!container) return;
   fetch('/pages/headquarters/nav.html')
   .then(r => r.text())
   .then(html => {
   container.innerHTML = html;
   // Mark current page active
   const currentPage = 'courses.html';
   container.querySelectorAll('.nav-item').forEach(function(a) {
   if (a.getAttribute('href') === currentPage) a.classList.add('active');
   });
   })
   .catch(function() { container.innerHTML = '네비게이션 로딩 실패'; });
   }

   async function loadCategories() {
   var overlay = document.getElementById('pageLoading');
   if (overlay) overlay.classList.remove('hide');
   try {
   const res = await apiGet('/headquarters/courses/categories');
   const cats = res.data || [];
   const grid = document.getElementById('categoryGrid');
   if (overlay) overlay.classList.add('hide');
   if (cats.length === 0) {
   grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--text-tertiary)">📭 등록된 카테고리가 없습니다. 아래 [+추가] 버튼으로 생성해주세요.</div>';
   return;
   }
   let html = '';
   cats.forEach(function(c) {
   const color = c.color || '#4F5EF8';
   const bgColor = c.bg_color || 'rgba(8,145,178,0.08)';
   const iconMap = {
   'ai_art': '🎨', 'ai_robot': '🤖'
   };
   const icon = iconMap[c.key] || '📁';
   html += '<div class="cat-card" style="border-top:3px solid ' + color + '">';
   html += '<div class="cat-icon">' + icon + '</div>';
   html += '<div class="cat-name" style="color:' + color + '">' + esc(c.name) + '</div>';
   html += '<div class="cat-stats">';
   html += '<span>📖 강좌 ' + (c.course_count || 0) + '개</span>';
   html += '<span>📁 폴더 ' + (c.folder_count || 0) + '개</span>';
   html += '</div>';
   const isPub = (c.is_public === undefined || c.is_public === null) ? true : !!c.is_public;
   html += '<div class="cat-public-row">';
   html += '<span class="cat-public-label ' + (isPub ? 'on' : 'off') + '" id="catPubLabel' + c.id + '">';
   html += (isPub ? '✅ 전체 공개' : '🚫 사용 중지');
   html += '</span>';
   html += '<label class="cat-switch" title="체크하면 원장·에듀케어가 매출/인원에서 이 강좌를 사용할 수 있습니다.">';
   html += '<input type="checkbox" ' + (isPub ? 'checked' : '') + ' onchange="toggleCategoryPublic(' + c.id + ', this)">';
   html += '<span class="slider"></span>';
   html += '</label>';
   html += '</div>';
   html += '<a href="category.html?cat=' + encodeURIComponent(c.key) + '" class="cat-btn" style="background:' + color + '">바로가기 →</a>';
   html += '</div>';
   });
   // Add card
   html += '<div class="cat-add-card" onclick="openCreateCategoryModal()">';
   html += '<div class="plus">+</div>';
   html += '<div class="label">카테고리 추가</div>';
   html += '</div>';
   grid.innerHTML = html;
   } catch (err) {
   if (overlay) overlay.classList.add('hide');
   document.getElementById('categoryGrid').innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--text-tertiary)">❌ 카테고리 로딩 실패: ' + esc(err.message) + '</div>';
   }
   }

   // ===== 카테고리 전체공개 토글 (원장·에듀케어 매출/인원 사용 허용) =====
   async function toggleCategoryPublic(categoryId, el) {
   const next = !!el.checked;
   el.disabled = true;
   try {
   await apiPatch('/headquarters/categories/' + categoryId + '/public', { is_public: next });
   const label = document.getElementById('catPubLabel' + categoryId);
   if (label) {
   label.textContent = next ? '✅ 전체 공개' : '🚫 사용 중지';
   label.classList.toggle('on', next);
   label.classList.toggle('off', !next);
   }
   showAlert(next ? '전체 공개로 설정했습니다. 원장·에듀케어가 사용할 수 있습니다.' : '사용 중지로 설정했습니다. 원장·에듀케어 매출/인원에서 제외됩니다.', 'success');
   } catch (err) {
   el.checked = !next; // 롤백
   showAlert(err.message || '설정 변경 실패', 'error');
   } finally {
   el.disabled = false;
   }
   }

   // ===== Create Category Modal (inline) =====
   function openCreateCategoryModal() {
   const name = prompt('새 카테고리 이름을 입력하세요.\n예: 스마트팜, 창의융합', '');
   if (!name) return;
   const key = prompt('카테고리 키(영문/언더스코어)를 입력하세요.\n예: smart_farm, creative_merge', name.toLowerCase().replace(/[^a-z0-9_]/g, '_'));
   if (!key) return;
   const color = prompt('글자색 (hex code, 예: #6B21A8)', '#6B21A8');
   const bgColor = prompt('배경색 (hex code, 예: #F3E8FF)', '#F3E8FF');
   apiPost('/headquarters/categories', {
   key: key,
   name: name,
   color: color || null,
   bg_color: bgColor || null,
   sort_order: 99
   }).then(function(res) {
   showAlert('카테고리가 생성되었습니다.', 'success');
   loadCategories();
   }).catch(function(err) {
   showAlert(err.message || '생성 실패', 'error');
   });
   }
   </script>


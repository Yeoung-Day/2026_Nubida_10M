    <script>
        // ============================================================
        // Q&A 관리 페이지 — 인라인 스크립트 (전체 try/catch 보호)
        // ============================================================
        (function() {
            'use strict';
            try {
                let allInquiries = [];

                function esc(s) {
                    if (s == null) return '';
                    const d = document.createElement('div');
                    d.textContent = s;
                    return d.innerHTML;
                }

                document.addEventListener('DOMContentLoaded', () => {
                    try {
                        console.log('[Q&A] DOMContentLoaded — 초기화 시작');
                        const user = getCurrentUser();
                        if (user) {
                            document.getElementById('sidebarUserName').textContent = user.name || user.username || '관리자';
                            document.getElementById('sidebarUserRole').textContent = '본사';
                        }
                        const now = new Date();
                        document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', {
                            year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
                        });
                        console.log('[Q&A] loadInquiries() 호출');
                        loadInquiries();
                    } catch(e) {
                        console.error('[Q&A] DOMContentLoaded 핸들러 오류:', e);
                    }
                });

                async function loadInquiries() {
                    console.log('[Q&A] loadInquiries() 시작');
                    const statusEl = document.getElementById('statusFilter');
                    const status = statusEl ? statusEl.value : '';
                    let url = '/inquiries/all';
                    if (status) url += '?status=' + encodeURIComponent(status);

                    try {
                        console.log('[Q&A] API 호출:', url);
                        const res = await apiGet(url);
                        console.log('[Q&A] API 응답:', res && res.status);
                        allInquiries = (res && res.data) || [];
                        renderTable();
                    } catch(e) {
                        console.error('[Q&A] Load error:', e);
                        const tbody = document.getElementById('inquiryTbody');
                        if (tbody) {
                            tbody.innerHTML = 
                                '<tr><td colspan="8" style="text-align:center;padding:40px;color:#EF4444;">데이터를 불러올 수 없습니다. 서버 상태를 확인해주세요.</td></tr>';
                        }
                    }
                }

        function renderTable() {
            console.log('[Q&A] renderTable() 시작 — 데이터 건수:', allInquiries.length);
            try {
                // Stats
                const total = allInquiries.length;
                const pending = allInquiries.filter(i => i.status === 'pending').length;
                const answered = allInquiries.filter(i => i.status === 'answered').length;
                const rate = total > 0 ? Math.round(answered / total * 100) : 0;

                setTextSafe('statTotal', total);
                setTextSafe('statPending', pending);
                setTextSafe('statAnswered', answered);
                setTextSafe('statRate', rate + '%');
                setTextSafe('inqCount', total + '건');

                const searchEl = document.getElementById('searchInput');
                const search = searchEl ? searchEl.value.trim().toLowerCase() : '';
                let filtered = allInquiries;
                if (search) {
                    const writer = (i) => (i.student_name || i.director_name || '').toLowerCase();
                    filtered = filtered.filter(i => 
                        i.title.toLowerCase().includes(search) || writer(i).includes(search)
                    );
                }

                const tbody = document.getElementById('inquiryTbody');
                if (!tbody) { console.warn('[Q&A] tbody 없음'); return; }
                if (filtered.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:#9CA3AF;">문의가 없습니다</td></tr>';
                    return;
                }

                tbody.innerHTML = filtered.map(i => {
                    const isPending = i.status === 'pending';
                    const writerName = i.student_name || i.director_name || '-';
                    const roleLabel = i.student_name ? '학생' : i.director_name ? '원장' : '-';
                    const branchName = i.branch_name || '-';
                    const date = i.created_at ? new Date(i.created_at).toLocaleDateString('ko-KR') : '-';

                    return `<tr>
                        <td class="col-id">${i.id}</td>
                        <td><span class="inq-role">${roleLabel}</span></td>
                        <td class="col-dim">${esc(branchName)}</td>
                        <td class="col-title" title="${esc(i.title)}">${esc(i.title)}</td>
                        <td><span class="inq-status ${isPending ? 'pending' : 'answered'}">${isPending ? '대기' : '완료'}</span></td>
                        <td class="col-dim">${esc(writerName)}</td>
                        <td class="col-date">${date}</td>
                        <td>
                            <button class="inq-action ${isPending ? 'primary' : ''}" onclick="openAnswerModal(${i.id})">
                                ${isPending ? '답변' : '보기'}
                            </button>
                        </td>
                    </tr>`;
                }).join('');
            } catch(e) {
                console.error('[Q&A] renderTable 오류:', e);
            }
        }

        function setTextSafe(id, val) {
            const el = document.getElementById(id);
            if (el) el.textContent = (val == null ? '' : String(val));
        }

        // ===== onclick에서 호출되는 함수들은 window에 노출 =====
        window.filterTable = function() { try { renderTable(); } catch(e) { console.error('[Q&A] filterTable 오류:', e); } };

        window.openAnswerModal = function(inquiryId) {
            try {
                const item = allInquiries.find(i => i.id === inquiryId);
                if (!item) return;

                const amIdEl = document.getElementById('amInquiryId');
                if (amIdEl) amIdEl.value = inquiryId;
                setTextSafe('amTitle', item.title);

                const writerName = item.student_name || item.director_name || '-';
                const roleLabel = item.student_name ? '🎒학생' : item.director_name ? '👤원장' : '';
                const branchName = item.branch_name || '-';
                const date = item.created_at ? new Date(item.created_at).toLocaleString('ko-KR') : '-';
                setTextSafe('amMeta', `${roleLabel} ${writerName} · ${branchName} · ${date}`);
                setTextSafe('amContent', item.content);

                // 이미지 첨부 표시
                const imgContainer = document.getElementById('amImageContainer');
                if (imgContainer) {
                    if (item.image_path && item.image_path !== 'null') {
                        imgContainer.style.display = 'block';
                        imgContainer.innerHTML = `<img src="${esc(item.image_path)}" style="max-width:100%;max-height:300px;border-radius:8px;border:1px solid #E5E7EB;margin-top:8px;">`;
                    } else {
                        imgContainer.style.display = 'none';
                    }
                }

                const answerEl = document.getElementById('amAnswer');
                if (answerEl) answerEl.value = '';

                const existingAnswer = document.getElementById('amExistingAnswer');
                const existingAnswerText = document.getElementById('amExistingAnswerText');
                const submitBtn = document.getElementById('amSubmitBtn');

                if (item.answer && existingAnswer && existingAnswerText) {
                    existingAnswer.style.display = 'block';
                    existingAnswerText.innerHTML = 
                        `<div>${esc(item.answer).replace(/\n/g, '<br>')}</div>
                         <div class="meta">${item.answered_by_name || '본사'} · ${item.answered_at ? new Date(item.answered_at).toLocaleString('ko-KR') : ''}</div>`;
                    if (submitBtn) submitBtn.textContent = '답변 수정';
                } else {
                    if (existingAnswer) existingAnswer.style.display = 'none';
                    if (submitBtn) submitBtn.textContent = '📤 답변 등록';
                }

                const modal = document.getElementById('answerModal');
                if (modal) modal.style.display = 'flex';
            } catch(e) {
                console.error('[Q&A] openAnswerModal 오류:', e);
            }
        };

        window.closeAnswerModal = function() {
            try {
                const modal = document.getElementById('answerModal');
                if (modal) modal.style.display = 'none';
            } catch(e) {
                console.error('[Q&A] closeAnswerModal 오류:', e);
            }
        };

        window.submitAnswer = async function() {
            try {
                const inquiryIdEl = document.getElementById('amInquiryId');
                const answerEl = document.getElementById('amAnswer');
                if (!inquiryIdEl || !answerEl) return;
                const inquiryId = inquiryIdEl.value;
                const answer = answerEl.value.trim();

                if (!answer) { alert('답변 내용을 입력해주세요.'); return; }

                const btn = document.getElementById('amSubmitBtn');
                if (btn) { btn.disabled = true; btn.textContent = '⏳ 저장 중...'; }

                const params = new URLSearchParams({ answer });
                const res = await apiPost('/inquiries/answer/' + inquiryId + '?' + params.toString());
                if (res && res.status === 'success') {
                    alert('✅ 답변이 등록되었습니다.');
                    closeAnswerModal();
                    loadInquiries();
                } else {
                    alert('❌ ' + (res.message || '실패했습니다.'));
                }
            } catch(e) {
                alert('❌ 오류: ' + (e.message || '알 수 없음'));
            } finally {
                const btn = document.getElementById('amSubmitBtn');
                if (btn) { btn.disabled = false; btn.textContent = '📤 답변 등록'; }
            }
        };

        window.handleLogout = function() {
            try {
                localStorage.removeItem('token');
                localStorage.removeItem('access_token');
                localStorage.removeItem('user');
                window.location.href = '/pages/login.html';
            } catch(e) {
                console.error('[Q&A] handleLogout 오류:', e);
            }
        };

        // ===== 사이드바 네비게이션 토글 =====
        function initSidebarNav() {
            // 열려야 할 섹션 확인 (쿼리 파라미터 또는 localStorage)
            const saved = localStorage.getItem('sidebar_open_section');
            if (saved) {
                const toggle = document.querySelector('.nav-toggle[data-section="' + saved + '"]');
                if (toggle) {
                    toggle.classList.add('open');
                    const sub = document.getElementById('sub-' + saved);
                    if (sub) sub.classList.add('open');
                }
            }

            // 토글 버튼 클릭 이벤트
            document.querySelectorAll('.nav-toggle').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var section = this.getAttribute('data-section');
                    var sub = document.getElementById('sub-' + section);
                    if (!sub) return;

                    // 현재 토글 상태 토글
                    var isOpen = this.classList.contains('open');
                    this.classList.toggle('open');
                    sub.classList.toggle('open');

                    // 상태 저장
                    if (!isOpen) {
                        localStorage.setItem('sidebar_open_section', section);
                    } else {
                        localStorage.removeItem('sidebar_open_section');
                    }
                });
            });
        }

        // ===== 페이지 초기화 =====
        initSidebarNav();

        // ===== 전역 함수 노출 (onclick에서 사용) =====
        window.loadInquiries = loadInquiries;

        // ===== IIFE 종료 (전체 try/catch) =====
            } catch(e) {
                console.error('[Q&A] 스크립트 초기화 치명적 오류:', e);
            }
        })();
    </script>

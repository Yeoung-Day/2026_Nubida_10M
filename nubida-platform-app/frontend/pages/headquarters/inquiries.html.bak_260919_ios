    <style>
        /* ===== Q&A 테이블 — 전문가용 디자인 ===== */
        .inq-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 720px;
        }
        .inq-table th,
        .inq-table td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }
        .inq-table thead th {
            text-align: left;
            padding: 12px 14px;
            font-weight: 600;
            color: #6B7280;
            font-size: 11px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            background: #FBFCFE;
            border-bottom: 1px solid #E9EDF3;
            position: sticky;
            top: 0;
            z-index: 2;
        }
        .inq-table tbody td {
            padding: 14px;
            border-bottom: 1px solid #F1F4F8;
            color: #374151;
            font-size: 13px;
            line-height: 1.5;
        }
        .inq-table tbody tr {
            transition: background .15s ease;
        }
        .inq-table tbody tr:last-child td { border-bottom: none; }
        .inq-table tbody tr:hover td { background: #F8FAFC; }

        /* 숫자/ID 컬럼 — 고정폭 숫자 */
        .inq-table .col-id {
            color: #9CA3AF;
            font-variant-numeric: tabular-nums;
            font-size: 12px;
            font-weight: 500;
        }
        /* 제목 — 본문 굵기 + 살짝 진하게, 말줄임 */
        .inq-table .col-title {
            color: #111827;
            font-weight: 600;
            font-size: 13.5px;
        }
        /* 보조 텍스트(작성자/에듀케어) */
        .inq-table .col-dim { color: #6B7280; }
        /* 작성일 — 숫자 정렬 */
        .inq-table .col-date {
            color: #6B7280;
            font-variant-numeric: tabular-nums;
            font-size: 12.5px;
        }
        /* 역할 라벨 — 조용한 텍스트 pill */
        .inq-role {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            color: #4B5563;
            background: #F3F5F9;
            border-radius: 6px;
            padding: 2px 8px;
            letter-spacing: 0.02em;
        }

        /* 상태 배지 — 점(dot) + 텍스트, 은은한 배경 */
        .inq-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            font-weight: 600;
            padding: 3px 10px 3px 8px;
            border-radius: 999px;
            letter-spacing: 0.01em;
        }
        .inq-status::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex: 0 0 auto;
        }
        .inq-status.pending { color: #92400E; background: #FEF6E7; }
        .inq-status.pending::before { background: #F59E0B; }
        .inq-status.answered { color: #065F46; background: #ECFAF2; }
        .inq-status.answered::before { background: #10B981; }

        /* 작업 버튼 — 조용한 아웃라인 */
        .inq-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid #DCE3EC;
            background: #FFFFFF;
            color: #374151;
            cursor: pointer;
            transition: background .15s, border-color .15s, color .15s;
            white-space: nowrap;
        }
        .inq-action:hover { background: #F4F6FA; border-color: #C9D2DE; }
        .inq-action.primary { background: #4F5EF8; border-color: #4F5EF8; color: #fff; }
        .inq-action.primary:hover { background: #4338CA; border-color: #4338CA; }

        /* 컬럼 폭 */
        .inq-table th:nth-child(1) { width: 64px; }
        .inq-table th:nth-child(2) { width: 78px; }
        .inq-table th:nth-child(3) { width: 110px; }
        .inq-table th:nth-child(4) { width: auto; min-width: 160px; }
        .inq-table th:nth-child(5) { width: 96px; }
        .inq-table th:nth-child(6) { width: 100px; }
        .inq-table th:nth-child(7) { width: 108px; }
        .inq-table th:nth-child(8) { width: 104px; }

        .badge-pending { background:#FEF6E7; color:#92400E; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; display:inline-block; }
        .badge-answered { background:#ECFAF2; color:#065F46; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; display:inline-block; }

        .answer-modal-content { padding:20px; }
        .answer-modal-content .qa-label { font-size:11px; font-weight:600; color:#6B7280; margin-bottom:4px; letter-spacing:.03em; text-transform:uppercase; }
        .answer-modal-content .qa-title { font-size:16px; font-weight:700; color:#111827; margin-bottom:8px; }
        .answer-modal-content .qa-meta { font-size:11px; color:#9CA3AF; margin-bottom:12px; }
        .answer-modal-content .qa-content { background:#F8FAFC; border:1px solid #EEF2F7; border-radius:10px; padding:14px; font-size:13px; line-height:1.7; color:#374151; margin-bottom:16px; white-space:pre-wrap; }
        .answer-modal-content .qa-answer-label { font-size:11px; font-weight:600; color:#4F5EF8; margin-bottom:6px; letter-spacing:.03em; text-transform:uppercase; }
        .answer-modal-content textarea { width:100%; min-height:120px; box-sizing:border-box; }
        .answer-modal-content .qa-existing-answer { background:#F5F7FF; border-left:3px solid #4F5EF8; border-radius:8px; padding:14px; font-size:13px; line-height:1.7; color:#374151; margin-bottom:16px; white-space:pre-wrap; }
        .answer-modal-content .qa-existing-answer .meta { font-size:11px; color:#9CA3AF; margin-top:6px; }

        .stats-ribbon { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; padding:18px 20px; background:#fff; border-bottom:1px solid #E9EDF3; }
        .stats-ribbon .sr-item { text-align:center; }
        .stats-ribbon .sr-label { font-size:11px; color:#9CA3AF; letter-spacing:.04em; text-transform:uppercase; font-weight:600; }
        .stats-ribbon .sr-value { font-size:22px; font-weight:700; color:#111827; margin-top:4px; font-variant-numeric:tabular-nums; }
        .stats-ribbon .sr-value.warning { color:#F59E0B; }
        .stats-ribbon .sr-value.success { color:#10B981; }
    </style>

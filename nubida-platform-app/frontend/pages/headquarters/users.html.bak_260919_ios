                            <option value="branch_staff">에듀케어직원</option>
                            <option value="director">공부방장</option>
                            <option value="student" selected>학생</option>
                            <option value="parent">학부모</option>
                        </select>
                    </div>
                    <div class="full form-group">
                        <label class="form-label">이메일 *</label>
                        <input type="email" class="form-input" id="newEmail" placeholder="user@example.com">
                    </div>
                    <div class="full form-group">
                        <label class="form-label">연락처</label>
                        <input type="text" class="form-input" id="newPhone" placeholder="010-0000-0000">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="closeModal('createUserModal')">취소</button>
                <button class="btn btn-primary" onclick="createUser()">사용자 생성</button>
            </div>
        </div>
    </div>

    <!-- 사용자 수정 모달 -->
    <div class="modal-overlay" id="editUserModal">
        <div class="modal" style="max-width:540px">
            <div class="modal-header">
                <h3>✏️ 사용자 정보 수정</h3>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserId">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">이름</label>
                        <input type="text" class="form-input" id="editName">
                    </div>
                    <div class="form-group">
                        <label class="form-label">역할</label>
                        <select class="form-input" id="editRole">
                            <option value="super_admin">최고관리자</option>
                            <option value="admin">관리자</option>
                            <option value="branch_admin">에듀케어(관리자)</option>
                            <option value="branch_manager">에듀케어(매니저)</option>
                            <option value="branch_staff">에듀케어직원</option>
                            <option value="director">공부방장</option>
                            <option value="student">학생</option>
                            <option value="parent">학부모</option>
                        </select>
                    </div>
                    <div class="full form-group">
                        <label class="form-label">이메일</label>
                        <input type="email" class="form-input" id="editEmail">
                    </div>
                    <div class="full form-group">
                        <label class="form-label">연락처</label>
                        <input type="text" class="form-input" id="editPhone">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="closeModal('editUserModal')">취소</button>
                <button class="btn btn-primary" onclick="updateUser()">저장</button>
            </div>
        </div>
    </div>

    <script src="/common/js/api.js?v=20260918abort"></script>
    <script src="/common/js/auth.js?v=20260911nav"></script>
    <script src="/common/js/utils.js?v=20260911nav"></script>
    <script>
    // ===== XSS 방지 헬퍼 (utils.js에 없을 경우 대비) =====
    if (typeof esc !== 'function') {
        window.esc = function(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        };
    }

    // ===== State =====
    let allUsers = [];
    let filteredUsers = [];
    let currentPage = 1;
    let totalPages = 1;
    const PER_PAGE = 20;
    let contractMap = {};

    // ===== Role display mapping =====
    const roleLabels = {
        'super_admin': '최고관리자',
        'admin': '관리자',
        'branch_admin': '에듀케어',
        'branch_manager': '에듀케어',
        'branch_staff': '에듀케어직원',
        'director': '공부방장',
        'student': '학생',
        'parent': '학부모',
    };

    const statusLabels = {
        active: '활성',
        inactive: '정지',
    };

    // ===== Load Contract Data for Director Affiliations =====
    async function loadContractMap() {
        try {
            const res = await apiGet('/headquarters/contracts');
            const contracts = res.data || [];
            contractMap = {};
            contracts.forEach(function(c) {
                if (c.user_id) {
                    contractMap[c.user_id] = {
                        contract_type: c.contract_type || 'direct',
                        branch_name: c.branch_name || '',
                    };
                }
            });
        } catch (e) {
            console.warn('Failed to load contract data:', e);
            contractMap = {};
        }
    }

    // ===== Get Contract Affiliation Tag for Director Users =====
    function getContractTag(user) {
        if (user.role !== 'director') return '';
        const contract = contractMap[user.id];
        if (!contract) return '';
        if (contract.contract_type === 'franchise' && contract.branch_name) {
            return ' <span class="contract-tag franchise" style="font-size:11px;padding:1px 6px;border-radius:4px;background:#E3F2FD;color:#1565C0;margin-left:4px;white-space:nowrap">\uD83C\uDFEA' + esc(contract.branch_name) + '</span>';
        }
        return ' <span class="contract-tag direct" style="font-size:11px;padding:1px 6px;border-radius:4px;background:#E8F5E9;color:#2E7D32;margin-left:4px;white-space:nowrap">\uD83C\uDFE2직영</span>';
    }

    // ===== Get Affiliation Badge — 원장/에듀케어 소속 [지역명/학원명] =====
    function getAffiliationTag(user) {
        if (['director', 'branch_admin', 'branch_manager', 'branch_staff'].indexOf(user.role) === -1) return '';
        // 소속배지 정책(9/8 확정): director=[학원명(academy_name)] → region 폴백, 에듀케어=[region] → branch_name 폴백
        var aff = '';
        if (user.role === 'director') aff = user.academy_name || user.region || user.branch_name || '';
        else aff = user.region || user.branch_name || '';
        if (!aff) return '';
        return ' <span class="affil-tag" title="소속 ' + esc(aff) + '" style="font-size:11px;font-weight:600;padding:1px 7px;border-radius:5px;background:#F3E5F5;color:#6A1B9A;margin-left:4px;white-space:nowrap;vertical-align:1px">[' + esc(aff) + ']</span>';
    }

    // ===== Initialization =====
    let currentTab = 'active';
    document.addEventListener('DOMContentLoaded', function() {
        requireAuth();
        renderSidebarUser();
        onAuthReady(async function() {
            await loadContractMap();
            switchUserTab('active');
        });
    });

    // ===== Tab Switch =====
    function switchUserTab(tab) {
        currentTab = tab;
        document.querySelectorAll('.hq-filter-tabs .tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
        
        if (tab === 'active') {
            document.getElementById('activeUsersSection').style.display = '';
            document.getElementById('withdrawnUsersSection').style.display = 'none';
            loadUsers(1);
        } else {
            document.getElementById('activeUsersSection').style.display = 'none';
            document.getElementById('withdrawnUsersSection').style.display = '';
            loadWithdrawn(1);
        }
    }

    let withdrawnCurrentPage = 1;
    let withdrawnTotalPages = 1;
    const WITH_PER_PAGE = 20;

    // ===== Load Withdrawn Students =====
    async function loadWithdrawn(page) {
        withdrawnCurrentPage = page || 1;
        try {
            const url = '/headquarters/withdrawn-students?page=' + withdrawnCurrentPage + '&per_page=' + WITH_PER_PAGE;
            const res = await apiGet(url);
            const items = res.data || [];
            withdrawnTotalPages = res.total_pages || 1;
            renderWithdrawn(items);
            renderWithdrawnPagination();
            document.getElementById('withdrawnCount').textContent = (res.total || 0) + '명';
        } catch (err) {
            console.error('Failed to load withdrawn students:', err);
            document.getElementById('withdrawnTableBody').innerHTML = '<tr class="user-empty"><td colspan="9">⚠️ 로딩 실패: ' + esc(err.message) + '</td></tr>';
        }
    }

    // ===== Render Withdrawn Students =====
    function renderWithdrawn(items) {
        const tbody = document.getElementById('withdrawnTableBody');
        if (!tbody) return;
        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr class="user-empty"><td colspan="9">👤 탈퇴한 회원이 없습니다.</td></tr>';
            return;
        }
        let html = '';
        for (let i = 0; i < items.length; i++) {
            const s = items[i];
            const endDate = s.end_date || '-';
            const reason = s.reason || '-';
            html += '<tr>';
            html += '<td data-label="ID" style="font-size:12px;color:var(--text-tertiary)">' + esc(String(s.id)) + '</td>';
            html += '<td data-label="학생명"><strong>' + esc(s.student_name || '-') + '</strong></td>';
            html += '<td data-label="아이디">' + esc(s.username || '-') + '</td>';
            html += '<td data-label="이메일" style="font-size:14px">' + esc(s.email || '-') + '</td>';
            html += '<td data-label="에듀케어">' + esc(s.branch_name || '-') + '</td>';
            html += '<td data-label="담당 원장">' + esc(s.director_name || '-') + '</td>';
            html += '<td data-label="학급">' + esc(s.course_name || '-') + '</td>';
            html += '<td data-label="사유" style="font-size:13px;color:#9CA3AF">' + esc(reason) + '</td>';
            html += '<td data-label="탈퇴일" style="font-size:14px">' + esc(endDate) + '</td>';
            html += '</tr>';
        }
        tbody.innerHTML = html;
    }

    // ===== Withdrawn Pagination =====
    function renderWithdrawnPagination() {
        const wrap = document.getElementById('withdrawnPaginationWrap');
        if (!wrap) return;
        let html = '';
        if (withdrawnCurrentPage > 1) {
            html += '<button class="btn btn-ghost btn-sm" onclick="loadWithdrawn(1)">«</button>';
            html += '<button class="btn btn-ghost btn-sm" onclick="loadWithdrawn(' + (withdrawnCurrentPage - 1) + ')">‹</button>';
        } else {
            html += '<button class="btn btn-ghost btn-sm" disabled>«</button><button class="btn btn-ghost btn-sm" disabled>‹</button>';
        }
        let start = Math.max(1, withdrawnCurrentPage - 2);
        let end = Math.min(withdrawnTotalPages, withdrawnCurrentPage + 2);
        for (let i = start; i <= end; i++) {
            let btnClass = (i === withdrawnCurrentPage) ? 'btn-primary' : 'btn-ghost';
            html += '<button class="btn btn-sm ' + btnClass + '" onclick="loadWithdrawn(' + i + ')">' + i + '</button>';
        }
        if (withdrawnCurrentPage < withdrawnTotalPages) {
            html += '<button class="btn btn-ghost btn-sm" onclick="loadWithdrawn(' + (withdrawnCurrentPage + 1) + ')">›</button>';
            html += '<button class="btn btn-ghost btn-sm" onclick="loadWithdrawn(' + withdrawnTotalPages + ')">»</button>';
        } else {
            html += '<button class="btn btn-ghost btn-sm" disabled>›</button><button class="btn btn-ghost btn-sm" disabled>»</button>';
        }
        wrap.innerHTML = html;
    }

    // ===== Load Users =====
    async function loadUsers(page) {
        currentPage = page || 1;
        const role = document.getElementById('roleFilter').value;

        try {
            let url = '/headquarters/users?page=' + currentPage + '&per_page=' + PER_PAGE;
            if (role) url += '&role=' + encodeURIComponent(role);

            const res = await apiGet(url);
            allUsers = res.data || [];
            totalPages = res.total_pages || 1;
            filteredUsers = allUsers.slice();
            renderUsers();
            renderPaginationUI();
            document.getElementById('userCount').textContent = (res.total || 0) + '명';
        } catch (err) {
            console.error('Failed to load users:', err);
            showAlert('사용자 목록을 불러오는데 실패했습니다.', 'error');
        }
    }

    // ===== Render Users =====
    function renderUsers() {
        const tbody = document.getElementById('userTableBody');
        if (!tbody) return;

        if (filteredUsers.length === 0) {
            tbody.innerHTML = '<tr class="user-empty"><td colspan="9">👥 등록된 사용자가 없습니다.</td></tr>';
            return;
        }

        var html = '';
        for (var i = 0; i < filteredUsers.length; i++) {
            var u = filteredUsers[i];
            var roleLabel = roleLabels[u.role] || u.role;
            var roleClass = u.role || '';
            var isActive = u.is_active !== false;
            var statusClass = isActive ? 'active' : 'inactive';
            var statusText = isActive ? '활성' : '비활성';
            var createdDate = u.created_at ? u.created_at.split('T')[0] : '-';
            var safeName = esc(u.name || '-');
            var safeNameAttr = esc(u.name || '');

            html += '<tr>';
            html += '<td data-label="ID" style="font-size:12px;color:var(--text-tertiary)">' + esc(String(u.id)) + '</td>';
            html += '<td data-label="이름"><strong>' + safeName + '</strong>' + getAffiliationTag(u) + '</td>';
            html += '<td data-label="아이디">' + esc(u.username || '-') + '</td>';
            html += '<td data-label="이메일" style="font-size:14px">' + esc(u.email || '-') + '</td>';
            html += '<td data-label="연락처" style="font-size:14px">' + esc(u.phone || '-') + '</td>';
            html += '<td data-label="역할"><span class="role-badge ' + roleClass + '">' + esc(roleLabel) + '</span>' + getContractTag(u) + '</td>';
            html += '<td data-label="상태"><span class="status-dot ' + statusClass + '"></span>' + statusText + '</td>';
            html += '<td data-label="가입일" style="font-size:14px;color:var(--text-tertiary)">' + createdDate + '</td>';
            html += '<td data-label="작업">';
            html += '<div class="action-cell">';
            html += '<button class="btn btn-ghost btn-xs" onclick="openEditModal(' + u.id + ')">✏️</button>';
            html += '<button class="btn btn-ghost btn-xs" onclick="toggleUserStatus(' + u.id + ')" style="color:' + (isActive ? '#E65100' : '#2E7D32') + '">' + (isActive ? '⏸ 정지' : '▶ 활성') + '</button>';
            html += '<button class="btn btn-ghost btn-xs" style="color:var(--danger)" onclick="confirmDeleteUser(' + u.id + ',\'' + safeNameAttr.replace(/'/g, "\\'") + '\')">🗑️</button>';
            html += '</div>';
            html += '</td>';
            html += '</tr>';
        }
        tbody.innerHTML = html;
    }

    // ===== Filter (client-side search) =====
    function filterUsers() {
        var q = document.getElementById('searchInput').value.toLowerCase().trim();
        if (!q) {
            filteredUsers = allUsers.slice();
        } else {
            filteredUsers = allUsers.filter(function(u) {
                return (u.name && u.name.toLowerCase().includes(q)) ||
                       (u.username && u.username.toLowerCase().includes(q)) ||
                       (u.email && u.email.toLowerCase().includes(q));
            });
        }
        renderUsers();
    }

    // ===== Pagination =====
    function renderPaginationUI() {
        var wrap = document.getElementById('paginationWrap');
        if (!wrap) return;
        var html = '';

        if (currentPage > 1) {
            html += '<button class="btn btn-ghost btn-sm" onclick="loadUsers(1)">«</button>';
            html += '<button class="btn btn-ghost btn-sm" onclick="loadUsers(' + (currentPage - 1) + ')">‹</button>';
        } else {
            html += '<button class="btn btn-ghost btn-sm" disabled>«</button><button class="btn btn-ghost btn-sm" disabled>‹</button>';
        }

        var start = Math.max(1, currentPage - 2);
        var end = Math.min(totalPages, currentPage + 2);
        for (var i = start; i <= end; i++) {
            var btnClass = (i === currentPage) ? 'btn-primary' : 'btn-ghost';
            html += '<button class="btn btn-sm ' + btnClass + '" onclick="loadUsers(' + i + ')">' + i + '</button>';
        }

        if (currentPage < totalPages) {
            html += '<button class="btn btn-ghost btn-sm" onclick="loadUsers(' + (currentPage + 1) + ')">›</button>';
            html += '<button class="btn btn-ghost btn-sm" onclick="loadUsers(' + totalPages + ')">»</button>';
        } else {
            html += '<button class="btn btn-ghost btn-sm" disabled>›</button><button class="btn btn-ghost btn-sm" disabled>»</button>';
        }

        wrap.innerHTML = html;
    }

    // ===== Create User =====
    async function createUser() {
        var username = document.getElementById('newUsername').value.trim();
        var password = document.getElementById('newPassword').value;
        var name = document.getElementById('newName').value.trim();
        var email = document.getElementById('newEmail').value.trim();
        var phone = document.getElementById('newPhone').value.trim();
        var role = document.getElementById('newRole').value;

        if (!username || !password || !name || !email) {
            showAlert('아이디, 비밀번호, 이름, 이메일은 필수 항목입니다.', 'error');
            return;
        }
        if (password.length < 6) {
            showAlert('비밀번호는 6자 이상이어야 합니다.', 'error');
            return;
        }

        try {
            await apiPost('/headquarters/users', {
                username: username,
                password: password,
                name: name,
                email: email,
                phone: phone,
                role: role,
            });
            showAlert('사용자가 생성되었습니다.', 'success');
            closeModal('createUserModal');
            document.getElementById('newUsername').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('newName').value = '';
            document.getElementById('newEmail').value = '';
            document.getElementById('newPhone').value = '';
            document.getElementById('newRole').value = 'student';
            await loadUsers(currentPage);
        } catch (err) {
            showAlert(err.message || '사용자 생성에 실패했습니다.', 'error');
        }
    }

    // ===== Open Edit Modal =====
    async function openEditModal(userId) {
        try {
            var user = allUsers.find(function(u) { return u.id === userId; });
            if (!user) {
                showAlert('사용자 정보를 찾을 수 없습니다.', 'error');
                return;
            }
            document.getElementById('editUserId').value = user.id;
            document.getElementById('editName').value = user.name || '';
            document.getElementById('editEmail').value = user.email || '';
            document.getElementById('editPhone').value = user.phone || '';
            document.getElementById('editRole').value = user.role || '';
            var statusEl = document.getElementById('editStatus');
            if (statusEl) statusEl.value = user.is_active !== false ? 'active' : 'inactive';
            openModal('editUserModal');
        } catch (err) {
            showAlert('사용자 정보를 불러오는데 실패했습니다.', 'error');
        }
    }

    // ===== Update User =====
    async function updateUser() {
        var id = document.getElementById('editUserId').value;
        if (!id) {
            showAlert('수정할 사용자를 선택하세요.', 'error');
            return;
        }
        var name = document.getElementById('editName').value.trim();
        var email = document.getElementById('editEmail').value.trim();
        var phone = document.getElementById('editPhone').value.trim();
        var role = document.getElementById('editRole').value;

        if (!name || !email) {
            showAlert('이름과 이메일은 필수 항목입니다.', 'error');
            return;
        }

        try {
            await apiPut('/headquarters/users/' + id, {
                name: name,
                email: email,
                phone: phone,
                role: role,
            });
            showAlert('사용자 정보가 수정되었습니다.', 'success');
            closeModal('editUserModal');
            await loadUsers(currentPage);
        } catch (err) {
            showAlert(err.message || '사용자 정보 수정에 실패했습니다.', 'error');
        }
    }

    // ===== Toggle User Status (activate/suspend) =====
    async function toggleUserStatus(userId) {
        if (!confirm('사용자의 상태를 변경하시겠습니까?')) return;
        try {
            await apiPut('/headquarters/users/' + userId + '/toggle-status');
            showAlert('사용자 상태가 변경되었습니다.', 'success');
            await loadUsers(currentPage);
        } catch (err) {
            showAlert(err.message || '상태 변경에 실패했습니다.', 'error');
        }
    }

    // ===== Confirm Delete User =====
    function confirmDeleteUser(userId, userName) {
        var safeName = userName || '이 사용자';
        if (!confirm('"' + safeName + '" 사용자를 정말 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.')) return;
        deleteUser(userId);
    }

    // ===== Delete User =====
    async function deleteUser(userId) {
        try {
            await apiDelete('/headquarters/users/' + userId);
            showAlert('사용자가 삭제되었습니다.', 'success');
            await loadUsers(currentPage);
        } catch (err) {
            showAlert(err.message || '사용자 삭제에 실패했습니다.', 'error');
        }
    }
</script>

   <script>
   let currentPage = 1;
   let totalPages = 1;
   let searchTimer = null;
   const METHOD_LABELS = {card:'카드',kakao:'카카오페이',toss:'토스페이',naver:'네이버페이',virtual_account:'가상계좌',transfer:'계좌이체'};
   const METHOD_ICONS = {card:'&#x1F4B3;',kakao:'&#x1F49B;',toss:'&#x1F4B3;',naver:'&#x1F49A;',virtual_account:'&#x1F3E6;',transfer:'&#x1F4B3;'};
   const STATUS_LABELS = {completed:'완료',pending:'대기',refunded:'환불',cancelled:'취소'};

   document.addEventListener('DOMContentLoaded', function() {
   loadPayments();
   loadHqOverview();
   document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});
   const u = getCurrentUser();
   if(u && u.name) document.getElementById('sidebarUserName').textContent = u.name;
   if(u && u.role) document.getElementById('sidebarUserRole').textContent = u.role;
   });

   function showToast(msg, type) {
   const t = document.createElement('div');
   t.className = 'toast ' + type;
   t.textContent = msg;
   document.body.appendChild(t);
   setTimeout(() => { if(t.parentNode) t.parentNode.removeChild(t); }, 3000);
   }

   function debounceSearch() {
   clearTimeout(searchTimer);
   searchTimer = setTimeout(() => { currentPage = 1; loadPayments(); }, 400);
   }

   async function loadPayments() {
   const tbody = document.getElementById('paymentTableBody');
   tbody.innerHTML = '<tr class="empty"><td colspan="8"><div class="empty-icon">&#x23F3;</div><h3>로딩 중...</h3></td></tr>';
   try {
   const params = {page: currentPage, per_page: 20};
   const status = document.getElementById('statusFilter').value;
   const method = document.getElementById('methodFilter').value;
   const search = document.getElementById('searchInput').value.trim();
   if(status) params.status = status;
   if(method) params.method = method;
   if(search) params.search = search;

   const res = await apiGet('/payments?' + new URLSearchParams(params));
   const data = res.data || [];
   const total = res.total || 0;
   totalPages = Math.max(1, Math.ceil(total / 20));

   // Stats
   const totalAmt = data.reduce((s,i) => s + (i.amount||0), 0);
   const completed = data.filter(i => i.status === 'completed').length;
   const refunded = data.filter(i => i.status === 'refunded'||i.status === 'cancelled').length;
   document.getElementById('statTotal').textContent = total;
   document.getElementById('statCompleted').textContent = completed;
   document.getElementById('statRefunded').textContent = refunded;
   document.getElementById('statAmount').textContent = totalAmt.toLocaleString()+'원';
   document.getElementById('paymentCount').textContent = '총 ' + total + '건';

   if(!data || data.length === 0) {
   tbody.innerHTML = '<tr class="empty"><td colspan="8"><div class="empty-icon">&#x1F4B0;</div><h3>등록된 결제 내역이 없습니다</h3><p>새 결제를 등록해주세요</p></td></tr>';
   renderPagination();
   return;
   }

   tbody.innerHTML = data.map(p => {
   const methodIcon = METHOD_ICONS[p.method] || '&#x1F4B3;';
   const methodLabel = METHOD_LABELS[p.method] || p.method;
   const statusBadge = '<span class="badge badge-'+p.status+'">'+(STATUS_LABELS[p.status]||p.status)+'</span>';
   const paidAt = p.paid_at ? new Date(p.paid_at).toLocaleDateString('ko-KR') : '-';
   return '<tr><td>'+p.id+'</td><td>'+(p.student_name||'['+p.student_id+']')+'</td><td style="font-weight:600">'+Number(p.amount).toLocaleString()+'원</td>'
   +'<td>'+methodIcon+' '+methodLabel+'</td><td>'+statusBadge+'</td><td>'+paidAt+'</td>'
   +'<td style="font-size:11px;color:var(--text-tertiary)">'+(p.receipt_number||'-')+'</td>'
   +'<td><button class="btn btn-outline" style="padding:4px 10px;font-size:11px" onclick="viewReceipt('+p.id+')">보기</button></td></tr>';
   }).join('');
   renderPagination();
   } catch(e) {
   tbody.innerHTML = '<tr class="empty"><td colspan="8"><div class="empty-icon">&#x26A0;</div><h3>불러오기 실패</h3><p>'+(e.message||'')+'</p></td></tr>';
   showToast('데이터를 불러올 수 없습니다', 'error');
   }
   }

   function renderPagination() {
   const el = document.getElementById('pagination');
   if(totalPages <= 1) { el.innerHTML = ''; return; }
   let html = '<button class="page-btn" onclick="goPage(1)" '+(currentPage<=1?'disabled':'')+'>&#xAB;</button>';
   html += '<button class="page-btn" onclick="goPage('+(currentPage-1)+')" '+(currentPage<=1?'disabled':'')+'>&#x2039;</button>';
   const start = Math.max(1, currentPage-2);
   const end = Math.min(totalPages, currentPage+2);
   for(let i=start; i<=end; i++) {
   html += '<button class="page-btn'+(i===currentPage?' active':'')+'" onclick="goPage('+i+')">'+i+'</button>';
   }
   html += '<button class="page-btn" onclick="goPage('+(currentPage+1)+')" '+(currentPage>=totalPages?'disabled':'')+'>&#x203A;</button>';
   html += '<button class="page-btn" onclick="goPage('+totalPages+')" '+(currentPage>=totalPages?'disabled':'')+'>&#xBB;</button>';
   el.innerHTML = html;
   }

   function goPage(page) {
   if(page < 1 || page > totalPages) return;
   currentPage = page;
   loadPayments();
   }

   function openCreateModal() {
   document.getElementById('createModal').style.display = 'flex';
   }

   function closeModal(id) {
   document.getElementById(id).style.display = 'none';
   }

   async function createPayment() {
   const data = {
   student_id: parseInt(document.getElementById('createStudentId').value),
   course_id: parseInt(document.getElementById('createCourseId').value),
   branch_id: parseInt(document.getElementById('createBranchId').value),
   amount: parseInt(document.getElementById('createAmount').value),
   method: document.getElementById('createMethod').value,
   };
   try {
   const res = await apiPost('/payments/process', data);
   showToast('결제가 등록되었습니다', 'success');
   closeModal('createModal');
   loadPayments();
   } catch(e) {
   showToast('결제 등록 실패: '+(e.message||''), 'error');
   }
   }

   async function viewReceipt(id) {
   try {
   const res = await apiGet('/payments/receipt/'+id);
   const d = res.data;
   alert('[영수증]\n영수증번호: '+d.receipt_number+'\n금액: '+Number(d.amount).toLocaleString()+'원\n'
   +'결제수단: '+(METHOD_LABELS[d.method]||d.method)+'\n상태: '+(STATUS_LABELS[d.status]||d.status));
   } catch(e) {
   showToast('영수증 조회 실패', 'error');
   }
   }

   async function loadHqOverview() {
   const grid = document.getElementById('hqBranchGrid');
   const chipsEl = document.getElementById('hqGlobalCats');
   if (!grid) return;
   const ymEl = document.getElementById('hqYm');
   const ym = ymEl && ymEl.value ? ymEl.value : '';
   try {
   const res = await apiGet('/headquarters/payments/hq-overview' + (ym ? ('?period_ym=' + ym) : ''));
   const d = res.data || {};
   const s = d.summary || {};
   const branches = d.branches || [];

   // 기간 표시
   const per = document.getElementById('hqPeriod');
   if (per) per.textContent = (d.period_ym || '') + ' 기준';
   if (ymEl && d.period_ym && !ymEl.value) ymEl.value = d.period_ym;

   const won = v => Number(v || 0).toLocaleString();

   // KPI
   const ts = document.getElementById('hqTotalStudents');
   if (ts) ts.innerHTML = won(s.total_students) + '<small>명</small>';
   const bc = document.getElementById('hqBranchCount');
   if (bc) bc.textContent = '에듀케어 ' + (s.branch_count || 0) + '곳';
   const nd = document.getElementById('hqNetDeposit');
   if (nd) nd.innerHTML = won(s.total_net_deposit) + '<small>원</small>';
   const rp = document.getElementById('hqRoyaltyPaid');
   if (rp) rp.innerHTML = won(s.total_royalty_paid) + '<small>원</small>';
   const rd = document.getElementById('hqRoyaltyDueSub');
   if (rd) rd.textContent = '청구 ' + won(s.total_royalty_due) + '원';
   const ru = document.getElementById('hqRoyaltyUnpaid');
   if (ru) ru.innerHTML = won(s.total_royalty_unpaid) + '<small>원</small>';

   // 교육과정별 전체 인원 (칩)
   const cats = s.categories || [];
   if (chipsEl) {
   chipsEl.innerHTML = cats.length
   ? cats.map(c => '<span class="hq-chip"><span class="hq-chip-dot"></span>'
   + '<span class="hq-chip-name">' + escHtml(c.label) + '</span>'
   + '<span class="hq-chip-num">' + c.count + '</span>'
   + '<span class="hq-chip-unit">명</span></span>').join('')
   : '<span class="hq-chip-empty">수강 중인 학생이 없습니다</span>';
   }

   // 에듀케어별 정산 카드
   if (!branches.length) {
   grid.innerHTML = '<div class="card"><div class="card-body" style="text-align:center;color:#9CA3AF;padding:40px">활성 에듀케어가 없습니다</div></div>';
   return;
   }
   grid.innerHTML = branches.map(b => {
   const catHtml = (b.categories && b.categories.length)
   ? b.categories.map(c => '<span class="hq-cat-item"><span class="hq-ci-name">' + escHtml(c.label) + '</span>'
   + '<span class="hq-ci-num">' + c.count + '</span><span class="hq-ci-unit">명</span></span>').join('')
   : '<span class="hq-cat-empty">수강 중인 학생이 없습니다</span>';
   const unpaidZero = (b.royalty_unpaid || 0) === 0 ? ' is-zero' : '';
   return ''
   + '<div class="hq-bcard">'
   +   '<div class="hq-bcard-head">'
   +     '<span class="hq-bname">' + escHtml(b.branch_name) + '</span>'
   +     '<span class="hq-bcode">' + escHtml(b.branch_code || '') + '</span>'
   +     '<span class="hq-bstudents">학생 <b>' + (b.student_count || 0) + '</b>명 · 원장 <b>' + (b.director_count || 0) + '</b>명</span>'
   +   '</div>'
   +   '<div class="hq-bcard-body">'
   +     '<div class="hq-settle-2">'
   +       '<div class="hq-settle-box">'
   +         '<div class="hq-sb-label">본사 입금액 (순수익)</div>'
   +         '<div class="hq-sb-value is-brand">' + won(b.net_deposit) + '원</div>'
   +         '<div class="hq-sb-note">순수익 ' + won(b.edu_profit) + ' − 공제 ' + won(b.income_tax) + ' (' + (b.income_tax_rate) + '%)</div>'
   +       '</div>'
   +       '<div class="hq-settle-box">'
   +         '<div class="hq-sb-label">원장 전체 매출</div>'
   +         '<div class="hq-sb-value">' + won(b.director_revenue) + '원</div>'
   +         '<div class="hq-sb-note">과세표준 ' + won(b.tax_base) + '원</div>'
   +       '</div>'
   +     '</div>'
   +     '<div class="hq-royalty-rows">'
   +       '<div class="hq-rrow"><span class="hq-rlabel">본사 로열티 (청구)</span><span class="hq-rval">' + won(b.royalty_due) + '원</span></div>'
   +       '<div class="hq-rrow is-paid"><span class="hq-rlabel">입금 완료 (승인)</span><span class="hq-rval">' + won(b.royalty_paid) + '원</span></div>'
   +       '<div class="hq-rrow is-unpaid' + unpaidZero + '"><span class="hq-rlabel">미수금</span><span class="hq-rval">' + won(b.royalty_unpaid) + '원</span></div>'
   +     '</div>'
   +     '<div class="hq-sub-label">강좌별 수강 인원</div>'
   +     '<div class="hq-cat-list">' + catHtml + '</div>'
   +   '</div>'
   + '</div>';
   }).join('');

   } catch(e) {
   grid.innerHTML = '<div class="card"><div class="card-body" style="text-align:center;color:#EF4444;padding:40px">불러오기 실패: ' + escHtml(e.message || '') + '</div></div>';
   showToast('정산 현황을 불러올 수 없습니다', 'error');
   }
   }

   function escHtml(s) {
   return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
   }
   </script>


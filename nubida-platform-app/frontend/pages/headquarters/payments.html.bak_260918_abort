        <style>
            /* ── 결제 내역 빈 상태 — 가운데 정렬 ── */
            #paymentTableBody tr.empty td { text-align:center; padding:56px 16px; color:#9CA3AF; }
            #paymentTableBody tr.empty .empty-icon { font-size:44px; line-height:1; margin-bottom:12px; opacity:.6; }
            #paymentTableBody tr.empty h3 { font-size:15px; font-weight:600; color:#6B7280; margin:0 0 6px; }
            #paymentTableBody tr.empty p { font-size:13px; color:#9CA3AF; margin:0; }

            /* ══════════════════════════════════════════════════════
               HQ 정산 통합 현황 (hq-*) — 세련된·미니멀, 이모지 배제
               ══════════════════════════════════════════════════════ */

            /* ── 정산 요약 (최상단) ── */
            .hq-summary { margin-bottom:20px; }
            .hq-sum-head { display:flex; align-items:baseline; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
            .hq-sum-head h2 { font-size:16px; font-weight:700; color:#111827; margin:0; letter-spacing:-.2px; }
            .hq-sum-head .hq-period { font-size:12px; color:#9CA3AF; font-variant-numeric:tabular-nums; }
            .hq-sum-head .hq-ym-input { margin-left:auto; }
            .hq-ym-input input {
              border:1px solid #E5E7EB; border-radius:8px; padding:6px 10px;
              font-size:12.5px; color:#374151; background:#fff; font-variant-numeric:tabular-nums;
            }
            .hq-ym-input input:focus { outline:none; border-color:#4F5EF8; box-shadow:0 0 0 3px rgba(79,94,248,.10); }

            /* ── KPI 카드 4종 ── */
            .hq-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px; }
            @media (max-width:900px){ .hq-kpis{ grid-template-columns:repeat(2,1fr);} }
            .hq-kpi {
              position:relative; background:#fff; border:1px solid #EEF0F4; border-radius:14px;
              padding:16px 18px; overflow:hidden;
            }
            .hq-kpi::before {
              content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:#E5E7EB;
            }
            .hq-kpi.is-brand::before { background:#4F5EF8; }
            .hq-kpi.is-green::before { background:#10B981; }
            .hq-kpi.is-amber::before { background:#F59E0B; }
            .hq-kpi.is-amber .hq-kpi-value { color:#DC2626; }
            .hq-kpi.is-slate::before { background:#64748B; }
            .hq-kpi-label { font-size:11.5px; font-weight:600; color:#8A93A6; letter-spacing:.02em; margin-bottom:8px; }
            .hq-kpi-value { font-size:22px; font-weight:700; color:#111827; letter-spacing:-.5px; font-variant-numeric:tabular-nums; line-height:1.15; }
            .hq-kpi-value small { font-size:13px; font-weight:600; color:#6B7280; margin-left:2px; }
            .hq-kpi-sub { font-size:11.5px; color:#9CA3AF; margin-top:6px; font-variant-numeric:tabular-nums; }
            .hq-kpi-sub b { color:#6B7280; font-weight:600; }

            /* ── 교육과정별 인원 칩 ── */
            .hq-cat-chips { display:flex; flex-wrap:wrap; gap:8px; }
            .hq-chip {
              display:inline-flex; align-items:center; gap:7px;
              background:#F8FAFC; border:1px solid #EDF0F5; border-radius:999px;
              padding:6px 13px 6px 11px; font-size:12.5px; color:#374151;
            }
            .hq-chip .hq-chip-dot { width:6px; height:6px; border-radius:50%; background:#4F5EF8; flex:0 0 auto; }
            .hq-chip .hq-chip-name { font-weight:500; }
            .hq-chip .hq-chip-num { font-weight:700; color:#111827; font-variant-numeric:tabular-nums; }
            .hq-chip .hq-chip-unit { font-size:11px; color:#9CA3AF; }
            .hq-chip-empty { font-size:12.5px; color:#9CA3AF; }

            /* ── 에듀케어별 정산 카드 ── */
            .hq-branch-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(390px,1fr)); gap:16px; margin-bottom:24px; }
            @media (max-width:860px){ .hq-branch-grid{ grid-template-columns:1fr;} }
            .hq-bcard {
              background:#fff; border:1px solid #EEF0F4; border-radius:16px; overflow:hidden;
              display:flex; flex-direction:column;
            }
            .hq-bcard-head {
              display:flex; align-items:center; gap:10px;
              padding:15px 18px; border-bottom:1px solid #F1F3F7; background:#FCFDFE;
            }
            .hq-bcard-head .hq-bname { font-size:14.5px; font-weight:700; color:#111827; letter-spacing:-.2px; }
            .hq-bcard-head .hq-bcode { font-size:11px; color:#9CA3AF; font-variant-numeric:tabular-nums; }
            .hq-bcard-head .hq-bstudents {
              margin-left:auto; font-size:11.5px; color:#6B7280;
              background:#F1F4F9; border-radius:999px; padding:4px 11px; font-weight:600;
            }
            .hq-bcard-head .hq-bstudents b { color:#111827; font-weight:700; font-variant-numeric:tabular-nums; }

            .hq-bcard-body { padding:16px 18px; }

            /* 정산 2열 (순수익 입금 / 로열티) */
            .hq-settle-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; }
            .hq-settle-box { border:1px solid #F1F3F7; border-radius:12px; padding:13px 14px; background:#FCFDFE; }
            .hq-settle-box .hq-sb-label { font-size:11px; font-weight:600; color:#8A93A6; margin-bottom:7px; letter-spacing:.02em; }
            .hq-settle-box .hq-sb-value { font-size:17px; font-weight:700; color:#111827; letter-spacing:-.3px; font-variant-numeric:tabular-nums; }
            .hq-settle-box .hq-sb-value.is-brand { color:#4F5EF8; }
            .hq-settle-box .hq-sb-note { font-size:11.5px; color:#8A93A6; margin-top:6px; font-variant-numeric:tabular-nums; }

            /* 로열티 세부 (입금완료/미수금) */
            .hq-royalty-rows { border:1px solid #F1F3F7; border-radius:12px; overflow:hidden; margin-bottom:14px; }
            .hq-rrow { display:flex; align-items:center; padding:9px 14px; font-size:12.5px; }
            .hq-rrow + .hq-rrow { border-top:1px solid #F6F8FB; }
            .hq-rrow .hq-rlabel { color:#6B7280; }
            .hq-rrow .hq-rval { margin-left:auto; font-weight:700; color:#111827; font-variant-numeric:tabular-nums; }
            .hq-rrow.is-paid .hq-rval { color:#10B981; }
            .hq-rrow.is-unpaid .hq-rval { color:#EF4444; }
            .hq-rrow.is-unpaid.is-zero .hq-rval { color:#9CA3AF; }

            /* 강좌별 인원 (에듀케어 카드 내부) */
            .hq-sub-label { font-size:11px; font-weight:600; color:#8A93A6; margin:18px 0 8px; letter-spacing:.02em; }
            .hq-cat-list { display:flex; flex-wrap:wrap; gap:7px; }
            .hq-cat-item {
              display:inline-flex; align-items:center; gap:7px; background:#F8FAFC;
              border:1px solid #EDF0F5; border-radius:9px; padding:6px 11px; font-size:12.5px;
            }
            .hq-cat-item .hq-ci-name { color:#4B5563; font-weight:500; }
            .hq-cat-item .hq-ci-num { font-weight:700; color:#111827; font-variant-numeric:tabular-nums; }
            .hq-cat-item .hq-ci-unit { font-size:11px; color:#9CA3AF; }
            .hq-cat-empty { font-size:12px; color:#B0B7C3; }

            /* 로딩 스켈레톤 */
            .hq-loading { display:grid; grid-template-columns:repeat(auto-fill,minmax(390px,1fr)); gap:16px; }
            .hq-sk { height:210px; border-radius:16px; background:linear-gradient(90deg,#F4F6F9 25%,#EDF0F5 50%,#F4F6F9 75%); background-size:200% 100%; animation:hqShimmer 1.4s infinite; }
            @keyframes hqShimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
        </style>

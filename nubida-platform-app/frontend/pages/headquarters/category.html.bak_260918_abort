  <script>
  // ============================================================
  // 카테고리 상세 페이지 — 상태 변수
  // ============================================================
  let catKey = '';
  let catName = '';
  let catColor = '#4F5EF8';
  let catBgColor = 'rgba(8,145,178,0.08)';
  let allCourses = [], filteredCourses = [], curPage = 1, totalPages = 1;
  let currentMaterials = [], currentMatCourseId = null;
  let activeFolder = null;
  let apiFolders = [];
  const PER_PAGE = 100;
  const statusLabels = { 'active': '공개', 'draft': '비공개', 'inactive': '중지' };

  // ===== 초기화 (onAuthReady 패턴) =====
  document.addEventListener('DOMContentLoaded', function() {
    requireAuth();
    renderSidebarUser();
    const params = new URLSearchParams(window.location.search);
    catKey = params.get('cat') || '';
    if (!catKey) {
      document.getElementById('catTitle').textContent = '잘못된 접근';
      showAlert('카테고리 파라미터가 없습니다.', 'error');
      document.getElementById('pageLoading').classList.add('hide');
      return;
    }
    // 인증 확인 전이라도 오버레이 먼저 표시
    var overlay = document.getElementById('pageLoading');
    if (overlay) overlay.classList.remove('hide');
    onAuthReady(function() {
      loadCategoryInfo();
      loadFolders();
      loadCourses(1);
    });
  });

  // ===== 카테고리 정보 =====
  async function loadCategoryInfo() {
    try {
      const res = await apiGet('/headquarters/courses/categories');
      const cats = res.data || [];
      const found = cats.find(function(c) { return c.key === catKey; });
      if (found) {
        catName = found.name;
        catColor = found.color || '#4F5EF8';
        catBgColor = found.bg_color || 'rgba(8,145,178,0.08)';
      } else {
        catName = catKey;
      }
    } catch (e) {
      catName = catKey;
    }
    document.getElementById('catTitle').textContent = catName + ' — 강좌 관리';
    document.getElementById('catDot').style.background = catColor;
    document.title = catName + ' — 누비다플랫폼';
  }

  // ===== 폴더 =====
  function flattenTree(nodes, depth) {
    if (depth === undefined) depth = 0;
    var result = [];
    nodes.forEach(function(n) {
      var children = n.children || [];
      result.push(Object.assign({}, n, { depth: depth }));
      result = result.concat(flattenTree(children, depth + 1));
    });
    return result;
  }

  async function loadFolders() {
    try {
      var res = await apiGet('/headquarters/folders?category=' + encodeURIComponent(catKey));
      apiFolders = flattenTree(res.data || []);
    } catch (e) { apiFolders = []; }
    renderFolders();
  }

  function renderFolders() {
    var container = document.getElementById('folderGrid');
    if (!container) return;
    var html = '';

    // "모든 강좌" 버튼
    var isAll = !activeFolder;
    html += '<div class="folder-all-btn' + (isAll ? ' active' : '') + '" onclick="selectFolder(null)" title="모든 강좌">';
    html += '<div class="icon">📋</div><div class="label">전체</div></div>';

    apiFolders.forEach(function(f) {
      var isActive = activeFolder === f.id;
      var depthPad = f.depth > 0 ? 'style="margin-left:' + (f.depth * 16) + 'px"' : '';
      html += '<div class="folder-card' + (isActive ? ' active' : '') + '" ' + depthPad + ' onclick="selectFolder(\'' + f.id + '\')">';
      html += '<div class="folder-card-icon">📁</div>';
      html += '<div class="folder-card-name">' + esc(f.name) + '</div>';
      html += '<div class="folder-card-count">' + (f.course_count || 0) + '개</div>';
      html += '<div class="folder-card-actions">';
      html += '<button class="btn-icon" onclick="event.stopPropagation();openRenameFolderModal(\'' + f.id + '\',\'' + esc(f.name.replace(/'/g, "\\'")) + '\')" title="이름 변경">✏️</button>';
      html += '<button class="btn-icon danger" onclick="event.stopPropagation();deleteFolder(\'' + f.id + '\')" title="삭제">🗑️</button>';
      html += '</div></div>';
    });

    // 폴더 추가 버튼
    html += '<div class="folder-add-card" onclick="openFolderModal()">';
    html += '<div style="font-size:24px">+</div>';
    html += '<div style="font-size:12px;font-weight:600">새 폴더</div></div>';

    container.innerHTML = html;
  }

  function selectFolder(id) {
    activeFolder = id;
    renderFolders();
    loadCourses(1);
  }

  // ===== 폴더 CRUD =====
  function openFolderModal() {
    document.getElementById('editFolderId').value = '';
    document.getElementById('folderNameInput').value = '';
    document.getElementById('folderModalTitle').textContent = '📁 새 폴더';
    document.getElementById('folderSaveBtn').textContent = '폴더 생성';
    var sel = document.getElementById('folderParentSelect');
    sel.innerHTML = '<option value="">없음 (최상위)</option>';
    apiFolders.forEach(function(f) {
      if (f.depth < 2) {
        sel.innerHTML += '<option value="' + f.id + '">' + esc(f.name) + '</option>';
      }
    });
    openModal('folderModal');
  }

  function openRenameFolderModal(id, name) {
    document.getElementById('renameFolderId').value = id;
    document.getElementById('renameFolderInput').value = name;
    openModal('renameFolderModal');
  }

  async function saveFolder() {
    var name = document.getElementById('folderNameInput').value.trim();
    if (!name) { showAlert('폴더명을 입력하세요.', 'error'); return; }
    var parentId = document.getElementById('folderParentSelect').value;
    try {
      await apiPost('/headquarters/folders', {
        category: catKey,
        name: name,
        parent_id: parentId || null
      });
      showAlert('폴더가 생성되었습니다.', 'success');
      closeModal('folderModal');
      loadFolders();
    } catch (e) {
      showAlert(e.message || '폴더 생성 실패', 'error');
    }
  }

  async function renameFolder() {
    var id = document.getElementById('renameFolderId').value;
    var name = document.getElementById('renameFolderInput').value.trim();
    if (!name) { showAlert('폴더명을 입력하세요.', 'error'); return; }
    try {
      await apiPut('/headquarters/folders/' + id, { name: name });
      showAlert('폴더명이 변경되었습니다.', 'success');
      closeModal('renameFolderModal');
      loadFolders();
    } catch (e) {
      showAlert(e.message || '폴더명 변경 실패', 'error');
    }
  }

  async function deleteFolder(id) {
    if (!confirm('정말 이 폴더를 삭제하시겠습니까?')) return;
    try {
      await apiDelete('/headquarters/folders/' + id);
      showAlert('폴더가 삭제되었습니다.', 'success');
      if (activeFolder === id) activeFolder = null;
      loadFolders();
      loadCourses(1);
    } catch (e) {
      showAlert(e.message || '폴더 삭제 실패', 'error');
    }
  }

  // ===== 강좌 로드 =====
  async function loadCourses(page) {
    curPage = page || 1;
    // 페이지 전체 로딩 오버레이 표시
    var overlay = document.getElementById('pageLoading');
    if (overlay) overlay.classList.remove('hide');
    // 타임아웃 플래그 (15초)
    var timedOut = false;
    var timeoutId = setTimeout(function() {
      timedOut = true;
      var tbody = document.getElementById('courseTableBody');
      if (tbody) {
        tbody.innerHTML = '<tr class="c-empty"><td colspan="7" style="text-align:center;padding:40px 0;color:var(--text-tertiary)">⏱️ 서버 응답이 지연되고 있습니다. 잠시 후 다시 시도해주세요.</td></tr>';
      }
      if (overlay) overlay.classList.add('hide');
    }, 15000);
    try {
      var params = '?category=' + encodeURIComponent(catKey) + '&page=' + curPage + '&per_page=' + PER_PAGE;
      if (activeFolder) params += '&folder_id=' + encodeURIComponent(activeFolder);
      var statusVal = document.getElementById('statusFilter').value;
      if (statusVal) params += '&status=' + encodeURIComponent(statusVal);
      var searchVal = document.getElementById('searchInput').value.trim();
      if (searchVal) params += '&search=' + encodeURIComponent(searchVal);

      var res = await apiGet('/headquarters/courses' + params);
      clearTimeout(timeoutId);
      if (timedOut) return;
      allCourses = res.data || [];
      totalPages = res.pagination ? res.pagination.total_pages : 1;
      filteredCourses = allCourses;
      // 오버레이 숨김
      if (overlay) overlay.classList.add('hide');
      renderCourses();
      renderPagination();
    } catch (e) {
      clearTimeout(timeoutId);
      if (timedOut) return;
      if (overlay) overlay.classList.add('hide');
      var msg = e.message || '알 수 없는 오류';
      if (msg.indexOf('NetworkError') !== -1 || msg.indexOf('Failed to fetch') !== -1 || msg.indexOf('network') !== -1) {
        document.getElementById('courseTableBody').innerHTML = '<tr class="c-empty"><td colspan="7" style="text-align:center;padding:40px 0">❌ 서버에 연결할 수 없습니다</td></tr>';
      } else {
        document.getElementById('courseTableBody').innerHTML = '<tr class="c-empty"><td colspan="7" style="text-align:center;padding:40px 0">❌ 강좌 로딩 실패: ' + esc(msg) + '</td></tr>';
      }
    }
  }

  function filterCourses() { loadCourses(1); }

  function renderCourses() {
    var tbody = document.getElementById('courseTableBody');
    if (!tbody) return;
    if (!filteredCourses || filteredCourses.length === 0) {
      tbody.innerHTML = '<tr class="c-empty"><td colspan="7">📭 등록된 강좌가 없습니다.</td></tr>';
      document.getElementById('courseCount').textContent = '0개';
      return;
    }
    var html = '';
    filteredCourses.forEach(function(c) {
      var statusLabel = statusLabels[c.status] || c.status || '알수없음';
      var badgeClass = c.status === 'active' ? 'badge badge-success' : (c.status === 'draft' ? 'badge badge-warning' : 'badge badge-danger');
      html += '<tr>';
      html += '<td class="checkbox-col"><input type="checkbox" class="course-check" value="' + c.id + '"></td>';
      html += '<td>' + c.id + '</td>';
      html += '<td><strong>' + esc(c.title) + '</strong></td>';
      html += '<td><a href="lecture-editor.html?course_id=' + c.id + '&title=' + encodeURIComponent(c.title) + '" class="file-count">📁 ' + (c.material_count || 0) + '</a></td>';
      html += '<td><span class="' + badgeClass + '">' + statusLabel + '</span></td>';
      html += '<td>' + formatDate(c.created_at) + '</td>';
      html += '<td class="actions-col">';
      html += '<button class="btn btn-ghost btn-xs" onclick="editCourse(' + c.id + ',\'' + esc(c.title.replace(/'/g, "\\'")) + '\',\'' + c.status + '\',\'' + esc((c.description || '').replace(/'/g, "\\'")) + '\',\'' + (c.folder_id || '') + '\')">✏️</button> ';
      html += '<button class="btn btn-ghost btn-xs btn-danger" onclick="deleteCourse(' + c.id + ')">🗑️</button>';
      html += '</td></tr>';
    });
    tbody.innerHTML = html;
    document.getElementById('courseCount').textContent = filteredCourses.length + '개';
    updateBatchDeleteBtn();
  }

  function renderPagination() {
    var container = document.getElementById('paginationWrap');
    if (!container) return;
    if (totalPages <= 1) { container.innerHTML = ''; return; }
    var html = '';
    if (curPage > 1) html += '<button class="page-btn" onclick="loadCourses(' + (curPage - 1) + ')">‹</button>';
    for (var i = 1; i <= totalPages; i++) {
      if (i === curPage) html += '<button class="page-btn active">' + i + '</button>';
      else if (Math.abs(i - curPage) <= 2 || i === 1 || i === totalPages)
        html += '<button class="page-btn" onclick="loadCourses(' + i + ')">' + i + '</button>';
    }
    if (curPage < totalPages) html += '<button class="page-btn" onclick="loadCourses(' + (curPage + 1) + ')">›</button>';
    container.innerHTML = html;
  }

  // ===== 강좌 CRUD =====
  function openCreateCourseModal() {
    document.getElementById('newTitle').value = '';
    document.getElementById('newStatus').value = 'active';
    document.getElementById('newDescription').value = '';
    openModal('createCourseModal');
  }

  async function createCourse() {
    var title = document.getElementById('newTitle').value.trim();
    if (!title) { showAlert('강좌명을 입력하세요.', 'error'); return; }
    var data = {
      category: catKey,
      title: title,
      status: document.getElementById('newStatus').value,
      description: document.getElementById('newDescription').value.trim()
    };
    if (activeFolder) data.folder_id = activeFolder;
    try {
      await apiPost('/headquarters/courses', data);
      showAlert('강좌가 생성되었습니다.', 'success');
      closeModal('createCourseModal');
      loadCourses(1);
    } catch (e) {
      showAlert(e.message || '강좌 생성 실패', 'error');
    }
  }

  function editCourse(id, title, status, description, folderId) {
    document.getElementById('editCourseId').value = id;
    document.getElementById('editTitle').value = title;
    document.getElementById('editStatus').value = status;
    document.getElementById('editDescription').value = description;
    var sel = document.getElementById('editFolderId');
    sel.innerHTML = '<option value="">폴더 없음 (전체)</option>';
    apiFolders.forEach(function(f) {
      var selected = f.id === folderId ? ' selected' : '';
      sel.innerHTML += '<option value="' + f.id + '"' + selected + '>' + esc(f.name) + '</option>';
    });
    openModal('editCourseModal');
  }

  async function updateCourse() {
    var id = document.getElementById('editCourseId').value;
    var data = {
      title: document.getElementById('editTitle').value.trim(),
      status: document.getElementById('editStatus').value,
      description: document.getElementById('editDescription').value.trim(),
      folder_id: document.getElementById('editFolderId').value || null
    };
    if (!data.title) { showAlert('강좌명을 입력하세요.', 'error'); return; }
    try {
      await apiPut('/headquarters/courses/' + id, data);
      showAlert('강좌가 수정되었습니다.', 'success');
      closeModal('editCourseModal');
      loadCourses(curPage);
    } catch (e) {
      showAlert(e.message || '강좌 수정 실패', 'error');
    }
  }

  async function deleteCourse(id) {
    if (!confirm('정말 이 강좌를 삭제하시겠습니까?')) return;
    try {
      await apiDelete('/headquarters/courses/' + id);
      showAlert('강좌가 삭제되었습니다.', 'success');
      loadCourses(curPage);
    } catch (e) {
      showAlert(e.message || '강좌 삭제 실패', 'error');
    }
  }

  function toggleSelectAll(src) {
    document.querySelectorAll('.course-check').forEach(function(cb) { cb.checked = src.checked; });
    updateBatchDeleteBtn();
  }

  function updateBatchDeleteBtn() {
    var checked = document.querySelectorAll('.course-check:checked').length;
    document.getElementById('batchDeleteBtn').style.display = checked > 0 ? 'inline-block' : 'none';
  }

  async function batchDeleteCourses() {
    var ids = [];
    document.querySelectorAll('.course-check:checked').forEach(function(cb) { ids.push(cb.value); });
    if (ids.length === 0) return;
    if (!confirm(ids.length + '개 강좌를 삭제하시겠습니까?')) return;
    try {
      await apiPost('/headquarters/courses/batch-delete', { ids: ids });
      showAlert(ids.length + '개 강좌가 삭제되었습니다.', 'success');
      loadCourses(1);
    } catch (e) {
      showAlert(e.message || '일괄 삭제 실패', 'error');
    }
  }

  // ===== 학습 자료 모달 =====
  async function openMaterialsModal(courseId, courseTitle) {
    currentMatCourseId = courseId;
    document.getElementById('matModalTitle').textContent = courseTitle;
    document.getElementById('matCourseId').value = courseId;
    document.getElementById('matUploadSection').style.display = 'block';
    document.getElementById('matInfoBanner').style.display = 'none';
    stopVideo();
    loadMaterials(courseId);
    openModal('materialsModal');
  }

  async function loadMaterials(courseId) {
    try {
      var res = await apiGet('/courses/' + courseId + '/materials');
      currentMaterials = res.data || [];
      renderMaterials();
    } catch (e) {
      document.getElementById('materialList').innerHTML = '<div class="empty-state"><h3>❌ 로딩 실패</h3><p>' + esc(e.message) + '</p></div>';
    }
  }

  function renderMaterials() {
    var container = document.getElementById('materialList');
    if (!container) return;
    document.getElementById('matCount').textContent = '총 ' + currentMaterials.length + '개 자료';
    if (currentMaterials.length === 0) {
      container.innerHTML = '<div class="empty-state" style="padding:40px 0"><div class="empty-icon">📭</div><h3>등록된 자료가 없습니다</h3></div>';
      return;
    }
    var html = '<div style="display:flex;flex-direction:column;gap:8px">';
    currentMaterials.forEach(function(m) {
      var icon = m.type === 'video' ? '🎬' : (m.type === 'link' || m.type === 'embed' ? '🔗' : '📄');
      html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border:1px solid var(--border-subtle);border-radius:8px;background:var(--bg-surface)">';
      html += '<div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0">';
      html += '<span>' + icon + '</span>';
      html += '<div style="flex:1;min-width:0">';
      html += '<div style="font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + esc(m.title) + '</div>';
      if (m.description) html += '<div style="font-size:12px;color:var(--text-tertiary)">' + esc(m.description) + '</div>';
      html += '</div></div>';
      html += '<div style="display:flex;gap:4px;flex-shrink:0">';
      if (m.type === 'video' || m.file_url) {
        html += '<button class="btn btn-ghost btn-xs" onclick="playVideo(\'' + esc((m.file_url || m.url || '').replace(/'/g, "\\'")) + '\',\'' + esc(m.title.replace(/'/g, "\\'")) + '\')">▶️</button>';
      } else if (m.url) {
        html += '<button class="btn btn-ghost btn-xs" onclick="window.open(\'' + esc(m.url.replace(/'/g, "\\'")) + '\',\'_blank\')">🔗</button>';
      }
      html += '<button class="btn btn-ghost btn-xs btn-danger" onclick="deleteMaterial(' + m.id + ')">🗑️</button>';
      html += '</div></div>';
    });
    html += '</div>';
    container.innerHTML = html;
  }

  function switchUploadTab(tab) {
    document.querySelectorAll('.mat-upload-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelector('.mat-upload-tab[data-utab="' + tab + '"]').classList.add('active');
    document.getElementById('matUploadFileTab').style.display = tab === 'file' ? 'block' : 'none';
    document.getElementById('matUploadLinkTab').style.display = tab === 'link' ? 'block' : 'none';
  }

  function onFilesSelected(input) {
    var files = input.files;
    if (!files || files.length === 0) return;
    var queue = document.getElementById('uploadQueue');
    queue.style.display = 'block';
    for (var i = 0; i < files.length; i++) {
      (function(file) {
        var itemId = 'upload-' + Date.now() + '-' + i;
        queue.innerHTML += '<div id="' + itemId + '" class="upload-queue-item" style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--border-subtle)">';
        queue.innerHTML += '<span style="flex:1;font-size:13px">' + esc(file.name) + ' (' + (file.size / 1024).toFixed(1) + 'KB)</span>';
        queue.innerHTML += '<span class="upload-status" id="' + itemId + '-status">대기 중...</span></div>';
        uploadFile(file, itemId);
      })(files[i]);
    }
    input.value = '';
  }

  async function uploadFile(file, itemId) {
    var statusEl = document.getElementById(itemId + '-status');
    if (statusEl) statusEl.textContent = '업로드 중...';
    try {
      var formData = new FormData();
      formData.append('file', file);
      formData.append('course_id', currentMatCourseId);
      var token = localStorage.getItem('token') || localStorage.getItem('access_token');
      var res = await fetch('/api/v1/courses/' + currentMatCourseId + '/upload', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token },
        body: formData
      });
      if (!res.ok) throw new Error('업로드 실패 (' + res.status + ')');
      if (statusEl) statusEl.textContent = '✅ 완료';
      loadMaterials(currentMatCourseId);
    } catch (e) {
      if (statusEl) statusEl.textContent = '❌ 실패';
      showAlert(file.name + ' 업로드 실패: ' + e.message, 'error');
    }
  }

  async function addLinkMaterial() {
    var url = document.getElementById('linkUrl').value.trim();
    var title = document.getElementById('linkTitle').value.trim();
    if (!url || !title) { showAlert('URL과 제목을 입력하세요.', 'error'); return; }
    try {
      await apiPost('/courses/' + currentMatCourseId + '/materials', {
        title: title,
        material_type: document.getElementById('linkType').value,
        file_url: url,
        description: document.getElementById('linkDescription').value.trim(),
        course_id: currentMatCourseId,
      });
      showAlert('링크가 추가되었습니다.', 'success');
      document.getElementById('linkUrl').value = '';
      document.getElementById('linkTitle').value = '';
      document.getElementById('linkDescription').value = '';
      loadMaterials(currentMatCourseId);
    } catch (e) {
      showAlert(e.message || '링크 추가 실패', 'error');
    }
  }

  function playVideo(url, title) {
    var player = document.getElementById('videoPlayer');
    var el = document.getElementById('videoElement');
    player.style.display = 'block';
    document.getElementById('videoTitle').textContent = '▶ ' + title;
    el.src = url;
    el.load();
    el.play().catch(function() { /* 자동재생 차단 무시 */ });
  }

  function stopVideo() {
    var el = document.getElementById('videoElement');
    el.pause();
    el.src = '';
    document.getElementById('videoPlayer').style.display = 'none';
  }

  async function deleteMaterial(id) {
    if (!confirm('이 자료를 삭제하시겠습니까?')) return;
    try {
      await apiDelete('/courses/materials/' + id);
      showAlert('자료가 삭제되었습니다.', 'success');
      loadMaterials(currentMatCourseId);
    } catch (e) {
      showAlert(e.message || '자료 삭제 실패', 'error');
    }
  }
  </script>

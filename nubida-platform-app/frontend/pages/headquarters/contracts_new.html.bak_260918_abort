document.addEventListener('DOMContentLoaded', function() {
    requireAuth();
    document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});
    const u = getCurrentUser();
    if (u && u.name) document.getElementById('sidebarUserName').textContent = u.name;
    if (u && u.role) {
        const roleLabels = { 'super_admin': '최고관리자', 'admin': '관리자', 'branch_admin': '지사 관리자', 'branch_manager': '지사 관리자', 'branch_staff': '지사 직원', 'director': '공부방장' };
        document.getElementById('sidebarUserRole').textContent = roleLabels[u.role] || u.role;
    }
    // 페이지 로딩 오버레이 표시
    var overlay = document.getElementById('pageLoading');
    if (overlay) overlay.classList.remove('hide');
    onAuthReady(function() {
        loadBranches(1);
        // 오버레이는 loadBranches 성공 시 hide됨
    });
    // 타임아웃: 15초 지나도 데이터 안 오면 오버레이 숨기고 에러 표시
    setTimeout(function() {
        if (overlay && !overlay.classList.contains('hide')) {
            overlay.classList.add('hide');
            document.getElementById('branchTableBody').innerHTML = '<tr class="branch-empty"><td colspan="10">⏱️ 서버 응답이 지연되고 있습니다. 페이지를 새로고침 해주세요.</td></tr>';
        }
    }, 15000);
});

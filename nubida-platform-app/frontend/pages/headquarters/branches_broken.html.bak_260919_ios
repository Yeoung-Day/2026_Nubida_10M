     .data-table { width:100%; border-collapse:collapse; font-size:14px; }
     .data-table thead th { background:#F9FAFB; font-size:12px; font-weight:600; color:#6B7280; text-transform:uppercase; letter-spacing:0.03em; padding:14px 20px; text-align:left; border-bottom:2px solid #E5E7EB; white-space:nowrap; }

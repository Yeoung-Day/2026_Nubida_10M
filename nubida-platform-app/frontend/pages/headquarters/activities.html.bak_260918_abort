    <script src="/common/js/pages-headquarters.js?v=20260911nav"></script>

    <script>
        let currentPage = 1;
        let currentFileType = '';

        document.addEventListener('DOMContentLoaded', async () => {
            requireAuth();
            const user = getCurrentUser();
            if (user) {
                document.getElementById('sidebarUserName').textContent = user.name || '관리자';
                document.getElementById('sidebarUserRole').textContent = '본사';
            }
            const now = new Date();
            document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });

            await loadActivities();
        });

        async function loadActivities() {
            const tbody = document.getElementById('activityTableBody');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:24px">로딩 중...</td></tr>';

            try {
                let url = `/api/v1/activities/admin/all?page=${currentPage}&per_page=20`;
                const fileType = document.getElementById('fileTypeFilter')?.value || '';
                if (fileType) url += '&file_type=' + fileType;

                const res = await fetch(url, {
                    headers: {
                        'Authorization': 'Bearer ' + (localStorage.getItem('token') || localStorage.getItem('access_token'))
                    }
                });
                const json = await res.json();
                if (!res.ok) throw new Error(json.message || json.detail || '로딩 실패');

                const items = json.data || [];
                const pagination = { page: json.page || 1, total_pages: json.total_pages || 1, total: json.total || 0 };

                if (!items.length) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:24px;color:var(--text-tertiary)">등록된 활동 영상이 없습니다.</td></tr>';
                } else {
                    tbody.innerHTML = items.map(item => {
                        const date = item.created_at ? new Date(item.created_at).toLocaleDateString('ko-KR') : '-';
                        const isVisible = item.is_visible;
                        const thumbSrc = item.thumbnail_path || item.file_path;
                        const typeIcon = item.file_type === 'video' ? '🎬' : '🖼️';
                        const typeClass = item.file_type === 'video' ? 'type-video' : 'type-image';

                        return `<tr>
                            <td><img src="${escHtml(thumbSrc)}" alt="" class="activity-preview-thumb" onerror="this.src='/common/assets/no-image.svg';this.style.cssText='width:80px;height:56px;border-radius:6px;background:#E8E8EC;display:flex;align-items:center;justify-content:center;font-size:24px;'"></td>
                            <td><strong>${escHtml(item.title)}</strong></td>
                            <td><span class="activity-type-badge ${typeClass}">${typeIcon} ${item.file_type === 'video' ? '영상' : '이미지'}</span></td>
                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(item.description || '-')}</td>
                            <td>${isVisible ? '<span class="badge badge-success">공개</span>' : '<span class="badge badge-warning">비공개</span>'}</td>
                            <td>${date}</td>
                            <td>
                                <div class="action-btn-group">
                                    <button class="btn-edit" onclick="openEditModal(${item.id}, '${escHtml(item.title)}', '${escHtml(item.description || '')}', ${item.is_visible})">✏️ 수정</button>
                                    <button class="${isVisible ? 'btn-visibility' : 'btn-visibility hidden'}" onclick="toggleVisibility(${item.id})">${isVisible ? '🔒 숨김' : '🔓 공개'}</button>
                                    <button class="btn-delete" onclick="deleteActivity(${item.id})">🗑️ 삭제</button>
                                </div>
                            </td>
                        </tr>`;
                    }).join('');
                }

                renderPaginationWidget('activityPagination', pagination, 'goToPage');
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:24px;color:var(--text-danger)">오류: ${escHtml(e.message || '알 수 없는 오류')}</td></tr>`;
            }
        }

        function goToPage(page) {
            currentPage = page;
            loadActivities();
        }

        function renderPaginationWidget(containerId, pagination, pageFn) {
            const container = document.getElementById(containerId);
            if (!container) return;
            if (!pagination || pagination.total_pages <= 1) {
                container.innerHTML = '';
                return;
            }
            const { page, total_pages } = pagination;
            let html = '<div class="pagination">';
            if (page > 1) html += `<button class="btn btn-sm" onclick="${pageFn}(${page - 1})">‹</button>`;
            for (let i = Math.max(1, page - 2); i <= Math.min(total_pages, page + 2); i++) {
                html += `<button class="btn btn-sm ${i === page ? 'btn-primary' : 'btn-outline'}" onclick="${pageFn}(${i})">${i}</button>`;
            }
            if (page < total_pages) html += `<button class="btn btn-sm" onclick="${pageFn}(${page + 1})">›</button>`;
            html += '</div>';
            container.innerHTML = html;
        }

        // Upload Modal
        function openUploadModal() {
            document.getElementById('uploadModal').style.display = 'flex';
            document.getElementById('activityTitle').value = '';
            document.getElementById('activityDescription').value = '';
            document.getElementById('activityFile').value = '';
        }

        function closeUploadModal() {
            document.getElementById('uploadModal').style.display = 'none';
        }

        async function uploadActivity() {
            const title = document.getElementById('activityTitle').value.trim();
            const description = document.getElementById('activityDescription').value.trim();
            const fileInput = document.getElementById('activityFile');

            if (!title) { alert('제목을 입력해주세요.'); return; }
            if (!fileInput.files.length) { alert('파일을 선택해주세요.'); return; }

            const uploadBtn = document.querySelector('#uploadModal .btn-primary');
            const origText = uploadBtn.textContent;
            uploadBtn.textContent = '⏳ 업로드 중...';
            uploadBtn.disabled = true;

            const formData = new FormData();
            formData.append('title', title);
            if (description) formData.append('description', description);
            formData.append('file', fileInput.files[0]);

            try {
                const token = localStorage.getItem('token') || localStorage.getItem('access_token');
                const res = await fetch('/api/v1/activities', {
                    method: 'POST',
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                    body: formData
                });
                const text = await res.text();
                let json;
                try { json = JSON.parse(text); } catch(e) { throw new Error(text || '업로드 실패'); }
                if (!res.ok) throw new Error(json.message || json.detail || '업로드 실패');
                closeUploadModal();
                showAlert('활동 영상이 업로드되었습니다.', 'success');
                await loadActivities();
            } catch(e) {
                alert('업로드 실패: ' + (e.message || '오류'));
            } finally {
                uploadBtn.textContent = origText;
                uploadBtn.disabled = false;
            }
        }

        // Edit Modal
        function openEditModal(id, title, description, isVisible) {
            document.getElementById('editModal').style.display = 'flex';
            document.getElementById('editActivityId').value = id;
            document.getElementById('editTitle').value = title;
            document.getElementById('editDescription').value = description;
            document.getElementById('editVisibility').value = isVisible ? 'true' : 'false';
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }

        async function updateActivity() {
            const id = document.getElementById('editActivityId').value;
            const title = document.getElementById('editTitle').value.trim();
            const description = document.getElementById('editDescription').value.trim();
            const isVisible = document.getElementById('editVisibility').value === 'true';

            if (!title) { alert('제목을 입력해주세요.'); return; }

            try {
                const res = await apiPut(`/activities/${id}`, {
                    title: title,
                    description: description || null,
                    is_visible: isVisible
                });
                closeEditModal();
                showAlert('활동 영상이 수정되었습니다.', 'success');
                await loadActivities();
            } catch(e) {
                alert('수정 실패: ' + (e.message || '오류'));
            }
        }

        // Toggle Visibility
        async function toggleVisibility(id) {
            try {
                const res = await apiPut(`/activities/${id}/visibility`, {});
                showAlert(res.message || '가시성이 변경되었습니다.', 'success');
                await loadActivities();
            } catch(e) {
                alert('변경 실패: ' + (e.message || '오류'));
            }
        }

        // Delete
        async function deleteActivity(id) {
            if (!confirm('정말 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.')) return;
            try {
                await apiDelete(`/activities/${id}`);
                showAlert('활동 영상이 삭제되었습니다.', 'success');
                await loadActivities();
            } catch(e) {
                alert('삭제 실패: ' + (e.message || '오류'));
            }
        }

        function escHtml(s) {
            if (!s) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }
    </script>
    
    <script src="/common/js/nav.js?v=20260913nav"></script>
</body>
</html>

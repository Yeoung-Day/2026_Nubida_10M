<script>
    let allMaterials = [];
    let currentPage = 1;
    let totalPages = 1;
    const PER_PAGE = 20;
    // ── 과목(교육명) 마스터 (본사 CRUD → 화면 탭/필터/입력 기준) ──
    let subjectMaster = [];       // [{id,name,sort_order,is_active}]
    let activeSubject = '';       // '' = 전체
    let allCourses = [];
    let courseTotal = 0;
    let _legacyCategoryValues = []; // 마스터 외 기존 등록분(레거시) — 필터/수정 시 유지
    const COURSES_API = '/headquarters/courses';
    const SUBJECT_COLORS = [
        ['#FCE7F3', '#9D174D'], ['#DBEAFE', '#1D4ED8'], ['#DCFCE7', '#15803D'],
        ['#CFFAFE', '#0E7490'], ['#FEF3C7', '#B45309'], ['#E0E7FF', '#4338CA'],
        ['#FFEDD5', '#C2410C'], ['#F3E8FF', '#7E22CE'], ['#F1F5F9', '#475569'],
        ['#FFE4E6', '#BE123C'], ['#E0F2FE', '#0369A1'], ['#FEF9C3', '#A16207']
    ];

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof requireAuth === 'function') requireAuth();
        if (typeof renderSidebarUser === 'function') renderSidebarUser();
        loadSubjects();
    });

    // ══════════════════════════════════════════════
    // 과목 마스터 — 탭/필터/입력 옵션의 단일 소스
    // ══════════════════════════════════════════════
    function isMasterName(name) {
        return subjectMaster.some(s => s.name === name);
    }

    function subjectNames() {
        return subjectMaster.slice().sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id).map(s => s.name);
    }

    async function loadSubjects() {
        try {
            const res = await apiGet('/subjects');
            subjectMaster = (res.data && res.data.items) ? res.data.items : [];
        } catch (e) {
            subjectMaster = [];
        }
        renderSubjectTabs();
        renderCategoryFilter();
        setCategoryDatalist();
        loadMaterials(1);
        loadCourses();
    }

    // ── 화면 상단 과목 탭 (한 줄 네비게이션) ──
    function renderSubjectTabs() {
        const wrap = document.getElementById('subjectTabs');
        if (!wrap) return;
        const subs = subjectMaster.filter(s => s.is_active !== false).sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id);
        let html = '<button type="button" class="subject-tab' + (activeSubject === '' ? ' active' : '') + '" onclick="selectSubjectTab(\'\')">전체</button>';
        subs.forEach(s => {
            html += '<button type="button" class="subject-tab' + (activeSubject === s.name ? ' active' : '') + '" data-sid="' + s.id + '" onclick="selectSubjectById(' + s.id + ')">' + escHtml(s.name) + '</button>';
        });
        wrap.innerHTML = html;
    }

    function selectSubjectById(id) {
        const s = subjectMaster.find(x => x.id === id);
        selectSubjectTab(s ? s.name : '');
    }

    function selectSubjectTab(name) {
        activeSubject = name || '';
        const sel = document.getElementById('categoryFilter');
        if (sel && subjectNames().indexOf(activeSubject) >= 0) sel.value = activeSubject;
        renderSubjectTabs();
        loadMaterials(1);
        loadCourses();
    }

    // ── [전체] 탭 버튼(카테고리 셀렉트 포함)과 동기화 ──
    function onCategorySelectChange() {
        const sel = document.getElementById('categoryFilter');
        selectSubjectTab(sel ? sel.value : '');
    }

    // ── 과목 관리 모달 (본사) ──
    function openSubjectManager() {
        const tbody = document.getElementById('subjectManageBody');
        if (!tbody) return;
        tbody.innerHTML = subjectMaster.slice().sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id)
            .map(s => '<tr data-smid="' + s.id + '" data-orig-name="' + escHtml(s.name) + '" data-orig-order="' + (s.sort_order || 0) + '">' +
                '<td><input type="number" class="form-input sm-order" value="' + (s.sort_order || 0) + '" min="0" style="width:70px;"></td>' +
                '<td><input type="text" class="form-input sm-name" value="' + escHtml(s.name) + '" maxlength="50" style="width:100%;"></td>' +
                '<td style="text-align:center;"><button type="button" class="action-btn danger" onclick="deleteSubjectById(' + s.id + ')">🗑️ 삭제</button></td>' +
                '</tr>').join('');
        document.getElementById('subjectManageHint').textContent = '과목명 변경 시 해당 과목의 교육자료·강좌 분류도 함께 변경됩니다.';
        openModal('subjectManagerModal');
    }

    function addSubjectRow() {
        const tbody = document.getElementById('subjectManageBody');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.dataset.smid = '';
        tr.dataset.isNew = '1';
        tr.innerHTML = '<td><input type="number" class="form-input sm-order" value="0" min="0" style="width:70px;"></td>' +
            '<td><input type="text" class="form-input sm-name" value="" maxlength="50" placeholder="새 과목명 (예: 미술)" style="width:100%;"></td>' +
            '<td style="text-align:center;"><button type="button" class="action-btn danger" onclick="this.closest(\'tr\').remove()">🗑️ 삭제</button></td>';
        tbody.appendChild(tr);
        const inp = tr.querySelector('.sm-name');
        if (inp) inp.focus();
    }

    async function deleteSubjectById(id) {
        const s = subjectMaster.find(x => x.id === id);
        if (!confirm('과목 「' + (s ? s.name : id) + '」을(를) 삭제할까요?\n자료·강좌의 과목명은 유지되며(전체 탭에서 확인), 해당 과목 탭에서만 제외됩니다.')) return;
        try {
            await apiDelete('/subjects/' + id);
            if (s && activeSubject === s.name) activeSubject = '';  // 활성 탭이 삭제되면 전체로 리셋
            showAlert('✅ 과목이 삭제되었습니다.', 'success');
            closeModal('subjectManagerModal');
            await loadSubjects();
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '삭제 실패'), 'error');
        }
    }

    async function saveSubjectManager() {
        const rows = Array.prototype.slice.call(document.querySelectorAll('#subjectManageBody tr'));
        const tasks = [];
        const seen = {};
        let firstErr = '';
        for (const tr of rows) {
            const name = (tr.querySelector('.sm-name').value || '').trim();
            const order = parseInt(tr.querySelector('.sm-order').value || '0', 10) || 0;
            if (!name) continue;
            if (seen[name]) { firstErr = '과목명이 중복됩니다: ' + name; break; }
            seen[name] = true;
            if (tr.dataset.isNew === '1') {
                tasks.push(apiPost('/subjects', { name: name, sort_order: order }));
            } else {
                const origName = tr.dataset.origName || '';
                const origOrder = tr.dataset.origOrder || '';
                if (name !== origName || String(order) !== String(origOrder)) {
                    tasks.push(apiPut('/subjects/' + tr.dataset.smid, { name: name, sort_order: order }));
                }
            }
        }
        if (firstErr) { showAlert('⚠️ ' + firstErr, 'error'); return; }
        if (!tasks.length) { showAlert('ℹ️ 변경된 내용이 없습니다.', 'success'); return; }
        try {
            await Promise.all(tasks);
            showAlert('✅ 과목 마스터가 저장되었습니다.', 'success');
            closeModal('subjectManagerModal');
            await loadSubjects();
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '저장 실패'), 'error');
        }
    }

    // ── 강좌(과정) 섹션 — 선택 과목의 과정을 함께 노출 ──
    async function loadCourses() {
        const box = document.getElementById('coursesList');
        if (!box) return;
        const cntEl = document.getElementById('coursesCount');
        const head = document.getElementById('coursesSectionTitle');
        box.innerHTML = '<div class="courses-empty">강좌를 불러오는 중...</div>';
        allCourses = [];
        courseTotal = 0;
        if (cntEl) cntEl.textContent = '';
        try {
            const isMaster = isMasterName(activeSubject);
            const q = (activeSubject && isMaster) ? '&subject=' + encodeURIComponent(activeSubject) : '';
            const res = await apiGet(COURSES_API + '?per_page=100&status=active' + q);
            const arr = Array.isArray(res.data) ? res.data : ((res.data && res.data.items) || []);
            allCourses = arr.filter(c => c.status === 'active');
            courseTotal = (typeof res.total === 'number') ? res.total : allCourses.length;
            if (cntEl) cntEl.textContent = courseTotal + '건';
            if (head) head.textContent = '🎓 과정(강좌)';
            renderCourses();
        } catch (e) {
            box.innerHTML = '<div class="courses-empty">⚠️ ' + escHtml(e.message || '강좌 로드 실패') + '</div>';
        }
    }

    function renderCourses() {
        const box = document.getElementById('coursesList');
        if (!box) return;
        if (!allCourses.length) {
            const subjTxt = (activeSubject && isMasterName(activeSubject)) ? '「' + activeSubject + '」' : '';
            box.innerHTML = '<div class="courses-empty">' + (subjTxt ? subjTxt + ' 과목에' : '') + ' 등록된 과정(강좌)이 없습니다.</div>';
            return;
        }
        box.innerHTML = allCourses.map(c => {
            const subjTxt = (activeSubject && isMasterName(activeSubject)) ? '' : (c.subject ? subjectPillHtml(c.subject) : '');
            const metaBits = [];
            if (c.branch_name) metaBits.push('🏢 ' + escHtml(c.branch_name));
            if (c.instructor) metaBits.push('👤 ' + escHtml(c.instructor));
            if (c.price) metaBits.push('💰 ' + Number(c.price).toLocaleString() + '원');
            if (c.material_count != null) metaBits.push('📚 자료 ' + c.material_count + '건');
            return '<div class="course-card">' +
                '<div class="course-card-icon">📖</div>' +
                '<div class="course-card-body">' +
                '<div class="course-card-name">' + escHtml(c.name) + (subjTxt ? ' ' + subjTxt : '') + '</div>' +
                (metaBits.length ? '<div class="course-card-meta">' + metaBits.join(' · ') + '</div>' : '') +
                '</div>' +
                '<span class="course-card-branch"></span>' +
                '</div>';
        }).join('');
    }

    // ── 목록 조회 ──
    async function loadMaterials(page) {
        currentPage = page || 1;
        const search = encodeURIComponent(document.getElementById('searchInput').value.trim());
        const category = encodeURIComponent(document.getElementById('categoryFilter').value);
        const mtype = encodeURIComponent(document.getElementById('typeFilter').value);
        const tb = document.getElementById('materialTableBody');
        tb.innerHTML = '<tr><td colspan="8" class="empty-cell">자료를 불러오는 중...</td></tr>';
        try {
            const res = await apiGet('/headquarters/edu-materials?search=' + search +
                '&category=' + category + '&material_type=' + mtype +
                '&page=' + currentPage + '&page_size=' + PER_PAGE);
            const data = res.data || {};
            allMaterials = data.items || [];
            const total = data.total || 0;
            totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
            document.getElementById('materialCount').textContent = total + '개';
            renderMaterials();
            renderPaginationUI();
            refreshCategoryOptions();
        } catch (e) {
            tb.innerHTML = '<tr><td colspan="8" class="empty-cell">⚠️ ' + escHtml(e.message || '로드 실패') + '</td></tr>';
        }
    }

    // ── 테이블 렌더링 ──
    const TYPE_META = {
        document: { icon: '📄', label: '문서', cls: 'document' },
        video: { icon: '🎬', label: '영상', cls: 'video' },
        image: { icon: '🖼️', label: '이미지', cls: 'image' },
        link: { icon: '🔗', label: '링크', cls: 'link' }
    };

    function fmtSize(bytes) {
        if (!bytes) return '';
        if (bytes < 1024) return bytes + 'B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + 'KB';
        return (bytes / 1024 / 1024).toFixed(1) + 'MB';
    }

    function extName(url) {
        if (!url) return '';
        const m = url.match(/\.([A-Za-z0-9]+)(\?.*)?$/);
        return m ? m[1].toUpperCase() : '';
    }

    function renderMaterials() {
        const tb = document.getElementById('materialTableBody');
        if (!allMaterials.length) {
            tb.innerHTML = '<tr><td colspan="8" class="empty-cell">📭 등록된 교육 자료가 없습니다. <br>우측 상단 [파일 업로드] 또는 [링크 등록]으로 첫 자료를 추가해보세요.</td></tr>';
            return;
        }
        tb.innerHTML = allMaterials.map(m => {
            const tm = TYPE_META[m.material_type] || TYPE_META.document;
            const fileTxt = m.file_url ? (extName(m.file_url) + ' ' + fmtSize(m.file_size)) : '';
            return '<tr>' +
                '<td><div class="edu-title" onclick="viewMaterial(' + m.id + ')">' + escHtml(m.title) + '</div>' +
                (m.description ? '<div class="edu-desc">' + escHtml(m.description) + '</div>' : '') + '</td>' +
                '<td>' + subjectPillHtml(m.category) + '</td>' +
                '<td><span class="badge-type ' + tm.cls + '">' + tm.icon + ' ' + tm.label + '</span></td>' +
                '<td><span class="file-cell">' + (m.file_url ? (m.material_type === 'link' ? '🔗 ' + escHtml(m.file_url) : '📎 ' + fileTxt) : '<span style="color:#d1d5db;">-</span>') + '</span></td>' +
                '<td><button class="badge-status ' + (m.is_published ? 'published' : 'hidden') + '" onclick="togglePublish(' + m.id + ')">' + (m.is_published ? '● 발행' : '○ 비발행') + '</button></td>' +
                '<td>' + (m.view_count || 0) + '</td>' +
                '<td>' + fmtDate(m.created_at) + '</td>' +
                '<td><div style="display:flex;gap:4px;flex-wrap:wrap;">' +
                (m.file_url ? '<button class="action-btn" onclick="viewMaterial(' + m.id + ')">👁 열기</button>' : '') +
                '<button class="action-btn" onclick="openEditModal(' + m.id + ')">✏️ 수정</button>' +
                '<button class="action-btn danger" onclick="deleteMaterial(' + m.id + ')">🗑️ 삭제</button>' +
                '</div></td></tr>';
        }).join('');
    }

    // ── 조회/열기 (링크는 새탭, 파일은 다운로드) ──
    async function viewMaterial(id) {
        const m = allMaterials.find(x => x.id === id);
        if (!m) return;
        if (m.material_type === 'link') {
            window.open(m.file_url, '_blank');
            return;
        }
        if (m.file_url) {
            downloadMaterial(id);
        } else {
            openEditModal(id);
        }
    }

    async function downloadMaterial(id) {
        try {
            const token = localStorage.getItem('token') || localStorage.getItem('access_token');
            const res = await fetch('/api/v1/director/edu-materials/' + id + '/download', {
                headers: token ? { 'Authorization': 'Bearer ' + token } : {}
            });
            if (!res.ok) {
                let msg = '다운로드 실패';
                try { const j = await res.json(); msg = j.message || j.detail || msg; } catch (e) {}
                throw new Error(msg);
            }
            const blob = await res.blob();
            const cd = res.headers.get('Content-Disposition') || '';
            let fname = 'download';
            const um = cd.match(/filename\*=UTF-8''([^;]+)/i);
            if (um) { try { fname = decodeURIComponent(um[1]); } catch (e) { fname = um[1]; } }
            else { const fm = cd.match(/filename="?([^";]+)"?/i); if (fm) fname = fm[1]; }
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = fname;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '다운로드 실패'), 'error');
        }
    }

    // ── 발행 토글 ──
    async function togglePublish(id) {
        const m = allMaterials.find(x => x.id === id);
        if (!m) return;
        try {
            await apiPut('/headquarters/edu-materials/' + id, { is_published: !m.is_published });
            showAlert(m.is_published ? '비발행(임시저장)으로 전환되었습니다.' : '발행되었습니다. 원장 화면에 노출됩니다.', 'success');
            loadMaterials(currentPage);
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '처리 실패'), 'error');
        }
    }

    // ── 삭제 ──
    async function deleteMaterial(id) {
        const m = allMaterials.find(x => x.id === id);
        if (!m) return;
        if (!confirm('「' + m.title + '」 자료를 삭제할까요?\n업로드된 파일도 함께 삭제됩니다.')) return;
        try {
            await apiDelete('/headquarters/edu-materials/' + id);
            showAlert('삭제되었습니다.', 'success');
            loadMaterials(currentPage);
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '삭제 실패'), 'error');
        }
    }

    // ── 업로드 모달 ──
    function openUploadModal() {
        document.getElementById('uploadFile').value = '';
        document.getElementById('uploadTitle').value = '';
        document.getElementById('uploadDesc').value = '';
        document.getElementById('uploadCategory').value = '';
        document.getElementById('uploadPublished').value = 'false';
        setCategoryDatalist();
        openModal('uploadModal');
    }

    function autoFillTitle() {
        const f = document.getElementById('uploadFile');
        const t = document.getElementById('uploadTitle');
        if (f.files && f.files[0] && !t.value.trim()) {
            t.value = f.files[0].name.replace(/\.[^.]+$/, '');
        }
    }

    async function submitUpload() {
        const f = document.getElementById('uploadFile');
        if (!f.files || !f.files[0]) { showAlert('⚠️ 파일을 선택해주세요.', 'error'); return; }
        const title = document.getElementById('uploadTitle').value.trim();
        if (!title) { showAlert('⚠️ 제목을 입력해주세요.', 'error'); return; }
        const upCat = document.getElementById('uploadCategory').value.trim();
        if (!isValidSubject(upCat)) {
            showAlert(upCat ? '⚠️ 교육명(과목)은 과목 마스터에 등록된 과목(국어·수학·영어·과학·사회·코딩·메이커·AI 등) 중에서 선택해주세요. [⚙️ 과목 관리]에서 추가할 수 있습니다.' : '⚠️ 교육명(과목)을 선택해주세요.', 'error');
            return;
        }
        const btn = document.getElementById('btnUploadSubmit');
        btn.disabled = true;
        btn.textContent = '업로드 중...';
        try {
            const fd = new FormData();
            fd.append('file', f.files[0]);
            fd.append('title', title);
            fd.append('description', document.getElementById('uploadDesc').value.trim());
            fd.append('category', document.getElementById('uploadCategory').value.trim());
            fd.append('is_published', document.getElementById('uploadPublished').value === 'true');
            const token = localStorage.getItem('token') || localStorage.getItem('access_token');
            const res = await fetch('/api/v1/headquarters/edu-materials/upload', {
                method: 'POST',
                headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                body: fd
            });
            const text = await res.text();
            let json;
            try { json = JSON.parse(text); } catch (e) { throw new Error(text || '업로드 실패'); }
            if (!res.ok) throw new Error(json.message || json.detail || '업로드 실패');
            closeModal('uploadModal');
            showAlert('✅ 파일이 업로드되었습니다.', 'success');
            loadMaterials(1);
            loadCourses();
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '업로드 실패'), 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '업로드';
        }
    }

    // ── 링크 등록 ──
    function openLinkModal() {
        document.getElementById('linkUrl').value = '';
        document.getElementById('linkTitle').value = '';
        document.getElementById('linkDesc').value = '';
        document.getElementById('linkCategory').value = '';
        document.getElementById('linkPublished').value = 'false';
        setCategoryDatalist();
        openModal('linkModal');
    }

    async function submitLink() {
        const url = document.getElementById('linkUrl').value.trim();
        const title = document.getElementById('linkTitle').value.trim();
        if (!url) { showAlert('⚠️ URL을 입력해주세요.', 'error'); return; }
        if (!title) { showAlert('⚠️ 제목을 입력해주세요.', 'error'); return; }
        const linkCat = document.getElementById('linkCategory').value.trim();
        if (!isValidSubject(linkCat)) {
            showAlert(linkCat ? '⚠️ 교육명(과목)은 과목 마스터에 등록된 과목 중에서 선택해주세요.' : '⚠️ 교육명(과목)을 선택해주세요.', 'error');
            return;
        }
        try {
            await apiPost('/headquarters/edu-materials', {
                title: title,
                description: document.getElementById('linkDesc').value.trim(),
                category: document.getElementById('linkCategory').value.trim(),
                material_type: 'link',
                file_url: url,
                is_published: document.getElementById('linkPublished').value === 'true'
            });
            closeModal('linkModal');
            showAlert('✅ 링크 자료가 등록되었습니다.', 'success');
            loadMaterials(1);
            loadCourses();
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '등록 실패'), 'error');
        }
    }

    // ── 수정 ──
    function openEditModal(id) {
        const m = allMaterials.find(x => x.id === id);
        if (!m) return;
        document.getElementById('editId').value = m.id;
        document.getElementById('editType').value = m.material_type;
        document.getElementById('editTitle').value = m.title;
        document.getElementById('editDesc').value = m.description || '';
        document.getElementById('editCategory').value = m.category || '';
        setCategoryDatalist(m.category || '');
        document.getElementById('editPublished').value = m.is_published ? 'true' : 'false';
        const urlGroup = document.getElementById('editUrlGroup');
        const fi = document.getElementById('editFileInfo');
        if (m.material_type === 'link') {
            urlGroup.style.display = '';
            document.getElementById('editUrl').value = m.file_url || '';
            fi.textContent = '';
        } else {
            urlGroup.style.display = 'none';
            document.getElementById('editUrl').value = '';
            fi.textContent = m.file_url ? '📎 첨부 파일: ' + m.file_url.replace('/uploads/edu/', '') + (m.file_size ? ' (' + fmtSize(m.file_size) + ')' : '') : '첨부 파일 없음';
        }
        openModal('editModal');
    }

    async function submitEdit() {
        const id = document.getElementById('editId').value;
        const mtype = document.getElementById('editType').value;
        const title = document.getElementById('editTitle').value.trim();
        if (!title) { showAlert('⚠️ 제목을 입력해주세요.', 'error'); return; }
        const editCat = document.getElementById('editCategory').value.trim();
        const origCat = (allMaterials.find(x => x.id === Number(id)) || {}).category || '';
        if (!isValidSubject(editCat, origCat)) {
            showAlert(editCat ? '⚠️ 교육명(과목)은 과목 마스터에 등록된 과목 중에서 선택하거나 기존 값을 유지해주세요.' : '⚠️ 교육명(과목)을 선택해주세요.', 'error');
            return;
        }
        const payload = {
            title: title,
            description: document.getElementById('editDesc').value.trim(),
            category: editCat,
            is_published: document.getElementById('editPublished').value === 'true'
        };
        if (mtype === 'link') {
            const url = document.getElementById('editUrl').value.trim();
            if (!url) { showAlert('⚠️ URL을 입력해주세요.', 'error'); return; }
            payload.file_url = url;
        }
        try {
            await apiPut('/headquarters/edu-materials/' + id, payload);
            closeModal('editModal');
            showAlert('✅ 수정되었습니다.', 'success');
            loadMaterials(currentPage);
            loadCourses();
        } catch (e) {
            showAlert('⚠️ ' + (e.message || '수정 실패'), 'error');
        }
    }

    // ── 유틸 ──
    function fmtDate(iso) {
        if (!iso) return '-';
        const d = new Date(iso);
        if (isNaN(d.getTime())) return '-';
        const p = n => String(n).padStart(2, '0');
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function escHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    let searchTimer = null;
    function debounceSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => loadMaterials(1), 350);
    }

    function refreshCategoryOptions() {
        // 현재 페이지에서 보이는 레거시(마스터 외) 값도 필터/수정에 보존
        (allMaterials || []).forEach(m => {
            const c = (m.category || '').trim();
            if (c && !isMasterName(c) && _legacyCategoryValues.indexOf(c) < 0) _legacyCategoryValues.push(c);
        });
        renderCategoryFilter();
    }

    // ── 교육명(과목) 옵션/칩/검증 헬퍼 ──
    function subjectPillHtml(c) {
        if (!c) return '<span style="color:#d1d5db;">-</span>';
        const i = subjectMaster.findIndex(s => s.name === c);
        if (i >= 0) {
            const colors = SUBJECT_COLORS[i % SUBJECT_COLORS.length];
            return '<span class="subject-pill" style="background:' + colors[0] + ';color:' + colors[1] + ';">' + escHtml(c) + '</span>';
        }
        return '<span class="subject-pill" style="background:#F1F5F9;color:#6B7280;font-weight:500;">' + escHtml(c) + '</span>';
    }

    function isValidSubject(c, extra) {
        if (!c) return false;
        return isMasterName(c) || (extra && c === extra);
    }

    function setCategoryDatalist(extra) {
        const dl = document.getElementById('categoryList');
        if (!dl) return;
        const vals = subjectNames();
        if (extra && vals.indexOf(extra) < 0) vals.unshift(extra);
        dl.innerHTML = vals.map(v => '<option value="' + escHtml(v) + '">').join('');
    }

    function renderCategoryFilter() {
        const sel = document.getElementById('categoryFilter');
        if (!sel) return;
        const cur = sel.value;
        const masters = subjectNames();
        let html = '<option value="">전체 교육명</option>';
        if (masters.length) {
            html += '<optgroup label="과목">' + masters.map(c => '<option value="' + escHtml(c) + '">' + escHtml(c) + '</option>').join('') + '</optgroup>';
        }
        if (_legacyCategoryValues.length) {
            html += '<optgroup label="기존 등록분">' + _legacyCategoryValues.map(c => '<option value="' + escHtml(c) + '">' + escHtml(c) + '</option>').join('') + '</optgroup>';
        }
        sel.innerHTML = html;
        if (cur) {
            const ok = Array.prototype.some.call(sel.options, o => o.value === cur);
            if (ok) sel.value = cur;
        }
    }

    // 전체 자료(모든 페이지)를 훑어 레거시 교육명(과목) 값 수집 → 필터 옵션 유지
    async function collectAllCategories() {
        try {
            const seen = [];
            let page = 1, total = 1;
            while (seen.length < total && page <= 20) {
                const res = await apiGet('/headquarters/edu-materials?search=&category=&material_type=&page=' + page + '&page_size=200');
                const d = res.data || {};
                total = d.total || 0;
                (d.items || []).forEach(m => {
                    const c = (m.category || '').trim();
                    if (c && !isMasterName(c) && seen.indexOf(c) < 0) seen.push(c);
                });
                if (!(d.items || []).length) break;
                page += 1;
            }
            _legacyCategoryValues = seen.sort();
            renderCategoryFilter();
        } catch (e) { /* 필터 옵션은 현재 페이지 기준으로도 유지됨 */ }
    }

    async function syncCategoryOptions() {
        await collectAllCategories();
        renderCategoryFilter();
    }

    function renderPaginationUI() {
        const wrap = document.getElementById('paginationWrap');
        let html = '';
        html += (currentPage > 1) ? '<button onclick="loadMaterials(1)">«</button><button onclick="loadMaterials(' + (currentPage - 1) + ')">‹</button>' : '<button disabled>«</button><button disabled>‹</button>';
        const start = Math.max(1, currentPage - 2);
        const end = Math.min(totalPages, currentPage + 2);
        for (let i = start; i <= end; i++) {
            html += '<button class="' + (i === currentPage ? 'active' : '') + '" onclick="loadMaterials(' + i + ')">' + i + '</button>';
        }
        html += (currentPage < totalPages) ? '<button onclick="loadMaterials(' + (currentPage + 1) + ')">›</button><button onclick="loadMaterials(' + totalPages + ')">»</button>' : '<button disabled>›</button><button disabled>»</button>';
        wrap.innerHTML = html;
    }
</script>

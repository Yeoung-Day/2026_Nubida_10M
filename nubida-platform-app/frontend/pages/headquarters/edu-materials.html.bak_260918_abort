<div class="modal-overlay" id="uploadModal">
    <div class="modal" style="max-width:560px;">
        <div class="modal-header">
            <h3>📤 교육 자료 파일 업로드</h3>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">파일 선택 <span class="req">*</span></label>
                <input type="file" class="form-input" id="uploadFile" accept=".pdf,.ppt,.pptx,.mp4,.webm,.mov,.avi,.mkv,.jpg,.jpeg,.png,.gif,.webp,.svg,.doc,.docx,.hwp,.txt,.xlsx,.zip" onchange="autoFillTitle()">
                <div class="small-text" style="margin-top:4px;color:var(--text-tertiary);">PDF·PPT는 업로드 즉시 슬라이드 뷰어 변환이 자동 시작됩니다.</div>
            </div>
            <div class="form-group">
                <label class="form-label">제목 <span class="req">*</span></label>
                <input type="text" class="form-input" id="uploadTitle" placeholder="자료 제목">
            </div>
            <div class="form-group">
                <label class="form-label">설명</label>
                <textarea class="form-input" id="uploadDesc" rows="2" placeholder="간단한 설명 (선택)"></textarea>
            </div>
            <div class="form-row" style="display:flex;gap:12px;">
                <div class="form-group" style="flex:1;">
                    <label class="form-label">교육명(과목) <span class="req">*</span></label>
                    <input type="text" class="form-input" id="uploadCategory" list="categoryList" placeholder="과목 선택/검색 (국어·수학·영어 등)">
                </div>
                <div class="form-group" style="flex:0 0 150px;">
                    <label class="form-label">발행 상태</label>
                    <select class="form-input" id="uploadPublished">
                        <option value="true">발행</option>
                        <option value="false" selected>임시저장</option>
                    </select>
                </div>
            </div>
            <datalist id="categoryList"></datalist>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline btn-sm" onclick="closeModal('uploadModal')">취소</button>
            <button class="btn btn-primary btn-sm" id="btnUploadSubmit" onclick="submitUpload()">업로드</button>
        </div>

  <script>
  let currentPage = 1;
  let totalPages = 1;
  let searchTimer = null;
  let createUploadedImages = [];
  let currentView = 'grid'; // 'grid' or 'list'
  let courseMap = {}; // {id: name}

  // ===== Initialization =====
  document.addEventListener('DOMContentLoaded', function() {
    requireAuth();
    renderSidebarUser();
    document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});
    onAuthReady(function() {
      loadCourses();
      loadPortfolios();
    });
  });

  // ===== Load Courses for Filter =====
  async function loadCourses() {
    try {
      const res = await apiGet('/headquarters/courses');
      const data = res.data || res || [];
      const courses = Array.isArray(data) ? data : [];
      const sel = document.getElementById('courseFilter');
      courses.forEach(c => {
        courseMap[c.id] = c.name;
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        sel.appendChild(opt);
      });
    } catch(e) {}
  }

  // ===== Toast =====
  function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = 'toast ' + (type || 'info');
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function() {
      if (t.parentNode) t.parentNode.removeChild(t);
    }, 3000);
  }

  // ===== Search =====
  function debounceSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function() {
      currentPage = 1;
      loadPortfolios();
    }, 400);
  }

  // ===== Load Portfolios =====
  async function loadPortfolios() {
    const grid = document.getElementById('portGrid');
    const tableBody = document.getElementById('portTableBody');
    try {
      const params = { page: currentPage, per_page: 20 };
      const courseId = document.getElementById('courseFilter').value;
      const search = document.getElementById('searchInput').value.trim();
      const status = document.getElementById('statusFilter').value;
      if (courseId) params.course_id = courseId;
      if (search) params.search = search;
      if (status) params.status = status;

      const res = await apiGet('/portfolio?' + new URLSearchParams(params));
      const data = res.data || [];
      const total = res.total || 0;
      totalPages = Math.max(1, Math.ceil(total / 20));

      // Stats
      const published = data.filter(function(i) { return i.status === 'published'; }).length;
      const draft = data.filter(function(i) { return i.status === 'draft'; }).length;
      const uniqueStudents = new Set(data.map(function(i) { return i.student_id; })).size;
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statPublished').textContent = published;
      document.getElementById('statDraft').textContent = draft;
      document.getElementById('statStudents').textContent = uniqueStudents;
      document.getElementById('portfolioCount').textContent = '총 ' + total + '개';

      if (!data || data.length === 0) {
        var emptyHtml = '<div class="empty-state">'
          + '<div class="empty-icon">📁</div>'
          + '<h3>등록된 포트폴리오가 없습니다</h3>'
          + '<p>학생이 포트폴리오를 제출하면 여기에 표시됩니다</p></div>';
        grid.innerHTML = emptyHtml;
        tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-tertiary)">등록된 포트폴리오가 없습니다</td></tr>';
        renderPagination();
        return;
      }

      // Grid rendering
      grid.innerHTML = data.map(function(p) {
        var statusLabel = (p.status || 'draft');
        var statusBadge = '<span class="badge badge-' + statusLabel + '">' + statusLabel + '</span>';
        var thumbContent = p.file_type === 'video' ? '🎬' : p.file_type === 'image' ? '🖼' : '📄';
        var dateStr = p.created_at ? new Date(p.created_at).toLocaleDateString('ko-KR') : '';
        return '<div class="port-card">'
          + '<div class="port-thumb">' + thumbContent + '</div>'
          + '<div class="port-body">'
          + '<div class="port-title" title="' + (p.title || '제목 없음') + '">' + (p.title || '제목 없음') + '</div>'
          + '<div class="port-student">' + (p.student_name || '학생') + '</div>'
          + '<div class="port-meta">'
          + '<span>' + (p.subject || '일반') + '</span>'
          + '<span>' + (p.file_type || '문서') + '</span>'
          + (p.course_id && courseMap[p.course_id] ? '<span style="background:#EEF0FF;color:#4F5EF8;">' + courseMap[p.course_id] + '</span>' : '')
          + '</div>'
          + '<div class="port-date">' + dateStr + '</div>'
          + '</div>'
          + '<div class="port-footer">'
          + '<div>' + statusBadge + '</div>'
          + '<div class="port-actions">'
          + '<button class="btn btn-outline" style="padding:4px 10px;font-size:11px" onclick="viewPortfolio(' + p.id + ')">보기</button>'
          + '<button class="btn btn-outline" style="padding:4px 10px;font-size:11px" onclick="editPortfolio(' + p.id + ')">수정</button>'
          + '<button class="btn btn-danger" style="padding:4px 8px;font-size:11px" onclick="deletePortfolio(' + p.id + ')">삭제</button>'
          + '</div></div></div>';
      }).join('');

      // Table rendering
      tableBody.innerHTML = data.map(function(p) {
        var statusLabel = (p.status || 'draft');
        var statusBadge = '<span class="badge badge-' + statusLabel + '">' + statusLabel + '</span>';
        var dateStr = p.created_at ? new Date(p.created_at).toLocaleDateString('ko-KR') : '-';
        return '<tr>'
          + '<td>' + statusBadge + '</td>'
          + '<td><strong>' + (p.student_name || '학생') + '</strong></td>'
          + '<td><a href="javascript:void(0)" onclick="viewPortfolio(' + p.id + ')" style="color:var(--accent);text-decoration:none;font-weight:500">' + (p.title || '제목 없음') + '</a></td>'
          + '<td>' + (p.course_id && courseMap[p.course_id] || p.subject || '-') + '</td>'
          + '<td style="font-size:12px;color:var(--text-tertiary)">' + dateStr + '</td>'
          + '<td><div style="display:flex;gap:4px">'
          + '<button class="btn btn-sm btn-primary" onclick="viewPortfolio(' + p.id + ')">보기</button>'
          + '<button class="btn btn-sm btn-outline" onclick="editPortfolio(' + p.id + ')">수정</button>'
          + '<button class="btn btn-sm btn-danger" onclick="deletePortfolio(' + p.id + ')">삭제</button>'
          + '</div></td>'
          + '</tr>';
      }).join('');

      renderPagination();
    } catch (e) {
      grid.innerHTML = '<div class="empty-state">'
        + '<div class="empty-icon">⚠</div>'
        + '<h3>불러오기 실패</h3>'
        + '<p>' + (e.message || '') + '</p></div>';
      tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-tertiary)">불러오기 실패</td></tr>';
      showToast('데이터를 불러올 수 없습니다', 'error');
    }
  }

  // ===== View Switch =====
  function switchView(view) {
    currentView = view;
    document.getElementById('viewGrid').className = view === 'grid' ? 'active' : '';
    document.getElementById('viewList').className = view === 'list' ? 'active' : '';
    document.getElementById('portGrid').style.display = view === 'grid' ? 'grid' : 'none';
    document.getElementById('portTableWrapper').style.display = view === 'list' ? 'block' : 'none';
  }

  // ===== Pagination =====
  function renderPagination() {
    var el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    var html = '<button class="page-btn" onclick="goPage(1)" ' + (currentPage <= 1 ? 'disabled' : '') + '>«</button>';
    html += '<button class="page-btn" onclick="goPage(' + (currentPage - 1) + ')" ' + (currentPage <= 1 ? 'disabled' : '') + '>‹</button>';
    var start = Math.max(1, currentPage - 2);
    var end = Math.min(totalPages, currentPage + 2);
    for (var i = start; i <= end; i++) {
      html += '<button class="page-btn' + (i === currentPage ? ' active' : '') + '" onclick="goPage(' + i + ')">' + i + '</button>';
    }
    html += '<button class="page-btn" onclick="goPage(' + (currentPage + 1) + ')" ' + (currentPage >= totalPages ? 'disabled' : '') + '>›</button>';
    html += '<button class="page-btn" onclick="goPage(' + totalPages + ')" ' + (currentPage >= totalPages ? 'disabled' : '') + '>»</button>';
    el.innerHTML = html;
  }

  function goPage(page) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadPortfolios();
  }

  // ===== Modal Helpers =====
  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // ===== View Portfolio =====
  async function viewPortfolio(id) {
    document.getElementById('detailModal').style.display = 'flex';
    document.getElementById('detailBody').innerHTML = '<p style="text-align:center;padding:40px;color:var(--text-tertiary)">로딩 중...</p>';
    try {
      var res = await apiGet('/portfolio/' + id);
      var p = res.data || res;

      // 상태 배지
      var statusBadge = '<span class="badge badge-' + (p.status || 'draft') + '">' + (p.status || 'draft') + '</span>';

      // 이미지
      var imagesHtml = '';
      if (p.image_urls && p.image_urls.length > 0) {
        imagesHtml = '<div class="port-detail-images">';
        p.image_urls.forEach(function(url) {
          imagesHtml += '<div class="port-detail-img-wrap"><img src="' + url + '" onerror="this.parentElement.style.display=\'none\'"></div>';
        });
        imagesHtml += '</div>';
      }

      // 파일 링크
      var fileHtml = '';
      if (p.content_url) {
        var fileIcon = p.file_type === 'pdf' ? '📕' : p.file_type === 'video' ? '🎬' : '📎';
        fileHtml = '<a href="' + p.content_url + '" target="_blank" class="port-detail-file">' + fileIcon + ' 파일 보기</a>';
      }

      // 텍스트 내용
      var contentHtml = '';
      if (p.content) {
        contentHtml = '<div class="port-detail-content"><div class="port-detail-label">📝 내용</div><div class="port-detail-text">' + esc(p.content) + '</div></div>';
      }

      document.getElementById('detailBody').innerHTML =
        '<div class="port-detail-top">'
        + '<div class="port-detail-icon">📄</div>'
        + '<div class="port-detail-title">' + esc(p.title || '제목 없음') + '</div>'
        + '<div class="port-detail-meta">'
        + '<span>👤 ' + esc(p.student_name || '-') + '</span>'
        + '<span>📚 ' + esc(p.subject || '-') + '</span>'
        + statusBadge
        + '</div>'
        + '<div class="port-detail-date">' + (p.created_at ? new Date(p.created_at).toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric'}) : '-') + '</div>'
        + '</div>'
        + imagesHtml
        + fileHtml
        + (p.description ? '<div class="port-detail-content"><div class="port-detail-label">📋 설명</div><div class="port-detail-text">' + esc(p.description) + '</div></div>' : '')
        + contentHtml
        + '<div class="port-detail-actions"><button class="btn btn-filled" onclick="closeModal(\'detailModal\')">닫기</button></div>';
    } catch (e) {
      document.getElementById('detailBody').innerHTML = '<p style="text-align:center;padding:40px;color:var(--text-tertiary)">불러오기 실패: ' + (e.message || '') + '</p>';
    }
  }

  // ===== Create / Edit Portfolio =====
  function closeCreateModal() {
    document.getElementById('portfolioCreateModal').style.display = 'none';
    document.getElementById('createEditId').value = '';
    document.getElementById('createTitle').value = '';
    document.getElementById('createContent').value = '';
    document.getElementById('createSubject').value = '';
    document.getElementById('createFileType').value = 'image';
    document.getElementById('createFileUrl').value = '';
    document.getElementById('createDescription').value = '';
    document.getElementById('createPublic').checked = true;
    document.getElementById('createImageUrls').value = '[]';
    createUploadedImages = [];
    document.getElementById('createImagePreviewContainer').innerHTML = '';
  }

  function openAddPortfolioModal() {
    closeCreateModal();
    document.getElementById('createModalTitle').textContent = '새 포트폴리오';
    document.getElementById('portfolioCreateModal').style.display = 'flex';
  }

  async function editPortfolio(id) {
    closeCreateModal();
    try {
      var res = await apiGet('/portfolio/' + id);
      var p = res.data || res;
      document.getElementById('createModalTitle').textContent = '포트폴리오 수정';
      document.getElementById('createEditId').value = p.id;
      document.getElementById('createTitle').value = p.title || '';
      document.getElementById('createContent').value = p.content || '';
      document.getElementById('createSubject').value = p.subject || '';
      document.getElementById('createFileType').value = p.file_type || 'image';
      document.getElementById('createFileUrl').value = p.file_url || '';
      document.getElementById('createDescription').value = p.description || '';
      document.getElementById('createPublic').checked = p.is_public !== false;
      var images = p.image_urls || [];
      document.getElementById('createImageUrls').value = JSON.stringify(images);
      createUploadedImages = images.slice();
      renderCreateImagePreviews(createUploadedImages);
      document.getElementById('portfolioCreateModal').style.display = 'flex';
    } catch (e) {
      showToast('포트폴리오 정보를 불러올 수 없습니다: ' + (e.message || ''), 'error');
    }
  }

  async function saveCreatePortfolio() {
    var id = document.getElementById('createEditId').value;
    var title = document.getElementById('createTitle').value.trim();
    var content = document.getElementById('createContent').value.trim();
    var subject = document.getElementById('createSubject').value;
    var file_type = document.getElementById('createFileType').value;
    var file_url = document.getElementById('createFileUrl').value.trim();
    var description = document.getElementById('createDescription').value.trim();
    var is_public = document.getElementById('createPublic').checked;
    var imageUrls = document.getElementById('createImageUrls').value;

    if (!title) { showToast('제목을 입력하세요', 'error'); return; }

    var payload = {
      title: title,
      content: content,
      subject: subject,
      file_type: file_type,
      file_url: file_url,
      description: description,
      is_public: is_public,
      image_urls: JSON.parse(imageUrls || '[]')
    };

    try {
      if (id) {
        await apiPut('/portfolio/' + id, payload);
        showToast('포트폴리오가 수정되었습니다', 'success');
      } else {
        await apiPost('/portfolio', payload);
        showToast('포트폴리오가 생성되었습니다', 'success');
      }
      closeCreateModal();
      loadPortfolios();
    } catch (e) {
      showToast('저장 실패: ' + (e.message || ''), 'error');
    }
  }

  async function deletePortfolio(id) {
    if (!confirm('정말 삭제하시겠습니까?')) return;
    try {
      await apiDelete('/portfolio/' + id);
      showToast('포트폴리오가 삭제되었습니다', 'success');
      loadPortfolios();
    } catch (e) {
      showToast('삭제 실패: ' + (e.message || ''), 'error');
    }
  }

  // ===== Image Upload Functions =====
  function renderCreateImagePreviews(urls) {
    var container = document.getElementById('createImagePreviewContainer');
    if (!urls || urls.length === 0) { container.innerHTML = ''; return; }
    container.innerHTML = urls.map(function(url, i) {
      return '<div class="preview-item">'
        + '<img src="' + url + '" class="preview-thumb">'
        + '<button class="preview-remove" onclick="removeCreateImage(' + i + ')" title="삭제">×</button>'
        + '</div>';
    }).join('');
  }

  function removeCreateImage(index) {
    createUploadedImages.splice(index, 1);
    document.getElementById('createImageUrls').value = JSON.stringify(createUploadedImages);
    renderCreateImagePreviews(createUploadedImages);
  }

  async function uploadCreateFiles(files) {
    if (!files || files.length === 0) return;
    for (var i = 0; i < files.length; i++) {
      var formData = new FormData();
      formData.append('file', files[i]);
      try {
        var token = localStorage.getItem('token') || localStorage.getItem('access_token');
        var res = await fetch('/api/v1/portfolio/upload', {
          method: 'POST',
          headers: token ? { 'Authorization': 'Bearer ' + token } : {},
          body: formData
        });
        var text = await res.text();
        var json;
        try { json = JSON.parse(text); } catch (e) { throw new Error(text || '업로드 실패'); }
        if (!res.ok) throw new Error(json.message || json.detail || '업로드 실패');
        var fileUrl = json.data && json.data.url ? json.data.url : (typeof json.data === 'string' ? json.data : null);
        if (fileUrl) {
          createUploadedImages.push(fileUrl);
          document.getElementById('createImageUrls').value = JSON.stringify(createUploadedImages);
          renderCreateImagePreviews(createUploadedImages);
        }
      } catch (e) {
        showToast('파일 업로드 실패: ' + (e.message || ''), 'error');
      }
    }
  }

  // ===== Course → Template 연동 =====
  function onCourseChange() {
    const courseId = document.getElementById('createCourse').value;
    const tmplSel = document.getElementById('createTemplate');
    tmplSel.innerHTML = '<option value="">양식 선택</option>';
    if (!courseId) return;
    apiGet('/portfolio-templates?course_id=' + courseId + '&per_page=50').then(function(res) {
      const data = res.data || {};
      const tmpls = data.templates || [];
      tmpls.forEach(function(t) {
        var opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = t.title + ' (' + (t.form_fields || []).length + '개 항목)';
        tmplSel.appendChild(opt);
      });
    }).catch(function() {});
  }

  // openAddPortfolioModal에 강좌 옵션 채우기
  var _origOpenAdd = openAddPortfolioModal;
  openAddPortfolioModal = function() {
    _origOpenAdd();
    var sel = document.getElementById('createCourse');
    sel.innerHTML = '<option value="">선택 안함</option>';
    Object.keys(courseMap).forEach(function(id) {
      var opt = document.createElement('option');
      opt.value = id;
      opt.textContent = courseMap[id];
      sel.appendChild(opt);
    });
    document.getElementById('createTemplate').innerHTML = '<option value="">양식 선택</option>';
  };

  // saveCreatePortfolio에 course_id, template_id 포함
  var _origSave = saveCreatePortfolio;
  saveCreatePortfolio = function() {
    var courseId = document.getElementById('createCourse').value;
    var templateId = document.getElementById('createTemplate').value;
    // 기존 payload 생성 전에 필드 값을 변수에 저장
    var _origPayload = null;
    var id = document.getElementById('createEditId').value;
    var title = document.getElementById('createTitle').value.trim();
    var content = document.getElementById('createContent').value.trim();
    var subject = document.getElementById('createSubject').value;
    var file_type = document.getElementById('createFileType').value;
    var file_url = document.getElementById('createFileUrl').value.trim();
    var description = document.getElementById('createDescription').value.trim();
    var is_public = document.getElementById('createPublic').checked;
    var imageUrls = document.getElementById('createImageUrls').value;

    if (!title) { showToast('제목을 입력하세요', 'error'); return; }

    var payload = {
      title: title,
      content: content,
      subject: subject,
      file_type: file_type,
      file_url: file_url,
      description: description,
      is_public: is_public,
      image_urls: JSON.parse(imageUrls || '[]'),
      course_id: courseId ? parseInt(courseId) : null,
      template_id: templateId ? parseInt(templateId) : null,
    };

    (async function() {
      try {
        if (id) {
          await apiPut('/portfolio/' + id, payload);
          showToast('포트폴리오가 수정되었습니다', 'success');
        } else {
          await apiPost('/portfolio', payload);
          showToast('포트폴리오가 생성되었습니다', 'success');
        }
        closeCreateModal();
        loadPortfolios();
      } catch (e) {
        showToast('저장 실패: ' + (e.message || ''), 'error');
      }
    })();
  };
  </script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    requireAuth();
    renderSidebarUser();
    document.getElementById('todayDate').textContent = new Date().toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric',weekday:'long'});
    loadDashboardStats();
});

function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = 'toast ' + (type || 'info');
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { if(t.parentNode) t.parentNode.removeChild(t); }, 3000);
}

async function loadDashboardStats() {
    try {
        const res = await apiGet('/headquarters/branches?per_page=1');
        document.getElementById('statBranches').textContent = (Number(res.total || 0)).toLocaleString();
    } catch(e) {}
    try {
        const res = await apiGet('/headquarters/contracts?per_page=1');
        document.getElementById('statContracts').textContent = (Number(res.total || 0)).toLocaleString();
    } catch(e) {}
    try {
        const res = await apiGet('/headquarters/contracts?status=active&per_page=100');
        const now = new Date();
        const expiring = (res.data || []).filter(c => {
            const end = new Date(c.end_date || '');
            if (isNaN(end.getTime())) return false;
            const diff = (end - now) / (1000 * 60 * 60 * 24);
            return diff >= 0 && diff <= 30;
        });
        document.getElementById('statExpiringContracts').textContent = expiring.length.toLocaleString();
    } catch(e) {}
    try {
        const res = await apiGet('/headquarters/directors/list?per_page=1');
        const data = res.data || [];
        document.getElementById('statDirectors').textContent = (data.length || res.pagination?.total || 0).toLocaleString();
    } catch(e) {}
    try {
        const res = await apiGet('/headquarters/branches?per_page=100');
        const branches = res.data || [];
        document.getElementById('statAcademies').textContent = branches.filter(b => b.status === 'active').length.toLocaleString();
        document.getElementById('statInactiveDirectors').textContent = branches.filter(b => b.status === 'inactive' || b.status === 'pending').length.toLocaleString();
    } catch(e) {}
    try {
        const res = await apiGet('/headquarters/payments/consolidated?status=pending&per_page=1').catch(() => ({}));
        const paymentData = res?.data || res || {};
        document.getElementById('statPendingPayments').textContent = (Number(paymentData.total_count || paymentData.total || 0)).toLocaleString();
    } catch(e) {}
    try {
        const [txnRes] = await Promise.all([
            apiGet('/headquarters/point-transactions?per_page=100').catch(() => ({data:[]}))
        ]);
        const txns = txnRes.data || [];
        document.getElementById('statPointStudents').textContent = new Set(txns.map(t => t.user_id)).size.toLocaleString();
    } catch(e) {}
}
</script>

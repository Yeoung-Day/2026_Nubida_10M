   <script>
   // 역할 라벨 매핑
   const roleLabels = {
   'branch_admin': { label: '에듀케어', cls: 'branch_admin' },
   'branch_manager': { label: '에듀케어', cls: 'branch_manager' },
   'director': { label: '원장', cls: 'director' },
   'student': { label: '학생', cls: 'student' },
   'parent': { label: '학부모', cls: 'parent' },
   };

   const roleIcons = {
   'branch_admin': '🏢',
   'branch_manager': '👥',
   'director': '👨‍🏫',
   'student': '👦',
   'parent': '👨‍👩‍👧',
   };

   // formatDateTime 함수 추가
   function formatDateTime(str) {
   if (!str) return '-';
   try {
   const d = new Date(str);
   if (isNaN(d.getTime())) return str;
   return d.toLocaleDateString('ko-KR', { year:'numeric', month:'2-digit', day:'2-digit' }) + ' ' +
   d.toLocaleTimeString('ko-KR', { hour:'2-digit', minute:'2-digit' });
   } catch(e) {
   return str;
   }
   }

   // esc 함수 추가 (XSS 방지)
   function esc(s) {
   if (typeof s !== 'string') s = String(s || '');
   return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
   }

   // 소속배지(9/8): 승인 대기 카드 — director=[가입 학원명], 에듀케어=[가입 지역 or 에듀케어명]
   function affilTag(u) {
   if (!u) return '';
   let aff = '';
   if (u.role === 'director') aff = u.branch_name || u.region || '';
   else if (['branch_admin', 'branch_manager', 'branch_staff'].includes(u.role)) aff = u.region || u.branch_name || '';
   if (!aff) return '';
   return '<span style="font-size:11px;font-weight:600;padding:1px 7px;border-radius:5px;background:#F3E5F5;color:#6A1B9A;margin-left:4px;white-space:nowrap;vertical-align:1px">[' + esc(aff) + ']</span>';
   }

   async function loadPendingUsers() {
   try {
   document.getElementById('loadingIndicator').style.display = 'block';
   document.getElementById('emptyState').style.display = 'none';
   document.getElementById('errorState').style.display = 'none';
   document.getElementById('pendingList').innerHTML = '';

   const res = await apiGet('/headquarters/pending-users');
   const users = res.data || [];

   document.getElementById('loadingIndicator').style.display = 'none';
   document.getElementById('pendingCount').textContent = users.length;

   if (users.length === 0) {
   document.getElementById('emptyState').style.display = 'block';
   return;
   }

   const list = document.getElementById('pendingList');
   list.innerHTML = '';

   users.forEach(u => {
   const roleInfo = roleLabels[u.role] || { label: u.role, cls: '' };
   const icon = roleIcons[u.role] || '👤';
   const createdDate = formatDateTime(u.created_at);

   const card = document.createElement('div');
   card.className = 'approval-card animate-fade-up';
   card.id = `user-card-${u.id}`;
   card.innerHTML = `
   <div class="user-info">
   <div class="name">${esc(u.name)}${affilTag(u)}</div>
   <div class="meta">
   <span>🆔 ${esc(u.username)}</span>
   <span>📧 ${esc(u.email)}</span>
   <span>📞 ${esc(u.phone || '-')}</span>
   <span><span class="role-badge-sm ${roleInfo.cls}">${icon} ${roleInfo.label}</span></span>
   <span>📅 ${createdDate}</span>
   </div>
   </div>
   <div class="actions">
   <button class="btn btn-approve btn-sm" onclick="approveUser(${u.id})">✅ 승인</button>
   <button class="btn btn-reject btn-sm" onclick="rejectUser(${u.id})">❌ 거절</button>
   </div>
   `;
   list.appendChild(card);
   });
   } catch (err) {
   document.getElementById('loadingIndicator').style.display = 'none';
   const errEl = document.getElementById('errorState');
   if (errEl) {
     errEl.textContent = '❌ ' + (err.message || '목록을 불러오는데 실패했습니다.');
     errEl.style.display = 'flex';
   }
   }
   }

   async function approveUser(userId) {
   if (!confirm('이 계정을 승인하시겠습니까?')) return;

   try {
   const btn = event?.target?.closest?.('button') || document.querySelector(`#user-card-${userId} .btn-approve`);
   if (btn) { btn.disabled = true; btn.textContent = '⏳ 처리 중...'; }

   const res = await apiPost(`/headquarters/users/${userId}/approve`);
   showAlert(res.message || '승인 완료', 'success');

   // 카드 애니메이션 제거
   const card = document.getElementById(`user-card-${userId}`);
   if (card) {
   card.style.transition = 'all 0.3s ease';
   card.style.opacity = '0';
   card.style.transform = 'translateX(30px)';
   setTimeout(() => card.remove(), 300);
   }
   setTimeout(loadPendingUsers, 400);
   } catch (err) {
   showAlert('승인 실패: ' + (err.message || '오류'), 'error');
   }
   }

   async function rejectUser(userId) {
   if (!confirm('⚠️ 정말 이 가입 신청을 거절하시겠습니까? 이 작업은 되돌릴 수 없습니다.')) return;

   try {
   const btn = event?.target?.closest?.('button') || document.querySelector(`#user-card-${userId} .btn-reject`);
   if (btn) { btn.disabled = true; btn.textContent = '⏳ 처리 중...'; }

   const res = await apiDelete(`/headquarters/users/${userId}/reject`);
   showAlert(res.message || '거절 완료', 'success');

   const card = document.getElementById(`user-card-${userId}`);
   if (card) {
   card.style.transition = 'all 0.3s ease';
   card.style.opacity = '0';
   card.style.transform = 'translateX(30px)';
   setTimeout(() => card.remove(), 300);
   }
   setTimeout(loadPendingUsers, 400);
   } catch (err) {
   showAlert('거절 실패: ' + (err.message || '오류'), 'error');
   }
   }

   document.addEventListener('DOMContentLoaded', () => {
   const user = getCurrentUser();
   if (user) {
   document.getElementById('sidebarUserName').textContent = user.name || user.username || '관리자';
   document.getElementById('sidebarUserRole').textContent = '본사';
   }
   loadPendingUsers();
   });
   </script>

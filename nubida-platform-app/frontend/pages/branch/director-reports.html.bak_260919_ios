    <script>let allReports = [];
    let currentPage = 1;
    let totalPages = 1;
    let directorReports = [];
    document.addEventListener('DOMContentLoaded', () => {
        requireAuth();
        renderSidebarUser();
        const now = new Date();
        document.getElementById('todayDate').textContent = now.toLocaleDateString('ko-KR', { year:'numeric', month:'long', day:'numeric', weekday:'long' });
        // Fill year options
        const yearSelect = document.getElementById('filterYear');
        const formYearSelect = document.getElementById('formYear');
        const dYearSelect = document.getElementById('dFilterYear');
        for (let y = now.getFullYear(); y >= 2024; y--) {
            const opt1 = document.createElement('option');
            opt1.value = y; opt1.textContent = y + '년';
            yearSelect.appendChild(opt1);
            if (dYearSelect) dYearSelect.appendChild(opt1.cloneNode(true));
            if (formYearSelect) {
                const opt2 = document.createElement('option');
                opt2.value = y; opt2.textContent = y + '년';
                formYearSelect.appendChild(opt2);
            }
        }
        // 수신함 기본 필터: 전체 (미확인 건이 바로 보이도록)
        if (dYearSelect) dYearSelect.value = now.getFullYear();
        // Default to current year, month: 전체
        document.getElementById('filterYear').value = '';
        document.getElementById('filterMonth').value = '';
        loadReports();
        loadDirectorReports();
        // % 항목 자동 계산 바인딩
        bindAutoCalcBranch();
    });
    function getStatusBadge(status) {
        if (status === 'draft') return '<span class="badge badge-warning">임시 저장</span>';
        if (status === 'submitted') return '<span class="badge badge-success">제출 완료</span>';
        if (status === 'confirmed_by_branch') return '<span class="badge badge-primary" style="background:#EEF2FF;color:#4F5EF8;border:1px solid #C7D2FE;">에듀케어 확인</span>';
        return '<span class="badge">' + (status || '-') + '</span>';
    }
    async function loadDirectorReports() {
        const container = document.getElementById('directorReportContainer');
        const countEl = document.getElementById('directorReportCount');
        if (container) container.innerHTML = '<div style="text-align:center;padding:24px"><div class="loading-spinner" style="margin:10px auto"></div>불러오는 중...</div>';
        try {
            const year = (document.getElementById('dFilterYear') || {}).value || '';
            const month = (document.getElementById('dFilterMonth') || {}).value || '';
            let url = '/branch/director-reports?per_page=200';
            if (year) url += '&year=' + year;
            if (month) url += '&month=' + month;
            const res = await apiGet(url);
            directorReports = res?.data || [];
            if (countEl) countEl.textContent = '(총 ' + directorReports.length + '건)';
            if (!directorReports.length) {
                renderDirectorStats();
                container.innerHTML = '<div class="empty-state"><div class="icon"></div><p>수신한 원장 보고서가 없습니다.</p></div>';
                return;
            }
            renderDirectorReports();
        } catch (e) {
            if (container) container.innerHTML = '<div class="empty-state"><div class="icon"></div><p>불러오기 실패</p></div>';
        }
    }
    async function confirmDirectorReport(reportId) {
        if (!confirm('이 보고서를 확인하시겠습니까? 확인 후 상태가 "에듀케어 확인"으로 변경됩니다.')) return;
        try {
            const res = await apiPut('/branch/director-reports/' + reportId + '/confirm');
            if (res && res.status === 'success') {
                showAlert(' 보고서가 확인되었습니다.', 'success');
                loadDirectorReports();
            } else {
                showAlert(res?.message || '확인 처리 실패', 'error');
            }
        } catch (e) {
            showAlert('확인 중 오류가 발생했습니다: ' + e.message, 'error');
        }
    }
    async function openDirectorDetail(reportId) {
        selectedReportId = reportId;
        const panelCard = document.getElementById('detailPanelCard');
        const panelBody = document.getElementById('detailPanelBody');
        const panelSub = document.getElementById('detailPanelSub');
        // 목록에서 선택 상태 반영
        if (typeof renderDirectorReports === 'function') renderDirectorReports();
        if (panelBody) panelBody.innerHTML = '<div style="text-align:center;padding:20px"><div class="loading-spinner" style="margin:10px auto"></div>불러오는 중...</div>';
        if (panelCard) panelCard.style.display = '';
        try {
            const res = await apiGet('/branch/director-reports/' + reportId);
            if (!res || res.status !== 'success' || !res.data) {
                showAlert('보고서를 불러올 수 없습니다.', 'error');
                if (panelCard) panelCard.style.display = 'none';
                return;
            }
            const r = res.data;
            if (panelSub) panelSub.textContent = '(총 ' + r.year + '년 ' + r.month + '월)';
            // -------- 인라인 확인 패널 --------
            if (panelBody) {
                let p = '<div class="ec-panel-head">' +
                    '<span class="ec-panel-name">' + esc(r.director_name || '원장') + ' <span class="rc-sep">·</span> ' + r.year + '년 ' + r.month + '월</span>' +
                    getStatusBadge(r.status) +
                    '<span class="ec-panel-actions">' +
                    '<button class="btn btn-outline btn-xs" onclick="scrollToDetailPanelClose()">접기</button>' +
                    (r.status === 'submitted' ? '<button class="btn btn-primary btn-xs" onclick="confirmDirectorReport(' + r.id + ')">확인 처리</button>' : '') +
                    '</span>' +
                    '</div>';
                p += '<div class="section-block"><h4>기본 정보</h4><table class="detail-table">' +
                    '<tr><td>공부방명</td><td>' + esc(r.branch_name || '-') + '</td></tr>' +

<style id="rev-design">
/* ── 매출관리 전용 디자인 ───────────────────────────── */
.rev-wrap{display:flex;flex-direction:column;gap:20px}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:2px}
.sec-title{font-size:15px;font-weight:650;color:#1F2437;letter-spacing:-.01em}
.sec-desc{font-size:12.5px;color:#98A1B2;margin-top:3px;letter-spacing:-.005em}
.rev-card{background:#fff;border:1px solid #E8ECF5;border-radius:16px;box-shadow:0 1px 2px rgba(16,24,40,.04),0 8px 24px -12px rgba(16,24,40,.08);overflow:hidden}
.rev-card-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 20px;border-bottom:1px solid #F1F4FA}
.rev-card-hd h3{font-size:14px;font-weight:650;color:#1F2437;letter-spacing:-.01em}
.rev-card-hd .sub{font-size:12px;color:#98A1B2;margin-top:3px;letter-spacing:-.005em}
.rev-card-bd{padding:0}

/* 통계 카드 */
.rev-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:1100px){.rev-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.rev-stats{grid-template-columns:1fr}}
.rev-stat{background:#fff;border:1px solid #E8ECF5;border-radius:16px;padding:18px 18px 16px;box-shadow:0 1px 2px rgba(16,24,40,.04);position:relative;overflow:hidden}
.rev-stat .badge-ic{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.rev-stat .badge-ic svg{width:17px;height:17px}
.rev-stat .lb{font-size:12px;color:#98A1B2;letter-spacing:.01em;display:flex;align-items:center;gap:5px}
.rev-stat .vl{font-size:22px;font-weight:680;color:#1F2437;margin-top:5px;font-variant-numeric:tabular-nums;letter-spacing:-.02em;line-height:1.2}
.rev-stat .vl.sm{font-size:17px}
.rev-stat .cap{font-size:11.5px;color:#AEB6C6;margin-top:5px;font-variant-numeric:tabular-nums}
.ic-blue{background:#EEF0FE}.ic-blue svg{stroke:#4F5EF8}
.ic-green{background:#E9F7F0}.ic-green svg{stroke:#0E9F6E}
.ic-amber{background:#FEF4E6}.ic-amber svg{stroke:#D97706}
.ic-slate{background:#F1F3F8}.ic-slate svg{stroke:#5A6478}
.gear-btn{background:none;border:0;padding:0;cursor:pointer;color:#B4BCCC;display:inline-flex;align-items:center;transition:color .15s,transform .15s}
.gear-btn:hover{color:#4F5EF8;transform:rotate(45deg)}
.gear-btn svg{width:13px;height:13px}

/* 요약 스트립 */
.rev-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#E8ECF5;border-radius:16px;overflow:hidden;border:1px solid #E8ECF5}
@media(max-width:760px){.rev-strip{grid-template-columns:1fr}}
.rev-strip>div{background:#fff;padding:16px 20px}
.rev-strip .k{font-size:11.5px;color:#98A1B2;letter-spacing:.02em;text-transform:uppercase;font-weight:600}
.rev-strip .v{font-size:19px;font-weight:680;color:#1F2437;margin-top:6px;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.rev-strip .v.p{color:#4F5EF8}
.rev-strip .v.g{color:#0E9F6E}

/* 계좌 정보 */
.acct-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#F1F4FA}
@media(max-width:760px){.acct-grid{grid-template-columns:1fr}}
.acct-item{background:#fff;padding:16px 20px}
.acct-item .k{font-size:11.5px;color:#98A1B2;letter-spacing:.02em;text-transform:uppercase;font-weight:600}
.acct-item .v{font-size:14.5px;font-weight:620;color:#1F2437;margin-top:6px;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.acct-empty{padding:26px 20px;text-align:center;color:#98A1B2;font-size:13px}
.acct-empty a{color:#4F5EF8;font-weight:600;text-decoration:none}
.acct-empty a:hover{text-decoration:underline}

/* 테이블 */
.rev-tbl{width:100%;border-collapse:collapse;font-size:13.5px}
.rev-tbl thead th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#98A1B2;font-weight:640;text-align:left;padding:12px 16px;background:#FBFCFE;border-bottom:1px solid #E8ECF5;white-space:nowrap}
.rev-tbl tbody td{padding:13px 16px;border-bottom:1px solid #F3F6FB;color:#1F2437;vertical-align:middle}
.rev-tbl tbody tr:last-child td{border-bottom:0}
.rev-tbl tbody tr:hover{background:#FBFCFE}
.rev-tbl .num-cell{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.rev-tbl .num-cell.profit{color:#4F5EF8;font-weight:640}
.rev-tbl .num-cell.muted{color:#7A8496}
.rev-tbl .strong{font-weight:620}
.rev-tbl .empty-cell{text-align:center;color:#98A1B2;padding:38px 16px}
.sub-note{display:block;font-size:11px;color:#AEB6C6;margin-top:3px;font-variant-numeric:tabular-nums}
.tbl-scroll{overflow-x:auto}

/* pill */
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11.5px;font-weight:620;letter-spacing:-.005em;white-space:nowrap}
.pill i.dot{width:6px;height:6px;border-radius:50%;flex:none}
.pill-ok{background:#E9F7F0;color:#0B7A55}.pill-ok i.dot{background:#0E9F6E}
.pill-wait{background:#FEF4E6;color:#B45309}.pill-wait i.dot{background:#F59E0B}
.pill-part{background:#EEF0FE;color:#3B49D6}.pill-part i.dot{background:#4F5EF8}

/* 필터 셀렉트 */
.rev-sel{appearance:none;border:1px solid #E8ECF5;background:#fff url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2398A1B2' stroke-width='2.5' stroke-linecap='round'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E") no-repeat right 10px center/13px;border-radius:10px;padding:8px 30px 8px 12px;font-size:13px;color:#1F2437;font-weight:560;cursor:pointer;transition:border-color .15s}
.rev-sel:hover{border-color:#D5DCEA}
.rev-sel:focus{outline:none;border-color:#4F5EF8;box-shadow:0 0 0 3px rgba(79,94,248,.1)}
@media(max-width:900px){.rev-tbl{font-size:12.5px}.rev-tbl thead th,.rev-tbl tbody td{padding:10px 12px}}
</style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            requireAuth();
            renderSidebarUser();
            loadRevenue();
            setupEditRevenueForm();
            setupProfitRateForm();
        });

        function openProfitRateModal() {
            // 현재 정산 비율(본사 설정값)을 불러와 시뮬레이션 시작점으로 사용
            apiGet('/branch/settings').then(r => {
                const data = r.data || {};
                document.getElementById('hqRoyaltyRateInput').value = data.hq_royalty_rate ?? 45;
                document.getElementById('profitRateInput').value = data.profit_rate ?? 7;
                document.getElementById('incomeTaxRateInput').value = data.income_tax_rate ?? 3.3;
                updateProfitPreview();
                openModal('profitRateModal');
            }).catch(() => {
                document.getElementById('hqRoyaltyRateInput').value = 45;
                document.getElementById('profitRateInput').value = 7;
                document.getElementById('incomeTaxRateInput').value = 3.3;
                updateProfitPreview();
                openModal('profitRateModal');
            });
        }

        function updateProfitPreview() {
            const hq = parseFloat(document.getElementById('hqRoyaltyRateInput')?.value) || 0;
            const pt = parseFloat(document.getElementById('profitRateInput')?.value) || 0;
            const it = parseFloat(document.getElementById('incomeTaxRateInput')?.value) || 0;
            const VIA = 1.1;                 // 부가세 10% 제외
            const sample = 1000000;          // 매출 100만원 기준
            const taxBase = sample / VIA;
            const profit = taxBase * pt / 100;
            const incomeTax = profit * it / 100;     // 사업소득세 (원천징수)
            const netDeposit = profit - incomeTax;   // 본사 → 에듀케어 입금액
            const won = v => Math.round(v).toLocaleString('ko-KR') + '원';
            const set = (id, t) => { const e = document.getElementById(id); if (e) e.textContent = t; };
            set('pvTaxBase', won(taxBase));
            set('pvRoyaltyLabel', `본사 로열티 ${hq}%`);
            set('pvRoyalty', won(taxBase * hq / 100));
            set('pvDirectorLabel', `원장 수익 ${(100 - hq).toFixed(0)}%`);
            set('pvDirector', won(taxBase * (100 - hq) / 100));
            set('pvProfitLabel', `에듀케어 순수익 ${pt}%`);
            set('pvProfit', won(profit));
            set('pvIncomeTaxLabel', `순수익 공제 ${it}%`);
            set('pvIncomeTax', '-' + won(incomeTax));
            set('pvNetDeposit', won(netDeposit));
        }

        function setupProfitRateForm() {
            // ⚠️ 정산 비율은 본사가 주관한다. 이 화면은 시뮬레이션 전용이며 저장하지 않는다.
            const hqInput = document.getElementById('hqRoyaltyRateInput');
            const ptInput = document.getElementById('profitRateInput');
            const itInput = document.getElementById('incomeTaxRateInput');
            if (hqInput) hqInput.addEventListener('input', updateProfitPreview);
            if (ptInput) ptInput.addEventListener('input', updateProfitPreview);
            if (itInput) itInput.addEventListener('input', updateProfitPreview);
            // 저장 요청이 들어와도 차단 (폼 onsubmit=return false + 아래 가드)
            const form = document.getElementById('profitRateForm');
            if (form) form.onsubmit = (e) => { e.preventDefault(); return false; };
        }
    </script>
    

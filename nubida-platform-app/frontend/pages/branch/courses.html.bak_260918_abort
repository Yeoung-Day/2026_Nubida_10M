    <script>
        document.addEventListener('DOMContentLoaded', () => {
            requireAuth();
            renderSidebarUser();
        });
        /* ---- 강좌 관리 헬퍼 ---- */
        function filterCourses(category) {
            document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            const btn = document.querySelector(`.tab-item[data-category="${category}"]`);
            if (btn) btn.classList.add('active');
            // Re-trigger loadCourses — in a real impl we'd pass category param
            loadCourses();
        }
        function toggleAllCourseCheckboxes(master) {
            document.querySelectorAll('#courseBody input[type="checkbox"]').forEach(cb => cb.checked = master.checked);
        }
        function confirmDeleteCourse() {
            const id = document.getElementById('deleteCourseId')?.value;
            if (!id) return;
            deleteCourse(parseInt(id));
            closeModal('deleteCourseModal');
        }
        // ============================================================
        // 아두이노 코딩 에디터 열기
        // ============================================================
        function openArduinoCode(courseId, courseName) {
            window.location.href = 'arduino-editor.html?course_id=' + courseId + '&title=' + encodeURIComponent(courseName || '');
        }
    </script>
    

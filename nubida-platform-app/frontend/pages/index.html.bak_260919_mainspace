    <script>
    // ══ 메인페이지 공지사항 (로그인 불필요 — 공개 API) ══
    (function() {
        var _notices = [];

        function esc(s) {
            if (s == null) return '';
            var d = document.createElement('div');
            d.textContent = String(s);
            return d.innerHTML;
        }

        function fmtDate(d) {
            if (!d) return '';
            try {
                var dt = new Date(String(d).replace(' ', 'T'));
                if (isNaN(dt.getTime())) return String(d).substring(0, 10);
                return dt.getFullYear() + '.' + String(dt.getMonth() + 1).padStart(2, '0') + '.' + String(dt.getDate()).padStart(2, '0');
            } catch (e) { return String(d).substring(0, 10); }
        }

        function firstImage(images) {
            if (!images) return null;
            try {
                var a = (typeof images === 'string') ? JSON.parse(images) : images;
                if (Array.isArray(a) && a.length) return a[0];
            } catch (e) {}
            return null;
        }

        function render(list) {
            var section = document.getElementById('noticesPublic');
            var wrap = document.getElementById('noticesPublicList');
            if (!section || !wrap) return;
            if (!list || !list.length) {
                section.style.display = 'none';
                return;
            }
            _notices = list;
            var html = '';
            list.forEach(function(n, i) {
                var img = firstImage(n.images);
                html += '<a class="notice-item' + (n.is_pinned ? ' pinned' : '') + '" href="javascript:void(0)" data-idx="' + i + '">';
                html += '<div class="notice-item-body">';
                html += '<div class="notice-item-top">';
                if (n.is_pinned) html += '<span class="notice-pin">공지</span>';
                html += '<span class="notice-date">' + esc(fmtDate(n.created_at)) + '</span>';
                html += '</div>';
                html += '<h3 class="notice-item-title">' + esc(n.title || '') + '</h3>';
                var desc = String(n.content || '').replace(/\s+/g, ' ').trim();
                if (desc) html += '<p class="notice-item-desc">' + esc(desc) + '</p>';
                html += '</div>';
                if (img) html += '<div class="notice-item-thumb"><img src="' + esc(img) + '" alt="" loading="lazy"></div>';
                html += '</a>';
            });
            wrap.innerHTML = html;

            wrap.querySelectorAll('.notice-item').forEach(function(el) {
                el.addEventListener('click', function() {
                    openNoticeModal(parseInt(el.getAttribute('data-idx'), 10));
                });
            });

            section.style.display = 'block';
        }

        window.openNoticeModal = function(idx) {
            var n = _notices[idx];
            if (!n) return;
            document.getElementById('noticeModalTitle').textContent = n.title || '';
            var meta = [];
            if (n.is_pinned) meta.push('상단 고정');
            if (n.created_at) meta.push(fmtDate(n.created_at));
            if (n.author) meta.push(n.author);
            document.getElementById('noticeModalMeta').textContent = meta.join(' · ');

            var bodyHtml = '';
            var img = firstImage(n.images);
            if (img) bodyHtml += '<img src="' + esc(img) + '" alt="">';
            var lines = String(n.content || '').split('\n');
            lines.forEach(function(line) {
                bodyHtml += '<p>' + (esc(line) || '&nbsp;') + '</p>';
            });
            document.getElementById('noticeModalBody').innerHTML = bodyHtml;
            document.getElementById('noticeModalOv').classList.add('open');
        };

        window.closeNoticeModal = function() {
            document.getElementById('noticeModalOv').classList.remove('open');
        };

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeNoticeModal();
        });

        // 공개 API 호출 (인증 불필요)
        fetch('/api/v1/platform/notices/public?limit=5', { cache: 'no-store' })
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(res) {
                if (!res) return;
                var data = res.data || res;
                render(Array.isArray(data) ? data : []);
            })
            .catch(function(err) { console.warn('[notices] load failed:', err); });
    })();
    </script>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 188 44" width="188" height="44">
  <defs>
    <linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#A78BFA"/>
      <stop offset="100%" style="stop-color:#8B5CF6"/>
    </linearGradient>
    <linearGradient id="lg2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#C4B5FD"/>
      <stop offset="100%" style="stop-color:#A78BFA"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- Icon: Light Purple Graduation Cap -->
  <g transform="translate(6, 4)">
    <!-- Cap Diamond (Top) -->
    <path d="M16 4 L30 11 L16 18 L2 11 Z" fill="url(#lg2)" filter="url(#glow)"/>
    <!-- Cap Bottom part -->
    <path d="M7 13.5 V18 C7 21, 25 21, 25 18 V13.5" fill="url(#lg)" />
    <!-- Tassel -->
    <path d="M16 11 L26 15.5 V21" fill="none" stroke="#FBBF24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- Small Cap button -->
    <circle cx="16" cy="11" r="1.5" fill="#FFF"/>
  </g>
  <!-- Brand text - light -->
  <text x="44" y="19" font-family="'Outfit','Inter','Noto Sans KR',sans-serif" font-size="13" font-weight="800" fill="#FFFFFF" letter-spacing="1.5">NUBIDA</text>
  <text x="44" y="34" font-family="'Noto Sans KR',sans-serif" font-size="11" font-weight="700" fill="#C4B5FD" letter-spacing="1">누비다플랫폼</text>
</svg>

/* ================================================================
   누비다플랫폼 v10.0 — 전면 반응형 CSS (Top Navbar Layout)
   모바일(≤480px) → 태블릿(≤768px) → 데스크톱(≤1024px) 순서
   ================================================================ */

/* =================================================================
   0. Variables
   ================================================================= */
:root {
  --topnav-mobile-h: 52px;
  --touch-target-min: 44px;
  --overlay-z: 150;
  --modal-z: 1000;
}

/* =================================================================
   1. 기본 모바일 (< 768px)
   ================================================================= */
@media (max-width: 768px) {
  .app-layout {
    min-height: 100dvh;
  }

  /* ── Top Navbar Mobile ── */
  .top-navbar {
    height: var(--topnav-mobile-h);
    padding: 0 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .top-navbar::-webkit-scrollbar { display: none; }

  .top-navbar-logo img {
    height: 22px;
  }

  .top-navbar-center {
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 2px;
  }
  .top-navbar-center::-webkit-scrollbar { display: none; }

  .top-nav-item {
    font-size: var(--text-xs);
    padding: 4px 8px;
    gap: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .top-nav-item .icon {
    font-size: 14px;
    width: 16px;
  }

  .top-navbar-user-name {
    display: none;
  }
  .top-navbar-user-role {
    display: none;
  }

  .top-navbar-right {
    flex-shrink: 0;
  }

  /* ── Dropdown Menu Mobile ── */
  .top-navbar-dropdown-menu {
    position: fixed;
    top: auto;
    left: 12px;
    right: 12px;
    bottom: calc(24px + env(safe-area-inset-bottom, 0));
    min-width: auto;
    max-height: 60vh;
    overflow-y: auto;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    z-index: 300;
  }

  /* ── 메인 콘텐츠 ── */
  .main-content {
    padding: 16px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0));
  }

  /* ── 페이지 헤더 ── */
  .page-header {
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    min-height: auto;
  }
  .page-header-left {
    width: 100%;
  }
  .page-header-left h1 {
    font-size: var(--text-2xl);
  }
  .page-header-right {
    width: 100%;
    flex-wrap: wrap;
    gap: 6px;
  }
  .page-header-right select,
  .page-header-right .form-select,
  .page-header-right input,
  .page-header-right .form-input {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* 검색 input max-width 오버라이드 */
  .nav-search .form-input,
  input#userSearch,
  input#studentSearch,
  input#paymentSearch,
  input#videoSearch,
  input[type="text"].form-input {
    max-width: 100% !important;
    width: 100% !important;
    flex: none !important;
    box-sizing: border-box;
  }

  /* ── 통계 카드 ── */
  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  .stat-card {
    padding: 14px;
  }
  .stat-value {
    font-size: 1.3rem;
  }
  .stat-card .stat-icon {
    font-size: 22px;
    top: 12px;
    right: 12px;
  }

  /* ── 그리드 레이아웃 ── */
  .grid-2,
  .grid-3,
  .grid-4 {
    grid-template-columns: 1fr !important;
    gap: 12px;
    margin-bottom: 12px;
  }
  .grid-2.mobile-2col,
  .grid-3.mobile-2col,
  .grid-4.mobile-2col {
    grid-template-columns: 1fr 1fr !important;
  }

  /* ── 테이블 (가로 스크롤) ── */
  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
  }
  .data-table {
    min-width: 500px;
  }
  .data-table th,
  .data-table td {
    padding: 8px 10px;
    font-size: 11px;
    white-space: nowrap;
  }
  .data-table td .btn {
    min-height: 28px;
    height: 28px;
    padding: 0 8px;
    font-size: 10px;
    width: auto;
    min-width: auto;
  }
  .data-table td .btn + .btn {
    margin-left: 2px;
  }
  .data-table td div[style*="display:flex"] {
    gap: 2px !important;
  }
  .data-table td div[style*="display:flex"] .btn {
    min-height: 28px;
    padding: 0 6px;
    font-size: 10px;
  }

  /* ── 카드 ── */
  .card,
  .card-premium {
    margin: 0;
    border-radius: 12px;
    margin-bottom: 12px;
  }
  .card-header {
    padding: 12px 14px;
  }
  .card-header h2 {
    font-size: 0.95rem;
  }
  .card-body {
    padding: 12px 14px;
  }
  .card-body[style*="padding:0"],
  .card-body[style*="padding:0px"] {
    padding: 0 !important;
  }
  .card-body[style*="padding:0"] .table-wrapper {
    margin: 0;
    border-radius: 0;
  }
  .card-footer {
    padding: 10px 14px;
  }

  /* ── 필터 바 ── */
  .filter-bar {
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .filter-item {
    width: 100%;
  }
  .filter-item select,
  .filter-item input,
  .filter-item .form-select,
  .filter-item .form-input {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* ── 버튼 ── */
  .btn {
    min-height: var(--touch-target-min);
    font-size: 13px;
  }
  .btn-sm {
    min-height: 36px;
    font-size: 12px;
  }
  .btn-filled,
  .btn-ghost,
  .btn-outline,
  .btn-primary,
  .btn-secondary {
    width: 100%;
    justify-content: center;
  }
  .toolbar .btn,
  .toolbar-right .btn,
  .toolbar-left .btn {
    width: auto;
    min-width: auto;
  }
  .btn-group {
    flex-direction: column;
    gap: 6px;
  }
  .btn-group .btn {
    width: 100%;
  }
  .card-header .btn {
    width: auto;
  }

  /* ── 모달 (하단 시트) ── */
  .modal-overlay {
    align-items: flex-end;
  }
  .modal {
    width: 100%;
    margin: 0;
    border-radius: 16px 16px 0 0;
    max-height: 85vh;
    overflow-y: auto;
    padding: 20px;
  }
  .modal-lg {
    max-width: 100%;
    max-height: 90vh;
  }
  .modal-header {
    padding: 0 0 12px 0;
  }
  .modal-body {
    padding: 0;
  }
  .modal-actions {
    flex-direction: column;
    gap: 8px;
    position: sticky;
    bottom: 0;
    background: var(--bg-white);
    padding: 12px 0 0 0;
    margin-top: 16px;
    border-top: 1px solid var(--border-default);
  }
  .modal-actions .btn {
    width: 100% !important;
  }
  .modal div[style*="display:flex"][style*="justify-content:flex-end"],
  .modal div[style*="display:flex"][style*="gap"] {
    flex-direction: column !important;
    gap: 8px !important;
  }
  .modal div[style*="display:flex"][style*="justify-content:flex-end"] .btn,
  .modal div[style*="display:flex"][style*="gap"] .btn {
    width: 100% !important;
  }

  /* ── 폼 ── */
  .form-row {
    flex-direction: column;
    gap: 12px;
  }
  .form-group {
    width: 100%;
  }
  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    max-width: 100% !important;
    box-sizing: border-box;
  }
  label.form-label {
    font-size: 12px;
  }
  .form-input[style*="max-width"],
  .form-select[style*="max-width"] {
    max-width: 100% !important;
    width: 100% !important;
  }

  /* ── 탭 ── */
  .tabs,
  .tab-bar {
    overflow-x: auto;
    white-space: nowrap;
    gap: 0;
    -webkit-overflow-scrolling: touch;
  }
  .tab-item {
    padding: 10px 14px;
    font-size: 12px;
    flex-shrink: 0;
  }

  /* ── 뷰 토글 ── */
  .view-toggle {
    width: 100%;
  }
  .view-toggle .vt-btn {
    flex: 1;
    padding: 8px;
    font-size: 11px;
  }

  /* ── 검색/페이지네이션 ── */
  .search-bar input {
    width: 100%;
  }
  .pagination {
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
  }
  .pagination button,
  .pagination .btn {
    min-width: 36px;
    min-height: 32px;
    font-size: 11px;
    width: auto;
  }

  /* ── 체크박스/토글 ── */
  label.checkbox-label,
  label.toggle-label {
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
  }
  input[type="checkbox"] {
    width: 20px;
    height: 20px;
  }

  /* ── 포트폴리오 그리드 ── */
  .portfolio-grid,
  .portfolio-container,
  #portfolioGridView {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px;
  }
  .portfolio-card {
    padding: 10px;
  }
  .portfolio-thumb {
    width: 100%;
    height: 72px;
  }
  .portfolio-title {
    font-size: 11px;
  }
}

/* ================================================================
   2. 햄버거 버튼 + 사이드바 Drawer (Sidebar Layout — 실제 페이지 구조)
   ================================================================ */
.hamburger-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-white);
  cursor: pointer;
  color: var(--text-primary);
  font-size: 18px;
  line-height: 1;
  padding: 0;
  margin-right: 8px;
  transition: background var(--transition-fast), border-color var(--transition-fast);
  flex-shrink: 0;
}
.hamburger-btn:hover {
  background: var(--bg-subtle);
  border-color: var(--border-default);
}
.hamburger-btn:active { transform: scale(0.95); }

.sidebar-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  z-index: 150;
  opacity: 0;
  transition: opacity var(--transition-fast);
}
.sidebar-overlay.visible { display: block; opacity: 1; }

/* 로그아웃(하단) 항상 표시: nav만 스크롤, footer 하단 고정 (데스크톱 포함) */
.sidebar-nav {
  flex: 1 1 auto;
  overflow-y: auto;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}
.sidebar-footer {
  flex-shrink: 0;
  position: sticky;
  bottom: 0;
  z-index: 5;
  background: var(--sidebar-bg, #fff);
}

/* 모바일 (≤768px): 사이드바 → Drawer, 햄버거 표시 */
@media (max-width: 768px) {
  .hamburger-btn {
    display: inline-flex;
    min-height: 38px;
  }
  .sidebar {
    position: fixed !important;
    top: 0;
    left: 0;
    bottom: auto;
    height: 100vh;
    height: 100dvh;
    width: 264px;
    max-width: 82vw;
    z-index: 200 !important;
    transform: translateX(-100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: none;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .sidebar.open {
    transform: translateX(0);
    box-shadow: 0 8px 40px rgba(15, 23, 42, 0.25);
  }
  body.sidebar-open { overflow: hidden; }
  /* 로그아웃(하단)이 항상 보이도록: nav만 스크롤, footer 하단 고정 */
  .sidebar {
    overflow-y: hidden !important;
  }
  .sidebar-nav {
    flex: 1 1 auto !important;
    overflow-y: auto !important;
    min-height: 0 !important;
    -webkit-overflow-scrolling: touch;
  }
  .sidebar-footer {
    flex-shrink: 0 !important;
    position: sticky !important;
    bottom: 0 !important;
    z-index: 5;
    background: var(--sidebar-bg, #fff);
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0)) !important;
  }
  .top-nav-left {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 4px;
  }
  .top-nav-left h1 {
    font-size: 1.15rem !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .main-content {
    margin-left: 0 !important;
    width: 100% !important;
    padding: 14px 14px calc(20px + env(safe-area-inset-bottom, 0)) !important;
    box-sizing: border-box;
  }
  .top-nav {
    padding: 8px 0;
  }
}

/* ================================================================
   3. 문제1: 인라인 그리드/레이아웃 모바일 정렬 (≤768px)
   - 인라인 style="grid-template-columns" 가 모바일에서 깨지는 것 방지
   ================================================================ */
@media (max-width: 768px) {
  /* 통계 카드: 인라인 3~4열 강제 → 2열 */
  .stats-grid[style*="grid-template-columns"] {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px !important;
  }
  /* 일반 인라인 그리드 → 1열 */
  .grid-2[style*="grid-template-columns"],
  .grid-3[style*="grid-template-columns"],
  .grid-4[style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
  }
  /* 원장 학급관리: 좌(목록)+우(상세) → 세로 스택 (문제2) */
  .split-layout {
    grid-template-columns: 1fr !important;
    gap: 12px !important;
  }
  /* 상세 패널: 목록 아래에서 여백 확보 */
  .detail-panel {
    margin-top: 4px;
  }
  /* 학급 카드 내부 메타 정보 줄바꿈 허용 */
  .class-card-meta {
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  /* 본사 대시보드 metric/link 그리드 보조 */
  .metric-grid,
  .link-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
  @media (max-width: 480px) {
    .metric-grid,
    .link-grid {
      grid-template-columns: 1fr !important;
    }
  }
  /* 지점 대시보드: 원장 정보 인라인 2열 → 1열 */
  #directorInfo,
  div[style*="grid-template-columns:1fr 1fr"] {
    grid-template-columns: 1fr !important;
  }
  /* flex 인라인 요소 줄바꿈 허용 */
  div[style*="display:flex"] {
    flex-wrap: wrap;
  }
}

/* ================================================================
   4. Top Navbar 레이아웃 모바일 (햄버거 → 메뉴 드롭다운)
   - topnav-*.html 조각 + common/notifications.html 등
   ================================================================ */
@media (max-width: 768px) {
  .top-navbar .hamburger-btn {
    display: inline-flex;
    margin-right: 6px;
  }
  .top-navbar-center {
    display: none;
  }
  .top-navbar.center-open .top-navbar-center {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: fixed;
    top: 52px;
    left: 0;
    right: 0;
    background: var(--bg-white, #fff);
    border-bottom: 1px solid var(--border-subtle, #E5E7EB);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    padding: 8px 12px 12px;
    gap: 2px;
    overflow-y: auto;
    max-height: 70vh;
    z-index: 180;
  }
  .top-navbar.center-open .top-navbar-center .top-nav-item {
    padding: 12px 10px;
    font-size: 14px;
    border-radius: 10px;
    width: 100%;
    box-sizing: border-box;
  }
  .top-navbar.center-open .top-navbar-center .top-navbar-dropdown {
    width: 100%;
  }
  .top-navbar.center-open .top-navbar-center .top-navbar-dropdown > .top-nav-item {
    width: 100%;
  }
  .top-navbar.center-open .top-navbar-center .top-navbar-dropdown-menu {
    position: static;
    box-shadow: none;
    border: 1px solid var(--border-subtle, #E5E7EB);
    margin: 4px 0 4px 8px;
    max-height: none;
    border-radius: 10px;
  }
  .top-navbar.center-open .top-navbar-center .top-navbar-dropdown-menu.open {
    display: block;
  }
}

/* ================================================================
   5. 통계 그리드(stats-grid) 배치 개선
   - PC: 4칸 이하 균등 그리드 (2×2 / 4칸)
   - 모바일: 2열 폭에 꽉 맞게, 초소형 1열
   ================================================================ */
.stats-grid {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
}
/* 카드 간격·크기 균등 보장 (인라인 스타일 포함) */
.stats-grid[style*="grid-template-columns"] {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
}
.stat-card {
  padding: var(--space-4) var(--space-5);
  min-height: 84px;
}
.stat-label {
  font-size: var(--text-3xs);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.stat-value {
  font-size: var(--text-4xl);
}
@media (max-width: 768px) {
  .stats-grid,
  .stats-grid[style*="grid-template-columns"] {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px !important;
    margin-bottom: 12px !important;
  }
  .stat-card {
    padding: 12px 12px !important;
    min-height: 72px !important;
    border-left-width: 3px !important;
  }
  .stat-label {
    font-size: 10px !important;
    letter-spacing: 0 !important;
    white-space: normal !important;
    line-height: 1.3 !important;
  }
  .stat-value {
    font-size: 1.35rem !important;
  }
}
@media (max-width: 340px) {
  .stats-grid,
  .stats-grid[style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
  }
}

/* ================================================================
   6. 필터/검색/버튼 배치 정리
   - PC: 한 줄 정돈 (여백·간격 균등)
   - 모바일: 세로 스택, 폭에 딱 맞게, 터치 타겟 44px
   ================================================================ */
.filter-bar {
  gap: 8px !important;
  align-items: center !important;
  margin-bottom: 16px !important;
}
.filter-item {
  flex: none;
  min-width: 0;
}
.filter-item .form-select,
.filter-item .form-input {
  min-width: 0 !important;
  width: auto;
  box-sizing: border-box;
}
/* 페이지 헤더 검색/버튼 행 정렬 */
.toolbar,
.toolbar-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.toolbar .form-input,
.toolbar .form-select,
.toolbar-right .form-input,
.toolbar-right .form-select {
  min-width: 0;
  height: 38px;
}
@media (max-width: 768px) {
  .filter-bar {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
    padding: 12px !important;
    border: 1px solid var(--border-subtle, #E5E7EB);
    border-radius: 12px;
  }
  .filter-item {
    width: 100% !important;
    flex: none !important;
  }
  .filter-item .form-select,
  .filter-item .form-input,
  .filter-item .btn {
    width: 100% !important;
    height: 44px !important;
    min-height: 44px !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }
  .filter-item label,
  .filter-item .filter-label {
    font-size: 12px;
  }
  .toolbar,
  .toolbar-row {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 8px !important;
  }
  .toolbar-left,
  .toolbar-right,
  .toolbar .form-input,
  .toolbar .form-select,
  .toolbar .btn {
    width: 100% !important;
    max-width: 100% !important;
  }
  .page-header-right .btn,
  .top-nav-right .btn {
    min-height: 44px;
  }
}

/* ================================================================
   7. 필터/검색 툴바 통합 정렬 (모든 페이지 공통)
   - 컨테이너 클래스 15종을 동일한 스타일로 통일
   - PC: 한 줄 wrap + 12px 간격 + 높이 38px

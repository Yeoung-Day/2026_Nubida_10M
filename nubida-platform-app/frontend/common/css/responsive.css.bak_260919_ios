/* ================================================================
   10. 필터바 모바일 정렬 (전 페이지 공통)
   - mgmt-toolbar / filter-bar / filter-row 등 필터 컨테이너를 모바일에서 세로/줄바꿈
   - 인라인 고정 width(130px/150px 등)를 모바일에서 100%로 덮어쓰기
   ================================================================ */
@media (max-width: 768px) {
  .mgmt-toolbar,
  .filter-bar,
  .filters-row,
  .filter-row,
  .filter-group,
  .filter-section,
  .toolbar-row,
  [class*="filter-bar"],
  [class*="filter-row"],
  [class*="filter-group"] {
    flex-wrap: wrap !important;
    gap: 8px !important;
  }

  .mgmt-toolbar select,
  .mgmt-toolbar input[type="text"],
  .mgmt-toolbar input[type="search"],
  .filter-bar select,
  .filter-bar input,
  .filters-row select,
  .filters-row input,
  .filter-row select,
  .filter-row input,
  .filter-group select,
  .filter-group input {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }

  /* 필터 라벨/버튼도 한 줄에 들어오도록 */
  .mgmt-toolbar .btn,
  .filter-bar .btn,
  .filters-row .btn {
    flex-shrink: 0;
  }
}

/* ================================================================
   원장 모바일 UI 4건 수정 (2026-08-05)
   - classes.html: 연결 강좌/학생 행 해제·퇴소 버튼 인라인 유지, 출결 툴바 가로 정렬
   - payments.html: 카드뷰 tfoot 합계 정렬
   - portfolio.html: top-nav 세로 배치 (h1 가림 방지)
   - settings.html: settings-grid 1열 전환
   ================================================================ */
@media (max-width: 768px) {

  /* ── 1) classes.html: 연결 강좌/학생 행 (해제/퇴소 버튼 인라인) ── */
  .linked-item .btn {
    width: auto !important;
    flex-shrink: 0 !important;
    min-height: 30px;
    padding: 4px 10px;
    font-size: 11px;
    white-space: nowrap;
  }
  .linked-item .linked-item-info {
    min-width: 0;
    flex: 1 1 auto;
  }
  .linked-item .linked-item-name,
  .linked-item .linked-item-sub {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 출결관리 툴바: 버튼/폼 가로 정렬 */
  #tabAttendance .action-bar .btn,
  #tabAttendance .flex.gap-16 .btn {
    width: auto !important;
    flex-shrink: 0 !important;
    min-height: 32px;
  }
  #tabAttendance .flex.gap-16 {
    flex-wrap: wrap !important;
    gap: 8px !important;
  }

  /* ── 2) payments.html: 카드뷰 tfoot 합계 정렬 ── */
  table[data-card-view] tfoot {
    display: block !important;
    width: 100% !important;
  }
  table[data-card-view] tfoot tr {
    display: grid !important;
    grid-template-columns: 1fr 1fr 1fr !important;
    gap: 4px 8px !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }
  table[data-card-view] tfoot td {
    display: flex !important;
    justify-content: flex-end !important;
    align-items: center !important;
    padding: 8px 10px !important;
    font-size: 12px !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    white-space: nowrap !important;
  }
  table[data-card-view] tfoot td:first-child {
    justify-content: flex-start !important;
    grid-column: 1 / -1 !important;
    width: 100% !important;
    font-weight: 700 !important;
    border-bottom: 1px dashed var(--border-default, #D1D5DB) !important;
    padding: 10px 12px !important;
  }
  /* 빈 셀(colspan 여백용) 숨김 — 모바일에서는 불필요 */
  table[data-card-view] tfoot td:empty {
    display: none !important;
  }

  /* ── 3) portfolio.html: top-nav 세로 배치 (h1 가림 방지) ── */
  .top-nav {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 8px !important;
  }
  .top-nav-left {
    width: 100% !important;
    justify-content: space-between !important;
  }
  .top-nav-right {
    width: 100% !important;
    justify-content: flex-start !important;
    flex-wrap: wrap !important;
    gap: 6px !important;
  }
  .top-nav-right .view-toggle {
    width: auto !important;
    flex: 0 1 auto !important;
  }
  .top-nav-right .view-toggle .vt-btn {
    padding: 8px 12px !important;
    font-size: 11px !important;
    white-space: nowrap;
  }

  /* ── 4) settings.html: settings-grid 1열 전환 ── */
  .settings-grid {
    grid-template-columns: 1fr !important;
    max-width: 100% !important;
    gap: 14px !important;
  }
}

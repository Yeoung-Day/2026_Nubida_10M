            ],
            stream: false
        });

        const aiReply = response.data.message.content;
        await conn.execute('INSERT INTO chat_history (student_id, role, content) VALUES (?, ?, ?)', [studentId, 'assistant', aiReply]);
        res.json({ reply: aiReply });
    } catch (err) {
        res.status(500).json({ message: 'AI 서버 응답 오류' });
    } finally { if (conn) await conn.end(); }
});


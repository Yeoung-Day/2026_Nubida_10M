// [1. 회원가입 API]
app.post('/api/register', async (req, res) => {
    const { studentId, password } = req.body;
    let conn;
    try {
        conn = await mysql.createConnection(dbConfig);
        const [rows] = await conn.execute('SELECT id FROM students WHERE student_id = ?', [studentId]);
        if (rows.length > 0) return res.status(409).json({ message: '이미 존재하는 아이디입니다.' });
        await conn.execute('INSERT INTO students (student_id, password) VALUES (?, ?)', [studentId, hashPassword(password)]);
        res.json({ success: true });
    } catch (err) { res.status(500).json({ error: err.message }); }
    finally { if (conn) await conn.end(); }
});

// [2. 로그인 API]
app.post('/api/login', async (req, res) => {
    const { studentId, password } = req.body;
    let conn;
    try {
        conn = await mysql.createConnection(dbConfig);
        const [rows] = await conn.execute('SELECT * FROM students WHERE student_id = ?', [studentId]);
        const _stu = rows.length > 0 ? rows[0] : null;
        if (_stu && verifyPassword(password, _stu.password)) {
            // 기존 평문/SHA-256 이면 PBKDF2 로 자동 업그레이드
            if (needsRehash(_stu.password)) {
                try {
                    await conn.execute('UPDATE students SET password = ? WHERE id = ?', [hashPassword(password), _stu.id]);
                } catch (e) { /* 업그레이드 실패는 로그인을 막지 않음 */ }
            }
            req.session.user = studentId;
            req.session.save(() => res.json({ success: true }));
        } else {
            res.status(401).json({ message: '학번 또는 비번이 틀립니다.' });
        }
    } catch (err) { res.status(500).json({ error: err.message }); }
    finally { if (conn) await conn.end(); }
});


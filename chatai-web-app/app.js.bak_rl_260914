    finally { if (conn) await conn.end(); }
});

// [4. AI 채팅 API - 정리 지침 및 마운트]
app.post('/api/chat', async (req, res) => {
    const studentId = req.session.user;
    if (!studentId) return res.status(403).json({ message: '로그인 필요' });
    const { message } = req.body;
    let conn;

    try {
        conn = await mysql.createConnection(dbConfig);
        await conn.execute('INSERT INTO chat_history (student_id, role, content) VALUES (?, ?, ?)', [studentId, 'user', message]);

        const [historyRows] = await conn.execute(
            'SELECT role, content FROM chat_history WHERE student_id = ? ORDER BY created_at DESC LIMIT 6',
            [studentId]
        );
        const history = historyRows.reverse().map(row => ({ role: row.role, content: row.content }));

        const response = await axios.post('http://ollama:11434/api/chat', {
            model: 'qwen3:8b',
            messages: [
                { 
                    role: 'system', 
                    content: "너는 '누비다 AI 선생님'이야. 학생의 질문에 답할 때 다음 형식을 지켜줘: 1. 가독성을 위해 줄바꿈을 자주 할 것. 2. 중요한 용어는 **굵게** 표시할 것. 3. 단계가 있다면 번호를 매겨 설명할 것. 4. 항상 친절한 존댓말을 쓸 것.\n\n[중요 - 정확성 규칙]\n- 절대 거짓 정보를 지어내지 마라. 모르는 내용이면 '죄송하지만 정확히 알지 못합니다'라고 솔직하게 인정해라.\n- 특히 특정 인물, 가수, 그룹, 역사적 사실, 숫자, 날짜 등의 구체적인 사실을 말할 때는 반드시 실제로 알고 있는 경우에만 답하고, 확신이 없으면 실제 존재하지 않는 정보를 만들어내지 마라.\n- 특정 인물/그룹 멤버 목록을 나열할 때, 실제로 아는 멤버만 나열하고 전체를 안다고 단정하지 마라. 확신이 없으면 '정확한 멤버 전체를 확인하기 어렵습니다'라고 답해라.\n- 질문의 대상이 본인이 학습한 정보에 없으면 추측하지 말고 모른다고 정직하게 말해라." 
